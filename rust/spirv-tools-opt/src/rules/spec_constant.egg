; =============================================================================
; Specialization Constant Optimization Rules (ONE PASS Global Optimization)
; =============================================================================
;
; SPIR-V specialization constants (OpSpecConstant*) are compile-time constants
; whose values can be specialized at pipeline creation time. This module
; implements spec constant optimizations in the e-graph.
;
; Key constructors (defined in datatypes.egg):
; - SpecConst: Reference to a spec constant (SpecConst spec_id default_value)
; - SpecAdd/Sub/Mul/...: Spec constant operations (OpSpecConstantOp)
; - SpecSelect: Spec constant conditional
;
; All spec constant operations are Expr sort and are evaluated at
; specialization time. The e-graph finds equivalent expressions that
; may be simpler.
;
; NOTE: Const is now IntExpr sort, not Expr. When spec constant rules need
; to reference integer constants as Expr, we use (IntToExpr (Const n)).
;
; =============================================================================
; Spec Constant Algebraic Identities
; =============================================================================
; These mirror the regular algebraic rules but for spec constant operations.
; Since Spec* ops take Expr, integer constants must be bridged via IntToExpr.

; SpecAdd identities
(rule ((= e (SpecAdd x (IntToExpr (Const 0))))) ((union e x)))
(rule ((= e (SpecAdd (IntToExpr (Const 0)) x))) ((union e x)))
(rule ((= e (SpecAdd x (SpecConst _ 0)))) ((union e x)))
(rule ((= e (SpecAdd (SpecConst _ 0) x))) ((union e x)))

; SpecSub identities
(rule ((= e (SpecSub x (IntToExpr (Const 0))))) ((union e x)))
(rule ((= e (SpecSub x x))) ((union e (IntToExpr (Const 0)))))

; SpecMul identities
(rule ((= e (SpecMul x (IntToExpr (Const 0))))) ((union e (IntToExpr (Const 0)))))
(rule ((= e (SpecMul (IntToExpr (Const 0)) x))) ((union e (IntToExpr (Const 0)))))
(rule ((= e (SpecMul x (IntToExpr (Const 1))))) ((union e x)))
(rule ((= e (SpecMul (IntToExpr (Const 1)) x))) ((union e x)))

; SpecDiv identities
(rule ((= e (SpecSDiv x (IntToExpr (Const 1))))) ((union e x)))
(rule ((= e (SpecUDiv x (IntToExpr (Const 1))))) ((union e x)))

; SpecBitwise identities
(rule ((= e (SpecBitAnd x (IntToExpr (Const 0))))) ((union e (IntToExpr (Const 0)))))
(rule ((= e (SpecBitAnd (IntToExpr (Const 0)) x))) ((union e (IntToExpr (Const 0)))))
(rule ((= e (SpecBitOr x (IntToExpr (Const 0))))) ((union e x)))
(rule ((= e (SpecBitOr (IntToExpr (Const 0)) x))) ((union e x)))
(rule ((= e (SpecBitXor x (IntToExpr (Const 0))))) ((union e x)))
(rule ((= e (SpecBitXor (IntToExpr (Const 0)) x))) ((union e x)))
(rule ((= e (SpecBitXor x x))) ((union e (IntToExpr (Const 0)))))

; =============================================================================
; Spec Constant Select Simplifications
; =============================================================================

; SpecSelect with constant condition (bridged through IntToExpr)
(rule ((= e (SpecSelect (IntToExpr (Const 0)) then_val else_val)))
      ((union e else_val)))
; SpecSelect with BoolToExpr constant condition
(rule ((= e (SpecSelect (BoolToExpr (BoolConst 0)) then_val else_val)))
      ((union e else_val)))
(rule ((= e (SpecSelect (BoolToExpr (BoolConst c)) then_val else_val)) (!= c 0))
      ((union e then_val)))

; SpecSelect with same branches
(rule ((= e (SpecSelect cond x x)))
      ((union e x)))

; =============================================================================
; Spec Constant Comparison Simplifications
; =============================================================================

; Self-comparisons
(rule ((= e (SpecEq x x))) ((union e (IntToExpr (Const 1)))))
(rule ((= e (SpecNe x x))) ((union e (IntToExpr (Const 0)))))
(rule ((= e (SpecSLt x x))) ((union e (IntToExpr (Const 0)))))
(rule ((= e (SpecULt x x))) ((union e (IntToExpr (Const 0)))))

; =============================================================================
; Spec Constant Strength Reduction
; =============================================================================
; Replace expensive spec ops with cheaper equivalents.

; Multiply by power of 2 -> shift
(rule ((= e (SpecMul x (IntToExpr (Const 2)))))
      ((union e (SpecShl x (IntToExpr (Const 1))))))
(rule ((= e (SpecMul x (IntToExpr (Const 4)))))
      ((union e (SpecShl x (IntToExpr (Const 2))))))
(rule ((= e (SpecMul x (IntToExpr (Const 8)))))
      ((union e (SpecShl x (IntToExpr (Const 3))))))
(rule ((= e (SpecMul (IntToExpr (Const 2)) x)))
      ((union e (SpecShl x (IntToExpr (Const 1))))))
(rule ((= e (SpecMul (IntToExpr (Const 4)) x)))
      ((union e (SpecShl x (IntToExpr (Const 2))))))
(rule ((= e (SpecMul (IntToExpr (Const 8)) x)))
      ((union e (SpecShl x (IntToExpr (Const 3))))))

; Unsigned divide by power of 2 -> shift
(rule ((= e (SpecUDiv x (IntToExpr (Const 2)))))
      ((union e (SpecShrU x (IntToExpr (Const 1))))))
(rule ((= e (SpecUDiv x (IntToExpr (Const 4)))))
      ((union e (SpecShrU x (IntToExpr (Const 2))))))
(rule ((= e (SpecUDiv x (IntToExpr (Const 8)))))
      ((union e (SpecShrU x (IntToExpr (Const 3))))))

; Unsigned mod by power of 2 -> bitwise and
(rule ((= e (SpecUMod x (IntToExpr (Const 2)))))
      ((union e (SpecBitAnd x (IntToExpr (Const 1))))))
(rule ((= e (SpecUMod x (IntToExpr (Const 4)))))
      ((union e (SpecBitAnd x (IntToExpr (Const 3))))))
(rule ((= e (SpecUMod x (IntToExpr (Const 8)))))
      ((union e (SpecBitAnd x (IntToExpr (Const 7))))))
(rule ((= e (SpecUMod x (IntToExpr (Const 16)))))
      ((union e (SpecBitAnd x (IntToExpr (Const 15))))))

; =============================================================================
; Spec Constant to Regular Constant Folding
; =============================================================================
; When both operands are known constants, fold to a regular constant.
; (The actual folding values would be computed by primitives)

; Two constants added -> constant
; Note: Full constant folding requires Rust primitives for evaluation

; =============================================================================
; SpecConst Default Value Usage
; =============================================================================
; When a spec constant is used with its default value known, we can sometimes
; simplify. But we keep the SpecConst form to allow runtime specialization.

; SpecConst with default 0 in certain contexts
(rule ((= e (SpecAdd (SpecConst id 0) x)))
      ((union e x)))  ; Only if spec constant remains 0 (conservative)

; =============================================================================
; Condition Analysis for Spec Constants
; =============================================================================
; NOTE: CanBeTrue/CanBeFalse now take BoolExpr, but Spec* ops are Expr sort.
; Spec constant condition analysis happens through ExprToBool bridge when
; spec constant results are used as conditions in Gamma/Select/If/Theta.
; Direct CanBeTrue/CanBeFalse rules for Spec* ops have been removed since
; those relations only accept BoolExpr.
