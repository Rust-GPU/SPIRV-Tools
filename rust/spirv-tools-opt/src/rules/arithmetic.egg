; =============================================================================
; Arithmetic Rewrite Rules
; =============================================================================

; Identity rules - ONE-DIRECTIONAL to prevent e-graph explosion
; Using (rule ... union) instead of (rewrite) to avoid x → Add(x, 0) for every x
(rule ((= e (Add x (Const 0))))
      ((union e x)))
(rule ((= e (Add (Const 0) x)))
      ((union e x)))
(rule ((= e (Sub x (Const 0))))
      ((union e x)))
(rule ((= e (Mul x (Const 1))))
      ((union e x)))
(rule ((= e (Mul (Const 1) x)))
      ((union e x)))
; Mul by zero: use rule + union to avoid cycles
(rule ((= e (Mul x (Const 0))))
      ((union e (Const 0))))
(rule ((= e (Mul (Const 0) x)))
      ((union e (Const 0))))

; Negation rules
; (Sub 0 x) is Neg x - ONE-DIRECTIONAL to prevent Neg x → Sub 0 x expansion
(rule ((= e (Sub (Const 0) x)))
      ((union e (Neg x))))
; Double negation - ONE-DIRECTIONAL (x → Neg(Neg(x)) would explode)
(rule ((= e (Neg (Neg x))))
      ((union e x)))
; Mul by -1 is Neg - ONE-DIRECTIONAL to prevent Neg x → Mul x -1 expansion
(rule ((= e (Mul x (Const -1))))
      ((union e (Neg x))))
(rule ((= e (Mul (Const -1) x)))
      ((union e (Neg x))))
; Neg factoring - ONE-DIRECTIONAL: pull Neg OUTSIDE Add (simplifying 2 Negs → 1)
; The reverse (pushing Neg inside) creates 2 new Neg nodes causing explosion.
(rule ((= e (Add (Neg x) (Neg y))))
      ((union e (Neg (Add x y)))))
(rule ((= e (Neg (Sub x y))))
      ((union e (Sub y x))))
(rule ((= e (Add x (Neg x))))
      ((union e (Const 0))))
(rule ((= e (Add (Neg x) x)))
      ((union e (Const 0))))
(rule ((= e (Sub x x)))
      ((union e (Const 0))))

; Algebraic cancellation rules - ONE-DIRECTIONAL to prevent explosion
; Without this fix, y → Sub(Add(x, y), x) for every x and y - catastrophic!
(rule ((= e (Sub (Add x y) x)))
      ((union e y)))
(rule ((= e (Sub (Add y x) x)))
      ((union e y)))
(rule ((= e (Add (Sub x y) y)))
      ((union e x)))
(rule ((= e (Add y (Sub x y))))
      ((union e x)))
(rule ((= e (Sub (Add x y) y)))
      ((union e x)))
(rule ((= e (Sub (Add y x) y)))
      ((union e x)))
(rule ((= e (Sub x (Sub x y))))
      ((union e y)))
; Sub patterns that produce Neg - ONE-DIRECTIONAL
; (Neg y → Sub x (Add x y) would create terms out of thin air)
(rule ((= e (Sub x (Add x y))))
      ((union e (Neg y))))
(rule ((= e (Sub x (Add y x))))
      ((union e (Neg y))))
(rule ((= e (Sub (Sub x y) x)))
      ((union e (Neg y))))
; Sub-sub simplifications - ONE-DIRECTIONAL
(rule ((= e (Sub (Sub a b) (Sub c b))))
      ((union e (Sub a c))))
(rule ((= e (Sub (Sub a b) (Sub a c))))
      ((union e (Sub c b))))

; Commutativity - ONE-DIRECTIONAL to prevent explosion
; We normalize: move constants to the right to enable constant reassociation
; NOTE: Full commutativity (rewrite (Add a b) (Add b a)) causes exponential explosion
; when combined with other rules. Instead, we use targeted normalization.
(rule ((= e (Add (Const c) x)) (!= c 0))
      ((union e (Add x (Const c)))))
(rule ((= e (Mul (Const c) x)) (!= c 0) (!= c 1))
      ((union e (Mul x (Const c)))))

; Associativity for Add - RESTRICTED to prevent explosion
; General associativity (Add (Add a b) c) -> (Add a (Add b c)) causes e-graph explosion
; when combined with identity rules:
;   1. Add(x, 0) = x via identity
;   2. Any Add(x, Y) now matches Add(Add(x, 0), Y)
;   3. Associativity fires endlessly
;
; Safe variant: Only apply when 'b' is an Add operation (not a Const that could be 0).
; This enables (a + (b + c)) + d -> a + ((b + c) + d) for chains of additions.
(rule ((= e (Add (Add a b) c)) (= b (Add _ _)))
      ((union e (Add a (Add b c)))))
;
; The constant reassociation rules below handle the most important optimization case
; (gathering constants together for folding).

; Constant reassociation
(rule ((= e (Add (Add x (Const a)) (Const b))))
      ((union e (Add x (Const (+ a b))))))
(rule ((= e (Add (Const a) (Add x (Const b)))))
      ((union e (Add x (Const (+ a b))))))
(rule ((= e (Add (Const a) (Add (Const b) x))))
      ((union e (Add x (Const (+ a b))))))

; Strength reduction: multiply by power of 2 -> shift - ONE-DIRECTIONAL
; We recognize Mul x 2^n as Shl, but NOT the reverse (Shl x n → Mul x 2^n)
; The reverse would interact badly with shift recognition patterns
(rule ((= e (Mul x (Const 2))))
      ((union e (Shl x (Const 1)))))
(rule ((= e (Mul x (Const 4))))
      ((union e (Shl x (Const 2)))))
(rule ((= e (Mul x (Const 8))))
      ((union e (Shl x (Const 3)))))
(rule ((= e (Mul x (Const 16))))
      ((union e (Shl x (Const 4)))))
(rule ((= e (Mul x (Const 32))))
      ((union e (Shl x (Const 5)))))
(rule ((= e (Mul x (Const 64))))
      ((union e (Shl x (Const 6)))))
(rule ((= e (Mul x (Const 128))))
      ((union e (Shl x (Const 7)))))
(rule ((= e (Mul x (Const 256))))
      ((union e (Shl x (Const 8)))))

; Division by power of 2 -> shift (unsigned) - ONE-DIRECTIONAL
(rule ((= e (UDiv x (Const 2))))
      ((union e (ShrU x (Const 1)))))
(rule ((= e (UDiv x (Const 4))))
      ((union e (ShrU x (Const 2)))))
(rule ((= e (UDiv x (Const 8))))
      ((union e (ShrU x (Const 3)))))
(rule ((= e (UDiv x (Const 16))))
      ((union e (ShrU x (Const 4)))))

; DISABLED: Division cancellation — incorrect when Mul wraps (32-bit overflow).
; SDiv(Mul(x, a), a) ≠ x if x*a overflows.  SPIR-V integers are modular.
; (rule ((= e (SDiv (Mul x a) a)))
;       ((union e x)))
; (rule ((= e (SDiv (Mul a x) a)))
;       ((union e x)))
; (rule ((= e (UDiv (Mul x a) a)))
;       ((union e x)))
; (rule ((= e (UDiv (Mul a x) a)))
;       ((union e x)))

; DISABLED: Mul/Div cancellation — (y / x) * x ≠ y for integer division.
; Integer division truncates: (7 / 2) * 2 = 6 ≠ 7.
; (rule ((= e (Mul (SDiv y x) x)))
;       ((union e y)))
; (rule ((= e (Mul x (SDiv y x))))
;       ((union e y)))
; (rule ((= e (Mul (UDiv y x) x)))
;       ((union e y)))
; (rule ((= e (Mul x (UDiv y x))))
;       ((union e y)))

; Division identity - ONE-DIRECTIONAL to prevent explosion
(rule ((= e (SDiv x (Const 1))))
      ((union e x)))
(rule ((= e (UDiv x (Const 1))))
      ((union e x)))

; Division by self
(rule ((= e (SDiv x x)))
      ((union e (Const 1))))
(rule ((= e (UDiv x x)))
      ((union e (Const 1))))

; Mod/Rem by power of 2: x mod 2^n = x & (2^n - 1) for unsigned - ONE-DIRECTIONAL
(rule ((= e (UMod x (Const 2))))
      ((union e (BitAnd x (Const 1)))))
(rule ((= e (UMod x (Const 4))))
      ((union e (BitAnd x (Const 3)))))
(rule ((= e (UMod x (Const 8))))
      ((union e (BitAnd x (Const 7)))))
(rule ((= e (UMod x (Const 16))))
      ((union e (BitAnd x (Const 15)))))

; Division/mod of 0
(rule ((= e (SDiv (Const 0) x)))
      ((union e (Const 0))))
(rule ((= e (UDiv (Const 0) x)))
      ((union e (Const 0))))
(rule ((= e (SRem (Const 0) x)))
      ((union e (Const 0))))
(rule ((= e (UMod (Const 0) x)))
      ((union e (Const 0))))
(rule ((= e (SMod (Const 0) x)))
      ((union e (Const 0))))

; Mod by 1
(rule ((= e (SRem x (Const 1))))
      ((union e (Const 0))))
(rule ((= e (UMod x (Const 1))))
      ((union e (Const 0))))
(rule ((= e (SMod x (Const 1))))
      ((union e (Const 0))))

; =============================================================================
; Distributive Law (Factoring) Rules - ONE-DIRECTIONAL
; =============================================================================
; NOTE: These MUST be one-directional rules! Using bidirectional rewrite causes
; x * (a + b) → (x * a) + (x * b) which expands forever with nested expressions.
; We only want to FACTOR (collect terms), not DISTRIBUTE (expand terms).

; (x * a) + (x * b) => x * (a + b)  - factoring out common term
; NOTE: These are safe because there is no general integer Mul associativity
; rule (only constant-folding variants). Without associativity creating new
; Mul groupings, the feedback loop that causes FP factoring explosion cannot
; form. If a general (Mul (Mul a b) c) -> (Mul a (Mul b c)) rule is ever
; added, these must be disabled too (see floating_point.egg factoring).
(rule ((= e (Add (Mul x a) (Mul x b))))
      ((union e (Mul x (Add a b)))))
(rule ((= e (Add (Mul a x) (Mul b x))))
      ((union e (Mul x (Add a b)))))
(rule ((= e (Add (Mul x a) (Mul b x))))
      ((union e (Mul x (Add a b)))))
(rule ((= e (Add (Mul a x) (Mul x b))))
      ((union e (Mul x (Add a b)))))

; (x * a) - (x * b) => x * (a - b)  - factoring with subtraction
(rule ((= e (Sub (Mul x a) (Mul x b))))
      ((union e (Mul x (Sub a b)))))
(rule ((= e (Sub (Mul a x) (Mul b x))))
      ((union e (Mul x (Sub a b)))))
(rule ((= e (Sub (Mul x a) (Mul b x))))
      ((union e (Mul x (Sub a b)))))
(rule ((= e (Sub (Mul a x) (Mul x b))))
      ((union e (Mul x (Sub a b)))))

; x + x => x * 2  - special case for adding same value - ONE-DIRECTIONAL
; (x * 2 → x + x would explode)
(rule ((= e (Add x x)))
      ((union e (Mul x (Const 2)))))

; =============================================================================
; Strength Reduction Recognition Patterns
; =============================================================================
; These rules recognize shift+add patterns and consolidate to multiplies.
; They're one-directional: we don't expand (Mul x 3) to shifts, but we
; recognize shifts as multiplies for better cost extraction.
; This prevents e-graph explosion while still enabling optimization.

; (x << 1) + x = x * 3
(rule ((= e (Add (Shl x (Const 1)) x)))
      ((union e (Mul x (Const 3)))))
(rule ((= e (Add x (Shl x (Const 1)))))
      ((union e (Mul x (Const 3)))))

; (x << 2) + x = x * 5
(rule ((= e (Add (Shl x (Const 2)) x)))
      ((union e (Mul x (Const 5)))))
(rule ((= e (Add x (Shl x (Const 2)))))
      ((union e (Mul x (Const 5)))))

; (x << 2) + (x << 1) = x * 6
(rule ((= e (Add (Shl x (Const 2)) (Shl x (Const 1)))))
      ((union e (Mul x (Const 6)))))
(rule ((= e (Add (Shl x (Const 1)) (Shl x (Const 2)))))
      ((union e (Mul x (Const 6)))))

; (x << 3) - x = x * 7
(rule ((= e (Sub (Shl x (Const 3)) x)))
      ((union e (Mul x (Const 7)))))

; (x << 3) + x = x * 9
(rule ((= e (Add (Shl x (Const 3)) x)))
      ((union e (Mul x (Const 9)))))
(rule ((= e (Add x (Shl x (Const 3)))))
      ((union e (Mul x (Const 9)))))

; (x << 3) + (x << 1) = x * 10
(rule ((= e (Add (Shl x (Const 3)) (Shl x (Const 1)))))
      ((union e (Mul x (Const 10)))))
(rule ((= e (Add (Shl x (Const 1)) (Shl x (Const 3)))))
      ((union e (Mul x (Const 10)))))

; (x << 4) - x = x * 15
(rule ((= e (Sub (Shl x (Const 4)) x)))
      ((union e (Mul x (Const 15)))))

; (x << 3) + (x << 2) = x * 12
(rule ((= e (Add (Shl x (Const 3)) (Shl x (Const 2)))))
      ((union e (Mul x (Const 12)))))
(rule ((= e (Add (Shl x (Const 2)) (Shl x (Const 3)))))
      ((union e (Mul x (Const 12)))))

; (x << 3) + (x << 1) + x = x * 11
(rule ((= e (Add (Add (Shl x (Const 3)) (Shl x (Const 1))) x)))
      ((union e (Mul x (Const 11)))))
(rule ((= e (Add (Shl x (Const 3)) (Add (Shl x (Const 1)) x))))
      ((union e (Mul x (Const 11)))))

; (x << 3) + (x << 2) + x = x * 13
(rule ((= e (Add (Add (Shl x (Const 3)) (Shl x (Const 2))) x)))
      ((union e (Mul x (Const 13)))))
(rule ((= e (Add (Shl x (Const 3)) (Add (Shl x (Const 2)) x))))
      ((union e (Mul x (Const 13)))))

; (x << 4) - (x << 1) = x * 14
(rule ((= e (Sub (Shl x (Const 4)) (Shl x (Const 1)))))
      ((union e (Mul x (Const 14)))))

; (x << 4) + x = x * 17
(rule ((= e (Add (Shl x (Const 4)) x)))
      ((union e (Mul x (Const 17)))))
(rule ((= e (Add x (Shl x (Const 4)))))
      ((union e (Mul x (Const 17)))))

; (x << 4) + (x << 1) = x * 18
(rule ((= e (Add (Shl x (Const 4)) (Shl x (Const 1)))))
      ((union e (Mul x (Const 18)))))
(rule ((= e (Add (Shl x (Const 1)) (Shl x (Const 4)))))
      ((union e (Mul x (Const 18)))))

; (x << 5) - x = x * 31
(rule ((= e (Sub (Shl x (Const 5)) x)))
      ((union e (Mul x (Const 31)))))

; (x << 5) + x = x * 33
(rule ((= e (Add (Shl x (Const 5)) x)))
      ((union e (Mul x (Const 33)))))
(rule ((= e (Add x (Shl x (Const 5)))))
      ((union e (Mul x (Const 33)))))

; =============================================================================
; Signed Division Strength Reduction
; =============================================================================

; SDiv by power of 2 needs sign-aware handling
; For signed: x / 2 = (x + (x >> 31)) >> 1 for 32-bit
; But ShrS already handles sign extension, so for simple cases:
; Note: These are for non-negative values; full signed div is complex

; =============================================================================
; Modulo Optimization Patterns
; =============================================================================

; x % x = 0
(rule ((= e (SRem x x)))
      ((union e (Const 0))))
(rule ((= e (UMod x x)))
      ((union e (Const 0))))
(rule ((= e (SMod x x)))
      ((union e (Const 0))))

; DISABLED: (x * y) % y = 0 — incorrect when Mul wraps (32-bit overflow).
; With modular arithmetic, (x*y mod 2^32) mod y ≠ 0 in general.
; (rule ((= e (SRem (Mul x y) y)))
;       ((union e (Const 0))))
; (rule ((= e (UMod (Mul x y) y)))
;       ((union e (Const 0))))
; (rule ((= e (SRem (Mul y x) y)))
;       ((union e (Const 0))))
; (rule ((= e (UMod (Mul y x) y)))
;       ((union e (Const 0))))

; Note: Min/Max integer operations are in logical.egg

; =============================================================================
; Algebraic Identities with Shifts
; =============================================================================

; Combining shifts: (x << a) << b = x << (a + b)
(rule ((= e (Shl (Shl x (Const a)) (Const b))))
      ((union e (Shl x (Const (+ a b))))))

; (x >> a) >> b = x >> (a + b) for same shift type
(rule ((= e (ShrU (ShrU x (Const a)) (Const b))))
      ((union e (ShrU x (Const (+ a b))))))
(rule ((= e (ShrS (ShrS x (Const a)) (Const b))))
      ((union e (ShrS x (Const (+ a b))))))

; Shift by 0 is identity (defined in bitwise.egg)

; =============================================================================
; Multiplication/Division Relationships
; =============================================================================

; (x * c) / c = x for non-zero c (assuming no overflow)
; Already covered above

; (x / c) * c + (x % c) = x (euclidean division identity)
; This is complex to express but useful for pattern matching

; Negation and multiplication
; When one operand is a constant, absorb the negate into the constant.
; This eliminates a Neg operation: -(x * c) → x * (-c)
(rule ((= e (Neg (Mul x (Const c)))))
      ((union e (Mul x (Const (- 0 c))))))
(rule ((= e (Neg (Mul (Const c) x))))
      ((union e (Mul x (Const (- 0 c))))))

; For non-constant operands, we pull Neg OUT of Mul to normalize.
; This enables double-negation cancellation.
(rule ((= e (Mul (Neg x) y)))
      ((union e (Neg (Mul x y)))))
(rule ((= e (Mul x (Neg y))))
      ((union e (Neg (Mul x y)))))
; Double negation in multiply cancels
(rule ((= e (Mul (Neg x) (Neg y))))
      ((union e (Mul x y))))

; =============================================================================
; Additional Expression Combining (C++ Parity)
; =============================================================================

; Division with negation (integer) - ONE-DIRECTIONAL to prevent explosion
; We pull Neg OUT of SDiv, not push Neg IN
(rule ((= e (SDiv (Neg x) y)))
      ((union e (Neg (SDiv x y)))))
(rule ((= e (SDiv x (Neg y))))
      ((union e (Neg (SDiv x y)))))
; Double negation in divide cancels - ONE-DIRECTIONAL
(rule ((= e (SDiv (Neg x) (Neg y))))
      ((union e (SDiv x y))))

; Note: FP negation distribution rules are in floating_point.egg

; =============================================================================
; Additional Factoring Patterns
; =============================================================================

; x + x + x = x * 3 - ONE-DIRECTIONAL to prevent explosion
(rule ((= e (Add x (Add x x))))
      ((union e (Mul x (Const 3)))))
(rule ((= e (Add (Add x x) x)))
      ((union e (Mul x (Const 3)))))

; Factoring patterns (recognize expanded form, merge to compact)
; a*c - b*c = (a - b) * c
; These are one-directional: we recognize the expanded form and factor it,
; but we don't expand compact multiplies to prevent e-graph explosion.
(rule ((= e (Sub (Mul a c) (Mul b c))))
      ((union e (Mul (Sub a b) c))))
(rule ((= e (Sub (Mul c a) (Mul c b))))
      ((union e (Mul (Sub a b) c))))

; =============================================================================
; Power of Two Division Optimization - ONE-DIRECTIONAL
; =============================================================================

; More powers of 2 for unsigned division
(rule ((= e (UDiv x (Const 32))))
      ((union e (ShrU x (Const 5)))))
(rule ((= e (UDiv x (Const 64))))
      ((union e (ShrU x (Const 6)))))
(rule ((= e (UDiv x (Const 128))))
      ((union e (ShrU x (Const 7)))))
(rule ((= e (UDiv x (Const 256))))
      ((union e (ShrU x (Const 8)))))
(rule ((= e (UDiv x (Const 512))))
      ((union e (ShrU x (Const 9)))))
(rule ((= e (UDiv x (Const 1024))))
      ((union e (ShrU x (Const 10)))))

; More powers of 2 for unsigned modulo
(rule ((= e (UMod x (Const 32))))
      ((union e (BitAnd x (Const 31)))))
(rule ((= e (UMod x (Const 64))))
      ((union e (BitAnd x (Const 63)))))
(rule ((= e (UMod x (Const 128))))
      ((union e (BitAnd x (Const 127)))))
(rule ((= e (UMod x (Const 256))))
      ((union e (BitAnd x (Const 255)))))
(rule ((= e (UMod x (Const 512))))
      ((union e (BitAnd x (Const 511)))))
(rule ((= e (UMod x (Const 1024))))
      ((union e (BitAnd x (Const 1023)))))

; Note: Floating-point identity rules (FAdd x 0, FMul x 1, etc.) are in floating_point.egg

; =============================================================================
; Absorption of Addition into Multiplication
; =============================================================================

; x * a + x = x * (a + 1)
(rule ((= e (Add (Mul x (Const a)) x)))
      ((union e (Mul x (Const (+ a 1))))))
(rule ((= e (Add x (Mul x (Const a)))))
      ((union e (Mul x (Const (+ a 1))))))

; x * a - x = x * (a - 1)
(rule ((= e (Sub (Mul x (Const a)) x)))
      ((union e (Mul x (Const (- a 1))))))

; x - x * a = x * (1 - a)
(rule ((= e (Sub x (Mul x (Const a)))))
      ((union e (Mul x (Const (- 1 a))))))

; =============================================================================
; Arithmetic Chain Merging (C++ MergeMulMul, MergeDivDiv, etc.)
; =============================================================================

; (x * a) * b = x * (a * b) - constant chain merging
; Use mul-safe guard to ensure a*b won't overflow before using egglog's * primitive.
(rule ((= e (Mul (Mul x (Const a)) (Const b))) (mul-safe a b))
      ((union e (Mul x (Const (* a b))))))
(rule ((= e (Mul (Const b) (Mul x (Const a)))) (mul-safe a b))
      ((union e (Mul x (Const (* a b))))))
(rule ((= e (Mul (Mul (Const a) x) (Const b))) (mul-safe a b))
      ((union e (Mul x (Const (* a b))))))

; (x / a) / b = x / (a * b)
; Use mul-safe guard to ensure a*b won't overflow
(rule ((= e (SDiv (SDiv x (Const a)) (Const b))) (mul-safe a b))
      ((union e (SDiv x (Const (* a b))))))
(rule ((= e (UDiv (UDiv x (Const a)) (Const b))) (mul-safe a b))
      ((union e (UDiv x (Const (* a b))))))

; DISABLED: (x * a) / a = x — incorrect when Mul wraps (32-bit overflow).
; Same issue as the disabled Div-of-Mul cancellation rules above.
; (rule ((= e (SDiv (Mul x (Const a)) (Const a))) (!= a 0))
;       ((union e x)))
; (rule ((= e (UDiv (Mul x (Const a)) (Const a))) (!= a 0))
;       ((union e x)))

; (x / a) * a = x (approximate for integers, exact if x is divisible by a)
; We keep this for the e-graph to explore

; Note: Add chain merging rules are in the "Constant reassociation" section above

; (x - a) - b = x - (a + b)
(rule ((= e (Sub (Sub x (Const a)) (Const b))))
      ((union e (Sub x (Const (+ a b))))))

; (x + a) - b = x + (a - b)
(rule ((= e (Sub (Add x (Const a)) (Const b))))
      ((union e (Add x (Const (- a b))))))

; (x - a) + b = x + (b - a)
(rule ((= e (Add (Sub x (Const a)) (Const b))))
      ((union e (Add x (Const (- b a))))))

; =============================================================================
; Shift Chain Merging
; =============================================================================

; (x << a) << b = x << (a + b) - already defined above, ensure coverage
; (x >> a) >> b = x >> (a + b) - already defined above

; (x * 2^a) as (x << a) - already have strength reduction

; =============================================================================
; Bitwise Chain with Constants
; =============================================================================

; (x & a) & b = x & (a & b)
(rule ((= e (BitAnd (BitAnd x (Const a)) (Const b))))
      ((union e (BitAnd x (Const (& a b))))))

; (x | a) | b = x | (a | b)
(rule ((= e (BitOr (BitOr x (Const a)) (Const b))))
      ((union e (BitOr x (Const (| a b))))))

; (x ^ a) ^ b = x ^ (a ^ b)
(rule ((= e (BitXor (BitXor x (Const a)) (Const b))))
      ((union e (BitXor x (Const (^ a b))))))

; =============================================================================
; Generic Add/Sub Cancellation (C++ MergeGenericAddSubArithmetic)
; =============================================================================
; NOTE: These rules are now handled by the ONE-DIRECTIONAL rules at the top
; of this file (around lines 39-54). The duplicate bidirectional rules below
; have been removed to prevent e-graph explosion.

; (a - b) + b = a (subtrahend cancels with addend) - ALREADY HANDLED ABOVE
; (a + b) - b = a - ALREADY HANDLED ABOVE

; =============================================================================
; Negate Merging with Mul/Div (C++ MergeNegateMulDivArithmetic)
; =============================================================================
; These rules merge negation into multiply/divide when one operand is constant

; -(-x) = x (already have this)
; -(x * c) = x * (-c) - handled via Neg distribution
; -(c * x) = x * (-c) - handled via Neg distribution

; =============================================================================
; Negate Merging with Add/Sub (C++ MergeNegateAddSubArithmetic)
; =============================================================================

; -(x + c) = (-c) - x
(rule ((= e (Neg (Add x (Const c)))))
      ((union e (Sub (Const (- 0 c)) x))))
(rule ((= e (Neg (Add (Const c) x))))
      ((union e (Sub (Const (- 0 c)) x))))

; -(x - c) = c - x
(rule ((= e (Neg (Sub x (Const c)))))
      ((union e (Sub (Const c) x))))

; -(c - x) = x - c (already have via Neg(Sub a b) = Sub b a)

; =============================================================================
; Add with Negate Merging (C++ MergeAddNegateArithmetic)
; =============================================================================

; (-x) + c = c - x - ONE-DIRECTIONAL
(rule ((= e (Add (Neg x) (Const c))))
      ((union e (Sub (Const c) x))))
(rule ((= e (Add (Const c) (Neg x))))
      ((union e (Sub (Const c) x))))

; =============================================================================
; Sub with Negate Merging (C++ MergeSubNegateArithmetic)
; =============================================================================

; (-x) - c = -(x + c) = (-c) - x
(rule ((= e (Sub (Neg x) (Const c))))
      ((union e (Sub (Const (- 0 c)) x))))

; c - (-x) = c + x - ONE-DIRECTIONAL
(rule ((= e (Sub (Const c) (Neg x))))
      ((union e (Add (Const c) x))))

; =============================================================================
; Sub Arithmetic Merging (C++ MergeSubAddArithmetic, MergeSubSubArithmetic)
; =============================================================================

; Note: (x - a) - b, (x + a) - b, (x - a) + b rules are in "Multiplication Chain Merging" section above

; b - (x + a) = (b - a) - x - for constants
(rule ((= e (Sub (Const b) (Add x (Const a)))))
      ((union e (Sub (Const (- b a)) x))))

; b - (x - a) = (b + a) - x
(rule ((= e (Sub (Const b) (Sub x (Const a)))))
      ((union e (Sub (Const (+ b a)) x))))

; =============================================================================
; Add Arithmetic Merging (C++ MergeAddAddArithmetic, MergeAddSubArithmetic)
; =============================================================================

; Note: (x + a) + b already covered in chain merging above
; Note: (x - a) + b = x + (b - a) already covered above

; Commutative variant for (x - a) + b
(rule ((= e (Add (Const b) (Sub x (Const a)))))
      ((union e (Add x (Const (- b a))))))
