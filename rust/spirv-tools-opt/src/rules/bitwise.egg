; =============================================================================
; Bitwise Rewrite Rules
; =============================================================================

; Identity rules - ONE-DIRECTIONAL to prevent e-graph explosion
; x → BitAnd(x, x) for every x would be catastrophic
(rule ((= e (BitAnd x x)))
      ((union e x)))
(rule ((= e (BitOr x x)))
      ((union e x)))
(rule ((= e (BitXor x x)))
      ((union e (Const 0))))
(rule ((= e (BitXor x (Const 0))))
      ((union e x)))
(rule ((= e (BitXor (Const 0) x)))
      ((union e x)))
(rule ((= e (BitAnd x (Const 0))))
      ((union e (Const 0))))

; All-ones patterns (-1 = all ones in two's complement)
(rule ((= e (BitOr x (Const -1))))
      ((union e (Const -1))))
(rule ((= e (BitAnd x (Const -1))))
      ((union e x)))
(rule ((= e (BitAnd (Const -1) x)))
      ((union e x)))
; XOR with all-ones is NOT - ONE-DIRECTIONAL (canonical form is BitNot)
(rule ((= e (BitXor x (Const -1))))
      ((union e (BitNot x))))

; Double negation - ONE-DIRECTIONAL
(rule ((= e (BitNot (BitNot x))))
      ((union e x)))

; De Morgan's laws - ONE-DIRECTIONAL to prevent explosion
; We pull BitNot OUTSIDE (simplifying 3 nodes → 1), not push INSIDE (which expands 1 → 3)
(rule ((= e (BitOr (BitNot x) (BitNot y))))
      ((union e (BitNot (BitAnd x y)))))
(rule ((= e (BitAnd (BitNot x) (BitNot y))))
      ((union e (BitNot (BitOr x y)))))

; Complement rules
(rule ((= e (BitAnd x (BitNot x))))
      ((union e (Const 0))))
(rule ((= e (BitAnd (BitNot x) x)))
      ((union e (Const 0))))
(rule ((= e (BitOr x (BitNot x))))
      ((union e (Const -1))))
(rule ((= e (BitOr (BitNot x) x)))
      ((union e (Const -1))))

; XOR rules - ONE-DIRECTIONAL to prevent explosion
; We pull BitNot OUT of XOR (not push in, which would expand forever)
(rule ((= e (BitXor (BitNot x) y)))
      ((union e (BitNot (BitXor x y)))))
(rule ((= e (BitXor x (BitNot y))))
      ((union e (BitNot (BitXor x y)))))

; Absorption rules: x | (x & y) = x, x & (x | y) = x - ONE-DIRECTIONAL
(rule ((= e (BitOr x (BitAnd x y))))
      ((union e x)))
(rule ((= e (BitOr x (BitAnd y x))))
      ((union e x)))
(rule ((= e (BitOr (BitAnd x y) x)))
      ((union e x)))
(rule ((= e (BitOr (BitAnd y x) x)))
      ((union e x)))
(rule ((= e (BitAnd x (BitOr x y))))
      ((union e x)))
(rule ((= e (BitAnd x (BitOr y x))))
      ((union e x)))
(rule ((= e (BitAnd (BitOr x y) x)))
      ((union e x)))
(rule ((= e (BitAnd (BitOr y x) x)))
      ((union e x)))

; Complement absorption: x | (~x & y) = x | y - ONE-DIRECTIONAL
(rule ((= e (BitOr x (BitAnd (BitNot x) y))))
      ((union e (BitOr x y))))
(rule ((= e (BitOr x (BitAnd y (BitNot x)))))
      ((union e (BitOr x y))))
(rule ((= e (BitAnd x (BitOr (BitNot x) y))))
      ((union e (BitAnd x y))))
(rule ((= e (BitAnd x (BitOr y (BitNot x)))))
      ((union e (BitAnd x y))))

; XOR absorption - ONE-DIRECTIONAL
(rule ((= e (BitAnd x (BitXor x y))))
      ((union e (BitAnd x (BitNot y)))))
(rule ((= e (BitAnd (BitXor x y) x)))
      ((union e (BitAnd x (BitNot y)))))

; Shift by 0 - ONE-DIRECTIONAL
(rule ((= e (Shl x (Const 0))))
      ((union e x)))
(rule ((= e (ShrU x (Const 0))))
      ((union e x)))
(rule ((= e (ShrS x (Const 0))))
      ((union e x)))

; Shift of 0
(rule ((= e (Shl (Const 0) x)))
      ((union e (Const 0))))
(rule ((= e (ShrU (Const 0) x)))
      ((union e (Const 0))))
(rule ((= e (ShrS (Const 0) x)))
      ((union e (Const 0))))

; =============================================================================
; Rotation Rules
; =============================================================================

; Rotate by 0 is identity - ONE-DIRECTIONAL
(rule ((= e (RotL x (Const 0))))
      ((union e x)))
(rule ((= e (RotR x (Const 0))))
      ((union e x)))

; Rotate of 0 is 0
(rule ((= e (RotL (Const 0) x)))
      ((union e (Const 0))))
(rule ((= e (RotR (Const 0) x)))
      ((union e (Const 0))))

; Rotate left and right are inverses (for 32-bit, rot(x, n) = rot(x, 32-n))
; RotL(x, n) = RotR(x, -n) in modular arithmetic - ONE-DIRECTIONAL
; Only go RotL with Neg → RotR (canonical form uses positive rotation)
(rule ((= e (RotL x (Neg n))))
      ((union e (RotR x n))))
(rule ((= e (RotR x (Neg n))))
      ((union e (RotL x n))))

; BitReverse is self-inverse when applied twice - ONE-DIRECTIONAL
(rule ((= e (BitReverse (BitReverse x))))
      ((union e x)))

; =============================================================================
; Bit Masking Patterns
; =============================================================================

; (x << n) >> n extracts high bits with zeros in low n bits (for ShrU)
; (x >> n) << n extracts high bits with zeros in low n bits
; These are used for bit field operations

; Masking with shift: (x & mask) where mask is 2^n - 1 extracts low n bits
; x & 1 extracts lowest bit
; NOTE: Expansion rule REMOVED - (BitAnd (BitOr x y) (Const 1)) → (BitOr (BitAnd x (Const 1)) (BitAnd y (Const 1)))
; would create MORE terms on RHS, causing e-graph explosion

; Shift then mask vs mask then shift optimizations
; ((x >> n) & m) vs ((x & (m << n)) >> n)

; =============================================================================
; Bit Field Operations (C++ parity)
; =============================================================================

; Extract low bit: x & 1
; Test if power of 2: (x & (x - 1)) == 0 for x > 0
; Count trailing zeros relates to FindILsb
; Count leading zeros relates to FindSMsb/FindUMsb

; (x | y) & ~x = y & ~x (masking) - ONE-DIRECTIONAL
(rule ((= e (BitAnd (BitOr x y) (BitNot x))))
      ((union e (BitAnd y (BitNot x)))))
(rule ((= e (BitAnd (BitOr y x) (BitNot x))))
      ((union e (BitAnd y (BitNot x)))))

; (x & y) | ~x = y | ~x (masking) - ONE-DIRECTIONAL
(rule ((= e (BitOr (BitAnd x y) (BitNot x))))
      ((union e (BitOr y (BitNot x)))))
(rule ((= e (BitOr (BitAnd y x) (BitNot x))))
      ((union e (BitOr y (BitNot x)))))

; XOR with all ones is NOT
; Already covered: (rewrite (BitXor x (Const -1)) (BitNot x))

; =============================================================================
; Shift Combining (C++ parity)
; =============================================================================

; Combine shifts in opposite directions
; (x >> a) << a masks off low bits (when a is same)
; NOTE: Expansion rule REMOVED - creates Sub, Shl, BitNot terms causing explosion
; The pattern (Shl (ShrU x a) a) creates a complex mask expression

; (x << a) >> a for ShrU masks off high bits
; Note: For signed shift right, this is more complex

; Shift of shifted value
; (x << a) << b = x << (a + b) - already in arithmetic.egg

; =============================================================================
; Bit Counting Relationships
; =============================================================================

; BitCount(~x) + BitCount(x) = bit_width (for fixed width)
; FindILsb(x) == -1 when x == 0
; FindILsb(x) >= 0 when x != 0

; BitReverse(x) relationships
; FindILsb(BitReverse(x)) relates to FindSMsb(x)

; =============================================================================
; Boolean Bit Optimization
; =============================================================================

; For boolean values (0 or 1):
; x ^ 1 = !x (for booleans)
; x & 1 = x (for booleans)
; x | 0 = x (already covered)

; =============================================================================
; Additional Loop Invariant Bitwise Rules
; =============================================================================
; Note: Most bitwise loop invariant rules are in rvsdg.egg
; Here we add the ones that weren't covered there

; LoopInvariantI rules - ONE-DIRECTIONAL (use rule/union to prevent cycles)
(rule ((= e (RotL (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantI (RotL a b)))))
(rule ((= e (RotR (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantI (RotR a b)))))
(rule ((= e (BitReverse (LoopInvariantI a))))
      ((union e (LoopInvariantI (BitReverse a)))))

; =============================================================================
; Gamma Distribution for Bitwise Operations
; =============================================================================
; Note: Most Gamma distribution rules for bitwise ops are in rvsdg.egg
; Here we add shift-related rules not covered there

; select(c, ~a, ~b) = ~select(c, a, b) - ONE-DIRECTIONAL
(rule ((= e (GammaI c (BitNot a) (BitNot b))))
      ((union e (BitNot (GammaI c a b)))))

; select(c, x << a, x << b) = x << select(c, a, b) - ONE-DIRECTIONAL
(rule ((= e (GammaI c (Shl x a) (Shl x b))))
      ((union e (Shl x (GammaI c a b)))))
(rule ((= e (GammaI c (ShrU x a) (ShrU x b))))
      ((union e (ShrU x (GammaI c a b)))))
(rule ((= e (GammaI c (ShrS x a) (ShrS x b))))
      ((union e (ShrS x (GammaI c a b)))))

; =============================================================================
; Additional Redundant And/Or/Xor Rules (not using primitives)
; =============================================================================
; Note: The primitive-based rules are in primitives.egg (bits-disjoint, etc.)

; These are additional patterns that don't require primitives:

; (a & m) | (b & m) = (a | b) & m  (factor out common mask) - ONE-DIRECTIONAL
(rule ((= e (BitOr (BitAnd a m) (BitAnd b m))))
      ((union e (BitAnd (BitOr a b) m))))
(rule ((= e (BitOr (BitAnd m a) (BitAnd b m))))
      ((union e (BitAnd (BitOr a b) m))))
(rule ((= e (BitOr (BitAnd a m) (BitAnd m b))))
      ((union e (BitAnd (BitOr a b) m))))
(rule ((= e (BitOr (BitAnd m a) (BitAnd m b))))
      ((union e (BitAnd (BitOr a b) m))))

; (a & m) ^ (b & m) = (a ^ b) & m  (factor out common mask) - ONE-DIRECTIONAL
(rule ((= e (BitXor (BitAnd a m) (BitAnd b m))))
      ((union e (BitAnd (BitXor a b) m))))
(rule ((= e (BitXor (BitAnd m a) (BitAnd b m))))
      ((union e (BitAnd (BitXor a b) m))))
(rule ((= e (BitXor (BitAnd a m) (BitAnd m b))))
      ((union e (BitAnd (BitXor a b) m))))
(rule ((= e (BitXor (BitAnd m a) (BitAnd m b))))
      ((union e (BitAnd (BitXor a b) m))))

; =============================================================================
; C++ Parity: RedundantAndOrXor Patterns
; =============================================================================
; When ANDing with a constant mask:
; m & (a | c) = a & m, when (m & c) == 0 (bits don't overlap)
; m & (a ^ c) = a & m, when (m & c) == 0 (bits don't overlap)
; m & (a | c) = m, when (m & c) == m (OR contains all needed bits)

; General patterns that work without knowing exact constant values:
; (a | 0) & m = a & m (already covered by identity rules)
; (a ^ 0) & m = a & m (already covered by identity rules)

; =============================================================================
; C++ Parity: RedundantAndAddSub Patterns
; =============================================================================
; m & (a + c) can simplify when add doesn't affect masked bits
; m & (a - c) can simplify when sub doesn't affect masked bits
; For example: 1 & (b + 2) = b & 1, since adding 2 doesn't change bit 0

; General rule: mask & (a + 0) = mask & a
; This is covered by Add identity rules

; =============================================================================
; C++ Parity: RedundantAndShift Patterns
; =============================================================================
; m & (a << n) = 0, when m's set bits are all shifted out
; m & (a >> n) = 0, when m's set bits are all shifted out

; General patterns that work for any constant:
; 0 & (a << n) = 0 (covered by BitAnd with 0)
; 0 & (a >> n) = 0 (covered by BitAnd with 0)

; Left shift of value then AND with mask selecting low bits
; (x << n) & ((1 << n) - 1) = 0 for any n > 0
; This is because left shift fills low bits with zeros

; Specific patterns where mask bits are shifted out:
; 1 & (x << 1) = 0  (bit 0 is shifted to bit 1, so AND with 1 is 0)
(rule ((= e (BitAnd (Const 1) (Shl x (Const 1)))))
      ((union e (Const 0))))
(rule ((= e (BitAnd (Shl x (Const 1)) (Const 1))))
      ((union e (Const 0))))

; 1 & (x << n) = 0 for n >= 1
(rule ((= e (BitAnd (Const 1) (Shl x (Const 2)))))
      ((union e (Const 0))))
(rule ((= e (BitAnd (Shl x (Const 2)) (Const 1))))
      ((union e (Const 0))))
(rule ((= e (BitAnd (Const 1) (Shl x (Const 3)))))
      ((union e (Const 0))))
(rule ((= e (BitAnd (Shl x (Const 3)) (Const 1))))
      ((union e (Const 0))))
(rule ((= e (BitAnd (Const 1) (Shl x (Const 4)))))
      ((union e (Const 0))))
(rule ((= e (BitAnd (Shl x (Const 4)) (Const 1))))
      ((union e (Const 0))))

; 3 & (x << 2) = 0  (bits 0-1 are shifted to bits 2-3)
(rule ((= e (BitAnd (Const 3) (Shl x (Const 2)))))
      ((union e (Const 0))))
(rule ((= e (BitAnd (Shl x (Const 2)) (Const 3))))
      ((union e (Const 0))))

; 7 & (x << 3) = 0  (bits 0-2 are shifted to bits 3-5)
(rule ((= e (BitAnd (Const 7) (Shl x (Const 3)))))
      ((union e (Const 0))))
(rule ((= e (BitAnd (Shl x (Const 3)) (Const 7))))
      ((union e (Const 0))))

; 15 & (x << 4) = 0  (bits 0-3 are shifted to bits 4-7)
(rule ((= e (BitAnd (Const 15) (Shl x (Const 4)))))
      ((union e (Const 0))))
(rule ((= e (BitAnd (Shl x (Const 4)) (Const 15))))
      ((union e (Const 0))))

; High bit masks with right shift
; 0x80000000 & (x >> 1) = 0 for 32-bit (high bit is shifted down)
; (any shift right of 1 or more moves data away from bit 31)
(rule ((= e (BitAnd (Const 2147483648) (ShrU x (Const 1)))))
      ((union e (Const 0))))
(rule ((= e (BitAnd (ShrU x (Const 1)) (Const 2147483648))))
      ((union e (Const 0))))

; For signed right shift, high bit propagates, so only works for ShrU

; =============================================================================
; Additional Bitwise Simplification Patterns
; =============================================================================

; Simplify AND with OR/XOR when one operand is same as mask operand
; m & (m | a) = m (absorption - already covered)
; m & (m ^ a) = m & ~a - ONE-DIRECTIONAL
(rule ((= e (BitAnd m (BitXor m a))))
      ((union e (BitAnd m (BitNot a)))))
(rule ((= e (BitAnd (BitXor m a) m)))
      ((union e (BitAnd m (BitNot a)))))
(rule ((= e (BitAnd m (BitXor a m))))
      ((union e (BitAnd m (BitNot a)))))
(rule ((= e (BitAnd (BitXor a m) m)))
      ((union e (BitAnd m (BitNot a)))))

; Simplify OR with AND when one operand subsumes
; m | (m & a) = m (absorption - already covered)
; m | (m ^ a) = m | a - ONE-DIRECTIONAL
(rule ((= e (BitOr m (BitXor m a))))
      ((union e (BitOr m a))))
(rule ((= e (BitOr (BitXor m a) m)))
      ((union e (BitOr m a))))
(rule ((= e (BitOr m (BitXor a m))))
      ((union e (BitOr m a))))
(rule ((= e (BitOr (BitXor a m) m)))
      ((union e (BitOr m a))))

; =============================================================================
; Bitwise Same-Op Constant Reassociation (C++ ReassociateCommutativeBitwise)
; =============================================================================
; A op (B op C) → (A op C) op B when A and C are constants.
; All 4 permutations for each op (no built-in commutativity). - ONE-DIRECTIONAL

; BitAnd: merge constants
(rule ((= e (BitAnd (Const a) (BitAnd x (Const b)))))
      ((union e (BitAnd (Const (& a b)) x))))
(rule ((= e (BitAnd (Const a) (BitAnd (Const b) x))))
      ((union e (BitAnd (Const (& a b)) x))))
(rule ((= e (BitAnd (BitAnd x (Const a)) (Const b))))
      ((union e (BitAnd (Const (& a b)) x))))
(rule ((= e (BitAnd (BitAnd (Const a) x) (Const b))))
      ((union e (BitAnd (Const (& a b)) x))))

; BitOr: merge constants
(rule ((= e (BitOr (Const a) (BitOr x (Const b)))))
      ((union e (BitOr (Const (| a b)) x))))
(rule ((= e (BitOr (Const a) (BitOr (Const b) x))))
      ((union e (BitOr (Const (| a b)) x))))
(rule ((= e (BitOr (BitOr x (Const a)) (Const b))))
      ((union e (BitOr (Const (| a b)) x))))
(rule ((= e (BitOr (BitOr (Const a) x) (Const b))))
      ((union e (BitOr (Const (| a b)) x))))

; BitXor: merge constants
(rule ((= e (BitXor (Const a) (BitXor x (Const b)))))
      ((union e (BitXor (Const (^ a b)) x))))
(rule ((= e (BitXor (Const a) (BitXor (Const b) x))))
      ((union e (BitXor (Const (^ a b)) x))))
(rule ((= e (BitXor (BitXor x (Const a)) (Const b))))
      ((union e (BitXor (Const (^ a b)) x))))
(rule ((= e (BitXor (BitXor (Const a) x) (Const b))))
      ((union e (BitXor (Const (^ a b)) x))))
