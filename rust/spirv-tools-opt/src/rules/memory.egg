; =============================================================================
; Memory Optimization Rules for E-Graph (ONE PASS Global Optimization)
; =============================================================================
;
; This module implements comprehensive memory optimizations in the e-graph:
; - Load-after-store forwarding
; - Dead store elimination
; - Redundant load elimination
; - Access chain combining
; - Memory state simplifications
;
; All optimizations happen in ONE pass via equality saturation.
;
; =============================================================================
; Load-After-Store Forwarding
; =============================================================================
; When we load from a pointer that was just stored to, return the stored value.

; Direct load-after-store: Load from ptr after storing val to ptr = val
(rule ((= e (Load ptr (StoreMem ptr val prev))))
      ((union e val)))

; Load from different pointer passes through store
; (Load p1 (StoreMem p2 val prev)) where p1 != p2 could equal (Load p1 prev)
; But we need aliasing analysis - for now, be conservative

; =============================================================================
; Dead Store Elimination
; =============================================================================
; A store followed by another store to the same location makes the first dead.

; Store-after-store: second store kills the first
(rule ((= m (StoreMem ptr val2 (StoreMem ptr val1 prev))))
      ((union m (StoreMem ptr val2 prev))))

; =============================================================================
; Redundant Load Elimination
; =============================================================================

; Load from MergeMem where both branches stored the same value
(rule ((= e (Load ptr (MergeMem cond (StoreMem ptr val s1) (StoreMem ptr val s2)))))
      ((union e val)))

; Two loads from the same pointer and memory state are equivalent
; (This is handled automatically by e-graph union-find)

; =============================================================================
; Memory State Simplifications
; =============================================================================

; MergeMem with identical states on both branches
(rule ((= m (MergeMem cond s s)))
      ((union m s)))

; MergeMem with constant condition
(rule ((= m (MergeMem (Const 0) then_m else_m)))
      ((union m else_m)))
(rule ((= m (MergeMem (Const c) then_m else_m)) (!= c 0))
      ((union m then_m)))

; MergeMem with negated condition - swap branches
(rule ((= m (MergeMem (LogNot cond) then_m else_m)))
      ((union m (MergeMem cond else_m then_m))))

; LoopMem with constant false condition - loop never executes
(rule ((= m (LoopMem (Const 0) body init)))
      ((union m init)))

; =============================================================================
; Access Chain Optimizations
; =============================================================================

; Access chain to same base with same indices are equivalent
; (Handled automatically by e-graph)

; Load through access chain from store through same access chain
(rule ((= e (Load (AccessChain1 base idx) (StoreMem (AccessChain1 base idx) val prev))))
      ((union e val)))
(rule ((= e (Load (AccessChain2 base i1 i2) (StoreMem (AccessChain2 base i1 i2) val prev))))
      ((union e val)))
(rule ((= e (Load (AccessChain3 base i1 i2 i3) (StoreMem (AccessChain3 base i1 i2 i3) val prev))))
      ((union e val)))

; =============================================================================
; Derivative Operation Optimizations
; =============================================================================

; Derivative of constant is zero
(rule ((= e (DPdx (Const _)))) ((union e (Const 0))))
(rule ((= e (DPdy (Const _)))) ((union e (Const 0))))
(rule ((= e (DPdxFine (Const _)))) ((union e (Const 0))))
(rule ((= e (DPdyFine (Const _)))) ((union e (Const 0))))
(rule ((= e (DPdxCoarse (Const _)))) ((union e (Const 0))))
(rule ((= e (DPdyCoarse (Const _)))) ((union e (Const 0))))

; Fwidth of constant is zero
(rule ((= e (Fwidth (Const _)))) ((union e (Const 0))))
(rule ((= e (FwidthFine (Const _)))) ((union e (Const 0))))
(rule ((= e (FwidthCoarse (Const _)))) ((union e (Const 0))))

; Derivative of loop-invariant is zero (if hoisted out)
(rule ((= e (DPdx (LoopInvariant x)))) ((union e (Const 0))))
(rule ((= e (DPdy (LoopInvariant x)))) ((union e (Const 0))))

; =============================================================================
; Private-to-Local Optimization
; =============================================================================
; Variables in Private storage class used only in one function can be
; moved to Function storage class. In e-graph, we model this by preferring
; Function storage (7) over Private storage (6).
;
; Note: Storage class 6 = Private, 7 = Function
; This is modeled but the actual transformation happens during extraction.

; =============================================================================
; Copy Propagation Through Memory
; =============================================================================

; Load after load from same pointer/memory = same value
; (Automatic via e-graph equality)

; Store then immediately load = stored value (already covered above)

; =============================================================================
; Scalar Replacement Patterns
; =============================================================================
; Composite load followed by extract can sometimes become direct field load.
; CompositeExtract(Load(ptr, mem), idx) could become Load(AccessChain(ptr, idx), mem)
; But we need to be careful about memory ordering.

; Extract from loaded composite - if we can prove it's safe
; This enables field-level dead store elimination
(rule ((= e (CompositeExtract (Load ptr mem) idx)))
      ((union e (Load (AccessChain1 ptr idx) mem))))

; =============================================================================
; Vector Load/Store Optimization
; =============================================================================
; Loading a vector then extracting one component can become scalar load
; (Requires knowing the pointer type - modeled but may not always apply)

; =============================================================================
; Access Chain Combining (C++ CombineAccessChains pass)
; =============================================================================
; Sequential access chains can be combined into a single chain with more indices.
; AccessChain1(AccessChain1(base, i1), i2) -> AccessChain2(base, i1, i2)

; Combine AccessChain1 + AccessChain1 -> AccessChain2
(rule ((= e (AccessChain1 (AccessChain1 base i1) i2)))
      ((union e (AccessChain2 base i1 i2))))

; Combine AccessChain1 + AccessChain2 -> AccessChain3
(rule ((= e (AccessChain1 (AccessChain2 base i1 i2) i3)))
      ((union e (AccessChain3 base i1 i2 i3))))

; Combine AccessChain2 + AccessChain1 -> AccessChain3
(rule ((= e (AccessChain2 (AccessChain1 base i1) i2 i3)))
      ((union e (AccessChain3 base i1 i2 i3))))

; =============================================================================
; Dynamic Access Chain Optimization
; =============================================================================
; Dynamic access chains with constant indices can become static chains

; AccessChainDyn(base, Const i) -> AccessChain1(base, i)
(rule ((= e (AccessChainDyn base (Const i))))
      ((union e (AccessChain1 base i))))

; =============================================================================
; Redundant Load Elimination Across Branches
; =============================================================================
; Loading after MergeMem when both branches load from same location

; Load from merged memory where neither branch modified the target
; Load(ptr, MergeMem(cond, s, s)) = Load(ptr, s) - but MergeMem simplifies first

; =============================================================================
; Store Value Forwarding Through Memory Merge
; =============================================================================
; When storing the same value in both branches, the load after merge is that value
; (Already covered by the Load/MergeMem/StoreMem rule above)

; =============================================================================
; Loop Memory Optimization
; =============================================================================
; Loop-invariant memory operations can be hoisted

; Load from pointer that's loop-invariant, from memory state that's loop-invariant
(rule ((= e (Load (LoopInvariant ptr) (LoopInvariant mem))))
      ((union e (LoopInvariant (Load ptr mem)))))

; =============================================================================
; Unused Store Elimination
; =============================================================================
; Store to a location that's immediately overwritten in both branches

; StoreMem followed by MergeMem where both branches overwrite the location
(rule ((= m (MergeMem cond (StoreMem ptr val1 (StoreMem ptr val0 prev))
                           (StoreMem ptr val2 (StoreMem ptr val0 prev)))))
      ((union m (MergeMem cond (StoreMem ptr val1 prev) (StoreMem ptr val2 prev)))))

; =============================================================================
; Atomic Operation Optimization
; =============================================================================

; AtomicLoad followed by AtomicStore with no intervening operations
; This is conservative - only applies when we can prove atomics are to same location

; AtomicExchange with value that was just atomically loaded returns same value
; (This is tricky with concurrency - be very conservative)

