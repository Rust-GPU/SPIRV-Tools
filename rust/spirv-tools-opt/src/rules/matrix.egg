; =============================================================================
; Matrix Operation Rules
; =============================================================================

; Transpose of transpose is identity - ONE-DIRECTIONAL to prevent explosion
(rule ((= e (Transpose (Transpose m))))
      ((union e m)))

; Matrix times identity (represented as 1.0 scalar) - conceptual
; MatTimesScalar with 1 and 0 - ONE-DIRECTIONAL to prevent explosion
; Note: Const returns IntExpr, wrapped with IntToExpr for Expr context
(rule ((= e (MatTimesScalar m (IntToExpr (Const 1)))))
      ((union e m)))

; Double inverse is identity - ONE-DIRECTIONAL to prevent explosion
(rule ((= e (MatInverse (MatInverse m))))
      ((union e m)))

; Transpose of outer product - ONE-DIRECTIONAL
; transpose(outerProduct(a,b)) = outerProduct(b,a)
(rule ((= e (Transpose (OuterProduct a b))))
      ((union e (OuterProduct b a))))

; Matrix multiply associativity - ONE-DIRECTIONAL (normalize to right-assoc)
; (A * B) * C = A * (B * C)
(rule ((= e (MatTimesMat (MatTimesMat a b) c)))
      ((union e (MatTimesMat a (MatTimesMat b c)))))

; Matrix-vector associativity with matrix multiply - ONE-DIRECTIONAL
; (A * B) * v = A * (B * v)
(rule ((= e (MatTimesVec (MatTimesMat a b) v)))
      ((union e (MatTimesVec a (MatTimesVec b v)))))

; Vector-matrix associativity - ONE-DIRECTIONAL
; v * (A * B) = (v * A) * B
(rule ((= e (VecTimesMat v (MatTimesMat a b))))
      ((union e (VecTimesMat (VecTimesMat v a) b))))

; Transpose and multiply - ONE-DIRECTIONAL
; (A*B)^T = B^T * A^T
(rule ((= e (Transpose (MatTimesMat a b))))
      ((union e (MatTimesMat (Transpose b) (Transpose a)))))

; =============================================================================
; Matrix-Scalar Multiplication Rules
; =============================================================================

; Scalar multiply by 0 gives zero matrix (represented as scalar 0 times matrix)
; Note: Without a ZeroMatrix constructor, we keep the scalar multiply form
; Note: Const returns IntExpr, wrapped with IntToExpr for Expr context
(rule ((= e (MatTimesScalar m (IntToExpr (Const 0)))))
      ((union e (MatTimesScalar m (IntToExpr (Const 0))))))

; Scalar multiply is commutative in the scalar: (M*s1)*s2 = (M*s2)*s1
; And associative: (M*s1)*s2 = M*(s1*s2)
; We express this as merging the scalars
; Note: Const returns IntExpr, wrapped with IntToExpr for Expr context
(rule ((= e (MatTimesScalar (MatTimesScalar m (IntToExpr (Const a))) (IntToExpr (Const b)))) (mul-safe a b))
      ((union e (MatTimesScalar m (IntToExpr (Const (* a b)))))))

; =============================================================================
; Determinant Rules
; =============================================================================

; Determinant of transpose equals determinant of original - ONE-DIRECTIONAL
; Note: Determinant(Expr) -> FloatExpr
(rule ((= e (Determinant (Transpose m))))
      ((union e (Determinant m))))

; Determinant of product = product of determinants - ONE-DIRECTIONAL
; det(A*B) = det(A) * det(B)
; Note: Determinant returns FloatExpr, FMul(FloatExpr, FloatExpr) -> FloatExpr
(rule ((= e (Determinant (MatTimesMat a b))))
      ((union e (FMul (Determinant a) (Determinant b)))))

; Determinant of scalar*matrix = scalar^n * det(matrix) for nxn matrix
; This is complex without knowing n, so we skip it

; Determinant of inverse = 1/determinant of original - ONE-DIRECTIONAL
; Note: FDiv(FloatExpr, FloatExpr) -> FloatExpr, FConst for float constant
; Note: Const is IntExpr, use FConst for float 1.0 in FDiv context
(rule ((= e (Determinant (MatInverse m))))
      ((union e (FDiv (FConst 1.0) (Determinant m)))))

; =============================================================================
; Inverse Rules (beyond what's already there)
; =============================================================================

; Inverse of product - ONE-DIRECTIONAL
; (A*B)^-1 = B^-1 * A^-1
(rule ((= e (MatInverse (MatTimesMat a b))))
      ((union e (MatTimesMat (MatInverse b) (MatInverse a)))))

; Inverse of transpose - ONE-DIRECTIONAL
; (A^T)^-1 = (A^-1)^T
(rule ((= e (MatInverse (Transpose m))))
      ((union e (Transpose (MatInverse m)))))

; Inverse of scalar*matrix - ONE-DIRECTIONAL
; (s*M)^-1 = (1/s)*M^-1
; Note: Const returns IntExpr, wrapped with IntToExpr for Expr context
(rule ((= e (MatInverse (MatTimesScalar m (IntToExpr (Const s))))))
      ((union e (MatTimesScalar (MatInverse m) (IntToExpr (Const (/ 1 s)))))))

; =============================================================================
; Outer Product Rules
; =============================================================================

; Outer product is anti-commutative with transpose
; (already have: transpose(outerProduct(a,b)) = outerProduct(b,a))

; Outer product distributes over vector addition (conceptually)
; outerProduct(a+b, c) = outerProduct(a, c) + outerProduct(b, c)
; But we don't have matrix addition in the e-graph yet

; Outer product with zero vector produces zero matrix
; (would need zero vector detection)

; =============================================================================
; Vector-Matrix Multiplication Rules
; =============================================================================

; Transpose relationship: v * M = (M^T * v)^T for row vector
; But SPIR-V treats vectors as column vectors, so:
; VecTimesMat(v, M) treats v as row vector: result is (M^T * v)

; Matrix-vector with transpose - ONE-DIRECTIONAL
(rule ((= e (MatTimesVec (Transpose m) v)))
      ((union e (VecTimesMat v m))))
(rule ((= e (VecTimesMat v (Transpose m))))
      ((union e (MatTimesVec m v))))

; =============================================================================
; Diagonal and Special Matrix Patterns
; =============================================================================

; If we had identity matrix representation:
; M * I = M
; I * M = M
; M * M^-1 = I
; M^-1 * M = I

; For now, these would require an Identity constructor

; =============================================================================
; Matrix Constant Evaluation via Decomposition
; =============================================================================
; Break matrix-to-vector operations into vector ops when the matrix structure
; is known (CompositeConstruct with known columns). The resulting vector
; operations (VecTimesScalar, Dot, VecFAdd) already have constant folding.
;
; Note: MatTimesMat, Transpose, and MatTimesScalar produce matrix results
; which would require creating CompositeConstruct values in rule conclusions.
; Since CompositeConstruct is a function (not constructor), this is not
; directly possible. Instead, matrix-matrix operations decompose indirectly
; through existing associativity rules:
;   (A * B) * v = A * (B * v)  [then MatTimesVec decomposes]
;   v * (A * B) = (v * A) * B  [then VecTimesMat decomposes]

; --- MatTimesVec: result = sum of scaled columns ---
; M * v where M = [c0, c1, ...] gives sum(ci * v[i])

; 2-column matrix * vector
(rule ((= e (MatTimesVec m v))
       (= m (CompositeConstruct (ECons c0 (ECons c1 (ENil))))))
      ((union e (VecFAdd (VecTimesScalar c0 (VecExtract v 0))
                         (VecTimesScalar c1 (VecExtract v 1))))))

; 3-column matrix * vector
(rule ((= e (MatTimesVec m v))
       (= m (CompositeConstruct (ECons c0 (ECons c1 (ECons c2 (ENil)))))))
      ((union e (VecFAdd (VecFAdd (VecTimesScalar c0 (VecExtract v 0))
                                  (VecTimesScalar c1 (VecExtract v 1)))
                         (VecTimesScalar c2 (VecExtract v 2))))))

; 4-column matrix * vector
(rule ((= e (MatTimesVec m v))
       (= m (CompositeConstruct (ECons c0 (ECons c1 (ECons c2 (ECons c3 (ENil))))))))
      ((union e (VecFAdd (VecFAdd (VecTimesScalar c0 (VecExtract v 0))
                                  (VecTimesScalar c1 (VecExtract v 1)))
                         (VecFAdd (VecTimesScalar c2 (VecExtract v 2))
                                  (VecTimesScalar c3 (VecExtract v 3)))))))

; --- VecTimesMat: result[i] = dot(v, column_i) ---

; vector * 2-column matrix
(rule ((= e (VecTimesMat v m))
       (= m (CompositeConstruct (ECons c0 (ECons c1 (ENil))))))
      ((union e (Vec2 (FloatToExpr (Dot v c0)) (FloatToExpr (Dot v c1))))))

; vector * 3-column matrix
(rule ((= e (VecTimesMat v m))
       (= m (CompositeConstruct (ECons c0 (ECons c1 (ECons c2 (ENil)))))))
      ((union e (Vec3 (FloatToExpr (Dot v c0)) (FloatToExpr (Dot v c1))
                      (FloatToExpr (Dot v c2))))))

; vector * 4-column matrix
(rule ((= e (VecTimesMat v m))
       (= m (CompositeConstruct (ECons c0 (ECons c1 (ECons c2 (ECons c3 (ENil))))))))
      ((union e (Vec4 (FloatToExpr (Dot v c0)) (FloatToExpr (Dot v c1))
                      (FloatToExpr (Dot v c2)) (FloatToExpr (Dot v c3))))))

; =============================================================================
; Matrix Loop Invariant Rules - ONE-DIRECTIONAL
; =============================================================================

(rule ((= e (MatTimesScalar (LoopInvariant m) (LoopInvariant s)))) ((union e (LoopInvariant (MatTimesScalar m s)))))
(rule ((= e (MatTimesVec (LoopInvariant m) (LoopInvariant v)))) ((union e (LoopInvariant (MatTimesVec m v)))))
(rule ((= e (VecTimesMat (LoopInvariant v) (LoopInvariant m)))) ((union e (LoopInvariant (VecTimesMat v m)))))
(rule ((= e (MatTimesMat (LoopInvariant a) (LoopInvariant b)))) ((union e (LoopInvariant (MatTimesMat a b)))))
(rule ((= e (Transpose (LoopInvariant m)))) ((union e (LoopInvariant (Transpose m)))))
; Note: Determinant returns FloatExpr, use LoopInvariantF (FloatExpr -> FloatExpr)
(rule ((= e (Determinant (LoopInvariant m)))) ((union e (LoopInvariantF (Determinant m)))))
(rule ((= e (MatInverse (LoopInvariant m)))) ((union e (LoopInvariant (MatInverse m)))))
(rule ((= e (OuterProduct (LoopInvariant a) (LoopInvariant b)))) ((union e (LoopInvariant (OuterProduct a b)))))

; =============================================================================
; Gamma Distribution for Matrix Operations - ONE-DIRECTIONAL
; =============================================================================

; select(c, M*v1, M*v2) = M * select(c, v1, v2)
; Note: Gamma condition is BoolExpr (already correct in typed sort system)
(rule ((= e (Gamma c (MatTimesVec m v1) (MatTimesVec m v2)))) ((union e (MatTimesVec m (Gamma c v1 v2)))))

; select(c, v1*M, v2*M) = select(c, v1, v2) * M
(rule ((= e (Gamma c (VecTimesMat v1 m) (VecTimesMat v2 m)))) ((union e (VecTimesMat (Gamma c v1 v2) m))))

; select(c, M*s1, M*s2) = M * select(c, s1, s2)
(rule ((= e (Gamma c (MatTimesScalar m s1) (MatTimesScalar m s2)))) ((union e (MatTimesScalar m (Gamma c s1 s2)))))
