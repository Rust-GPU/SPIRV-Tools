; =============================================================================
; Vector Construction/Extraction Rules
; =============================================================================

; Extract from Vec2 - ONE-DIRECTIONAL to prevent explosion
(rule ((= e (VecExtract (Vec2 a b) 0)))
      ((union e a)))
(rule ((= e (VecExtract (Vec2 a b) 1)))
      ((union e b)))

; Extract from Vec3 - ONE-DIRECTIONAL
(rule ((= e (VecExtract (Vec3 a b c) 0)))
      ((union e a)))
(rule ((= e (VecExtract (Vec3 a b c) 1)))
      ((union e b)))
(rule ((= e (VecExtract (Vec3 a b c) 2)))
      ((union e c)))

; Extract from Vec4 - ONE-DIRECTIONAL
(rule ((= e (VecExtract (Vec4 a b c d) 0)))
      ((union e a)))
(rule ((= e (VecExtract (Vec4 a b c d) 1)))
      ((union e b)))
(rule ((= e (VecExtract (Vec4 a b c d) 2)))
      ((union e c)))
(rule ((= e (VecExtract (Vec4 a b c d) 3)))
      ((union e d)))

; Insert then extract same index returns inserted value - ONE-DIRECTIONAL
(rule ((= e (VecExtract (VecInsert v x 0) 0)))
      ((union e x)))
(rule ((= e (VecExtract (VecInsert v x 1) 1)))
      ((union e x)))
(rule ((= e (VecExtract (VecInsert v x 2) 2)))
      ((union e x)))
(rule ((= e (VecExtract (VecInsert v x 3) 3)))
      ((union e x)))

; Insert then extract different index returns original
(rewrite (VecExtract (VecInsert v x 0) 1) (VecExtract v 1))
(rewrite (VecExtract (VecInsert v x 0) 2) (VecExtract v 2))
(rewrite (VecExtract (VecInsert v x 0) 3) (VecExtract v 3))
(rewrite (VecExtract (VecInsert v x 1) 0) (VecExtract v 0))
(rewrite (VecExtract (VecInsert v x 1) 2) (VecExtract v 2))
(rewrite (VecExtract (VecInsert v x 1) 3) (VecExtract v 3))
(rewrite (VecExtract (VecInsert v x 2) 0) (VecExtract v 0))
(rewrite (VecExtract (VecInsert v x 2) 1) (VecExtract v 1))
(rewrite (VecExtract (VecInsert v x 2) 3) (VecExtract v 3))
(rewrite (VecExtract (VecInsert v x 3) 0) (VecExtract v 0))
(rewrite (VecExtract (VecInsert v x 3) 1) (VecExtract v 1))
(rewrite (VecExtract (VecInsert v x 3) 2) (VecExtract v 2))

; NOTE: CompositeExtract from CompositeConstruct rules are defined in datatypes.egg
; along with the ExprList datatype that they depend on.

; =============================================================================
; Vector Arithmetic Rules
; =============================================================================

; Vector identity operations - ONE-DIRECTIONAL to prevent explosion
(rule ((= e (VecAdd v (Vec2 (Const 0) (Const 0)))))
      ((union e v)))
(rule ((= e (VecAdd v (Vec3 (Const 0) (Const 0) (Const 0)))))
      ((union e v)))
(rule ((= e (VecAdd v (Vec4 (Const 0) (Const 0) (Const 0) (Const 0)))))
      ((union e v)))
(rule ((= e (VecMul v (Vec2 (Const 1) (Const 1)))))
      ((union e v)))
(rule ((= e (VecMul v (Vec3 (Const 1) (Const 1) (Const 1)))))
      ((union e v)))
(rule ((= e (VecMul v (Vec4 (Const 1) (Const 1) (Const 1) (Const 1)))))
      ((union e v)))

; VecNeg double negation - ONE-DIRECTIONAL
(rule ((= e (VecNeg (VecNeg v))))
      ((union e v)))
(rule ((= e (VecFNeg (VecFNeg v))))
      ((union e v)))

; VecTimesScalar with 0 and 1 - ONE-DIRECTIONAL for identity
(rewrite (VecTimesScalar v (Const 0)) (Vec2 (Const 0) (Const 0)))
(rule ((= e (VecTimesScalar v (Const 1))))
      ((union e v)))

; =============================================================================
; Dot Product Rules
; =============================================================================

; Dot product with zero vector is zero
; Dot of unit vectors is 1
; Self-dot is length squared

; Extract from Dot when one vector is unit vector (has a 1 in one component, 0 elsewhere)
; Dot(Vec2(1,0), v) = VecExtract(v, 0)
(rewrite (Dot (Vec2 (Const 1) (Const 0)) v) (VecExtract v 0))
(rewrite (Dot (Vec2 (Const 0) (Const 1)) v) (VecExtract v 1))
(rewrite (Dot v (Vec2 (Const 1) (Const 0))) (VecExtract v 0))
(rewrite (Dot v (Vec2 (Const 0) (Const 1))) (VecExtract v 1))

(rewrite (Dot (Vec3 (Const 1) (Const 0) (Const 0)) v) (VecExtract v 0))
(rewrite (Dot (Vec3 (Const 0) (Const 1) (Const 0)) v) (VecExtract v 1))
(rewrite (Dot (Vec3 (Const 0) (Const 0) (Const 1)) v) (VecExtract v 2))
(rewrite (Dot v (Vec3 (Const 1) (Const 0) (Const 0))) (VecExtract v 0))
(rewrite (Dot v (Vec3 (Const 0) (Const 1) (Const 0))) (VecExtract v 1))
(rewrite (Dot v (Vec3 (Const 0) (Const 0) (Const 1))) (VecExtract v 2))

(rewrite (Dot (Vec4 (Const 1) (Const 0) (Const 0) (Const 0)) v) (VecExtract v 0))
(rewrite (Dot (Vec4 (Const 0) (Const 1) (Const 0) (Const 0)) v) (VecExtract v 1))
(rewrite (Dot (Vec4 (Const 0) (Const 0) (Const 1) (Const 0)) v) (VecExtract v 2))
(rewrite (Dot (Vec4 (Const 0) (Const 0) (Const 0) (Const 1)) v) (VecExtract v 3))
(rewrite (Dot v (Vec4 (Const 1) (Const 0) (Const 0) (Const 0))) (VecExtract v 0))
(rewrite (Dot v (Vec4 (Const 0) (Const 1) (Const 0) (Const 0))) (VecExtract v 1))
(rewrite (Dot v (Vec4 (Const 0) (Const 0) (Const 1) (Const 0))) (VecExtract v 2))
(rewrite (Dot v (Vec4 (Const 0) (Const 0) (Const 0) (Const 1))) (VecExtract v 3))

; Dot is commutative - REMOVED to prevent e-graph explosion
; These bidirectional rules cause cycles: (Dot a b) ↔ (Dot b a) ↔ ...

; =============================================================================
; Vector Subtraction and Negation
; =============================================================================

; Vector subtraction with self is zero
; Note: produces a zero vector, represented via construction

; v - 0 = v (for various dimensions) - ONE-DIRECTIONAL
(rule ((= e (VecSub v (Vec2 (Const 0) (Const 0)))))
      ((union e v)))
(rule ((= e (VecSub v (Vec3 (Const 0) (Const 0) (Const 0)))))
      ((union e v)))
(rule ((= e (VecSub v (Vec4 (Const 0) (Const 0) (Const 0) (Const 0)))))
      ((union e v)))

; 0 - v = -v
(rewrite (VecSub (Vec2 (Const 0) (Const 0)) v) (VecNeg v))
(rewrite (VecSub (Vec3 (Const 0) (Const 0) (Const 0)) v) (VecNeg v))
(rewrite (VecSub (Vec4 (Const 0) (Const 0) (Const 0) (Const 0)) v) (VecNeg v))

; Floating-point vector variants - ONE-DIRECTIONAL
(rule ((= e (VecFAdd v (Vec2 (Const 0) (Const 0)))))
      ((union e v)))
(rule ((= e (VecFAdd v (Vec3 (Const 0) (Const 0) (Const 0)))))
      ((union e v)))
(rule ((= e (VecFAdd v (Vec4 (Const 0) (Const 0) (Const 0) (Const 0)))))
      ((union e v)))

(rule ((= e (VecFMul v (Vec2 (Const 1) (Const 1)))))
      ((union e v)))
(rule ((= e (VecFMul v (Vec3 (Const 1) (Const 1) (Const 1)))))
      ((union e v)))
(rule ((= e (VecFMul v (Vec4 (Const 1) (Const 1) (Const 1) (Const 1)))))
      ((union e v)))

(rule ((= e (VecFSub v (Vec2 (Const 0) (Const 0)))))
      ((union e v)))
(rule ((= e (VecFSub v (Vec3 (Const 0) (Const 0) (Const 0)))))
      ((union e v)))
(rule ((= e (VecFSub v (Vec4 (Const 0) (Const 0) (Const 0) (Const 0)))))
      ((union e v)))

; =============================================================================
; Vector Operations Distributivity
; =============================================================================

; VecTimesScalar distributes over VecAdd
(rewrite (VecTimesScalar (VecAdd a b) s) (VecAdd (VecTimesScalar a s) (VecTimesScalar b s)))

; VecTimesScalar with scalar multiplication
(rewrite (VecTimesScalar (VecTimesScalar v s1) s2) (VecTimesScalar v (Mul s1 s2)))

; =============================================================================
; Cross Product Properties
; =============================================================================

; Cross product with self is zero (for 3D vectors)
; Note: commented because zero vector construction is complex
; (rewrite (Cross a a) (Vec3 (Const 0) (Const 0) (Const 0)))

; Cross product negation
(rewrite (Cross (VecNeg a) b) (VecNeg (Cross a b)))
(rewrite (Cross a (VecNeg b)) (VecNeg (Cross a b)))
(rewrite (Cross (VecNeg a) (VecNeg b)) (Cross a b))

; Cross product distributes over scalar multiplication
(rewrite (Cross (VecTimesScalar a s) b) (VecTimesScalar (Cross a b) s))
(rewrite (Cross a (VecTimesScalar b s)) (VecTimesScalar (Cross a b) s))

; =============================================================================
; Dot Product Additional Properties
; =============================================================================

; Dot product distributes over VecAdd
(rewrite (Dot (VecAdd a b) c) (Add (Dot a c) (Dot b c)))
(rewrite (Dot a (VecAdd b c)) (Add (Dot a b) (Dot a c)))

; Dot product distributes over scalar multiplication
(rewrite (Dot (VecTimesScalar a s) b) (Mul s (Dot a b)))
(rewrite (Dot a (VecTimesScalar b s)) (Mul (Dot a b) s))

; Dot with negated vector
(rewrite (Dot (VecNeg a) b) (Neg (Dot a b)))
(rewrite (Dot a (VecNeg b)) (Neg (Dot a b)))

; =============================================================================
; Reconstruct Vector from Extracts
; =============================================================================

; If we extract all components and rebuild, we get the original
; Vec2(VecExtract(v, 0), VecExtract(v, 1)) = v for Vec2
; Note: This is an extraction pattern that helps with optimization

; Insert into slot we just extracted from is identity - ONE-DIRECTIONAL
(rule ((= e (VecInsert v (VecExtract v 0) 0)))
      ((union e v)))
(rule ((= e (VecInsert v (VecExtract v 1) 1)))
      ((union e v)))
(rule ((= e (VecInsert v (VecExtract v 2) 2)))
      ((union e v)))
(rule ((= e (VecInsert v (VecExtract v 3) 3)))
      ((union e v)))

; =============================================================================
; Vector Length and Normalize Relationships
; =============================================================================

; Length(Normalize(v)) would be 1, but we need float representation
; Normalize is idempotent for non-zero vectors (already in glsl.egg)

; Dot(v, v) = Length(v)^2
; This is useful for optimization but hard to express without sqrt

; =============================================================================
; Vector Projection Patterns
; =============================================================================

; Scalar projection: (Dot(a, b) / Dot(b, b)) * b gives projection of a onto b
; This is complex to express but common in graphics

; =============================================================================
; Floating-Point Vector Operations
; =============================================================================

; VecFMul with 0 = 0 vector
; VecFMul with 1 = identity (already covered)

; VecFAdd associativity - ONE-DIRECTIONAL (right-associative canonical form)
(rule ((= e (VecFAdd (VecFAdd a b) c)))
      ((union e (VecFAdd a (VecFAdd b c)))))

; VecFMul associativity - ONE-DIRECTIONAL (right-associative canonical form)
(rule ((= e (VecFMul (VecFMul a b) c)))
      ((union e (VecFMul a (VecFMul b c)))))

; VecFAdd/VecFMul commutativity - REMOVED to prevent e-graph explosion
; These bidirectional rules cause cycles: (VecFAdd a b) ↔ (VecFAdd b a) ↔ ...

; =============================================================================
; Scalar-Vector Multiplication Chain
; =============================================================================

; (v * s1) * s2 = v * (s1 * s2)
(rule ((= e (VecTimesScalar (VecTimesScalar v (Const s1)) (Const s2))) (mul-safe s1 s2))
      ((union e (VecTimesScalar v (Const (* s1 s2))))))

; v * 0 produces zero vector (already have for integer version)

; v * (-1) = -v
(rewrite (VecTimesScalar v (Const -1)) (VecNeg v))

; =============================================================================
; Cross Product Additional Rules
; =============================================================================

; Cross product is anti-commutative (already in glsl.egg via VecNeg)

; Cross product of orthogonal unit vectors gives the third
; These are specific geometric identities

; =============================================================================
; Dot Product with Constructed Vectors
; =============================================================================

; Dot(Vec2(a, b), Vec2(c, d)) = a*c + b*d
; This is useful for constant folding but complex to express

; =============================================================================
; Vector Component-wise Operations
; =============================================================================

; Component-wise minimum and maximum
; VecMin(v, v) = v, VecMax(v, v) = v
; These would need VecMin/VecMax constructors

; =============================================================================
; Swizzle/Shuffle Optimizations (C++ VectorShuffle parity)
; =============================================================================
; Uses specialized VecShuffle2/3/4 with fixed-arity indices for cleaner rules

; -----------------------------------------------------------------------------
; Identity shuffles - ONE-DIRECTIONAL to prevent explosion
; -----------------------------------------------------------------------------
(rule ((= e (VecShuffle2 v _ 0 1)))
      ((union e v)))
(rule ((= e (VecShuffle3 v _ 0 1 2)))
      ((union e v)))
(rule ((= e (VecShuffle4 v _ 0 1 2 3)))
      ((union e v)))

; Same operand identity - ONE-DIRECTIONAL
(rule ((= e (VecShuffle2 v v 0 1)))
      ((union e v)))
(rule ((= e (VecShuffle3 v v 0 1 2)))
      ((union e v)))
(rule ((= e (VecShuffle4 v v 0 1 2 3)))
      ((union e v)))

; -----------------------------------------------------------------------------
; Extract from VecShuffle (C++ VectorShuffleFeedingExtract)
; When extracting from a shuffle, go directly to the source vector
; -----------------------------------------------------------------------------

; Vec4 shuffle -> extract at position 0
(rewrite (VecExtract (VecShuffle4 v _ 0 _ _ _) 0) (VecExtract v 0))
(rewrite (VecExtract (VecShuffle4 v _ 1 _ _ _) 0) (VecExtract v 1))
(rewrite (VecExtract (VecShuffle4 v _ 2 _ _ _) 0) (VecExtract v 2))
(rewrite (VecExtract (VecShuffle4 v _ 3 _ _ _) 0) (VecExtract v 3))

; Vec4 shuffle -> extract at position 1
(rewrite (VecExtract (VecShuffle4 v _ _ 0 _ _) 1) (VecExtract v 0))
(rewrite (VecExtract (VecShuffle4 v _ _ 1 _ _) 1) (VecExtract v 1))
(rewrite (VecExtract (VecShuffle4 v _ _ 2 _ _) 1) (VecExtract v 2))
(rewrite (VecExtract (VecShuffle4 v _ _ 3 _ _) 1) (VecExtract v 3))

; Vec4 shuffle -> extract at position 2
(rewrite (VecExtract (VecShuffle4 v _ _ _ 0 _) 2) (VecExtract v 0))
(rewrite (VecExtract (VecShuffle4 v _ _ _ 1 _) 2) (VecExtract v 1))
(rewrite (VecExtract (VecShuffle4 v _ _ _ 2 _) 2) (VecExtract v 2))
(rewrite (VecExtract (VecShuffle4 v _ _ _ 3 _) 2) (VecExtract v 3))

; Vec4 shuffle -> extract at position 3
(rewrite (VecExtract (VecShuffle4 v _ _ _ _ 0) 3) (VecExtract v 0))
(rewrite (VecExtract (VecShuffle4 v _ _ _ _ 1) 3) (VecExtract v 1))
(rewrite (VecExtract (VecShuffle4 v _ _ _ _ 2) 3) (VecExtract v 2))
(rewrite (VecExtract (VecShuffle4 v _ _ _ _ 3) 3) (VecExtract v 3))

; Vec3 shuffle -> extract
(rewrite (VecExtract (VecShuffle3 v _ 0 _ _) 0) (VecExtract v 0))
(rewrite (VecExtract (VecShuffle3 v _ 1 _ _) 0) (VecExtract v 1))
(rewrite (VecExtract (VecShuffle3 v _ 2 _ _) 0) (VecExtract v 2))
(rewrite (VecExtract (VecShuffle3 v _ _ 0 _) 1) (VecExtract v 0))
(rewrite (VecExtract (VecShuffle3 v _ _ 1 _) 1) (VecExtract v 1))
(rewrite (VecExtract (VecShuffle3 v _ _ 2 _) 1) (VecExtract v 2))
(rewrite (VecExtract (VecShuffle3 v _ _ _ 0) 2) (VecExtract v 0))
(rewrite (VecExtract (VecShuffle3 v _ _ _ 1) 2) (VecExtract v 1))
(rewrite (VecExtract (VecShuffle3 v _ _ _ 2) 2) (VecExtract v 2))

; Vec2 shuffle -> extract
(rewrite (VecExtract (VecShuffle2 v _ 0 _) 0) (VecExtract v 0))
(rewrite (VecExtract (VecShuffle2 v _ 1 _) 0) (VecExtract v 1))
(rewrite (VecExtract (VecShuffle2 v _ _ 0) 1) (VecExtract v 0))
(rewrite (VecExtract (VecShuffle2 v _ _ 1) 1) (VecExtract v 1))

; -----------------------------------------------------------------------------
; Broadcast patterns - same index in all positions
; -----------------------------------------------------------------------------
(rewrite (VecShuffle4 v _ 0 0 0 0) (VecBroadcast4 (VecExtract v 0)))
(rewrite (VecShuffle4 v _ 1 1 1 1) (VecBroadcast4 (VecExtract v 1)))
(rewrite (VecShuffle4 v _ 2 2 2 2) (VecBroadcast4 (VecExtract v 2)))
(rewrite (VecShuffle4 v _ 3 3 3 3) (VecBroadcast4 (VecExtract v 3)))

(rewrite (VecShuffle3 v _ 0 0 0) (VecBroadcast3 (VecExtract v 0)))
(rewrite (VecShuffle3 v _ 1 1 1) (VecBroadcast3 (VecExtract v 1)))
(rewrite (VecShuffle3 v _ 2 2 2) (VecBroadcast3 (VecExtract v 2)))

(rewrite (VecShuffle2 v _ 0 0) (VecBroadcast2 (VecExtract v 0)))
(rewrite (VecShuffle2 v _ 1 1) (VecBroadcast2 (VecExtract v 1)))

; Broadcast constructs the vector with repeated value
(rewrite (VecBroadcast2 x) (Vec2 x x))
(rewrite (VecBroadcast3 x) (Vec3 x x x))
(rewrite (VecBroadcast4 x) (Vec4 x x x x))

; -----------------------------------------------------------------------------
; Common swizzle patterns
; -----------------------------------------------------------------------------

; Reverse vec2
(rewrite (VecShuffle2 v v 1 0) (Vec2 (VecExtract v 1) (VecExtract v 0)))

; Swap halves of vec4 (.zwxy)
(rewrite (VecShuffle4 v v 2 3 0 1) (Vec4 (VecExtract v 2) (VecExtract v 3) (VecExtract v 0) (VecExtract v 1)))

; Extract .xy from vec4 to vec2
(rewrite (VecShuffle2 (Vec4 a b c d) _ 0 1) (Vec2 a b))
(rewrite (VecShuffle2 (Vec4 a b c d) _ 2 3) (Vec2 c d))

; Extract .xyz from vec4 to vec3
(rewrite (VecShuffle3 (Vec4 a b c d) _ 0 1 2) (Vec3 a b c))

; -----------------------------------------------------------------------------
; Shuffle of constructed vector simplifies
; -----------------------------------------------------------------------------
(rewrite (VecShuffle4 (Vec4 a b c d) _ 0 1 2 3) (Vec4 a b c d))
(rewrite (VecShuffle4 (Vec4 a b c d) _ 3 2 1 0) (Vec4 d c b a))
(rewrite (VecShuffle4 (Vec4 a b c d) _ 0 0 0 0) (Vec4 a a a a))
(rewrite (VecShuffle4 (Vec4 a b c d) _ 1 1 1 1) (Vec4 b b b b))
(rewrite (VecShuffle4 (Vec4 a b c d) _ 2 2 2 2) (Vec4 c c c c))
(rewrite (VecShuffle4 (Vec4 a b c d) _ 3 3 3 3) (Vec4 d d d d))

(rewrite (VecShuffle3 (Vec3 a b c) _ 0 1 2) (Vec3 a b c))
(rewrite (VecShuffle3 (Vec3 a b c) _ 2 1 0) (Vec3 c b a))

(rewrite (VecShuffle2 (Vec2 a b) _ 0 1) (Vec2 a b))
(rewrite (VecShuffle2 (Vec2 a b) _ 1 0) (Vec2 b a))

; -----------------------------------------------------------------------------
; Two consecutive shuffles can sometimes be combined
; (C++ VectorShuffleFeedingShuffle)
; -----------------------------------------------------------------------------
; When shuffling from a shuffle, compose the indices
; This is complex in general, but some patterns are clear:

; Shuffle(Shuffle(v, _, m1), _, identity) = Shuffle(v, _, m1)
(rewrite (VecShuffle4 (VecShuffle4 v w i0 i1 i2 i3) _ 0 1 2 3) (VecShuffle4 v w i0 i1 i2 i3))
(rewrite (VecShuffle3 (VecShuffle3 v w i0 i1 i2) _ 0 1 2) (VecShuffle3 v w i0 i1 i2))
(rewrite (VecShuffle2 (VecShuffle2 v w i0 i1) _ 0 1) (VecShuffle2 v w i0 i1))

; -----------------------------------------------------------------------------
; Shuffle of broadcast optimization
; Any shuffle of a broadcast vector yields the same broadcast
; This is because all elements are identical, so rearranging them has no effect
; -----------------------------------------------------------------------------

; Shuffle of broadcast Vec4 (all same value) is still that broadcast
(rule ((= e (VecShuffle4 (Vec4 x x x x) _ _ _ _ _)))
      ((union e (Vec4 x x x x))))
(rule ((= e (VecShuffle3 (Vec4 x x x x) _ _ _ _)))
      ((union e (Vec3 x x x))))
(rule ((= e (VecShuffle2 (Vec4 x x x x) _ _ _)))
      ((union e (Vec2 x x))))

; Shuffle of broadcast Vec3
(rule ((= e (VecShuffle3 (Vec3 x x x) _ _ _ _)))
      ((union e (Vec3 x x x))))
(rule ((= e (VecShuffle2 (Vec3 x x x) _ _ _)))
      ((union e (Vec2 x x))))

; Shuffle of broadcast Vec2
(rule ((= e (VecShuffle2 (Vec2 x x) _ _ _)))
      ((union e (Vec2 x x))))

; Shuffle from VecBroadcast directly
(rule ((= e (VecShuffle4 (VecBroadcast4 x) _ _ _ _ _)))
      ((union e (VecBroadcast4 x))))
(rule ((= e (VecShuffle3 (VecBroadcast3 x) _ _ _ _)))
      ((union e (VecBroadcast3 x))))
(rule ((= e (VecShuffle2 (VecBroadcast2 x) _ _ _)))
      ((union e (VecBroadcast2 x))))

; Downcast shuffle of broadcast
(rule ((= e (VecShuffle3 (VecBroadcast4 x) _ _ _ _)))
      ((union e (VecBroadcast3 x))))
(rule ((= e (VecShuffle2 (VecBroadcast4 x) _ _ _)))
      ((union e (VecBroadcast2 x))))
(rule ((= e (VecShuffle2 (VecBroadcast3 x) _ _ _)))
      ((union e (VecBroadcast2 x))))

; Extract from broadcast is the broadcast value
(rule ((= e (VecExtract (VecBroadcast2 x) _)))
      ((union e x)))
(rule ((= e (VecExtract (VecBroadcast3 x) _)))
      ((union e x)))
(rule ((= e (VecExtract (VecBroadcast4 x) _)))
      ((union e x)))

; =============================================================================
; Loop Invariant Vector Operations
; =============================================================================

(rewrite (VecAdd (LoopInvariant a) (LoopInvariant b)) (LoopInvariant (VecAdd a b)))
(rewrite (VecSub (LoopInvariant a) (LoopInvariant b)) (LoopInvariant (VecSub a b)))
(rewrite (VecMul (LoopInvariant a) (LoopInvariant b)) (LoopInvariant (VecMul a b)))
(rewrite (VecNeg (LoopInvariant a)) (LoopInvariant (VecNeg a)))
(rewrite (VecFAdd (LoopInvariant a) (LoopInvariant b)) (LoopInvariant (VecFAdd a b)))
(rewrite (VecFSub (LoopInvariant a) (LoopInvariant b)) (LoopInvariant (VecFSub a b)))
(rewrite (VecFMul (LoopInvariant a) (LoopInvariant b)) (LoopInvariant (VecFMul a b)))
(rewrite (VecFNeg (LoopInvariant a)) (LoopInvariant (VecFNeg a)))
(rewrite (Dot (LoopInvariant a) (LoopInvariant b)) (LoopInvariant (Dot a b)))
(rewrite (Cross (LoopInvariant a) (LoopInvariant b)) (LoopInvariant (Cross a b)))
(rewrite (Normalize (LoopInvariant a)) (LoopInvariant (Normalize a)))
(rewrite (Length (LoopInvariant a)) (LoopInvariant (Length a)))

; =============================================================================
; Gamma Distribution for Vector Operations
; =============================================================================

; select(c, v1 + v2, v1 + v3) = v1 + select(c, v2, v3)
(rewrite (Gamma c (VecFAdd x a) (VecFAdd x b)) (VecFAdd x (Gamma c a b)))
(rewrite (Gamma c (VecFMul x a) (VecFMul x b)) (VecFMul x (Gamma c a b)))
(rewrite (Gamma c (VecAdd x a) (VecAdd x b)) (VecAdd x (Gamma c a b)))
(rewrite (Gamma c (VecMul x a) (VecMul x b)) (VecMul x (Gamma c a b)))
