; =============================================================================
; Vector Construction/Extraction Rules
; =============================================================================

; Extract from Vec2 - ONE-DIRECTIONAL to prevent explosion
(rule ((= e (VecExtract (Vec2 a b) 0)))
      ((union e a)))
(rule ((= e (VecExtract (Vec2 a b) 1)))
      ((union e b)))

; Extract from Vec3 - ONE-DIRECTIONAL
(rule ((= e (VecExtract (Vec3 a b c) 0)))
      ((union e a)))
(rule ((= e (VecExtract (Vec3 a b c) 1)))
      ((union e b)))
(rule ((= e (VecExtract (Vec3 a b c) 2)))
      ((union e c)))

; Extract from Vec4 - ONE-DIRECTIONAL
(rule ((= e (VecExtract (Vec4 a b c d) 0)))
      ((union e a)))
(rule ((= e (VecExtract (Vec4 a b c d) 1)))
      ((union e b)))
(rule ((= e (VecExtract (Vec4 a b c d) 2)))
      ((union e c)))
(rule ((= e (VecExtract (Vec4 a b c d) 3)))
      ((union e d)))

; Insert then extract same index returns inserted value - ONE-DIRECTIONAL
(rule ((= e (VecExtract (VecInsert v x 0) 0)))
      ((union e x)))
(rule ((= e (VecExtract (VecInsert v x 1) 1)))
      ((union e x)))
(rule ((= e (VecExtract (VecInsert v x 2) 2)))
      ((union e x)))
(rule ((= e (VecExtract (VecInsert v x 3) 3)))
      ((union e x)))

; Insert then extract different index returns original - ONE-DIRECTIONAL
(rule ((= e (VecExtract (VecInsert v x 0) 1))) ((union e (VecExtract v 1))))
(rule ((= e (VecExtract (VecInsert v x 0) 2))) ((union e (VecExtract v 2))))
(rule ((= e (VecExtract (VecInsert v x 0) 3))) ((union e (VecExtract v 3))))
(rule ((= e (VecExtract (VecInsert v x 1) 0))) ((union e (VecExtract v 0))))
(rule ((= e (VecExtract (VecInsert v x 1) 2))) ((union e (VecExtract v 2))))
(rule ((= e (VecExtract (VecInsert v x 1) 3))) ((union e (VecExtract v 3))))
(rule ((= e (VecExtract (VecInsert v x 2) 0))) ((union e (VecExtract v 0))))
(rule ((= e (VecExtract (VecInsert v x 2) 1))) ((union e (VecExtract v 1))))
(rule ((= e (VecExtract (VecInsert v x 2) 3))) ((union e (VecExtract v 3))))
(rule ((= e (VecExtract (VecInsert v x 3) 0))) ((union e (VecExtract v 0))))
(rule ((= e (VecExtract (VecInsert v x 3) 1))) ((union e (VecExtract v 1))))
(rule ((= e (VecExtract (VecInsert v x 3) 2))) ((union e (VecExtract v 2))))

; NOTE: CompositeExtract from CompositeConstruct rules are defined in datatypes.egg
; along with the ExprList datatype that they depend on.

; =============================================================================
; Vector Arithmetic Rules
; =============================================================================

; Vector identity operations - ONE-DIRECTIONAL to prevent explosion
; Note: Const returns IntExpr, wrapped with IntToExpr for Expr context (Vec components)
(rule ((= e (VecAdd v (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e v)))
(rule ((= e (VecAdd v (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e v)))
(rule ((= e (VecAdd v (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e v)))
(rule ((= e (VecMul v (Vec2 (IntToExpr (Const 1)) (IntToExpr (Const 1))))))
      ((union e v)))
(rule ((= e (VecMul v (Vec3 (IntToExpr (Const 1)) (IntToExpr (Const 1)) (IntToExpr (Const 1))))))
      ((union e v)))
(rule ((= e (VecMul v (Vec4 (IntToExpr (Const 1)) (IntToExpr (Const 1)) (IntToExpr (Const 1)) (IntToExpr (Const 1))))))
      ((union e v)))

; VecNeg double negation - ONE-DIRECTIONAL
(rule ((= e (VecNeg (VecNeg v))))
      ((union e v)))
(rule ((= e (VecFNeg (VecFNeg v))))
      ((union e v)))

; VecTimesScalar with 0 and 1 - ONE-DIRECTIONAL for identity
; Note: Const returns IntExpr, wrapped with IntToExpr for Expr context
(rule ((= e (VecTimesScalar v (IntToExpr (Const 0)))))
      ((union e (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
(rule ((= e (VecTimesScalar v (IntToExpr (Const 1)))))
      ((union e v)))

; =============================================================================
; Dot Product Rules
; =============================================================================

; Dot product with zero vector is zero (integer version)
; Dot of unit vectors is 1
; Self-dot is length squared

; Dot with zero vector is zero - ONE-DIRECTIONAL
; Note: Dot(Expr, Expr) -> FloatExpr, so result is FConst for float zero
; Integer vectors (Const 0 for integer 0, wrapped with IntToExpr for Expr)
(rule ((= e (Dot (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0))) v))) ((union e (FConst 0.0))))
(rule ((= e (Dot v (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0)))))) ((union e (FConst 0.0))))
(rule ((= e (Dot (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))) v))) ((union e (FConst 0.0))))
(rule ((= e (Dot v (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)))))) ((union e (FConst 0.0))))
(rule ((= e (Dot (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))) v))) ((union e (FConst 0.0))))
(rule ((= e (Dot v (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)))))) ((union e (FConst 0.0))))

; Extract from Dot when one vector is unit vector (has a 1 in one component, 0 elsewhere)
; INTEGER vectors - Dot(Vec2(1,0), v) = ExprToFloat(VecExtract(v, 0)) - ONE-DIRECTIONAL
; Note: Dot returns FloatExpr, VecExtract returns Expr, so wrap with ExprToFloat
(rule ((= e (Dot (Vec2 (IntToExpr (Const 1)) (IntToExpr (Const 0))) v))) ((union e (ExprToFloat (VecExtract v 0)))))
(rule ((= e (Dot (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 1))) v))) ((union e (ExprToFloat (VecExtract v 1)))))
(rule ((= e (Dot v (Vec2 (IntToExpr (Const 1)) (IntToExpr (Const 0)))))) ((union e (ExprToFloat (VecExtract v 0)))))
(rule ((= e (Dot v (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 1)))))) ((union e (ExprToFloat (VecExtract v 1)))))

(rule ((= e (Dot (Vec3 (IntToExpr (Const 1)) (IntToExpr (Const 0)) (IntToExpr (Const 0))) v))) ((union e (ExprToFloat (VecExtract v 0)))))
(rule ((= e (Dot (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 1)) (IntToExpr (Const 0))) v))) ((union e (ExprToFloat (VecExtract v 1)))))
(rule ((= e (Dot (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 1))) v))) ((union e (ExprToFloat (VecExtract v 2)))))
(rule ((= e (Dot v (Vec3 (IntToExpr (Const 1)) (IntToExpr (Const 0)) (IntToExpr (Const 0)))))) ((union e (ExprToFloat (VecExtract v 0)))))
(rule ((= e (Dot v (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 1)) (IntToExpr (Const 0)))))) ((union e (ExprToFloat (VecExtract v 1)))))
(rule ((= e (Dot v (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 1)))))) ((union e (ExprToFloat (VecExtract v 2)))))

(rule ((= e (Dot (Vec4 (IntToExpr (Const 1)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))) v))) ((union e (ExprToFloat (VecExtract v 0)))))
(rule ((= e (Dot (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 1)) (IntToExpr (Const 0)) (IntToExpr (Const 0))) v))) ((union e (ExprToFloat (VecExtract v 1)))))
(rule ((= e (Dot (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 1)) (IntToExpr (Const 0))) v))) ((union e (ExprToFloat (VecExtract v 2)))))
(rule ((= e (Dot (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 1))) v))) ((union e (ExprToFloat (VecExtract v 3)))))
(rule ((= e (Dot v (Vec4 (IntToExpr (Const 1)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)))))) ((union e (ExprToFloat (VecExtract v 0)))))
(rule ((= e (Dot v (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 1)) (IntToExpr (Const 0)) (IntToExpr (Const 0)))))) ((union e (ExprToFloat (VecExtract v 1)))))
(rule ((= e (Dot v (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 1)) (IntToExpr (Const 0)))))) ((union e (ExprToFloat (VecExtract v 2)))))
(rule ((= e (Dot v (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 1)))))) ((union e (ExprToFloat (VecExtract v 3)))))

; FLOAT vectors - Dot with unit vector (one f32 1.0, rest f32 0.0) = VecExtract
; f32 1.0 = bit pattern 0x3f800000 = 1065353216
; f32 0.0 = bit pattern 0 (same as integer 0)
; These use is-float-one32/is-float-zero32 guards for proper f32 matching
; Note: Const is IntExpr, wrapped with IntToExpr for Expr context in Vec components
; Note: Dot returns FloatExpr, VecExtract returns Expr, wrap with ExprToFloat

; Vec2 float unit vectors
(rule ((= e (Dot (Vec2 (IntToExpr (Const c1)) (IntToExpr (Const c2))) v)) (is-float-one32 c1) (is-float-zero32 c2))
      ((union e (ExprToFloat (VecExtract v 0)))))
(rule ((= e (Dot (Vec2 (IntToExpr (Const c1)) (IntToExpr (Const c2))) v)) (is-float-zero32 c1) (is-float-one32 c2))
      ((union e (ExprToFloat (VecExtract v 1)))))
(rule ((= e (Dot v (Vec2 (IntToExpr (Const c1)) (IntToExpr (Const c2))))) (is-float-one32 c1) (is-float-zero32 c2))
      ((union e (ExprToFloat (VecExtract v 0)))))
(rule ((= e (Dot v (Vec2 (IntToExpr (Const c1)) (IntToExpr (Const c2))))) (is-float-zero32 c1) (is-float-one32 c2))
      ((union e (ExprToFloat (VecExtract v 1)))))

; Vec3 float unit vectors
(rule ((= e (Dot (Vec3 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3))) v)) (is-float-one32 c1) (is-float-zero32 c2) (is-float-zero32 c3))
      ((union e (ExprToFloat (VecExtract v 0)))))
(rule ((= e (Dot (Vec3 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3))) v)) (is-float-zero32 c1) (is-float-one32 c2) (is-float-zero32 c3))
      ((union e (ExprToFloat (VecExtract v 1)))))
(rule ((= e (Dot (Vec3 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3))) v)) (is-float-zero32 c1) (is-float-zero32 c2) (is-float-one32 c3))
      ((union e (ExprToFloat (VecExtract v 2)))))
(rule ((= e (Dot v (Vec3 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3))))) (is-float-one32 c1) (is-float-zero32 c2) (is-float-zero32 c3))
      ((union e (ExprToFloat (VecExtract v 0)))))
(rule ((= e (Dot v (Vec3 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3))))) (is-float-zero32 c1) (is-float-one32 c2) (is-float-zero32 c3))
      ((union e (ExprToFloat (VecExtract v 1)))))
(rule ((= e (Dot v (Vec3 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3))))) (is-float-zero32 c1) (is-float-zero32 c2) (is-float-one32 c3))
      ((union e (ExprToFloat (VecExtract v 2)))))

; Vec4 float unit vectors
(rule ((= e (Dot (Vec4 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3)) (IntToExpr (Const c4))) v)) (is-float-one32 c1) (is-float-zero32 c2) (is-float-zero32 c3) (is-float-zero32 c4))
      ((union e (ExprToFloat (VecExtract v 0)))))
(rule ((= e (Dot (Vec4 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3)) (IntToExpr (Const c4))) v)) (is-float-zero32 c1) (is-float-one32 c2) (is-float-zero32 c3) (is-float-zero32 c4))
      ((union e (ExprToFloat (VecExtract v 1)))))
(rule ((= e (Dot (Vec4 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3)) (IntToExpr (Const c4))) v)) (is-float-zero32 c1) (is-float-zero32 c2) (is-float-one32 c3) (is-float-zero32 c4))
      ((union e (ExprToFloat (VecExtract v 2)))))
(rule ((= e (Dot (Vec4 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3)) (IntToExpr (Const c4))) v)) (is-float-zero32 c1) (is-float-zero32 c2) (is-float-zero32 c3) (is-float-one32 c4))
      ((union e (ExprToFloat (VecExtract v 3)))))
(rule ((= e (Dot v (Vec4 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3)) (IntToExpr (Const c4))))) (is-float-one32 c1) (is-float-zero32 c2) (is-float-zero32 c3) (is-float-zero32 c4))
      ((union e (ExprToFloat (VecExtract v 0)))))
(rule ((= e (Dot v (Vec4 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3)) (IntToExpr (Const c4))))) (is-float-zero32 c1) (is-float-one32 c2) (is-float-zero32 c3) (is-float-zero32 c4))
      ((union e (ExprToFloat (VecExtract v 1)))))
(rule ((= e (Dot v (Vec4 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3)) (IntToExpr (Const c4))))) (is-float-zero32 c1) (is-float-zero32 c2) (is-float-one32 c3) (is-float-zero32 c4))
      ((union e (ExprToFloat (VecExtract v 2)))))
(rule ((= e (Dot v (Vec4 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3)) (IntToExpr (Const c4))))) (is-float-zero32 c1) (is-float-zero32 c2) (is-float-zero32 c3) (is-float-one32 c4))
      ((union e (ExprToFloat (VecExtract v 3)))))

; F64 FLOAT vectors - Dot with unit vector (one f64 1.0, rest f64 0.0) = VecExtract
; Uses is-float-one64/is-float-zero64 guards for proper f64 matching

; Vec2 f64 unit vectors
(rule ((= e (Dot (Vec2 (IntToExpr (Const c1)) (IntToExpr (Const c2))) v)) (is-float-one64 c1) (is-float-zero64 c2))
      ((union e (ExprToFloat (VecExtract v 0)))))
(rule ((= e (Dot (Vec2 (IntToExpr (Const c1)) (IntToExpr (Const c2))) v)) (is-float-zero64 c1) (is-float-one64 c2))
      ((union e (ExprToFloat (VecExtract v 1)))))
(rule ((= e (Dot v (Vec2 (IntToExpr (Const c1)) (IntToExpr (Const c2))))) (is-float-one64 c1) (is-float-zero64 c2))
      ((union e (ExprToFloat (VecExtract v 0)))))
(rule ((= e (Dot v (Vec2 (IntToExpr (Const c1)) (IntToExpr (Const c2))))) (is-float-zero64 c1) (is-float-one64 c2))
      ((union e (ExprToFloat (VecExtract v 1)))))

; Vec3 f64 unit vectors
(rule ((= e (Dot (Vec3 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3))) v)) (is-float-one64 c1) (is-float-zero64 c2) (is-float-zero64 c3))
      ((union e (ExprToFloat (VecExtract v 0)))))
(rule ((= e (Dot (Vec3 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3))) v)) (is-float-zero64 c1) (is-float-one64 c2) (is-float-zero64 c3))
      ((union e (ExprToFloat (VecExtract v 1)))))
(rule ((= e (Dot (Vec3 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3))) v)) (is-float-zero64 c1) (is-float-zero64 c2) (is-float-one64 c3))
      ((union e (ExprToFloat (VecExtract v 2)))))
(rule ((= e (Dot v (Vec3 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3))))) (is-float-one64 c1) (is-float-zero64 c2) (is-float-zero64 c3))
      ((union e (ExprToFloat (VecExtract v 0)))))
(rule ((= e (Dot v (Vec3 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3))))) (is-float-zero64 c1) (is-float-one64 c2) (is-float-zero64 c3))
      ((union e (ExprToFloat (VecExtract v 1)))))
(rule ((= e (Dot v (Vec3 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3))))) (is-float-zero64 c1) (is-float-zero64 c2) (is-float-one64 c3))
      ((union e (ExprToFloat (VecExtract v 2)))))

; Vec4 f64 unit vectors
(rule ((= e (Dot (Vec4 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3)) (IntToExpr (Const c4))) v)) (is-float-one64 c1) (is-float-zero64 c2) (is-float-zero64 c3) (is-float-zero64 c4))
      ((union e (ExprToFloat (VecExtract v 0)))))
(rule ((= e (Dot (Vec4 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3)) (IntToExpr (Const c4))) v)) (is-float-zero64 c1) (is-float-one64 c2) (is-float-zero64 c3) (is-float-zero64 c4))
      ((union e (ExprToFloat (VecExtract v 1)))))
(rule ((= e (Dot (Vec4 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3)) (IntToExpr (Const c4))) v)) (is-float-zero64 c1) (is-float-zero64 c2) (is-float-one64 c3) (is-float-zero64 c4))
      ((union e (ExprToFloat (VecExtract v 2)))))
(rule ((= e (Dot (Vec4 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3)) (IntToExpr (Const c4))) v)) (is-float-zero64 c1) (is-float-zero64 c2) (is-float-zero64 c3) (is-float-one64 c4))
      ((union e (ExprToFloat (VecExtract v 3)))))
(rule ((= e (Dot v (Vec4 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3)) (IntToExpr (Const c4))))) (is-float-one64 c1) (is-float-zero64 c2) (is-float-zero64 c3) (is-float-zero64 c4))
      ((union e (ExprToFloat (VecExtract v 0)))))
(rule ((= e (Dot v (Vec4 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3)) (IntToExpr (Const c4))))) (is-float-zero64 c1) (is-float-one64 c2) (is-float-zero64 c3) (is-float-zero64 c4))
      ((union e (ExprToFloat (VecExtract v 1)))))
(rule ((= e (Dot v (Vec4 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3)) (IntToExpr (Const c4))))) (is-float-zero64 c1) (is-float-zero64 c2) (is-float-one64 c3) (is-float-zero64 c4))
      ((union e (ExprToFloat (VecExtract v 2)))))
(rule ((= e (Dot v (Vec4 (IntToExpr (Const c1)) (IntToExpr (Const c2)) (IntToExpr (Const c3)) (IntToExpr (Const c4))))) (is-float-zero64 c1) (is-float-zero64 c2) (is-float-zero64 c3) (is-float-one64 c4))
      ((union e (ExprToFloat (VecExtract v 3)))))

; Dot is commutative - REMOVED to prevent e-graph explosion
; These bidirectional rules cause cycles: (Dot a b) <-> (Dot b a) <-> ...

; =============================================================================
; Vector Subtraction and Negation
; =============================================================================

; v - 0 = v (for various dimensions) - ONE-DIRECTIONAL
; Note: Const returns IntExpr, wrapped with IntToExpr for Expr context
(rule ((= e (VecSub v (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e v)))
(rule ((= e (VecSub v (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e v)))
(rule ((= e (VecSub v (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e v)))

; 0 - v = -v - ONE-DIRECTIONAL
(rule ((= e (VecSub (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0))) v)))
      ((union e (VecNeg v))))
(rule ((= e (VecSub (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))) v)))
      ((union e (VecNeg v))))
(rule ((= e (VecSub (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))) v)))
      ((union e (VecNeg v))))

; Floating-point vector identity with zero - ONE-DIRECTIONAL
(rule ((= e (VecFAdd v (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e v)))
(rule ((= e (VecFAdd v (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e v)))
(rule ((= e (VecFAdd v (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e v)))

(rule ((= e (VecFMul v (Vec2 (IntToExpr (Const 1)) (IntToExpr (Const 1))))))
      ((union e v)))
(rule ((= e (VecFMul v (Vec3 (IntToExpr (Const 1)) (IntToExpr (Const 1)) (IntToExpr (Const 1))))))
      ((union e v)))
(rule ((= e (VecFMul v (Vec4 (IntToExpr (Const 1)) (IntToExpr (Const 1)) (IntToExpr (Const 1)) (IntToExpr (Const 1))))))
      ((union e v)))

(rule ((= e (VecFSub v (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e v)))
(rule ((= e (VecFSub v (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e v)))
(rule ((= e (VecFSub v (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e v)))

; 0 - v = -v (float) - ONE-DIRECTIONAL
(rule ((= e (VecFSub (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0))) v)))
      ((union e (VecFNeg v))))
(rule ((= e (VecFSub (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))) v)))
      ((union e (VecFNeg v))))
(rule ((= e (VecFSub (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))) v)))
      ((union e (VecFNeg v))))

; =============================================================================
; Vector Self-Cancellation (uses VecSize to produce correct zero vector)
; =============================================================================
; Parallels: Sub(x,x)→0, Add(x,Neg(x))→0, FSub(x,x)→0.0

; VecSub(v, v) → zero vector - ONE-DIRECTIONAL
(rule ((= e (VecSub v v)) (= 2 (VecSize v)))
      ((union e (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
(rule ((= e (VecSub v v)) (= 3 (VecSize v)))
      ((union e (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
(rule ((= e (VecSub v v)) (= 4 (VecSize v)))
      ((union e (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))

; VecAdd(v, VecNeg(v)) → zero vector - ONE-DIRECTIONAL
(rule ((= e (VecAdd v (VecNeg v))) (= 2 (VecSize v)))
      ((union e (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
(rule ((= e (VecAdd v (VecNeg v))) (= 3 (VecSize v)))
      ((union e (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
(rule ((= e (VecAdd v (VecNeg v))) (= 4 (VecSize v)))
      ((union e (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
(rule ((= e (VecAdd (VecNeg v) v)) (= 2 (VecSize v)))
      ((union e (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
(rule ((= e (VecAdd (VecNeg v) v)) (= 3 (VecSize v)))
      ((union e (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
(rule ((= e (VecAdd (VecNeg v) v)) (= 4 (VecSize v)))
      ((union e (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))

; VecFSub(v, v) → zero vector - ONE-DIRECTIONAL
(rule ((= e (VecFSub v v)) (= 2 (VecSize v)))
      ((union e (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
(rule ((= e (VecFSub v v)) (= 3 (VecSize v)))
      ((union e (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
(rule ((= e (VecFSub v v)) (= 4 (VecSize v)))
      ((union e (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))

; VecFAdd(v, VecFNeg(v)) → zero vector - ONE-DIRECTIONAL
(rule ((= e (VecFAdd v (VecFNeg v))) (= 2 (VecSize v)))
      ((union e (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
(rule ((= e (VecFAdd v (VecFNeg v))) (= 3 (VecSize v)))
      ((union e (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
(rule ((= e (VecFAdd v (VecFNeg v))) (= 4 (VecSize v)))
      ((union e (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
(rule ((= e (VecFAdd (VecFNeg v) v)) (= 2 (VecSize v)))
      ((union e (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
(rule ((= e (VecFAdd (VecFNeg v) v)) (= 3 (VecSize v)))
      ((union e (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
(rule ((= e (VecFAdd (VecFNeg v) v)) (= 4 (VecSize v)))
      ((union e (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))

; =============================================================================
; Vector Negation of Subtraction - ONE-DIRECTIONAL
; =============================================================================
; Parallels: Neg(Sub(x,y)) → Sub(y,x), FNeg(FSub(a,b)) → FSub(b,a)

(rule ((= e (VecNeg (VecSub x y))))
      ((union e (VecSub y x))))
(rule ((= e (VecFNeg (VecFSub x y))))
      ((union e (VecFSub y x))))

; =============================================================================
; Vector Algebraic Cancellation - ONE-DIRECTIONAL
; =============================================================================
; Parallels: Sub(Add(x,y),x)→y, Add(Sub(x,y),y)→x, etc. from arithmetic.egg

; Integer vector cancellation chains
(rule ((= e (VecSub (VecAdd x y) x)))
      ((union e y)))
(rule ((= e (VecSub (VecAdd y x) x)))
      ((union e y)))
(rule ((= e (VecAdd (VecSub x y) y)))
      ((union e x)))
(rule ((= e (VecAdd y (VecSub x y))))
      ((union e x)))
(rule ((= e (VecSub (VecAdd x y) y)))
      ((union e x)))
(rule ((= e (VecSub (VecAdd y x) y)))
      ((union e x)))
(rule ((= e (VecSub x (VecSub x y))))
      ((union e y)))

; Sub patterns that produce VecNeg - ONE-DIRECTIONAL
(rule ((= e (VecSub x (VecAdd x y))))
      ((union e (VecNeg y))))
(rule ((= e (VecSub x (VecAdd y x))))
      ((union e (VecNeg y))))
(rule ((= e (VecSub (VecSub x y) x)))
      ((union e (VecNeg y))))

; Sub-sub simplifications - ONE-DIRECTIONAL
(rule ((= e (VecSub (VecSub a b) (VecSub c b))))
      ((union e (VecSub a c))))
(rule ((= e (VecSub (VecSub a b) (VecSub a c))))
      ((union e (VecSub c b))))

; Float vector cancellation chains
; Parallels: FSub(FAdd(a,b),b)→a, FAdd(FSub(a,b),b)→a from floating_point.egg
(rule ((= e (VecFSub (VecFAdd a b) b)))
      ((union e a)))
(rule ((= e (VecFSub (VecFAdd b a) b)))
      ((union e a)))
(rule ((= e (VecFAdd (VecFSub a b) b)))
      ((union e a)))
(rule ((= e (VecFAdd b (VecFSub a b))))
      ((union e a)))

; VecFAdd with negation canonicalization - ONE-DIRECTIONAL
; Parallels: FAdd(a, FNeg(b)) → FSub(a,b) from floating_point.egg
(rule ((= e (VecFAdd a (VecFNeg b))))
      ((union e (VecFSub a b))))

; =============================================================================
; Vector Operations Distributivity
; =============================================================================

; VecTimesScalar distributes over VecAdd - ONE-DIRECTIONAL (distribute, don't factor)
(rule ((= e (VecTimesScalar (VecAdd a b) s)))
      ((union e (VecAdd (VecTimesScalar a s) (VecTimesScalar b s)))))

; VecTimesScalar with scalar multiplication - ONE-DIRECTIONAL (combine scalars)
; Note: s1 and s2 are Expr (from VecTimesScalar args), but Mul takes IntExpr.
; Use ExprToInt/IntToExpr bridges to cross sorts.
(rule ((= e (VecTimesScalar (VecTimesScalar v s1) s2)))
      ((union e (VecTimesScalar v (IntToExpr (Mul (ExprToInt s1) (ExprToInt s2)))))))

; =============================================================================
; Cross Product Properties
; =============================================================================

; Cross product with self is zero (for 3D vectors)
; Note: commented because zero vector construction is complex
; (rewrite (Cross a a) (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))

; Cross product negation - ONE-DIRECTIONAL (push VecNeg out of Cross)
(rule ((= e (Cross (VecNeg a) b)))
      ((union e (VecNeg (Cross a b)))))
(rule ((= e (Cross a (VecNeg b))))
      ((union e (VecNeg (Cross a b)))))
(rule ((= e (Cross (VecNeg a) (VecNeg b))))
      ((union e (Cross a b))))

; Cross product distributes over scalar multiplication - ONE-DIRECTIONAL
(rule ((= e (Cross (VecTimesScalar a s) b)))
      ((union e (VecTimesScalar (Cross a b) s))))
(rule ((= e (Cross a (VecTimesScalar b s))))
      ((union e (VecTimesScalar (Cross a b) s))))

; =============================================================================
; Dot Product Additional Properties
; =============================================================================

; Dot product distributes over VecAdd - ONE-DIRECTIONAL (expand Dot)
; Note: Dot returns FloatExpr, so use FAdd (FloatExpr + FloatExpr -> FloatExpr)
(rule ((= e (Dot (VecAdd a b) c)))
      ((union e (FAdd (Dot a c) (Dot b c)))))
(rule ((= e (Dot a (VecAdd b c))))
      ((union e (FAdd (Dot a b) (Dot a c)))))

; Dot product distributes over scalar multiplication - ONE-DIRECTIONAL
; Note: Dot returns FloatExpr, s is Expr (from VecTimesScalar), use FMul with ExprToFloat
(rule ((= e (Dot (VecTimesScalar a s) b)))
      ((union e (FMul (ExprToFloat s) (Dot a b)))))
(rule ((= e (Dot a (VecTimesScalar b s))))
      ((union e (FMul (Dot a b) (ExprToFloat s)))))

; Dot with negated vector - ONE-DIRECTIONAL
; Note: Dot returns FloatExpr, so use FNeg (FloatExpr -> FloatExpr)
(rule ((= e (Dot (VecNeg a) b)))
      ((union e (FNeg (Dot a b)))))
(rule ((= e (Dot a (VecNeg b))))
      ((union e (FNeg (Dot a b)))))

; =============================================================================
; Reconstruct Vector from Extracts
; =============================================================================

; If we extract all components and rebuild, we get the original
; Vec2(VecExtract(v, 0), VecExtract(v, 1)) = v for Vec2
; Note: This is an extraction pattern that helps with optimization

; Insert into slot we just extracted from is identity - ONE-DIRECTIONAL
(rule ((= e (VecInsert v (VecExtract v 0) 0)))
      ((union e v)))
(rule ((= e (VecInsert v (VecExtract v 1) 1)))
      ((union e v)))
(rule ((= e (VecInsert v (VecExtract v 2) 2)))
      ((union e v)))
(rule ((= e (VecInsert v (VecExtract v 3) 3)))
      ((union e v)))

; =============================================================================
; Vector Length and Normalize Relationships
; =============================================================================

; Length(Normalize(v)) would be 1, but we need float representation
; Normalize is idempotent for non-zero vectors (already in glsl.egg)

; Dot(v, v) = Length(v)^2
; This is useful for optimization but hard to express without sqrt

; =============================================================================
; Vector Projection Patterns
; =============================================================================

; Scalar projection: (Dot(a, b) / Dot(b, b)) * b gives projection of a onto b
; This is complex to express but common in graphics

; =============================================================================
; Floating-Point Vector Operations
; =============================================================================

; VecFMul with 0 = 0 vector
; VecFMul with 1 = identity (already covered)

; VecFAdd/VecFMul associativity - RESTRICTED to prevent explosion
; Same issue as scalar: identity rules (x + 0 = x) combined with general associativity
; cause exponential growth. Safe variant only fires when 'b' is same operation type.
(rule ((= e (VecFAdd (VecFAdd a b) c)) (= b (VecFAdd _ _)))
      ((union e (VecFAdd a (VecFAdd b c)))))
(rule ((= e (VecFMul (VecFMul a b) c)) (= b (VecFMul _ _)))
      ((union e (VecFMul a (VecFMul b c)))))

; VecFAdd/VecFMul commutativity - REMOVED to prevent e-graph explosion
; These bidirectional rules cause cycles: (VecFAdd a b) <-> (VecFAdd b a) <-> ...

; =============================================================================
; Scalar-Vector Multiplication Chain
; =============================================================================

; (v * s1) * s2 = v * (s1 * s2)
; Note: Const returns IntExpr, wrapped with IntToExpr for Expr context in VecTimesScalar
(rule ((= e (VecTimesScalar (VecTimesScalar v (IntToExpr (Const s1))) (IntToExpr (Const s2)))) (mul-safe s1 s2))
      ((union e (VecTimesScalar v (IntToExpr (Const (* s1 s2)))))))

; v * 0 produces zero vector (already have for integer version)

; v * (-1) = -v - ONE-DIRECTIONAL
(rule ((= e (VecTimesScalar v (IntToExpr (Const -1)))))
      ((union e (VecNeg v))))

; =============================================================================
; Cross Product Additional Rules
; =============================================================================

; Cross product is anti-commutative (already in glsl.egg via VecNeg)

; Cross product of orthogonal unit vectors gives the third
; These are specific geometric identities

; =============================================================================
; Dot Product with Constructed Vectors
; =============================================================================

; Dot(Vec2(a, b), Vec2(c, d)) = a*c + b*d
; This is useful for constant folding but complex to express

; =============================================================================
; Vector Component-wise Operations
; =============================================================================

; Component-wise minimum and maximum
; VecMin(v, v) = v, VecMax(v, v) = v
; These would need VecMin/VecMax constructors

; =============================================================================
; Swizzle/Shuffle Optimizations (C++ VectorShuffle parity)
; =============================================================================
; Uses specialized VecShuffle2/3/4 with fixed-arity indices for cleaner rules

; -----------------------------------------------------------------------------
; Identity shuffles - ONE-DIRECTIONAL to prevent explosion
; -----------------------------------------------------------------------------
(rule ((= e (VecShuffle2 v _ 0 1)))
      ((union e v)))
(rule ((= e (VecShuffle3 v _ 0 1 2)))
      ((union e v)))
(rule ((= e (VecShuffle4 v _ 0 1 2 3)))
      ((union e v)))

; Same operand identity - ONE-DIRECTIONAL
(rule ((= e (VecShuffle2 v v 0 1)))
      ((union e v)))
(rule ((= e (VecShuffle3 v v 0 1 2)))
      ((union e v)))
(rule ((= e (VecShuffle4 v v 0 1 2 3)))
      ((union e v)))

; -----------------------------------------------------------------------------
; Extract from VecShuffle (C++ VectorShuffleFeedingExtract)
; When extracting from a shuffle, go directly to the source vector
; -----------------------------------------------------------------------------

; Vec4 shuffle -> extract at position 0 - ONE-DIRECTIONAL
(rule ((= e (VecExtract (VecShuffle4 v _ 0 _ _ _) 0))) ((union e (VecExtract v 0))))
(rule ((= e (VecExtract (VecShuffle4 v _ 1 _ _ _) 0))) ((union e (VecExtract v 1))))
(rule ((= e (VecExtract (VecShuffle4 v _ 2 _ _ _) 0))) ((union e (VecExtract v 2))))
(rule ((= e (VecExtract (VecShuffle4 v _ 3 _ _ _) 0))) ((union e (VecExtract v 3))))

; Vec4 shuffle -> extract at position 1 - ONE-DIRECTIONAL
(rule ((= e (VecExtract (VecShuffle4 v _ _ 0 _ _) 1))) ((union e (VecExtract v 0))))
(rule ((= e (VecExtract (VecShuffle4 v _ _ 1 _ _) 1))) ((union e (VecExtract v 1))))
(rule ((= e (VecExtract (VecShuffle4 v _ _ 2 _ _) 1))) ((union e (VecExtract v 2))))
(rule ((= e (VecExtract (VecShuffle4 v _ _ 3 _ _) 1))) ((union e (VecExtract v 3))))

; Vec4 shuffle -> extract at position 2 - ONE-DIRECTIONAL
(rule ((= e (VecExtract (VecShuffle4 v _ _ _ 0 _) 2))) ((union e (VecExtract v 0))))
(rule ((= e (VecExtract (VecShuffle4 v _ _ _ 1 _) 2))) ((union e (VecExtract v 1))))
(rule ((= e (VecExtract (VecShuffle4 v _ _ _ 2 _) 2))) ((union e (VecExtract v 2))))
(rule ((= e (VecExtract (VecShuffle4 v _ _ _ 3 _) 2))) ((union e (VecExtract v 3))))

; Vec4 shuffle -> extract at position 3 - ONE-DIRECTIONAL
(rule ((= e (VecExtract (VecShuffle4 v _ _ _ _ 0) 3))) ((union e (VecExtract v 0))))
(rule ((= e (VecExtract (VecShuffle4 v _ _ _ _ 1) 3))) ((union e (VecExtract v 1))))
(rule ((= e (VecExtract (VecShuffle4 v _ _ _ _ 2) 3))) ((union e (VecExtract v 2))))
(rule ((= e (VecExtract (VecShuffle4 v _ _ _ _ 3) 3))) ((union e (VecExtract v 3))))

; Vec3 shuffle -> extract - ONE-DIRECTIONAL
(rule ((= e (VecExtract (VecShuffle3 v _ 0 _ _) 0))) ((union e (VecExtract v 0))))
(rule ((= e (VecExtract (VecShuffle3 v _ 1 _ _) 0))) ((union e (VecExtract v 1))))
(rule ((= e (VecExtract (VecShuffle3 v _ 2 _ _) 0))) ((union e (VecExtract v 2))))
(rule ((= e (VecExtract (VecShuffle3 v _ _ 0 _) 1))) ((union e (VecExtract v 0))))
(rule ((= e (VecExtract (VecShuffle3 v _ _ 1 _) 1))) ((union e (VecExtract v 1))))
(rule ((= e (VecExtract (VecShuffle3 v _ _ 2 _) 1))) ((union e (VecExtract v 2))))
(rule ((= e (VecExtract (VecShuffle3 v _ _ _ 0) 2))) ((union e (VecExtract v 0))))
(rule ((= e (VecExtract (VecShuffle3 v _ _ _ 1) 2))) ((union e (VecExtract v 1))))
(rule ((= e (VecExtract (VecShuffle3 v _ _ _ 2) 2))) ((union e (VecExtract v 2))))

; Vec2 shuffle -> extract - ONE-DIRECTIONAL
(rule ((= e (VecExtract (VecShuffle2 v _ 0 _) 0))) ((union e (VecExtract v 0))))
(rule ((= e (VecExtract (VecShuffle2 v _ 1 _) 0))) ((union e (VecExtract v 1))))
(rule ((= e (VecExtract (VecShuffle2 v _ _ 0) 1))) ((union e (VecExtract v 0))))
(rule ((= e (VecExtract (VecShuffle2 v _ _ 1) 1))) ((union e (VecExtract v 1))))

; -----------------------------------------------------------------------------
; Broadcast patterns - same index in all positions - ONE-DIRECTIONAL
; -----------------------------------------------------------------------------
(rule ((= e (VecShuffle4 v _ 0 0 0 0))) ((union e (VecBroadcast4 (VecExtract v 0)))))
(rule ((= e (VecShuffle4 v _ 1 1 1 1))) ((union e (VecBroadcast4 (VecExtract v 1)))))
(rule ((= e (VecShuffle4 v _ 2 2 2 2))) ((union e (VecBroadcast4 (VecExtract v 2)))))
(rule ((= e (VecShuffle4 v _ 3 3 3 3))) ((union e (VecBroadcast4 (VecExtract v 3)))))

(rule ((= e (VecShuffle3 v _ 0 0 0))) ((union e (VecBroadcast3 (VecExtract v 0)))))
(rule ((= e (VecShuffle3 v _ 1 1 1))) ((union e (VecBroadcast3 (VecExtract v 1)))))
(rule ((= e (VecShuffle3 v _ 2 2 2))) ((union e (VecBroadcast3 (VecExtract v 2)))))

(rule ((= e (VecShuffle2 v _ 0 0))) ((union e (VecBroadcast2 (VecExtract v 0)))))
(rule ((= e (VecShuffle2 v _ 1 1))) ((union e (VecBroadcast2 (VecExtract v 1)))))

; Broadcast constructs the vector with repeated value - ONE-DIRECTIONAL
(rule ((= e (VecBroadcast2 x))) ((union e (Vec2 x x))))
(rule ((= e (VecBroadcast3 x))) ((union e (Vec3 x x x))))
(rule ((= e (VecBroadcast4 x))) ((union e (Vec4 x x x x))))

; -----------------------------------------------------------------------------
; Common swizzle patterns - ONE-DIRECTIONAL
; -----------------------------------------------------------------------------

; Reverse vec2
(rule ((= e (VecShuffle2 v v 1 0)))
      ((union e (Vec2 (VecExtract v 1) (VecExtract v 0)))))

; Swap halves of vec4 (.zwxy)
(rule ((= e (VecShuffle4 v v 2 3 0 1)))
      ((union e (Vec4 (VecExtract v 2) (VecExtract v 3) (VecExtract v 0) (VecExtract v 1)))))

; Extract .xy from vec4 to vec2
(rule ((= e (VecShuffle2 (Vec4 a b c d) _ 0 1))) ((union e (Vec2 a b))))
(rule ((= e (VecShuffle2 (Vec4 a b c d) _ 2 3))) ((union e (Vec2 c d))))

; Extract .xyz from vec4 to vec3
(rule ((= e (VecShuffle3 (Vec4 a b c d) _ 0 1 2))) ((union e (Vec3 a b c))))

; -----------------------------------------------------------------------------
; Shuffle of constructed vector simplifies - ONE-DIRECTIONAL
; -----------------------------------------------------------------------------
(rule ((= e (VecShuffle4 (Vec4 a b c d) _ 0 1 2 3))) ((union e (Vec4 a b c d))))
(rule ((= e (VecShuffle4 (Vec4 a b c d) _ 3 2 1 0))) ((union e (Vec4 d c b a))))
(rule ((= e (VecShuffle4 (Vec4 a b c d) _ 0 0 0 0))) ((union e (Vec4 a a a a))))
(rule ((= e (VecShuffle4 (Vec4 a b c d) _ 1 1 1 1))) ((union e (Vec4 b b b b))))
(rule ((= e (VecShuffle4 (Vec4 a b c d) _ 2 2 2 2))) ((union e (Vec4 c c c c))))
(rule ((= e (VecShuffle4 (Vec4 a b c d) _ 3 3 3 3))) ((union e (Vec4 d d d d))))

(rule ((= e (VecShuffle3 (Vec3 a b c) _ 0 1 2))) ((union e (Vec3 a b c))))
(rule ((= e (VecShuffle3 (Vec3 a b c) _ 2 1 0))) ((union e (Vec3 c b a))))

(rule ((= e (VecShuffle2 (Vec2 a b) _ 0 1))) ((union e (Vec2 a b))))
(rule ((= e (VecShuffle2 (Vec2 a b) _ 1 0))) ((union e (Vec2 b a))))

; -----------------------------------------------------------------------------
; Two consecutive shuffles can sometimes be combined - ONE-DIRECTIONAL
; (C++ VectorShuffleFeedingShuffle)
; -----------------------------------------------------------------------------
; When shuffling from a shuffle, compose the indices
; This is complex in general, but some patterns are clear:

; Shuffle(Shuffle(v, _, m1), _, identity) = Shuffle(v, _, m1)
(rule ((= e (VecShuffle4 (VecShuffle4 v w i0 i1 i2 i3) _ 0 1 2 3))) ((union e (VecShuffle4 v w i0 i1 i2 i3))))
(rule ((= e (VecShuffle3 (VecShuffle3 v w i0 i1 i2) _ 0 1 2))) ((union e (VecShuffle3 v w i0 i1 i2))))
(rule ((= e (VecShuffle2 (VecShuffle2 v w i0 i1) _ 0 1))) ((union e (VecShuffle2 v w i0 i1))))

; -----------------------------------------------------------------------------
; Shuffle of broadcast optimization
; Any shuffle of a broadcast vector yields the same broadcast
; This is because all elements are identical, so rearranging them has no effect
; -----------------------------------------------------------------------------

; Shuffle of broadcast Vec4 (all same value) is still that broadcast
(rule ((= e (VecShuffle4 (Vec4 x x x x) _ _ _ _ _)))
      ((union e (Vec4 x x x x))))
(rule ((= e (VecShuffle3 (Vec4 x x x x) _ _ _ _)))
      ((union e (Vec3 x x x))))
(rule ((= e (VecShuffle2 (Vec4 x x x x) _ _ _)))
      ((union e (Vec2 x x))))

; Shuffle of broadcast Vec3
(rule ((= e (VecShuffle3 (Vec3 x x x) _ _ _ _)))
      ((union e (Vec3 x x x))))
(rule ((= e (VecShuffle2 (Vec3 x x x) _ _ _)))
      ((union e (Vec2 x x))))

; Shuffle of broadcast Vec2
(rule ((= e (VecShuffle2 (Vec2 x x) _ _ _)))
      ((union e (Vec2 x x))))

; Shuffle from VecBroadcast directly
(rule ((= e (VecShuffle4 (VecBroadcast4 x) _ _ _ _ _)))
      ((union e (VecBroadcast4 x))))
(rule ((= e (VecShuffle3 (VecBroadcast3 x) _ _ _ _)))
      ((union e (VecBroadcast3 x))))
(rule ((= e (VecShuffle2 (VecBroadcast2 x) _ _ _)))
      ((union e (VecBroadcast2 x))))

; Downcast shuffle of broadcast
(rule ((= e (VecShuffle3 (VecBroadcast4 x) _ _ _ _)))
      ((union e (VecBroadcast3 x))))
(rule ((= e (VecShuffle2 (VecBroadcast4 x) _ _ _)))
      ((union e (VecBroadcast2 x))))
(rule ((= e (VecShuffle2 (VecBroadcast3 x) _ _ _)))
      ((union e (VecBroadcast2 x))))

; Extract from broadcast is the broadcast value
(rule ((= e (VecExtract (VecBroadcast2 x) _)))
      ((union e x)))
(rule ((= e (VecExtract (VecBroadcast3 x) _)))
      ((union e x)))
(rule ((= e (VecExtract (VecBroadcast4 x) _)))
      ((union e x)))

; =============================================================================
; Loop Invariant Vector Operations - ONE-DIRECTIONAL
; =============================================================================

(rule ((= e (VecAdd (LoopInvariant a) (LoopInvariant b)))) ((union e (LoopInvariant (VecAdd a b)))))
(rule ((= e (VecSub (LoopInvariant a) (LoopInvariant b)))) ((union e (LoopInvariant (VecSub a b)))))
(rule ((= e (VecMul (LoopInvariant a) (LoopInvariant b)))) ((union e (LoopInvariant (VecMul a b)))))
(rule ((= e (VecNeg (LoopInvariant a)))) ((union e (LoopInvariant (VecNeg a)))))
(rule ((= e (VecFAdd (LoopInvariant a) (LoopInvariant b)))) ((union e (LoopInvariant (VecFAdd a b)))))
(rule ((= e (VecFSub (LoopInvariant a) (LoopInvariant b)))) ((union e (LoopInvariant (VecFSub a b)))))
(rule ((= e (VecFMul (LoopInvariant a) (LoopInvariant b)))) ((union e (LoopInvariant (VecFMul a b)))))
(rule ((= e (VecFNeg (LoopInvariant a)))) ((union e (LoopInvariant (VecFNeg a)))))
(rule ((= e (VecFRem (LoopInvariant a) (LoopInvariant b)))) ((union e (LoopInvariant (VecFRem a b)))))
(rule ((= e (VecFMod (LoopInvariant a) (LoopInvariant b)))) ((union e (LoopInvariant (VecFMod a b)))))
; Note: VecDiv and VecFDiv loop invariant rules are in licm.egg
(rule ((= e (VecSDiv (LoopInvariant a) (LoopInvariant b)))) ((union e (LoopInvariant (VecSDiv a b)))))
(rule ((= e (VecUDiv (LoopInvariant a) (LoopInvariant b)))) ((union e (LoopInvariant (VecUDiv a b)))))
(rule ((= e (VecSRem (LoopInvariant a) (LoopInvariant b)))) ((union e (LoopInvariant (VecSRem a b)))))
(rule ((= e (VecSMod (LoopInvariant a) (LoopInvariant b)))) ((union e (LoopInvariant (VecSMod a b)))))
(rule ((= e (VecUMod (LoopInvariant a) (LoopInvariant b)))) ((union e (LoopInvariant (VecUMod a b)))))
; Note: Dot returns FloatExpr, use LoopInvariantF (FloatExpr -> FloatExpr)
(rule ((= e (Dot (LoopInvariant a) (LoopInvariant b)))) ((union e (LoopInvariantF (Dot a b)))))
(rule ((= e (Cross (LoopInvariant a) (LoopInvariant b)))) ((union e (LoopInvariant (Cross a b)))))
(rule ((= e (Normalize (LoopInvariant a)))) ((union e (LoopInvariant (Normalize a)))))
; Note: Length returns FloatExpr, use LoopInvariantF (FloatExpr -> FloatExpr)
(rule ((= e (Length (LoopInvariant a)))) ((union e (LoopInvariantF (Length a)))))

; =============================================================================
; VecSize Seeding — needed for ShuffleExtract resolution
; =============================================================================

(rule ((= e (Vec2 _ _))) ((set (VecSize e) 2)))
(rule ((= e (Vec3 _ _ _))) ((set (VecSize e) 3)))
(rule ((= e (Vec4 _ _ _ _))) ((set (VecSize e) 4)))
(rule ((= e (VecBroadcast2 _))) ((set (VecSize e) 2)))
(rule ((= e (VecBroadcast3 _))) ((set (VecSize e) 3)))
(rule ((= e (VecBroadcast4 _))) ((set (VecSize e) 4)))
(rule ((= e (VecShuffle2 _ _ _ _))) ((set (VecSize e) 2)))
(rule ((= e (VecShuffle3 _ _ _ _ _))) ((set (VecSize e) 3)))
(rule ((= e (VecShuffle4 _ _ _ _ _ _))) ((set (VecSize e) 4)))

; Propagate VecSize through common vector ops that preserve dimensionality
(rule ((= e (VecAdd a _)) (= sz (VecSize a))) ((set (VecSize e) sz)))
(rule ((= e (VecSub a _)) (= sz (VecSize a))) ((set (VecSize e) sz)))
(rule ((= e (VecMul a _)) (= sz (VecSize a))) ((set (VecSize e) sz)))
(rule ((= e (VecNeg a)) (= sz (VecSize a))) ((set (VecSize e) sz)))
(rule ((= e (VecFAdd a _)) (= sz (VecSize a))) ((set (VecSize e) sz)))
(rule ((= e (VecFSub a _)) (= sz (VecSize a))) ((set (VecSize e) sz)))
(rule ((= e (VecFMul a _)) (= sz (VecSize a))) ((set (VecSize e) sz)))
(rule ((= e (VecFNeg a)) (= sz (VecSize a))) ((set (VecSize e) sz)))
(rule ((= e (VecFRem a _)) (= sz (VecSize a))) ((set (VecSize e) sz)))
(rule ((= e (VecFMod a _)) (= sz (VecSize a))) ((set (VecSize e) sz)))
(rule ((= e (VecDiv a _)) (= sz (VecSize a))) ((set (VecSize e) sz)))
(rule ((= e (VecSDiv a _)) (= sz (VecSize a))) ((set (VecSize e) sz)))
(rule ((= e (VecUDiv a _)) (= sz (VecSize a))) ((set (VecSize e) sz)))
(rule ((= e (VecSRem a _)) (= sz (VecSize a))) ((set (VecSize e) sz)))
(rule ((= e (VecSMod a _)) (= sz (VecSize a))) ((set (VecSize e) sz)))
(rule ((= e (VecUMod a _)) (= sz (VecSize a))) ((set (VecSize e) sz)))
(rule ((= e (VecTimesScalar a _)) (= sz (VecSize a))) ((set (VecSize e) sz)))
(rule ((= e (VecFMix a _ _)) (= sz (VecSize a))) ((set (VecSize e) sz)))

; =============================================================================
; ShuffleExtract Resolution
; =============================================================================
; ShuffleExtract(v1, v2, i) resolves to the correct VecExtract based on VecSize(v1)

; Index from first source (i < VecSize(v1))
(rule ((= e (ShuffleExtract v1 v2 i)) (= sz (VecSize v1)) (< i sz) (>= i 0))
      ((union e (VecExtract v1 i))))

; Index from second source (i >= VecSize(v1))
(rule ((= e (ShuffleExtract v1 v2 i)) (= sz (VecSize v1)) (>= i sz) (< i 8))
      ((union e (VecExtract v2 (- i sz)))))

; Undef index (0xFFFFFFFF stored as i64 = 4294967295)
(rule ((= e (ShuffleExtract v1 v2 4294967295)))
      ((union e (Undef))))

; =============================================================================
; VecShuffle Decomposition — enables constant fold, chain collapse, extract-from-shuffle
; =============================================================================
; Unconditionally decompose VecShuffle into Vec of ShuffleExtracts.
; The e-graph keeps both representations; the extractor picks the cheapest.

(rule ((= e (VecShuffle4 v1 v2 i0 i1 i2 i3)))
      ((union e (Vec4 (ShuffleExtract v1 v2 i0) (ShuffleExtract v1 v2 i1) (ShuffleExtract v1 v2 i2) (ShuffleExtract v1 v2 i3)))))

(rule ((= e (VecShuffle3 v1 v2 i0 i1 i2)))
      ((union e (Vec3 (ShuffleExtract v1 v2 i0) (ShuffleExtract v1 v2 i1) (ShuffleExtract v1 v2 i2)))))

(rule ((= e (VecShuffle2 v1 v2 i0 i1)))
      ((union e (Vec2 (ShuffleExtract v1 v2 i0) (ShuffleExtract v1 v2 i1)))))

; =============================================================================
; VecSelect Decomposition (component-wise select with vector boolean mask)
; =============================================================================
; When the mask structure is known (Vec2/3/4), decompose into per-element
; Gamma via ExprToBool bridge. Existing Gamma rules handle constant conditions.

; VecSelect with same true/false branches is identity
(rule ((= e (VecSelect mask t t)))
      ((union e t)))

; VecSelect decomposition for Vec2 mask
(rule ((= e (VecSelect (Vec2 m0 m1) t f)))
      ((union e (Vec2 (Gamma (ExprToBool m0) (VecExtract t 0) (VecExtract f 0))
                      (Gamma (ExprToBool m1) (VecExtract t 1) (VecExtract f 1))))))

; VecSelect decomposition for Vec3 mask
(rule ((= e (VecSelect (Vec3 m0 m1 m2) t f)))
      ((union e (Vec3 (Gamma (ExprToBool m0) (VecExtract t 0) (VecExtract f 0))
                      (Gamma (ExprToBool m1) (VecExtract t 1) (VecExtract f 1))
                      (Gamma (ExprToBool m2) (VecExtract t 2) (VecExtract f 2))))))

; VecSelect decomposition for Vec4 mask
(rule ((= e (VecSelect (Vec4 m0 m1 m2 m3) t f)))
      ((union e (Vec4 (Gamma (ExprToBool m0) (VecExtract t 0) (VecExtract f 0))
                      (Gamma (ExprToBool m1) (VecExtract t 1) (VecExtract f 1))
                      (Gamma (ExprToBool m2) (VecExtract t 2) (VecExtract f 2))
                      (Gamma (ExprToBool m3) (VecExtract t 3) (VecExtract f 3))))))

; =============================================================================
; Gamma Distribution for Vector Operations - ONE-DIRECTIONAL
; =============================================================================

; select(c, v1 + v2, v1 + v3) = v1 + select(c, v2, v3)
; Note: Gamma condition is BoolExpr (already correct in typed sort system)
(rule ((= e (Gamma c (VecFAdd x a) (VecFAdd x b)))) ((union e (VecFAdd x (Gamma c a b)))))
(rule ((= e (Gamma c (VecFMul x a) (VecFMul x b)))) ((union e (VecFMul x (Gamma c a b)))))
(rule ((= e (Gamma c (VecAdd x a) (VecAdd x b)))) ((union e (VecAdd x (Gamma c a b)))))
(rule ((= e (Gamma c (VecMul x a) (VecMul x b)))) ((union e (VecMul x (Gamma c a b)))))
