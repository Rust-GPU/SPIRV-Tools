; =============================================================================
; Comparison Rewrite Rules
; =============================================================================

; Reflexive comparisons - produce BoolConst since comparisons return boolean
(rule ((= e (Eq x x)))
      ((union e (BoolConst 1))))
(rule ((= e (Ne x x)))
      ((union e (BoolConst 0))))
(rule ((= e (SLe x x)))
      ((union e (BoolConst 1))))
(rule ((= e (SGe x x)))
      ((union e (BoolConst 1))))
(rule ((= e (ULe x x)))
      ((union e (BoolConst 1))))
(rule ((= e (UGe x x)))
      ((union e (BoolConst 1))))
(rule ((= e (SLt x x)))
      ((union e (BoolConst 0))))
(rule ((= e (SGt x x)))
      ((union e (BoolConst 0))))
(rule ((= e (ULt x x)))
      ((union e (BoolConst 0))))
(rule ((= e (UGt x x)))
      ((union e (BoolConst 0))))

; Comparison with negation - ONE-DIRECTIONAL
(rule ((= e (Eq x (Neg x))))
      ((union e (Eq x (Const 0)))))
(rule ((= e (Ne x (Neg x))))
      ((union e (Ne x (Const 0)))))

; =============================================================================
; Comparison Negation (C++ Parity) - ONE-DIRECTIONAL
; =============================================================================
; NOTE: These MUST be one-directional rules! Using bidirectional rewrite causes
; cycles: LogNot(Eq a b) ↔ Ne a b ↔ LogNot(Ne a b) ↔ Eq a b ↔ ...
; We only simplify LogNot(comparison) to the negated comparison form.

; LogNot of comparisons flips the comparison - ONE-DIRECTIONAL
(rule ((= e (LogNot (Eq a b))))
      ((union e (Ne a b))))
(rule ((= e (LogNot (Ne a b))))
      ((union e (Eq a b))))
(rule ((= e (LogNot (SLt a b))))
      ((union e (SGe a b))))
(rule ((= e (LogNot (SLe a b))))
      ((union e (SGt a b))))
(rule ((= e (LogNot (SGt a b))))
      ((union e (SLe a b))))
(rule ((= e (LogNot (SGe a b))))
      ((union e (SLt a b))))
(rule ((= e (LogNot (ULt a b))))
      ((union e (UGe a b))))
(rule ((= e (LogNot (ULe a b))))
      ((union e (UGt a b))))
(rule ((= e (LogNot (UGt a b))))
      ((union e (ULe a b))))
(rule ((= e (LogNot (UGe a b))))
      ((union e (ULt a b))))

; =============================================================================
; Comparison Flipping (swap operands)
; =============================================================================

; a < b is equivalent to b > a - ONE-DIRECTIONAL
; Canonicalize to "less than" form (SLt, SLe, ULt, ULe) to prevent cycles
(rule ((= e (SGt a b)))
      ((union e (SLt b a))))
(rule ((= e (SGe a b)))
      ((union e (SLe b a))))
(rule ((= e (UGt a b)))
      ((union e (ULt b a))))
(rule ((= e (UGe a b)))
      ((union e (ULe b a))))

; Equality is symmetric - ONE-DIRECTIONAL
; Only union, don't create new nodes in both directions
; Note: We don't add any rule here because Eq(a,b) ↔ Eq(b,a) would still explode
; The e-graph handles this via union when both forms are present

; =============================================================================
; Comparison of Negated Values
; =============================================================================

; (-a) < (-b) is equivalent to b < a (for signed) - ONE-DIRECTIONAL
(rule ((= e (SLt (Neg a) (Neg b))))
      ((union e (SLt b a))))
(rule ((= e (SLe (Neg a) (Neg b))))
      ((union e (SLe b a))))
(rule ((= e (SGt (Neg a) (Neg b))))
      ((union e (SGt b a))))
(rule ((= e (SGe (Neg a) (Neg b))))
      ((union e (SGe b a))))

; =============================================================================
; Comparison with Constants
; =============================================================================

; x < 0 for signed: test sign bit
; x >= 0 for signed: test non-negative

; x < 1 for unsigned is x == 0 - ONE-DIRECTIONAL
(rule ((= e (ULt x (Const 1))))
      ((union e (Eq x (Const 0)))))

; x <= 0 for unsigned is x == 0 - ONE-DIRECTIONAL
(rule ((= e (ULe x (Const 0))))
      ((union e (Eq x (Const 0)))))

; x > 0 for unsigned is x != 0 - ONE-DIRECTIONAL
(rule ((= e (UGt x (Const 0))))
      ((union e (Ne x (Const 0)))))

; x >= 1 for unsigned is x != 0 - ONE-DIRECTIONAL
(rule ((= e (UGe x (Const 1))))
      ((union e (Ne x (Const 0)))))

; =============================================================================
; Boundary Value Comparisons (C++ Parity - from fold.cpp)
; =============================================================================
; These optimize comparisons involving INT32_MIN, INT32_MAX, UINT32_MAX
; UINT32_MAX = 0xFFFFFFFF = 4294967295 = -1 as signed
; INT32_MAX = 2147483647
; INT32_MIN = -2147483648

; ULt: x < UINT32_MAX is always true unless x == UINT32_MAX
; UINT32_MAX < x is always false - ONE-DIRECTIONAL
; Note: UINT32_MAX (0xFFFFFFFF) is stored as Const -1 due to sign extension
(rule ((= e (ULt (Const -1) x)))
      ((union e (BoolConst 0))))
; x < 0 for unsigned is always false - ONE-DIRECTIONAL
(rule ((= e (ULt x (Const 0))))
      ((union e (BoolConst 0))))

; SLt: INT32_MAX < x is always false - ONE-DIRECTIONAL
(rule ((= e (SLt (Const 2147483647) x)))
      ((union e (BoolConst 0))))
; x < INT32_MIN is always false - ONE-DIRECTIONAL
(rule ((= e (SLt x (Const -2147483648))))
      ((union e (BoolConst 0))))

; UGt: 0 > x for unsigned is always false - ONE-DIRECTIONAL
(rule ((= e (UGt (Const 0) x)))
      ((union e (BoolConst 0))))
; x > UINT32_MAX is always false - ONE-DIRECTIONAL
; Note: UINT32_MAX (0xFFFFFFFF) is stored as Const -1 due to sign extension
(rule ((= e (UGt x (Const -1))))
      ((union e (BoolConst 0))))

; SGt: INT32_MIN > x is always false - ONE-DIRECTIONAL
(rule ((= e (SGt (Const -2147483648) x)))
      ((union e (BoolConst 0))))
; x > INT32_MAX is always false - ONE-DIRECTIONAL
(rule ((= e (SGt x (Const 2147483647))))
      ((union e (BoolConst 0))))

; ULe: 0 <= x for unsigned is always true - ONE-DIRECTIONAL
(rule ((= e (ULe (Const 0) x)))
      ((union e (BoolConst 1))))
; x <= UINT32_MAX is always true - ONE-DIRECTIONAL
; Note: UINT32_MAX (0xFFFFFFFF) is stored as Const -1 due to sign extension
(rule ((= e (ULe x (Const -1))))
      ((union e (BoolConst 1))))

; SLe: INT32_MIN <= x is always true - ONE-DIRECTIONAL
(rule ((= e (SLe (Const -2147483648) x)))
      ((union e (BoolConst 1))))
; x <= INT32_MAX is always true - ONE-DIRECTIONAL
(rule ((= e (SLe x (Const 2147483647))))
      ((union e (BoolConst 1))))

; UGe: x >= 0 for unsigned is always true - ONE-DIRECTIONAL
(rule ((= e (UGe x (Const 0))))
      ((union e (BoolConst 1))))
; UINT32_MAX >= x is always true - ONE-DIRECTIONAL
; Note: UINT32_MAX (0xFFFFFFFF) is stored as Const -1 due to sign extension
(rule ((= e (UGe (Const -1) x)))
      ((union e (BoolConst 1))))

; SGe: x >= INT32_MIN is always true - ONE-DIRECTIONAL
(rule ((= e (SGe x (Const -2147483648))))
      ((union e (BoolConst 1))))
; INT32_MAX >= x is always true - ONE-DIRECTIONAL
(rule ((= e (SGe (Const 2147483647) x)))
      ((union e (BoolConst 1))))

; =============================================================================
; Comparison Chaining (C++ Parity)
; =============================================================================

; (a < b) && (b < c) implies a < c (transitivity)
; Hard to express directly, but useful for analysis

; (a == b) && (b == c) implies a == c
; Also hard to express directly

; (a <= b) && (b <= a) implies a == b
(rule ((= e (LogAnd (SLe a b) (SLe b a))))
      ((union e (Eq a b))))
(rule ((= e (LogAnd (ULe a b) (ULe b a))))
      ((union e (Eq a b))))

; (a < b) || (a >= b) is always true
(rule ((= e (LogOr (SLt a b) (SGe a b))))
      ((union e (BoolConst 1))))
(rule ((= e (LogOr (ULt a b) (UGe a b))))
      ((union e (BoolConst 1))))

; (a < b) && (a >= b) is always false
(rule ((= e (LogAnd (SLt a b) (SGe a b))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (ULt a b) (UGe a b))))
      ((union e (BoolConst 0))))

; =============================================================================
; Min/Max and Comparison Relationships
; =============================================================================

; SMin(a, b) <= a is always true
; SMax(a, b) >= a is always true

; a <= SMax(a, b) is always true
(rule ((= e (SLe a (SMax a b))))
      ((union e (BoolConst 1))))
(rule ((= e (ULe a (UMax a b))))
      ((union e (BoolConst 1))))

; SMin(a, b) <= a is always true
(rule ((= e (SLe (SMin a b) a)))
      ((union e (BoolConst 1))))
(rule ((= e (ULe (UMin a b) a)))
      ((union e (BoolConst 1))))

; =============================================================================
; Comparison with Add/Sub
; =============================================================================

; (a + c) == (b + c) is a == b - ONE-DIRECTIONAL
(rule ((= e (Eq (Add a c) (Add b c))))
      ((union e (Eq a b))))
(rule ((= e (Ne (Add a c) (Add b c))))
      ((union e (Ne a b))))

; (a - c) == (b - c) is a == b - ONE-DIRECTIONAL
(rule ((= e (Eq (Sub a c) (Sub b c))))
      ((union e (Eq a b))))
(rule ((= e (Ne (Sub a c) (Sub b c))))
      ((union e (Ne a b))))

; (a + c) < (b + c) is a < b (no overflow assumed) - ONE-DIRECTIONAL
(rule ((= e (SLt (Add a c) (Add b c))))
      ((union e (SLt a b))))
(rule ((= e (SLe (Add a c) (Add b c))))
      ((union e (SLe a b))))
(rule ((= e (SGt (Add a c) (Add b c))))
      ((union e (SGt a b))))
(rule ((= e (SGe (Add a c) (Add b c))))
      ((union e (SGe a b))))

; =============================================================================
; Loop Invariant Comparisons
; =============================================================================
; Note: Eq, Ne, SLt, SLe, SGt, SGe, ULt, ULe, UGt, UGe are already in rvsdg.egg
; The rules there cover the basic comparisons

; =============================================================================
; Gamma Distribution for Comparisons
; =============================================================================

; select(c, a == x, a == y) = a == select(c, x, y) - ONE-DIRECTIONAL
; Eq/Ne/SLt/SLe/ULt/ULe take IntExpr operands and return BoolExpr.
; The outer Gamma has BoolExpr branches, so use GammaB.
; The inner Gamma selects IntExpr values, so use GammaI.
(rule ((= e (GammaB c (Eq a x) (Eq a y))))
      ((union e (Eq a (GammaI c x y)))))
(rule ((= e (GammaB c (Ne a x) (Ne a y))))
      ((union e (Ne a (GammaI c x y)))))
(rule ((= e (GammaB c (SLt a x) (SLt a y))))
      ((union e (SLt a (GammaI c x y)))))
(rule ((= e (GammaB c (SLe a x) (SLe a y))))
      ((union e (SLe a (GammaI c x y)))))
(rule ((= e (GammaB c (ULt a x) (ULt a y))))
      ((union e (ULt a (GammaI c x y)))))
(rule ((= e (GammaB c (ULe a x) (ULe a y))))
      ((union e (ULe a (GammaI c x y)))))

; =============================================================================
; Comparison after Bitwise Operations
; =============================================================================

; (x & mask) == 0 checks if bits in mask are clear
; (x | mask) != 0 is always true if mask != 0

; (x & 1) == 0 checks if x is even
; (x & 1) != 0 checks if x is odd

; =============================================================================
; Comparison after Arithmetic
; =============================================================================

; (x - y) == 0 is x == y - ONE-DIRECTIONAL
(rule ((= e (Eq (Sub x y) (Const 0))))
      ((union e (Eq x y))))
(rule ((= e (Ne (Sub x y) (Const 0))))
      ((union e (Ne x y))))

; (x + y) == 0 where y is constant becomes x == -y
; This is handled by constant propagation

; =============================================================================
; Zero/NonZero Comparisons
; =============================================================================

; x == 0 || y == 0 patterns
; These are common in graphics for avoiding division by zero

; LogNot of equality with zero is same as != 0 - ONE-DIRECTIONAL
(rule ((= e (LogNot (Eq x (Const 0)))))
      ((union e (Ne x (Const 0)))))
