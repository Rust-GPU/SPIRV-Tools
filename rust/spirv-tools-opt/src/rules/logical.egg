; =============================================================================
; Logical Rewrite Rules
; =============================================================================

; Identity rules - ONE-DIRECTIONAL to prevent e-graph explosion
(rule ((= e (LogNot (LogNot x))))
      ((union e x)))
(rule ((= e (LogAnd x x)))
      ((union e x)))
(rule ((= e (LogOr x x)))
      ((union e x)))
(rule ((= e (LogAnd x (Const 0))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (Const 0) x)))
      ((union e (Const 0))))
(rule ((= e (LogOr x (Const 0))))
      ((union e x)))
(rule ((= e (LogOr (Const 0) x)))
      ((union e x)))
(rule ((= e (LogAnd x (Const 1))))
      ((union e x)))
(rule ((= e (LogAnd (Const 1) x)))
      ((union e x)))
(rule ((= e (LogOr x (Const 1))))
      ((union e (Const 1))))
(rule ((= e (LogOr (Const 1) x)))
      ((union e (Const 1))))

; Logical complement
(rule ((= e (LogAnd x (LogNot x))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (LogNot x) x)))
      ((union e (Const 0))))
(rule ((= e (LogOr x (LogNot x))))
      ((union e (Const 1))))
(rule ((= e (LogOr (LogNot x) x)))
      ((union e (Const 1))))

; =============================================================================
; Select/If Rewrite Rules
; =============================================================================

; Select rules - ONE-DIRECTIONAL where RHS is simpler
(rule ((= e (Select (Const 0) t f)))
      ((union e f)))
(rule ((= e (Select (Const 1) t f)))
      ((union e t)))
(rule ((= e (Select c x x)))
      ((union e x)))
(rewrite (Select (LogNot c) t f) (Select c f t))
(rewrite (Select c (Select c a b) d) (Select c a d))
(rewrite (Select c d (Select c a b)) (Select c d b))

; If rules - ONE-DIRECTIONAL where RHS is simpler
(rule ((= e (If (Const 0) t f)))
      ((union e f)))
(rule ((= e (If (Const 1) t f)))
      ((union e t)))

; =============================================================================
; Min/Max Rewrite Rules
; =============================================================================

; Idempotent - ONE-DIRECTIONAL
(rule ((= e (SMin x x)))
      ((union e x)))
(rule ((= e (SMax x x)))
      ((union e x)))
(rule ((= e (UMin x x)))
      ((union e x)))
(rule ((= e (UMax x x)))
      ((union e x)))

; Commutative - REMOVED to prevent e-graph explosion
; These bidirectional rules cause cycles: (SMin a b) ↔ (SMin b a) ↔ ...
; Commutativity is handled implicitly by the e-graph when both forms are present

; Associative - ONE-DIRECTIONAL (right-associative canonical form)
; Only go from left-associative to right-associative, never back
(rule ((= e (SMin (SMin a b) c)))
      ((union e (SMin a (SMin b c)))))
(rule ((= e (SMax (SMax a b) c)))
      ((union e (SMax a (SMax b c)))))
(rule ((= e (UMin (UMin a b) c)))
      ((union e (UMin a (UMin b c)))))
(rule ((= e (UMax (UMax a b) c)))
      ((union e (UMax a (UMax b c)))))

; Min/Max with negation - ONE-DIRECTIONAL
; Only simplify negations OUT of Min/Max, never push them in
(rule ((= e (SMin (Neg a) (Neg b))))
      ((union e (Neg (SMax a b)))))
(rule ((= e (SMax (Neg a) (Neg b))))
      ((union e (Neg (SMin a b)))))

; =============================================================================
; De Morgan's Laws for Logical Operations - REMOVED
; =============================================================================
; De Morgan's laws are bidirectional in nature:
;   !(a && b) ↔ (!a || !b)
;   !(a || b) ↔ (!a && !b)
; These can cause explosion when combined with double negation elimination.
; Example: LogNot(LogAnd(a,b)) → LogOr(LogNot(a),LogNot(b))
;          But then LogOr absorbs into LogAnd via other rules, causing cycles.
; Better to handle these at extraction time or with specific patterns.

; =============================================================================
; Absorption Laws
; =============================================================================

; a && (a || b) = a - ONE-DIRECTIONAL
(rule ((= e (LogAnd a (LogOr a b))))
      ((union e a)))
(rule ((= e (LogAnd (LogOr a b) a)))
      ((union e a)))
(rule ((= e (LogAnd a (LogOr b a))))
      ((union e a)))
(rule ((= e (LogAnd (LogOr b a) a)))
      ((union e a)))

; a || (a && b) = a - ONE-DIRECTIONAL
(rule ((= e (LogOr a (LogAnd a b))))
      ((union e a)))
(rule ((= e (LogOr (LogAnd a b) a)))
      ((union e a)))
(rule ((= e (LogOr a (LogAnd b a))))
      ((union e a)))
(rule ((= e (LogOr (LogAnd b a) a)))
      ((union e a)))

; =============================================================================
; Complement Absorption
; =============================================================================

; a || (!a && b) = a || b
(rewrite (LogOr a (LogAnd (LogNot a) b)) (LogOr a b))
(rewrite (LogOr a (LogAnd b (LogNot a))) (LogOr a b))

; a && (!a || b) = a && b
(rewrite (LogAnd a (LogOr (LogNot a) b)) (LogAnd a b))
(rewrite (LogAnd a (LogOr b (LogNot a))) (LogAnd a b))

; =============================================================================
; XOR Logical Properties
; =============================================================================

; a XOR a = false (represented as 0)
(rule ((= e (LogNe a a)))
      ((union e (Const 0))))

; a XOR 0 = a - ONE-DIRECTIONAL
(rule ((= e (LogNe a (Const 0))))
      ((union e a)))
(rule ((= e (LogNe (Const 0) a)))
      ((union e a)))

; a XOR 1 = !a
(rewrite (LogNe a (Const 1)) (LogNot a))
(rewrite (LogNe (Const 1) a) (LogNot a))

; =============================================================================
; Min/Max Absorption and Distributivity
; =============================================================================

; min(a, max(a, b)) = a - ONE-DIRECTIONAL
(rule ((= e (SMin a (SMax a b))))
      ((union e a)))
(rule ((= e (SMin (SMax a b) a)))
      ((union e a)))
(rule ((= e (UMin a (UMax a b))))
      ((union e a)))
(rule ((= e (UMin (UMax a b) a)))
      ((union e a)))

; max(a, min(a, b)) = a - ONE-DIRECTIONAL
(rule ((= e (SMax a (SMin a b))))
      ((union e a)))
(rule ((= e (SMax (SMin a b) a)))
      ((union e a)))
(rule ((= e (UMax a (UMin a b))))
      ((union e a)))
(rule ((= e (UMax (UMin a b) a)))
      ((union e a)))

; min(min(a, b), b) = min(a, b)
(rewrite (SMin (SMin a b) b) (SMin a b))
(rewrite (SMin a (SMin a b)) (SMin a b))
(rewrite (UMin (UMin a b) b) (UMin a b))
(rewrite (UMin a (UMin a b)) (UMin a b))

; max(max(a, b), b) = max(a, b)
(rewrite (SMax (SMax a b) b) (SMax a b))
(rewrite (SMax a (SMax a b)) (SMax a b))
(rewrite (UMax (UMax a b) b) (UMax a b))
(rewrite (UMax a (UMax a b)) (UMax a b))

; =============================================================================
; Select with Boolean Simplifications
; =============================================================================

; select(true, a, b) = a - already in rules
; select(false, a, b) = b - already in rules

; select(c, true, false) = c (boolean to boolean) - ONE-DIRECTIONAL
(rule ((= e (Select c (Const 1) (Const 0))))
      ((union e c)))

; select(c, false, true) = !c
(rewrite (Select c (Const 0) (Const 1)) (LogNot c))

; select(c, a, a) = a - already in rules

; =============================================================================
; Conditional Distribution over Logical Ops
; =============================================================================

; select(c, a && b, a && d) = a && select(c, b, d)
(rewrite (Select c (LogAnd a b) (LogAnd a d)) (LogAnd a (Select c b d)))

; select(c, a || b, a || d) = a || select(c, b, d)
(rewrite (Select c (LogOr a b) (LogOr a d)) (LogOr a (Select c b d)))

; =============================================================================
; Loop Invariant Logical Rules
; =============================================================================
; Note: LogNot is in rvsdg.egg, SMin/SMax/UMin/UMax are in rvsdg.egg
; Here we add the ones not covered there

(rewrite (LogAnd (LoopInvariant a) (LoopInvariant b)) (LoopInvariant (LogAnd a b)))
(rewrite (LogOr (LoopInvariant a) (LoopInvariant b)) (LoopInvariant (LogOr a b)))
(rewrite (LogEq (LoopInvariant a) (LoopInvariant b)) (LoopInvariant (LogEq a b)))
(rewrite (LogNe (LoopInvariant a) (LoopInvariant b)) (LoopInvariant (LogNe a b)))

; =============================================================================
; Gamma with Logical Operations
; =============================================================================

; select(c, !a, !b) = !(select(c, a, b))
(rewrite (Gamma c (LogNot a) (LogNot b)) (LogNot (Gamma c a b)))

; select(c, a && x, b && x) = select(c, a, b) && x
(rewrite (Gamma c (LogAnd a x) (LogAnd b x)) (LogAnd (Gamma c a b) x))
(rewrite (Gamma c (LogOr a x) (LogOr b x)) (LogOr (Gamma c a b) x))

; select(c, min(a, x), min(b, x)) = min(select(c, a, b), x)
(rewrite (Gamma c (SMin a x) (SMin b x)) (SMin (Gamma c a b) x))
(rewrite (Gamma c (SMax a x) (SMax b x)) (SMax (Gamma c a b) x))
(rewrite (Gamma c (UMin a x) (UMin b x)) (UMin (Gamma c a b) x))
(rewrite (Gamma c (UMax a x) (UMax b x)) (UMax (Gamma c a b) x))

; =============================================================================
; Comparison Contradiction Rules (not in comparison.egg)
; =============================================================================
; These extend comparison.egg with floating-point and additional patterns

; (a < b) && (b < a) = false (contradiction)
(rule ((= e (LogAnd (SLt a b) (SLt b a))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (ULt a b) (ULt b a))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (FOrdLt a b) (FOrdLt b a))))
      ((union e (Const 0))))

; (a < b) && (b <= a) = false (contradiction)
(rule ((= e (LogAnd (SLt a b) (SLe b a))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (SLe b a) (SLt a b))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (ULt a b) (ULe b a))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (ULe b a) (ULt a b))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (FOrdLt a b) (FOrdLe b a))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (FOrdLe b a) (FOrdLt a b))))
      ((union e (Const 0))))

; (a > b) && (b > a) = false (contradiction)
(rule ((= e (LogAnd (SGt a b) (SGt b a))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (UGt a b) (UGt b a))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (FOrdGt a b) (FOrdGt b a))))
      ((union e (Const 0))))

; (a == b) && (a != b) = false (contradiction)
(rule ((= e (LogAnd (Eq a b) (Ne a b))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (Ne a b) (Eq a b))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (FOrdEq a b) (FOrdNe a b))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (FOrdNe a b) (FOrdEq a b))))
      ((union e (Const 0))))

; (a == b) && (a < b) = false (contradiction)
(rule ((= e (LogAnd (Eq a b) (SLt a b))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (SLt a b) (Eq a b))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (Eq a b) (ULt a b))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (ULt a b) (Eq a b))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (FOrdEq a b) (FOrdLt a b))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (FOrdLt a b) (FOrdEq a b))))
      ((union e (Const 0))))

; (a == b) && (a > b) = false (contradiction)
(rule ((= e (LogAnd (Eq a b) (SGt a b))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (SGt a b) (Eq a b))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (Eq a b) (UGt a b))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (UGt a b) (Eq a b))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (FOrdEq a b) (FOrdGt a b))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (FOrdGt a b) (FOrdEq a b))))
      ((union e (Const 0))))

; =============================================================================
; Comparison Tautologies (always true) - extends comparison.egg
; =============================================================================
; Note: Some of these are in comparison.egg, here we add the commuted versions

; (a <= b) || (b < a) = true (one must be true)
(rule ((= e (LogOr (SLe a b) (SLt b a))))
      ((union e (Const 1))))
(rule ((= e (LogOr (SLt b a) (SLe a b))))
      ((union e (Const 1))))
(rule ((= e (LogOr (ULe a b) (ULt b a))))
      ((union e (Const 1))))
(rule ((= e (LogOr (ULt b a) (ULe a b))))
      ((union e (Const 1))))

; (a <= b) || (a > b) = true
(rule ((= e (LogOr (SLe a b) (SGt a b))))
      ((union e (Const 1))))
(rule ((= e (LogOr (SGt a b) (SLe a b))))
      ((union e (Const 1))))
(rule ((= e (LogOr (ULe a b) (UGt a b))))
      ((union e (Const 1))))
(rule ((= e (LogOr (UGt a b) (ULe a b))))
      ((union e (Const 1))))

; (a == b) || (a != b) = true
(rule ((= e (LogOr (Eq a b) (Ne a b))))
      ((union e (Const 1))))
(rule ((= e (LogOr (Ne a b) (Eq a b))))
      ((union e (Const 1))))

; =============================================================================
; Comparison Redundancy Elimination
; =============================================================================

; (a < b) && (a <= b) = (a < b) (stricter condition wins)
(rule ((= e (LogAnd (SLt a b) (SLe a b))))
      ((union e (SLt a b))))
(rule ((= e (LogAnd (SLe a b) (SLt a b))))
      ((union e (SLt a b))))
(rule ((= e (LogAnd (ULt a b) (ULe a b))))
      ((union e (ULt a b))))
(rule ((= e (LogAnd (ULe a b) (ULt a b))))
      ((union e (ULt a b))))
(rule ((= e (LogAnd (FOrdLt a b) (FOrdLe a b))))
      ((union e (FOrdLt a b))))
(rule ((= e (LogAnd (FOrdLe a b) (FOrdLt a b))))
      ((union e (FOrdLt a b))))

; (a > b) && (a >= b) = (a > b) (stricter condition wins)
(rule ((= e (LogAnd (SGt a b) (SGe a b))))
      ((union e (SGt a b))))
(rule ((= e (LogAnd (SGe a b) (SGt a b))))
      ((union e (SGt a b))))
(rule ((= e (LogAnd (UGt a b) (UGe a b))))
      ((union e (UGt a b))))
(rule ((= e (LogAnd (UGe a b) (UGt a b))))
      ((union e (UGt a b))))
(rule ((= e (LogAnd (FOrdGt a b) (FOrdGe a b))))
      ((union e (FOrdGt a b))))
(rule ((= e (LogAnd (FOrdGe a b) (FOrdGt a b))))
      ((union e (FOrdGt a b))))

; (a < b) || (a <= b) = (a <= b) (weaker condition wins)
(rule ((= e (LogOr (SLt a b) (SLe a b))))
      ((union e (SLe a b))))
(rule ((= e (LogOr (SLe a b) (SLt a b))))
      ((union e (SLe a b))))
(rule ((= e (LogOr (ULt a b) (ULe a b))))
      ((union e (ULe a b))))
(rule ((= e (LogOr (ULe a b) (ULt a b))))
      ((union e (ULe a b))))
(rule ((= e (LogOr (FOrdLt a b) (FOrdLe a b))))
      ((union e (FOrdLe a b))))
(rule ((= e (LogOr (FOrdLe a b) (FOrdLt a b))))
      ((union e (FOrdLe a b))))

; (a > b) || (a >= b) = (a >= b) (weaker condition wins)
(rule ((= e (LogOr (SGt a b) (SGe a b))))
      ((union e (SGe a b))))
(rule ((= e (LogOr (SGe a b) (SGt a b))))
      ((union e (SGe a b))))
(rule ((= e (LogOr (UGt a b) (UGe a b))))
      ((union e (UGe a b))))
(rule ((= e (LogOr (UGe a b) (UGt a b))))
      ((union e (UGe a b))))
(rule ((= e (LogOr (FOrdGt a b) (FOrdGe a b))))
      ((union e (FOrdGe a b))))
(rule ((= e (LogOr (FOrdGe a b) (FOrdGt a b))))
      ((union e (FOrdGe a b))))

; =============================================================================
; Floating-Point Reflexive Comparisons (not in comparison.egg)
; =============================================================================

; Floating-point reflexive comparisons
(rule ((= e (FOrdLt a a)))
      ((union e (Const 0))))
(rule ((= e (FOrdGt a a)))
      ((union e (Const 0))))
(rule ((= e (FOrdLe a a)))
      ((union e (Const 1))))
(rule ((= e (FOrdGe a a)))
      ((union e (Const 1))))
(rule ((= e (FOrdEq a a)))
      ((union e (Const 1))))
(rule ((= e (FOrdNe a a)))
      ((union e (Const 0))))

; =============================================================================
; Comparison Transitivity (C++ Parity)
; =============================================================================
; Note: comparison.egg mentions these but doesn't fully implement them

; (a < b) && (b < c) => also (a < c)
(rule ((= e (LogAnd (SLt a b) (SLt b c))))
      ((union (SLt a c) (Const 1))))
(rule ((= e (LogAnd (ULt a b) (ULt b c))))
      ((union (ULt a c) (Const 1))))

; (a <= b) && (b <= c) => also (a <= c)
(rule ((= e (LogAnd (SLe a b) (SLe b c))))
      ((union (SLe a c) (Const 1))))
(rule ((= e (LogAnd (ULe a b) (ULe b c))))
      ((union (ULe a c) (Const 1))))

; (a < b) && (b <= c) => also (a < c)
(rule ((= e (LogAnd (SLt a b) (SLe b c))))
      ((union (SLt a c) (Const 1))))
(rule ((= e (LogAnd (ULt a b) (ULe b c))))
      ((union (ULt a c) (Const 1))))

; (a <= b) && (b < c) => also (a < c)
(rule ((= e (LogAnd (SLe a b) (SLt b c))))
      ((union (SLt a c) (Const 1))))
(rule ((= e (LogAnd (ULe a b) (ULt b c))))
      ((union (ULt a c) (Const 1))))
