; =============================================================================
; Logical Rewrite Rules
; =============================================================================

; Identity rules - ONE-DIRECTIONAL to prevent e-graph explosion
(rule ((= e (LogNot (LogNot x))))
      ((union e x)))
(rule ((= e (LogAnd x x)))
      ((union e x)))
(rule ((= e (LogOr x x)))
      ((union e x)))
; LogAnd with false: already in constant_folding.egg (BoolConst variant)
; LogOr with false (identity) - BoolConst variant
(rule ((= e (LogOr x (BoolConst 0))))
      ((union e x)))
(rule ((= e (LogOr (BoolConst 0) x)))
      ((union e x)))
; LogAnd with true (identity) - BoolConst variant
(rule ((= e (LogAnd x (BoolConst 1))))
      ((union e x)))
(rule ((= e (LogAnd (BoolConst 1) x)))
      ((union e x)))
; LogOr with true - BoolConst variant
(rule ((= e (LogOr x (BoolConst 1))))
      ((union e (BoolConst 1))))
(rule ((= e (LogOr (BoolConst 1) x)))
      ((union e (BoolConst 1))))

; Logical complement
(rule ((= e (LogAnd x (LogNot x))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (LogNot x) x)))
      ((union e (BoolConst 0))))
(rule ((= e (LogOr x (LogNot x))))
      ((union e (BoolConst 1))))
(rule ((= e (LogOr (LogNot x) x)))
      ((union e (BoolConst 1))))

; =============================================================================
; Select/If Rewrite Rules
; =============================================================================

; Select rules - ONE-DIRECTIONAL where RHS is simpler
(rule ((= e (Select (BoolConst 0) t f)))
      ((union e f)))
(rule ((= e (Select (BoolConst 1) t f)))
      ((union e t)))
(rule ((= e (Select c x x)))
      ((union e x)))
; Select with negated condition - ONE-DIRECTIONAL
(rule ((= e (Select (LogNot c) t f)))
      ((union e (Select c f t))))
; Nested Select simplification - ONE-DIRECTIONAL
(rule ((= e (Select c (Select c a b) d)))
      ((union e (Select c a d))))
(rule ((= e (Select c d (Select c a b))))
      ((union e (Select c d b))))

; If rules - ONE-DIRECTIONAL where RHS is simpler
(rule ((= e (If (BoolConst 0) t f)))
      ((union e f)))
(rule ((= e (If (BoolConst 1) t f)))
      ((union e t)))

; =============================================================================
; Min/Max Rewrite Rules
; =============================================================================

; Idempotent - ONE-DIRECTIONAL
(rule ((= e (SMin x x)))
      ((union e x)))
(rule ((= e (SMax x x)))
      ((union e x)))
(rule ((= e (UMin x x)))
      ((union e x)))
(rule ((= e (UMax x x)))
      ((union e x)))

; Commutative - REMOVED to prevent e-graph explosion
; These bidirectional rules cause cycles: (SMin a b) ↔ (SMin b a) ↔ ...
; Commutativity is handled implicitly by the e-graph when both forms are present

; Associative - ONE-DIRECTIONAL (right-associative canonical form)
; Only go from left-associative to right-associative, never back
(rule ((= e (SMin (SMin a b) c)))
      ((union e (SMin a (SMin b c)))))
(rule ((= e (SMax (SMax a b) c)))
      ((union e (SMax a (SMax b c)))))
(rule ((= e (UMin (UMin a b) c)))
      ((union e (UMin a (UMin b c)))))
(rule ((= e (UMax (UMax a b) c)))
      ((union e (UMax a (UMax b c)))))

; Min/Max with negation - ONE-DIRECTIONAL
; Only simplify negations OUT of Min/Max, never push them in
(rule ((= e (SMin (Neg a) (Neg b))))
      ((union e (Neg (SMax a b)))))
(rule ((= e (SMax (Neg a) (Neg b))))
      ((union e (Neg (SMin a b)))))

; =============================================================================
; De Morgan's Laws for Logical Operations - REMOVED
; =============================================================================
; De Morgan's laws are bidirectional in nature:
;   !(a && b) ↔ (!a || !b)
;   !(a || b) ↔ (!a && !b)
; These can cause explosion when combined with double negation elimination.
; Example: LogNot(LogAnd(a,b)) → LogOr(LogNot(a),LogNot(b))
;          But then LogOr absorbs into LogAnd via other rules, causing cycles.
; Better to handle these at extraction time or with specific patterns.

; =============================================================================
; Absorption Laws
; =============================================================================

; a && (a || b) = a - ONE-DIRECTIONAL
(rule ((= e (LogAnd a (LogOr a b))))
      ((union e a)))
(rule ((= e (LogAnd (LogOr a b) a)))
      ((union e a)))
(rule ((= e (LogAnd a (LogOr b a))))
      ((union e a)))
(rule ((= e (LogAnd (LogOr b a) a)))
      ((union e a)))

; a || (a && b) = a - ONE-DIRECTIONAL
(rule ((= e (LogOr a (LogAnd a b))))
      ((union e a)))
(rule ((= e (LogOr (LogAnd a b) a)))
      ((union e a)))
(rule ((= e (LogOr a (LogAnd b a))))
      ((union e a)))
(rule ((= e (LogOr (LogAnd b a) a)))
      ((union e a)))

; =============================================================================
; Complement Absorption
; =============================================================================

; a || (!a && b) = a || b - ONE-DIRECTIONAL
(rule ((= e (LogOr a (LogAnd (LogNot a) b))))
      ((union e (LogOr a b))))
(rule ((= e (LogOr a (LogAnd b (LogNot a)))))
      ((union e (LogOr a b))))

; a && (!a || b) = a && b - ONE-DIRECTIONAL
(rule ((= e (LogAnd a (LogOr (LogNot a) b))))
      ((union e (LogAnd a b))))
(rule ((= e (LogAnd a (LogOr b (LogNot a)))))
      ((union e (LogAnd a b))))

; =============================================================================
; XOR Logical Properties
; =============================================================================

; a XOR a = false (represented as BoolConst 0)
(rule ((= e (LogNe a a)))
      ((union e (BoolConst 0))))

; a XOR 0 = a - ONE-DIRECTIONAL (BoolConst variant)
(rule ((= e (LogNe a (BoolConst 0))))
      ((union e a)))
(rule ((= e (LogNe (BoolConst 0) a)))
      ((union e a)))

; a XOR 1 = !a - ONE-DIRECTIONAL (BoolConst variant)
(rule ((= e (LogNe a (BoolConst 1))))
      ((union e (LogNot a))))
(rule ((= e (LogNe (BoolConst 1) a)))
      ((union e (LogNot a))))

; =============================================================================
; Min/Max Absorption and Distributivity
; =============================================================================

; min(a, max(a, b)) = a - ONE-DIRECTIONAL
(rule ((= e (SMin a (SMax a b))))
      ((union e a)))
(rule ((= e (SMin (SMax a b) a)))
      ((union e a)))
(rule ((= e (UMin a (UMax a b))))
      ((union e a)))
(rule ((= e (UMin (UMax a b) a)))
      ((union e a)))

; max(a, min(a, b)) = a - ONE-DIRECTIONAL
(rule ((= e (SMax a (SMin a b))))
      ((union e a)))
(rule ((= e (SMax (SMin a b) a)))
      ((union e a)))
(rule ((= e (UMax a (UMin a b))))
      ((union e a)))
(rule ((= e (UMax (UMin a b) a)))
      ((union e a)))

; min(min(a, b), b) = min(a, b) - ONE-DIRECTIONAL
(rule ((= e (SMin (SMin a b) b)))
      ((union e (SMin a b))))
(rule ((= e (SMin a (SMin a b))))
      ((union e (SMin a b))))
(rule ((= e (UMin (UMin a b) b)))
      ((union e (UMin a b))))
(rule ((= e (UMin a (UMin a b))))
      ((union e (UMin a b))))

; max(max(a, b), b) = max(a, b) - ONE-DIRECTIONAL
(rule ((= e (SMax (SMax a b) b)))
      ((union e (SMax a b))))
(rule ((= e (SMax a (SMax a b))))
      ((union e (SMax a b))))
(rule ((= e (UMax (UMax a b) b)))
      ((union e (UMax a b))))
(rule ((= e (UMax a (UMax a b))))
      ((union e (UMax a b))))

; =============================================================================
; Select with Boolean Simplifications
; =============================================================================

; select(true, a, b) = a - already in rules
; select(false, a, b) = b - already in rules

; select(c, true, false) = c (boolean to boolean) - ONE-DIRECTIONAL
; Branches are BoolExpr, so use SelectB
(rule ((= e (SelectB c (BoolConst 1) (BoolConst 0))))
      ((union e c)))

; select(c, false, true) = !c - ONE-DIRECTIONAL
; Branches are BoolExpr, so use SelectB
(rule ((= e (SelectB c (BoolConst 0) (BoolConst 1))))
      ((union e (LogNot c))))

; select(c, a, a) = a - already in rules

; =============================================================================
; Conditional Distribution over Logical Ops
; =============================================================================

; select(c, a && b, a && d) = a && select(c, b, d) - ONE-DIRECTIONAL
; Branches are BoolExpr, so use SelectB/GammaB
(rule ((= e (SelectB c (LogAnd a b) (LogAnd a d))))
      ((union e (LogAnd a (SelectB c b d)))))

; select(c, a || b, a || d) = a || select(c, b, d) - ONE-DIRECTIONAL
; Branches are BoolExpr, so use SelectB/GammaB
(rule ((= e (SelectB c (LogOr a b) (LogOr a d))))
      ((union e (LogOr a (SelectB c b d)))))

; =============================================================================
; Loop Invariant Logical Rules
; =============================================================================
; Note: LogNot is in rvsdg.egg, SMin/SMax/UMin/UMax are in rvsdg.egg
; Here we add the ones not covered there

; Loop invariant rules - ONE-DIRECTIONAL
; LogAnd/LogOr/LogEq/LogNe operate on BoolExpr, so use LoopInvariantB
(rule ((= e (LogAnd (LoopInvariantB a) (LoopInvariantB b))))
      ((union e (LoopInvariantB (LogAnd a b)))))
(rule ((= e (LogOr (LoopInvariantB a) (LoopInvariantB b))))
      ((union e (LoopInvariantB (LogOr a b)))))
(rule ((= e (LogEq (LoopInvariantB a) (LoopInvariantB b))))
      ((union e (LoopInvariantB (LogEq a b)))))
(rule ((= e (LogNe (LoopInvariantB a) (LoopInvariantB b))))
      ((union e (LoopInvariantB (LogNe a b)))))

; =============================================================================
; Gamma with Logical Operations
; =============================================================================

; select(c, !a, !b) = !(select(c, a, b)) - ONE-DIRECTIONAL
; Branches are BoolExpr, so use GammaB
(rule ((= e (GammaB c (LogNot a) (LogNot b))))
      ((union e (LogNot (GammaB c a b)))))

; select(c, a && x, b && x) = select(c, a, b) && x - ONE-DIRECTIONAL
; Branches are BoolExpr, so use GammaB
(rule ((= e (GammaB c (LogAnd a x) (LogAnd b x))))
      ((union e (LogAnd (GammaB c a b) x))))
(rule ((= e (GammaB c (LogOr a x) (LogOr b x))))
      ((union e (LogOr (GammaB c a b) x))))

; select(c, min(a, x), min(b, x)) = min(select(c, a, b), x) - ONE-DIRECTIONAL
; SMin/SMax/UMin/UMax operate on IntExpr, so use GammaI
(rule ((= e (GammaI c (SMin a x) (SMin b x))))
      ((union e (SMin (GammaI c a b) x))))
(rule ((= e (GammaI c (SMax a x) (SMax b x))))
      ((union e (SMax (GammaI c a b) x))))
(rule ((= e (GammaI c (UMin a x) (UMin b x))))
      ((union e (UMin (GammaI c a b) x))))
(rule ((= e (GammaI c (UMax a x) (UMax b x))))
      ((union e (UMax (GammaI c a b) x))))

; =============================================================================
; Comparison Contradiction Rules (not in comparison.egg)
; =============================================================================
; These extend comparison.egg with floating-point and additional patterns

; (a < b) && (b < a) = false (contradiction)
(rule ((= e (LogAnd (SLt a b) (SLt b a))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (ULt a b) (ULt b a))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (FOrdLt a b) (FOrdLt b a))))
      ((union e (BoolConst 0))))

; (a < b) && (b <= a) = false (contradiction)
(rule ((= e (LogAnd (SLt a b) (SLe b a))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (SLe b a) (SLt a b))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (ULt a b) (ULe b a))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (ULe b a) (ULt a b))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (FOrdLt a b) (FOrdLe b a))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (FOrdLe b a) (FOrdLt a b))))
      ((union e (BoolConst 0))))

; (a > b) && (b > a) = false (contradiction)
(rule ((= e (LogAnd (SGt a b) (SGt b a))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (UGt a b) (UGt b a))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (FOrdGt a b) (FOrdGt b a))))
      ((union e (BoolConst 0))))

; (a == b) && (a != b) = false (contradiction)
(rule ((= e (LogAnd (Eq a b) (Ne a b))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (Ne a b) (Eq a b))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (FOrdEq a b) (FOrdNe a b))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (FOrdNe a b) (FOrdEq a b))))
      ((union e (BoolConst 0))))

; (a == b) && (a < b) = false (contradiction)
(rule ((= e (LogAnd (Eq a b) (SLt a b))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (SLt a b) (Eq a b))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (Eq a b) (ULt a b))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (ULt a b) (Eq a b))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (FOrdEq a b) (FOrdLt a b))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (FOrdLt a b) (FOrdEq a b))))
      ((union e (BoolConst 0))))

; (a == b) && (a > b) = false (contradiction)
(rule ((= e (LogAnd (Eq a b) (SGt a b))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (SGt a b) (Eq a b))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (Eq a b) (UGt a b))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (UGt a b) (Eq a b))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (FOrdEq a b) (FOrdGt a b))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (FOrdGt a b) (FOrdEq a b))))
      ((union e (BoolConst 0))))

; =============================================================================
; Comparison Tautologies (always true) - extends comparison.egg
; =============================================================================
; Note: Some of these are in comparison.egg, here we add the commuted versions

; (a <= b) || (b < a) = true (one must be true)
(rule ((= e (LogOr (SLe a b) (SLt b a))))
      ((union e (BoolConst 1))))
(rule ((= e (LogOr (SLt b a) (SLe a b))))
      ((union e (BoolConst 1))))
(rule ((= e (LogOr (ULe a b) (ULt b a))))
      ((union e (BoolConst 1))))
(rule ((= e (LogOr (ULt b a) (ULe a b))))
      ((union e (BoolConst 1))))

; (a <= b) || (a > b) = true
(rule ((= e (LogOr (SLe a b) (SGt a b))))
      ((union e (BoolConst 1))))
(rule ((= e (LogOr (SGt a b) (SLe a b))))
      ((union e (BoolConst 1))))
(rule ((= e (LogOr (ULe a b) (UGt a b))))
      ((union e (BoolConst 1))))
(rule ((= e (LogOr (UGt a b) (ULe a b))))
      ((union e (BoolConst 1))))

; (a == b) || (a != b) = true
(rule ((= e (LogOr (Eq a b) (Ne a b))))
      ((union e (BoolConst 1))))
(rule ((= e (LogOr (Ne a b) (Eq a b))))
      ((union e (BoolConst 1))))

; =============================================================================
; Comparison Redundancy Elimination
; =============================================================================

; (a < b) && (a <= b) = (a < b) (stricter condition wins)
(rule ((= e (LogAnd (SLt a b) (SLe a b))))
      ((union e (SLt a b))))
(rule ((= e (LogAnd (SLe a b) (SLt a b))))
      ((union e (SLt a b))))
(rule ((= e (LogAnd (ULt a b) (ULe a b))))
      ((union e (ULt a b))))
(rule ((= e (LogAnd (ULe a b) (ULt a b))))
      ((union e (ULt a b))))
(rule ((= e (LogAnd (FOrdLt a b) (FOrdLe a b))))
      ((union e (FOrdLt a b))))
(rule ((= e (LogAnd (FOrdLe a b) (FOrdLt a b))))
      ((union e (FOrdLt a b))))

; (a > b) && (a >= b) = (a > b) (stricter condition wins)
(rule ((= e (LogAnd (SGt a b) (SGe a b))))
      ((union e (SGt a b))))
(rule ((= e (LogAnd (SGe a b) (SGt a b))))
      ((union e (SGt a b))))
(rule ((= e (LogAnd (UGt a b) (UGe a b))))
      ((union e (UGt a b))))
(rule ((= e (LogAnd (UGe a b) (UGt a b))))
      ((union e (UGt a b))))
(rule ((= e (LogAnd (FOrdGt a b) (FOrdGe a b))))
      ((union e (FOrdGt a b))))
(rule ((= e (LogAnd (FOrdGe a b) (FOrdGt a b))))
      ((union e (FOrdGt a b))))

; (a < b) || (a <= b) = (a <= b) (weaker condition wins)
(rule ((= e (LogOr (SLt a b) (SLe a b))))
      ((union e (SLe a b))))
(rule ((= e (LogOr (SLe a b) (SLt a b))))
      ((union e (SLe a b))))
(rule ((= e (LogOr (ULt a b) (ULe a b))))
      ((union e (ULe a b))))
(rule ((= e (LogOr (ULe a b) (ULt a b))))
      ((union e (ULe a b))))
(rule ((= e (LogOr (FOrdLt a b) (FOrdLe a b))))
      ((union e (FOrdLe a b))))
(rule ((= e (LogOr (FOrdLe a b) (FOrdLt a b))))
      ((union e (FOrdLe a b))))

; (a > b) || (a >= b) = (a >= b) (weaker condition wins)
(rule ((= e (LogOr (SGt a b) (SGe a b))))
      ((union e (SGe a b))))
(rule ((= e (LogOr (SGe a b) (SGt a b))))
      ((union e (SGe a b))))
(rule ((= e (LogOr (UGt a b) (UGe a b))))
      ((union e (UGe a b))))
(rule ((= e (LogOr (UGe a b) (UGt a b))))
      ((union e (UGe a b))))
(rule ((= e (LogOr (FOrdGt a b) (FOrdGe a b))))
      ((union e (FOrdGe a b))))
(rule ((= e (LogOr (FOrdGe a b) (FOrdGt a b))))
      ((union e (FOrdGe a b))))

; =============================================================================
; Floating-Point Reflexive Comparisons (not in comparison.egg)
; =============================================================================

; Floating-point reflexive comparisons
(rule ((= e (FOrdLt a a)))
      ((union e (BoolConst 0))))
(rule ((= e (FOrdGt a a)))
      ((union e (BoolConst 0))))
(rule ((= e (FOrdLe a a)))
      ((union e (BoolConst 1))))
(rule ((= e (FOrdGe a a)))
      ((union e (BoolConst 1))))
(rule ((= e (FOrdEq a a)))
      ((union e (BoolConst 1))))
(rule ((= e (FOrdNe a a)))
      ((union e (BoolConst 0))))

; =============================================================================
; Comparison Transitivity (C++ Parity)
; =============================================================================
; Note: comparison.egg mentions these but doesn't fully implement them

; (a < b) && (b < c) => also (a < c)
(rule ((= e (LogAnd (SLt a b) (SLt b c))))
      ((union (SLt a c) (BoolConst 1))))
(rule ((= e (LogAnd (ULt a b) (ULt b c))))
      ((union (ULt a c) (BoolConst 1))))

; (a <= b) && (b <= c) => also (a <= c)
(rule ((= e (LogAnd (SLe a b) (SLe b c))))
      ((union (SLe a c) (BoolConst 1))))
(rule ((= e (LogAnd (ULe a b) (ULe b c))))
      ((union (ULe a c) (BoolConst 1))))

; (a < b) && (b <= c) => also (a < c)
(rule ((= e (LogAnd (SLt a b) (SLe b c))))
      ((union (SLt a c) (BoolConst 1))))
(rule ((= e (LogAnd (ULt a b) (ULe b c))))
      ((union (ULt a c) (BoolConst 1))))

; (a <= b) && (b < c) => also (a < c)
(rule ((= e (LogAnd (SLe a b) (SLt b c))))
      ((union (SLt a c) (BoolConst 1))))
(rule ((= e (LogAnd (ULe a b) (ULt b c))))
      ((union (ULt a c) (BoolConst 1))))

; =============================================================================
; LogAnd/LogOr with GammaB Identity Patterns
; =============================================================================
; These patterns optimize logical operations combined with conditionals.
; Since LogAnd/LogOr operate on BoolExpr and branches are BoolExpr, use GammaB.

; c && select(c, a, b) = c && a (if c is true, we pick a; if false, result is false anyway)
(rule ((= e (LogAnd c (GammaB c a b))))
      ((union e (LogAnd c a))))
(rule ((= e (LogAnd (GammaB c a b) c)))
      ((union e (LogAnd c a))))

; !c && select(c, a, b) = !c && b (if c is false, we pick b)
(rule ((= e (LogAnd (LogNot c) (GammaB c a b))))
      ((union e (LogAnd (LogNot c) b))))
(rule ((= e (LogAnd (GammaB c a b) (LogNot c))))
      ((union e (LogAnd (LogNot c) b))))

; c || select(c, a, b) = c || b (if c is true, result is true; if false, pick b)
(rule ((= e (LogOr c (GammaB c a b))))
      ((union e (LogOr c b))))
(rule ((= e (LogOr (GammaB c a b) c)))
      ((union e (LogOr c b))))

; !c || select(c, a, b) = !c || a
(rule ((= e (LogOr (LogNot c) (GammaB c a b))))
      ((union e (LogOr (LogNot c) a))))
(rule ((= e (LogOr (GammaB c a b) (LogNot c))))
      ((union e (LogOr (LogNot c) a))))

; =============================================================================
; Additional Boolean Gamma Patterns
; =============================================================================

; select(c, c && a, false) = c && a (proved by truth table)
; Branches are BoolExpr, so use GammaB
(rule ((= e (GammaB c (LogAnd c a) (BoolConst 0))))
      ((union e (LogAnd c a))))

; select(c, c || a, true) = true (c true means c||a=true; c false means result is true)
; Branches are BoolExpr, so use GammaB
(rule ((= e (GammaB c (LogOr c a) (BoolConst 1))))
      ((union e (BoolConst 1))))

; select(c, !c, true) = !c
; Branches are BoolExpr, so use GammaB
(rule ((= e (GammaB c (LogNot c) (BoolConst 1))))
      ((union e (LogNot c))))

; =============================================================================
; Logical Operation Gamma Fusion
; =============================================================================

; select(c, a, b) && select(c, x, y) = select(c, a && x, b && y)
; Branches are BoolExpr, so use GammaB
(rule ((= e (LogAnd (GammaB c a b) (GammaB c x y))))
      ((union e (GammaB c (LogAnd a x) (LogAnd b y)))))

; select(c, a, b) || select(c, x, y) = select(c, a || x, b || y)
; Branches are BoolExpr, so use GammaB
(rule ((= e (LogOr (GammaB c a b) (GammaB c x y))))
      ((union e (GammaB c (LogOr a x) (LogOr b y)))))

; =============================================================================
; Comparison with Shift Patterns
; =============================================================================

; (x << n) == 0 is same as (x & mask) == 0 where mask has high bits
; But simpler: (x << n) == 0 implies x has no bits in positions that survive shift
; For n >= 32, (x << n) is 0 (for 32-bit), so comparison is always true
; We don't have bit width info, so skip those

; (x >> n) == 0 for unsigned: x has no bits in high positions (x < 2^(32-n))
; (x >> 1) == 0 means x < 2, i.e., x is 0 or 1
; These don't simplify nicely without value range analysis

; (x << n) != 0 when we know x != 0 and n < 32
; Can't express without more type info

; x == (x << 0) is always true (shift by 0 is identity, but identity rules handle this)
; x == (x >> 0) is always true

; =============================================================================
; Zero Extension/Sign Extension Comparison Patterns
; =============================================================================

; Comparing bit-extracted values
; (x & 0xFF) < 256 is always true (byte comparison)
(rule ((= e (ULt (BitAnd x (Const 255)) (Const 256))))
      ((union e (BoolConst 1))))
(rule ((= e (ULe (BitAnd x (Const 255)) (Const 255))))
      ((union e (BoolConst 1))))
(rule ((= e (ULt (BitAnd x (Const 65535)) (Const 65536))))
      ((union e (BoolConst 1))))
(rule ((= e (ULe (BitAnd x (Const 65535)) (Const 65535))))
      ((union e (BoolConst 1))))

; (x & mask) >= 0 is always true for unsigned (handled by UGe x 0 rule)

; =============================================================================
; Comparison with Masked Values
; =============================================================================

; (x & 1) == 0 || (x & 1) == 1 is always true (covers all cases)
(rule ((= e (LogOr (Eq (BitAnd x (Const 1)) (Const 0)) (Eq (BitAnd x (Const 1)) (Const 1)))))
      ((union e (BoolConst 1))))

; (x & 1) == 0 && (x & 1) == 1 is always false (contradiction)
(rule ((= e (LogAnd (Eq (BitAnd x (Const 1)) (Const 0)) (Eq (BitAnd x (Const 1)) (Const 1)))))
      ((union e (BoolConst 0))))

; (x & 1) != 0 is same as (x & 1) == 1 for single bit
(rule ((= e (Ne (BitAnd x (Const 1)) (Const 0))))
      ((union e (Eq (BitAnd x (Const 1)) (Const 1)))))

; (x & 1) != 1 is same as (x & 1) == 0 for single bit
(rule ((= e (Ne (BitAnd x (Const 1)) (Const 1))))
      ((union e (Eq (BitAnd x (Const 1)) (Const 0)))))
