; =============================================================================
; Bridge Liveness Propagation
; =============================================================================

(rule ((Live e) (= e (IntToExpr x))) ((LiveI x)))
(rule ((Live e) (= e (FloatToExpr x))) ((LiveF x)))
(rule ((Live e) (= e (BoolToExpr x))) ((LiveB x)))

; =============================================================================
; Expr Liveness Propagation
; =============================================================================

; Generic control flow
(rule ((Live e) (= e (Gamma c t f))) ((LiveB c) (Live t) (Live f)))
(rule ((Live e) (= e (Select c t f))) ((LiveB c) (Live t) (Live f)))
(rule ((Live e) (= e (If c t f))) ((LiveB c) (Live t) (Live f)))
(rule ((Live e) (= e (Theta c body init))) ((LiveB c) (Live body) (Live init)))
(rule ((Live e) (= e (LoopVar))) ())
(rule ((Live e) (= e (LoopInvariant x))) ((Live x)))
(rule ((Live e) (= e (Sym _))) ())
(rule ((Live e) (= e (CopyObject x))) ((Live x)))
(rule ((Live e) (= e (Undef))) ())
(rule ((Live e) (= e (Arg _))) ())

