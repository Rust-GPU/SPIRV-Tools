(constructor VecBroadcast4 (Expr) Expr)

; ShuffleExtract — helper to extract element from either source of a shuffle
; ShuffleExtract(v1, v2, index) picks from v1 if index < VecSize(v1), else v2
(constructor ShuffleExtract (Expr Expr i64) Expr)

; VecSize — tracks the number of components in a vector expression
(function VecSize (Expr) i64 :merge (min old new))

