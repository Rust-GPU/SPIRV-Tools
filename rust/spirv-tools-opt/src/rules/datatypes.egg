(rule ((LiveI e) (= e (RotL a b))) ((LiveI a) (LiveI b)))
(rule ((LiveI e) (= e (RotR a b))) ((LiveI a) (LiveI b)))
(rule ((LiveI e) (= e (SMin a b))) ((LiveI a) (LiveI b)))
(rule ((LiveI e) (= e (SMax a b))) ((LiveI a) (LiveI b)))
(rule ((LiveI e) (= e (UMin a b))) ((LiveI a) (LiveI b)))
(rule ((LiveI e) (= e (UMax a b))) ((LiveI a) (LiveI b)))
(rule ((LiveI e) (= e (SAbs a))) ((LiveI a)))
(rule ((LiveI e) (= e (Sign a))) ((LiveI a)))
(rule ((LiveI e) (= e (FindILsb a))) ((LiveI a)))
(rule ((LiveI e) (= e (FindSMsb a))) ((LiveI a)))
(rule ((LiveI e) (= e (FindUMsb a))) ((LiveI a)))
