(constructor FEq (FloatExpr FloatExpr) BoolExpr)
(constructor FNe (FloatExpr FloatExpr) BoolExpr)
(constructor FLt (FloatExpr FloatExpr) BoolExpr)
(constructor FLe (FloatExpr FloatExpr) BoolExpr)
(constructor FGt (FloatExpr FloatExpr) BoolExpr)
(constructor FGe (FloatExpr FloatExpr) BoolExpr)

