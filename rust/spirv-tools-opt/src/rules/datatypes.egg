(constructor LogOr (BoolExpr BoolExpr) BoolExpr)
(constructor LogEq (BoolExpr BoolExpr) BoolExpr)
(constructor LogNe (BoolExpr BoolExpr) BoolExpr)

; Constants
(constructor BoolConst (i64) BoolExpr)

; Typed control flow
(constructor BSym (String) BoolExpr)
(constructor GammaB (BoolExpr BoolExpr BoolExpr) BoolExpr)
(constructor SelectB (BoolExpr BoolExpr BoolExpr) BoolExpr)
(constructor IfB (BoolExpr BoolExpr BoolExpr) BoolExpr)
(constructor ThetaB (BoolExpr BoolExpr BoolExpr) BoolExpr)
(constructor LoopVarB () BoolExpr)
(constructor LoopInvariantB (BoolExpr) BoolExpr)
(constructor CopyB (BoolExpr) BoolExpr)

; Subgroup boolean operations
(constructor GroupElect () BoolExpr)
(constructor GroupAll (BoolExpr) BoolExpr)
