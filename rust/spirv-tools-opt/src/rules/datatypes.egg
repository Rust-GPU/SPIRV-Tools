; =============================================================================
; RVSDG Region Types
; =============================================================================

(datatype ExprList
    (ENil)
    (ECons Expr ExprList)
)

; =============================================================================
; Additional Constructors Using ExprList
; =============================================================================

(function VecShuffle (Expr Expr ExprList) Expr :merge old)
(function CompositeConstruct (ExprList) Expr :merge old)
(function CompositeExtract (Expr i64) Expr :merge old)
(function CompositeInsert (Expr Expr i64) Expr :merge old)
(function Switch (Expr ExprList Expr) Expr :merge old)
(function Case (Expr Expr) Expr :merge old)
(function BinarySwitch (Expr ExprList Expr) Expr :merge old)

; CompositeExtract from CompositeConstruct rules
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ENil))) 0)))
      ((union e a)))
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ECons b (ENil)))) 0)))
      ((union e a)))
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ECons b (ENil)))) 1)))
      ((union e b)))
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ECons b (ECons c (ENil))))) 0)))
      ((union e a)))
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ECons b (ECons c (ENil))))) 1)))
      ((union e b)))
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ECons b (ECons c (ENil))))) 2)))
      ((union e c)))
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ECons b (ECons c (ECons d (ENil)))))) 0)))
      ((union e a)))
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ECons b (ECons c (ECons d (ENil)))))) 1)))
      ((union e b)))
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ECons b (ECons c (ECons d (ENil)))))) 2)))
      ((union e c)))
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ECons b (ECons c (ECons d (ENil)))))) 3)))
      ((union e d)))

; =============================================================================
; CompositeInsert Optimization
; =============================================================================

; Insert then extract at same index returns inserted value
(rule ((= e (CompositeExtract (CompositeInsert composite val 0) 0)))
      ((union e val)))
(rule ((= e (CompositeExtract (CompositeInsert composite val 1) 1)))
      ((union e val)))
(rule ((= e (CompositeExtract (CompositeInsert composite val 2) 2)))
      ((union e val)))
(rule ((= e (CompositeExtract (CompositeInsert composite val 3) 3)))
      ((union e val)))

; Insert then extract at different index returns extraction from original
(rule ((= outer (CompositeExtract (CompositeInsert composite val 0) 1))
       (= inner (CompositeExtract composite 1)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 0) 2))
       (= inner (CompositeExtract composite 2)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 0) 3))
       (= inner (CompositeExtract composite 3)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 1) 0))
       (= inner (CompositeExtract composite 0)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 1) 2))
       (= inner (CompositeExtract composite 2)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 1) 3))
       (= inner (CompositeExtract composite 3)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 2) 0))
       (= inner (CompositeExtract composite 0)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 2) 1))
       (= inner (CompositeExtract composite 1)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 2) 3))
       (= inner (CompositeExtract composite 3)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 3) 0))
       (= inner (CompositeExtract composite 0)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 3) 1))
       (= inner (CompositeExtract composite 1)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 3) 2))
       (= inner (CompositeExtract composite 2)))
      ((union outer inner)))

; Inserting value extracted from same position is identity
(rule ((= e (CompositeInsert composite (CompositeExtract composite 0) 0)))
      ((union e composite)))
(rule ((= e (CompositeInsert composite (CompositeExtract composite 1) 1)))
      ((union e composite)))
(rule ((= e (CompositeInsert composite (CompositeExtract composite 2) 2)))
      ((union e composite)))
(rule ((= e (CompositeInsert composite (CompositeExtract composite 3) 3)))
      ((union e composite)))

; =============================================================================
; CompositeExtractFeedingConstruct
; =============================================================================

(rule ((= e (CompositeConstruct (ECons (CompositeExtract v 0) (ECons (CompositeExtract v 1) (ENil))))))
      ((union e v)))
(rule ((= e (CompositeConstruct (ECons (CompositeExtract v 0) (ECons (CompositeExtract v 1) (ECons (CompositeExtract v 2) (ENil)))))))
      ((union e v)))
(rule ((= e (CompositeConstruct (ECons (CompositeExtract v 0) (ECons (CompositeExtract v 1) (ECons (CompositeExtract v 2) (ECons (CompositeExtract v 3) (ENil))))))))
      ((union e v)))

(rule ((= e (Vec2 (CompositeExtract v 0) (CompositeExtract v 1))))
      ((union e v)))
(rule ((= e (Vec3 (CompositeExtract v 0) (CompositeExtract v 1) (CompositeExtract v 2))))
      ((union e v)))
(rule ((= e (Vec4 (CompositeExtract v 0) (CompositeExtract v 1) (CompositeExtract v 2) (CompositeExtract v 3))))
      ((union e v)))
(rule ((= e (Vec2 (VecExtract v 0) (VecExtract v 1))))
      ((union e v)))
(rule ((= e (Vec3 (VecExtract v 0) (VecExtract v 1) (VecExtract v 2))))
      ((union e v)))
(rule ((= e (Vec4 (VecExtract v 0) (VecExtract v 1) (VecExtract v 2) (VecExtract v 3))))
      ((union e v)))

; =============================================================================
; Undef Optimization Rules
; =============================================================================

(rule ((= e (CompositeExtract (Undef) _)))
      ((union e (Undef))))
(rule ((= e (VecExtract (Undef) _)))
      ((union e (Undef))))

; CopyObject/Copy elimination (rules for typed operations like Mul*0, BitAnd*0, etc.
; are in their respective rule files: arithmetic.egg, bitwise.egg, logical.egg)
(rule ((= e (CopyObject x))) ((union e x)))
(rule ((= e (CopyI x))) ((union e x)))
(rule ((= e (CopyF x))) ((union e x)))
(rule ((= e (CopyB x))) ((union e x)))

; =============================================================================
; Insert-to-Construct Transformation
; =============================================================================

(rule ((= result (CompositeInsert (CompositeInsert _ v0 0) v1 1)))
      ((union result (Vec2 v0 v1))))
(rule ((= result (CompositeInsert (CompositeInsert (CompositeInsert _ v0 0) v1 1) v2 2)))
      ((union result (Vec3 v0 v1 v2))))
(rule ((= result (CompositeInsert (CompositeInsert (CompositeInsert (CompositeInsert _ v0 0) v1 1) v2 2) v3 3)))
      ((union result (Vec4 v0 v1 v2 v3))))

(rule ((= result (VecInsert (VecInsert _ v0 0) v1 1)))
      ((union result (Vec2 v0 v1))))
(rule ((= result (VecInsert (VecInsert (VecInsert _ v0 0) v1 1) v2 2)))
      ((union result (Vec3 v0 v1 v2))))
(rule ((= result (VecInsert (VecInsert (VecInsert (VecInsert _ v0 0) v1 1) v2 2) v3 3)))
      ((union result (Vec4 v0 v1 v2 v3))))

; =============================================================================
; Effect Sort (side effects and control flow)
; =============================================================================

(datatype Effect
    (Pure)
    (Return)
    (ReturnValue Expr)
    (Seq Effect Effect)
    (EffGamma BoolExpr Effect Effect)
    (Unreachable)
)

; =============================================================================
; Liveness Tracking for DCE
; =============================================================================

(relation Root (Effect))
(relation Live (Expr))
(relation LiveI (IntExpr))
(relation LiveF (FloatExpr))
(relation LiveB (BoolExpr))

; Forward declarations for condition analysis
(relation CanBeTrue (BoolExpr))
(relation CanBeFalse (BoolExpr))

; =============================================================================
; Root Effects propagate liveness
; =============================================================================

(rule ((Root e) (= e (ReturnValue x))) ((Live x)))
(rule ((Root e) (= e (EffGamma c t f))) ((LiveB c)))
(rule ((Root e) (= e (EffGamma c t f)) (CanBeTrue c)) ((Root t)))
(rule ((Root e) (= e (EffGamma c t f)) (CanBeFalse c)) ((Root f)))
(rule ((Root e) (= e (Seq a b))) ((Root a) (Root b)))

; =============================================================================
