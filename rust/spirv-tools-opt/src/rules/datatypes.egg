(constructor Eq (IntExpr IntExpr) BoolExpr)
(constructor Ne (IntExpr IntExpr) BoolExpr)
(constructor SLt (IntExpr IntExpr) BoolExpr)
(constructor SLe (IntExpr IntExpr) BoolExpr)
(constructor SGt (IntExpr IntExpr) BoolExpr)
(constructor SGe (IntExpr IntExpr) BoolExpr)
