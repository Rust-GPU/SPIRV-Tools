(rule ((LiveI e) (= e (BitOr a b))) ((LiveI a) (LiveI b)))
(rule ((LiveI e) (= e (BitXor a b))) ((LiveI a) (LiveI b)))
(rule ((LiveI e) (= e (BitNot a))) ((LiveI a)))
