(rule ((LiveI e) (= e (BitFieldUExtract a b c))) ((LiveI a) (LiveI b) (LiveI c)))
(rule ((LiveI e) (= e (Const _))) ())
(rule ((LiveI e) (= e (Const64 _))) ())
(rule ((LiveI e) (= e (ConvertFToS a))) ((LiveF a)))
(rule ((LiveI e) (= e (ConvertFToU a))) ((LiveF a)))
