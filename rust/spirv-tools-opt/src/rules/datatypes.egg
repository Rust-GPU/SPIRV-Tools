(rule ((LiveI e) (= e (GroupSMax a))) ((LiveI a)))
(rule ((LiveI e) (= e (GroupUMax a))) ((LiveI a)))
(rule ((LiveI e) (= e (GroupBitAnd a))) ((LiveI a)))
(rule ((LiveI e) (= e (GroupBitOr a))) ((LiveI a)))
(rule ((LiveI e) (= e (GroupBitXor a))) ((LiveI a)))
(rule ((LiveI e) (= e (PackHalf2x16 a))) ((Live a)))
(rule ((LiveI e) (= e (PackSnorm4x8 a))) ((Live a)))
(rule ((LiveI e) (= e (PackSnorm2x16 a))) ((Live a)))
(rule ((LiveI e) (= e (PackUnorm4x8 a))) ((Live a)))
(rule ((LiveI e) (= e (PackUnorm2x16 a))) ((Live a)))
(rule ((LiveI e) (= e (PackDouble2x32 a))) ((Live a)))
(rule ((LiveI e) (= e (ExprToInt x))) ((Live x)))

