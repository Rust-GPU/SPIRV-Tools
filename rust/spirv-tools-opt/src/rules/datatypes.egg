(rule ((LiveB e) (= e (FOrdNe a b))) ((LiveF a) (LiveF b)))
(rule ((LiveB e) (= e (FOrdLt a b))) ((LiveF a) (LiveF b)))
(rule ((LiveB e) (= e (FOrdLe a b))) ((LiveF a) (LiveF b)))
(rule ((LiveB e) (= e (FOrdGt a b))) ((LiveF a) (LiveF b)))
