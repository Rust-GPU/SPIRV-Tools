(rule ((LiveB e) (= e (FUnordLe a b))) ((LiveF a) (LiveF b)))
(rule ((LiveB e) (= e (FUnordGt a b))) ((LiveF a) (LiveF b)))
(rule ((LiveB e) (= e (FUnordGe a b))) ((LiveF a) (LiveF b)))
(rule ((LiveB e) (= e (FEq a b))) ((LiveF a) (LiveF b)))
