; =============================================================================
; SPIR-V RVSDG Expression Language Definition for egglog
; =============================================================================
;
; Uses typed sorts (IntExpr, FloatExpr, BoolExpr) for scalar operations
; to prevent cross-domain type merging. Type-agnostic operations (vectors,
; memory, images, etc.) remain in the general Expr sort.
;
; Key design:
; - Sorts declared with (sort ...) + constructors with (constructor ...)
;   to enable mutual recursion between typed sorts
; - Cross-domain merging is impossible by construction: IntExpr values
;   can never be in the same e-class as FloatExpr or BoolExpr values
; - All sorts participate in ONE BIG SATURATION
; - Bridge constructors (IntToExpr, FloatToExpr, BoolToExpr) connect
;   typed sorts to the general Expr sort for vectors, memory, effects
;
; Key types:
; - IntExpr: Integer scalar computations
; - FloatExpr: Float scalar computations
; - BoolExpr: Boolean computations (comparisons, logical)
; - Expr: Type-agnostic (vectors, matrices, memory, images, etc.)
; - Effect: Side effects and control flow (return, store, etc.)

; =============================================================================
; Sort Declarations (all declared upfront to allow mutual recursion)
; =============================================================================

(sort IntExpr)
(sort FloatExpr)
(sort BoolExpr)
(sort Expr)

; =============================================================================
; IntExpr — Integer-valued scalar expressions
; =============================================================================

; Arithmetic
(constructor Add (IntExpr IntExpr) IntExpr)
(constructor Sub (IntExpr IntExpr) IntExpr)
(constructor Mul (IntExpr IntExpr) IntExpr)
(constructor Neg (IntExpr) IntExpr)
(constructor SDiv (IntExpr IntExpr) IntExpr)
(constructor UDiv (IntExpr IntExpr) IntExpr)
(constructor SRem (IntExpr IntExpr) IntExpr)
(constructor SMod (IntExpr IntExpr) IntExpr)
(constructor UMod (IntExpr IntExpr) IntExpr)

; Bitwise
(constructor Shl (IntExpr IntExpr) IntExpr)
(constructor ShrS (IntExpr IntExpr) IntExpr)
(constructor ShrU (IntExpr IntExpr) IntExpr)
(constructor BitAnd (IntExpr IntExpr) IntExpr)
(constructor BitOr (IntExpr IntExpr) IntExpr)
(constructor BitXor (IntExpr IntExpr) IntExpr)
(constructor BitNot (IntExpr) IntExpr)
(constructor BitReverse (IntExpr) IntExpr)
(constructor RotL (IntExpr IntExpr) IntExpr)
(constructor RotR (IntExpr IntExpr) IntExpr)

; Min/Max
(constructor SMin (IntExpr IntExpr) IntExpr)
(constructor SMax (IntExpr IntExpr) IntExpr)
(constructor UMin (IntExpr IntExpr) IntExpr)
(constructor UMax (IntExpr IntExpr) IntExpr)

; Abs/Sign
(constructor SAbs (IntExpr) IntExpr)
(constructor Sign (IntExpr) IntExpr)

; Bit queries
(constructor FindILsb (IntExpr) IntExpr)
(constructor FindSMsb (IntExpr) IntExpr)
(constructor FindUMsb (IntExpr) IntExpr)
(constructor BitCount (IntExpr) IntExpr)

; Bitfield operations
(constructor BitFieldInsert (IntExpr IntExpr IntExpr IntExpr) IntExpr)
(constructor BitFieldSExtract (IntExpr IntExpr IntExpr) IntExpr)
(constructor BitFieldUExtract (IntExpr IntExpr IntExpr) IntExpr)

; Constants
(constructor Const (i64) IntExpr)
(constructor Const64 (i64) IntExpr)

; Conversions (to int)
(constructor ConvertFToS (FloatExpr) IntExpr)
(constructor ConvertFToU (FloatExpr) IntExpr)
(constructor SConvert (IntExpr) IntExpr)
(constructor UConvert (IntExpr) IntExpr)

; Clamp
(constructor SClamp (IntExpr IntExpr IntExpr) IntExpr)
(constructor UClamp (IntExpr IntExpr IntExpr) IntExpr)

; Typed control flow
(constructor ISym (String) IntExpr)
(constructor GammaI (BoolExpr IntExpr IntExpr) IntExpr)
(constructor SelectI (BoolExpr IntExpr IntExpr) IntExpr)
(constructor IfI (BoolExpr IntExpr IntExpr) IntExpr)
(constructor ThetaI (BoolExpr IntExpr IntExpr) IntExpr)
(constructor LoopVarI () IntExpr)
(constructor LoopInvariantI (IntExpr) IntExpr)
(constructor CopyI (IntExpr) IntExpr)

; Subgroup integer reductions
(constructor GroupIAdd (IntExpr) IntExpr)
(constructor GroupIMul (IntExpr) IntExpr)
(constructor GroupSMin (IntExpr) IntExpr)
(constructor GroupUMin (IntExpr) IntExpr)
(constructor GroupSMax (IntExpr) IntExpr)
(constructor GroupUMax (IntExpr) IntExpr)
(constructor GroupBitAnd (IntExpr) IntExpr)
(constructor GroupBitOr (IntExpr) IntExpr)
(constructor GroupBitXor (IntExpr) IntExpr)

; Packing (vector/float input → int result)
(constructor PackHalf2x16 (Expr) IntExpr)
(constructor PackSnorm4x8 (Expr) IntExpr)
(constructor PackSnorm2x16 (Expr) IntExpr)
(constructor PackUnorm4x8 (Expr) IntExpr)
(constructor PackUnorm2x16 (Expr) IntExpr)
(constructor PackDouble2x32 (Expr) IntExpr)

