(constructor FUnordEq (FloatExpr FloatExpr) BoolExpr)
(constructor FUnordNe (FloatExpr FloatExpr) BoolExpr)
(constructor FUnordLt (FloatExpr FloatExpr) BoolExpr)
(constructor FUnordLe (FloatExpr FloatExpr) BoolExpr)
(constructor FUnordGt (FloatExpr FloatExpr) BoolExpr)
(constructor FUnordGe (FloatExpr FloatExpr) BoolExpr)

