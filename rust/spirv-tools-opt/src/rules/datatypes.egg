(rule ((LiveI e) (= e (Add a b))) ((LiveI a) (LiveI b)))
(rule ((LiveI e) (= e (Sub a b))) ((LiveI a) (LiveI b)))
(rule ((LiveI e) (= e (Mul a b))) ((LiveI a) (LiveI b)))
(rule ((LiveI e) (= e (Neg a))) ((LiveI a)))
(rule ((LiveI e) (= e (SDiv a b))) ((LiveI a) (LiveI b)))
