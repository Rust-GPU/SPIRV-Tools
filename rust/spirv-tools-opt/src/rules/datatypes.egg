(rule ((Live e) (= e (FOrdEq a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FOrdNe a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FOrdLt a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FOrdLe a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FOrdGt a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FOrdGe a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FUnordEq a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FUnordNe a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FUnordLt a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FUnordLe a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FUnordGt a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FUnordGe a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (IsNan a))) ((Live a)))
(rule ((Live e) (= e (IsInf a))) ((Live a)))

; Propagate liveness through vector operations
(rule ((Live e) (= e (VecExtract v _))) ((Live v)))
(rule ((Live e) (= e (Vec2 a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (Vec3 a b c))) ((Live a) (Live b) (Live c)))
(rule ((Live e) (= e (Vec4 a b c d))) ((Live a) (Live b) (Live c) (Live d)))
(rule ((Live e) (= e (VecInsert v s _))) ((Live v) (Live s)))
(rule ((Live e) (= e (VecShuffle2 a b _ _))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecShuffle3 a b _ _ _))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecShuffle4 a b _ _ _ _))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecBroadcast2 a))) ((Live a)))
(rule ((Live e) (= e (VecBroadcast3 a))) ((Live a)))
(rule ((Live e) (= e (VecBroadcast4 a))) ((Live a)))
(rule ((Live e) (= e (VecAdd a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecSub a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecMul a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecDiv a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecNeg a))) ((Live a)))
(rule ((Live e) (= e (VecFAdd a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecFSub a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecFMul a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecFDiv a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecFNeg a))) ((Live a)))
(rule ((Live e) (= e (Dot a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecTimesScalar v s))) ((Live v) (Live s)))

; Propagate liveness through matrix operations
(rule ((Live e) (= e (MatTimesScalar m s))) ((Live m) (Live s)))
(rule ((Live e) (= e (MatTimesVec m v))) ((Live m) (Live v)))
(rule ((Live e) (= e (VecTimesMat v m))) ((Live v) (Live m)))
(rule ((Live e) (= e (MatTimesMat a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (Transpose m))) ((Live m)))
(rule ((Live e) (= e (OuterProduct a b))) ((Live a) (Live b)))

; Propagate liveness through type conversions
(rule ((Live e) (= e (ConvertFToS a))) ((Live a)))
(rule ((Live e) (= e (ConvertFToU a))) ((Live a)))
(rule ((Live e) (= e (ConvertSToF a))) ((Live a)))
(rule ((Live e) (= e (ConvertUToF a))) ((Live a)))
