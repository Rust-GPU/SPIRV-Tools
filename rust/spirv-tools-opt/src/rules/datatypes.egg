; =============================================================================
; SPIR-V RVSDG Expression Language Definition for egglog
; =============================================================================
;
; This uses RVSDG (Regionalized Value State Dependence Graph) to represent
; control flow in a structured way that enables powerful optimizations.
;
; Key types:
; - Expr: Pure value computations (arithmetic, bitwise, etc.)
; - Region: A sequence of operations with outputs (replaces basic blocks)
; - Gamma: Conditional selection node (replaces if-then-else + phi)
; - Theta: Loop node (replaces while loops + phi)
; - Effect: Side effects and control flow (return, store, etc.)

; =============================================================================
; Pure Expression Sort (no side effects)
; =============================================================================

(datatype Expr
    ; Arithmetic operations
    (Add Expr Expr)
    (Sub Expr Expr)
    (Mul Expr Expr)
    (Neg Expr)
    (SDiv Expr Expr)
    (UDiv Expr Expr)
    (SRem Expr Expr)
    (SMod Expr Expr)
    (UMod Expr Expr)

    ; Bitwise operations
    (Shl Expr Expr)
    (ShrS Expr Expr)
    (ShrU Expr Expr)
    (BitAnd Expr Expr)
    (BitOr Expr Expr)
    (BitXor Expr Expr)
    (BitNot Expr)
    (BitReverse Expr)
    (RotL Expr Expr)
    (RotR Expr Expr)

    ; Comparison operations
    (Eq Expr Expr)
    (Ne Expr Expr)
    (SLt Expr Expr)
    (SLe Expr Expr)
    (SGt Expr Expr)
    (SGe Expr Expr)
    (ULt Expr Expr)
    (ULe Expr Expr)
    (UGt Expr Expr)
    (UGe Expr Expr)

    ; Min/Max operations
    (SMin Expr Expr)
    (SMax Expr Expr)
    (UMin Expr Expr)
    (UMax Expr Expr)

    ; Logical operations (on boolean values)
    (LogNot Expr)
    (LogAnd Expr Expr)
    (LogOr Expr Expr)
    (LogEq Expr Expr)
    (LogNe Expr Expr)

    ; Gamma node: structured conditional (RVSDG)
    ; (Gamma cond then_val else_val) - selects then_val if cond is true
    ; This is the RVSDG way to represent conditional values without phi nodes
    (Gamma Expr Expr Expr)

    ; Legacy Select (alias for Gamma for backward compatibility)
    (Select Expr Expr Expr)
    (If Expr Expr Expr)

    ; Theta node: tail-controlled loop (RVSDG)
    ; (Theta cond body_result loop_var_init)
    ;   - cond: continue condition (evaluated each iteration)
    ;   - body_result: the value computed in the loop body
    ;   - loop_var_init: initial value of loop-carried variable
    ; The loop continues while cond is true, and body_result becomes the next loop_var
    (Theta Expr Expr Expr)

    ; Loop variable reference - refers to the current iteration's loop variable
    ; Used inside Theta body to reference the loop-carried state
    (LoopVar)

    ; LoopInvariant wrapper - marks an expression as loop-invariant
    ; An expression that doesn't depend on LoopVar can be hoisted out of Theta
    (LoopInvariant Expr)

    ; Floating-point operations
    (FAdd Expr Expr)
    (FSub Expr Expr)
    (FMul Expr Expr)
    (FDiv Expr Expr)
    (FNeg Expr)
    (FRem Expr Expr)
    (FMin Expr Expr)
    (FMax Expr Expr)
    (FAbs Expr)
    (FFloor Expr)
    (FCeil Expr)
    (FRound Expr)
    (FTrunc Expr)

    ; Floating-point comparison operations (ordered)
    (FOrdEq Expr Expr)
    (FOrdNe Expr Expr)
    (FOrdLt Expr Expr)
    (FOrdLe Expr Expr)
    (FOrdGt Expr Expr)
    (FOrdGe Expr Expr)

    ; Floating-point comparison operations (unordered - true if NaN)
    (FUnordEq Expr Expr)
    (FUnordNe Expr Expr)
    (FUnordLt Expr Expr)
    (FUnordLe Expr Expr)
    (FUnordGt Expr Expr)
    (FUnordGe Expr Expr)

    ; FP predicates
    (IsNan Expr)
    (IsInf Expr)

    ; Vector construction and extraction
    ; Vec2/3/4 build vectors from scalars
    (Vec2 Expr Expr)
    (Vec3 Expr Expr Expr)
    (Vec4 Expr Expr Expr Expr)

    ; Extract scalar from vector (index is compile-time constant)
    (VecExtract Expr i64)

    ; Insert scalar into vector at index
    (VecInsert Expr Expr i64)

    ; VectorShuffle - specialized by output vector size
    ; Indices reference v1 (0..n-1) or v2 (n..2n-1) where n is input vector size
    (VecShuffle2 Expr Expr i64 i64)
    (VecShuffle3 Expr Expr i64 i64 i64)
    (VecShuffle4 Expr Expr i64 i64 i64 i64)

    ; Broadcast scalar to all components
    (VecBroadcast2 Expr)
    (VecBroadcast3 Expr)
    (VecBroadcast4 Expr)

    ; Vector arithmetic (component-wise)
    (VecAdd Expr Expr)
    (VecSub Expr Expr)
    (VecMul Expr Expr)
    (VecDiv Expr Expr)
    (VecNeg Expr)
    (VecFAdd Expr Expr)
    (VecFSub Expr Expr)
    (VecFMul Expr Expr)
    (VecFDiv Expr Expr)
    (VecFNeg Expr)

    ; Dot product
    (Dot Expr Expr)

    ; Vector times scalar
    (VecTimesScalar Expr Expr)

    ; Matrix operations
    ; MatrixTimesScalar (matrix, scalar)
    (MatTimesScalar Expr Expr)
    ; MatrixTimesVector (matrix, vector) -> vector
    (MatTimesVec Expr Expr)
    ; VectorTimesMatrix (vector, matrix) -> vector
    (VecTimesMat Expr Expr)
    ; MatrixTimesMatrix (matrix, matrix) -> matrix
    (MatTimesMat Expr Expr)
    ; Transpose
    (Transpose Expr)
    ; OuterProduct (vec, vec) -> matrix
    (OuterProduct Expr Expr)
    ; Determinant
    (Determinant Expr)
    ; Inverse
    (MatInverse Expr)

    ; GLSL extended instructions commonly optimized
    (FMix Expr Expr Expr)
    (SmoothStep Expr Expr Expr)
    (FClamp Expr Expr Expr)
    (SClamp Expr Expr Expr)
    (UClamp Expr Expr Expr)
    (Cross Expr Expr)
    (Normalize Expr)
    (Length Expr)
    (Distance Expr Expr)
    (Reflect Expr Expr)
    (Refract Expr Expr Expr)
    (FaceForward Expr Expr Expr)

    ; Additional GLSL math functions
    (Sqrt Expr)
    (InverseSqrt Expr)
    (Exp Expr)
    (Exp2 Expr)
    (Log Expr)
    (Log2 Expr)
    (Pow Expr Expr)
    (Sin Expr)
    (Cos Expr)
    (Tan Expr)
    (Asin Expr)
    (Acos Expr)
    (Atan Expr)
    (Atan2 Expr Expr)
    (Sinh Expr)
    (Cosh Expr)
    (Tanh Expr)
    (Asinh Expr)
    (Acosh Expr)
    (Atanh Expr)
    (Fma Expr Expr Expr)
    (Fract Expr)
    (Modf Expr)
    (ModfStruct Expr)
    (Ldexp Expr Expr)
    (Frexp Expr)
    (FrexpStruct Expr)
    (Step Expr Expr)
    (Sign Expr)
    (FSign Expr)
    (SAbs Expr)
    (FindILsb Expr)
    (FindSMsb Expr)
    (FindUMsb Expr)
    (BitCount Expr)

    ; Constants - we use i64 for the value
    ; Const is for 32-bit values, Const64 for 64-bit values
    (Const i64)
    (Const64 i64)

    ; Symbols (variables / function arguments)
    (Sym String)

    ; Argument reference in a region (by index)
    ; Used inside Gamma/Theta regions to refer to inputs
    (Arg i64)

    ; Copy operation (OpCopyObject)
    ; CopyObject just makes a copy - it's always equal to the original
    (CopyObject Expr)

    ; Undefined value (OpUndef)
    ; Represents an undefined value of any type
    ; Operations on Undef have special optimization rules
    (Undef)

    ; ==========================================================================
    ; Type Conversion Operations (SPIR-V OpConvert* and OpBitcast)
    ; ==========================================================================

    ; Float to integer conversions
    (ConvertFToS Expr)      ; Float to signed int (OpConvertFToS)
    (ConvertFToU Expr)      ; Float to unsigned int (OpConvertFToU)

    ; Integer to float conversions
    (ConvertSToF Expr)      ; Signed int to float (OpConvertSToF)
    (ConvertUToF Expr)      ; Unsigned int to float (OpConvertUToF)

    ; Integer width changes
    (SConvert Expr)         ; Signed int width change (OpSConvert)
    (UConvert Expr)         ; Unsigned int width change (OpUConvert)

    ; Float precision changes
    (FConvert Expr)         ; Float precision change (OpFConvert)

    ; Bit-preserving reinterpretation
    (Bitcast Expr)          ; Bit-preserving type reinterpretation (OpBitcast)

    ; Quantization
    (QuantizeToF16 Expr)    ; Quantize float to 16-bit precision (OpQuantizeToF16)

    ; ==========================================================================
    ; Pack/Unpack Operations (GLSL.std.450)
    ; ==========================================================================

    ; Half-float packing
    (PackHalf2x16 Expr)     ; Pack two floats into uint (GLSLstd450PackHalf2x16)
    (UnpackHalf2x16 Expr)   ; Unpack uint to two floats (GLSLstd450UnpackHalf2x16)

    ; Snorm packing
    (PackSnorm4x8 Expr)     ; Pack 4 floats to snorm bytes (GLSLstd450PackSnorm4x8)
    (UnpackSnorm4x8 Expr)   ; Unpack snorm bytes to 4 floats (GLSLstd450UnpackSnorm4x8)
    (PackSnorm2x16 Expr)    ; Pack 2 floats to snorm shorts (GLSLstd450PackSnorm2x16)
    (UnpackSnorm2x16 Expr)  ; Unpack snorm shorts to 2 floats (GLSLstd450UnpackSnorm2x16)

    ; Unorm packing
    (PackUnorm4x8 Expr)     ; Pack 4 floats to unorm bytes (GLSLstd450PackUnorm4x8)
    (UnpackUnorm4x8 Expr)   ; Unpack unorm bytes to 4 floats (GLSLstd450UnpackUnorm4x8)
    (PackUnorm2x16 Expr)    ; Pack 2 floats to unorm shorts (GLSLstd450PackUnorm2x16)
    (UnpackUnorm2x16 Expr)  ; Unpack unorm shorts to 2 floats (GLSLstd450UnpackUnorm2x16)

    ; Double packing (for 64-bit doubles)
    (PackDouble2x32 Expr)   ; Pack two uints to double (GLSLstd450PackDouble2x32)
    (UnpackDouble2x32 Expr) ; Unpack double to two uints (GLSLstd450UnpackDouble2x32)

    ; ==========================================================================
    ; Additional GLSL Math Functions
    ; ==========================================================================

    ; Radians/Degrees conversion
    (Radians Expr)          ; Convert degrees to radians (GLSLstd450Radians)
    (Degrees Expr)          ; Convert radians to degrees (GLSLstd450Degrees)

    ; NaN/Inf handling
    (NMin Expr Expr)        ; NaN-ignoring minimum (GLSLstd450NMin)
    (NMax Expr Expr)        ; NaN-ignoring maximum (GLSLstd450NMax)
    (NClamp Expr Expr Expr) ; NaN-ignoring clamp (GLSLstd450NClamp)

    ; ==========================================================================
    ; Memory Operations (for global e-graph optimization)
    ; ==========================================================================
    ; Memory state is modeled as an Expr to enable state threading through the
    ; e-graph. This allows load-after-store forwarding, dead store elimination,
    ; and other memory optimizations in ONE pass.
    ;
    ; Memory state forms a chain: InitMem -> Store -> Store -> ...
    ; Loads read from a memory state, producing a value.
    ; The e-graph unifies equivalent memory states and values.

    ; Initial memory state (function/shader entry)
    (InitMem)

    ; Memory state after a store: (StoreMem ptr value prev_state)
    ; Returns the new memory state
    (StoreMem Expr Expr Expr)

    ; Memory state at control flow merge: (MergeMem cond then_mem else_mem)
    (MergeMem Expr Expr Expr)

    ; Memory state after a loop: (LoopMem cond body_mem init_mem)
    (LoopMem Expr Expr Expr)

    ; Load from memory: (Load ptr mem_state) -> value
    (Load Expr Expr)

    ; Variable/pointer reference: (Var name storage_class)
    ; storage_class: 0=Function, 1=Private, 2=Workgroup, 3=Uniform, etc.
    (Var String i64)

    ; Access chain: (AccessChain1/2/3 base idx1 [idx2 [idx3]])
    ; Specialized for common depths to avoid ExprList dependency
    (AccessChain1 Expr i64)
    (AccessChain2 Expr i64 i64)
    (AccessChain3 Expr i64 i64 i64)

    ; Dynamic access chain: (AccessChainDyn base index_expr)
    (AccessChainDyn Expr Expr)

    ; Image operations (pure reads)
    (ImageSample Expr Expr)     ; (image, coord) -> color
    (ImageFetch Expr Expr)      ; (image, coord) -> texel
    (ImageRead Expr Expr)       ; (image, coord) -> data

    ; Sampler/Image combination
    (SampledImage Expr Expr)    ; (image, sampler) -> combined sampled_image
    (Image Expr)                ; Extract image from sampled_image

    ; Image write returns new memory state: (ImageWrite image coord data mem)
    (ImageWrite Expr Expr Expr Expr)

    ; Atomic operations: return (value, new_mem_state) encoded as pair
    ; For simplicity, we return just the loaded value; mem state is implicit
    (AtomicLoad Expr Expr)              ; (ptr, mem) -> value
    (AtomicStore Expr Expr Expr)        ; (ptr, value, mem) -> new_mem
    (AtomicExchange Expr Expr Expr)     ; (ptr, value, mem) -> old_value
    (AtomicCompareExchange Expr Expr Expr Expr) ; (ptr, cmp, val, mem) -> old
    (AtomicIAdd Expr Expr Expr)         ; (ptr, value, mem) -> old_value
    (AtomicISub Expr Expr Expr)
    (AtomicSMin Expr Expr Expr)
    (AtomicUMin Expr Expr Expr)
    (AtomicSMax Expr Expr Expr)
    (AtomicUMax Expr Expr Expr)
    (AtomicAnd Expr Expr Expr)
    (AtomicOr Expr Expr Expr)
    (AtomicXor Expr Expr Expr)

    ; Subgroup/Wave operations for compute shaders
    (GroupElect)                        ; Returns true for first active invocation
    (GroupAll Expr)                     ; All predicate: all invocations true?
    (GroupAny Expr)                     ; Any predicate: any invocation true?
    (GroupAllEqual Expr)                ; All values equal across invocations?
    (GroupBroadcast Expr Expr)          ; Broadcast value from specific invocation
    (GroupBroadcastFirst Expr)          ; Broadcast from first active invocation
    (GroupShuffle Expr Expr)            ; Shuffle by invocation ID
    (GroupShuffleXor Expr Expr)         ; Shuffle by XOR mask

    ; Subgroup arithmetic reductions
    (GroupIAdd Expr)                    ; Integer addition reduction
    (GroupFAdd Expr)                    ; Float addition reduction
    (GroupIMul Expr)                    ; Integer multiplication reduction
    (GroupFMul Expr)                    ; Float multiplication reduction
    (GroupSMin Expr)                    ; Signed min reduction
    (GroupUMin Expr)                    ; Unsigned min reduction
    (GroupFMin Expr)                    ; Float min reduction
    (GroupSMax Expr)                    ; Signed max reduction
    (GroupUMax Expr)                    ; Unsigned max reduction
    (GroupFMax Expr)                    ; Float max reduction
    (GroupBitAnd Expr)                  ; Bitwise AND reduction
    (GroupBitOr Expr)                   ; Bitwise OR reduction
    (GroupBitXor Expr)                  ; Bitwise XOR reduction
    (GroupLogAnd Expr)                  ; Logical AND reduction
    (GroupLogOr Expr)                   ; Logical OR reduction
    (GroupLogXor Expr)                  ; Logical XOR reduction

    ; ==========================================================================
    ; Function Calls and Inlining (for global optimization)
    ; ==========================================================================
    ; Functions are modeled in the e-graph to enable cross-function optimization.
    ; Inlining is a rewrite: Call(f, args) = Subst(body_of_f, args)

    ; Function call with 1-4 arguments (common cases)
    (Call1 String Expr)
    (Call2 String Expr Expr)
    (Call3 String Expr Expr Expr)
    (Call4 String Expr Expr Expr Expr)

    ; Substitution: (Subst body arg_index value)
    ; Replaces Arg(arg_index) with value in body
    (Subst Expr i64 Expr)

    ; ==========================================================================
    ; Specialization Constants
    ; ==========================================================================
    ; Spec constants are compile-time constants with runtime-specializable values.
    ; Modeled as Expr to enable algebraic optimization before specialization.

    ; Spec constant reference: (SpecConst spec_id default_value)
    (SpecConst i64 i64)

    ; Spec constant operations (OpSpecConstantOp)
    ; These compute at specialization time
    (SpecAdd Expr Expr)
    (SpecSub Expr Expr)
    (SpecMul Expr Expr)
    (SpecSDiv Expr Expr)
    (SpecUDiv Expr Expr)
    (SpecSMod Expr Expr)
    (SpecUMod Expr Expr)
    (SpecShl Expr Expr)
    (SpecShrS Expr Expr)
    (SpecShrU Expr Expr)
    (SpecBitAnd Expr Expr)
    (SpecBitOr Expr Expr)
    (SpecBitXor Expr Expr)
    (SpecEq Expr Expr)
    (SpecNe Expr Expr)
    (SpecSLt Expr Expr)
    (SpecULt Expr Expr)
    (SpecSelect Expr Expr Expr)

    ; ==========================================================================
    ; Loop Unrolling Support
    ; ==========================================================================
    ; Bounded loops can be unrolled when trip count is known.

    ; Bounded theta: (BoundedTheta trip_count body init)
    ; A loop with known iteration count
    (BoundedTheta i64 Expr Expr)

    ; Loop iteration: (LoopIter iteration_number value)
    ; Represents the value at a specific iteration (for unrolling)
    (LoopIter i64 Expr)

    ; ==========================================================================
    ; Derivative Operations (for fragment shaders)
    ; ==========================================================================
    (DPdx Expr)         ; Partial derivative in x
    (DPdy Expr)         ; Partial derivative in y
    (DPdxFine Expr)     ; Fine partial derivative in x
    (DPdyFine Expr)     ; Fine partial derivative in y
    (DPdxCoarse Expr)   ; Coarse partial derivative in x
    (DPdyCoarse Expr)   ; Coarse partial derivative in y
    (Fwidth Expr)       ; abs(dPdx) + abs(dPdy)
    (FwidthFine Expr)
    (FwidthCoarse Expr)

    ; ==========================================================================
    ; Bitfield Operations (OpBitField*)
    ; ==========================================================================
    ; BitFieldInsert(base, insert, offset, count): Insert bits into base
    ; Result = (base & ~mask) | ((insert << offset) & mask)
    ; where mask = ((1 << count) - 1) << offset
    (BitFieldInsert Expr Expr Expr Expr)  ; (base, insert, offset, count)

    ; BitFieldSExtract(base, offset, count): Extract signed bits
    ; Extracts 'count' bits starting at 'offset', sign-extended
    (BitFieldSExtract Expr Expr Expr)     ; (base, offset, count)

    ; BitFieldUExtract(base, offset, count): Extract unsigned bits
    ; Extracts 'count' bits starting at 'offset', zero-extended
    (BitFieldUExtract Expr Expr Expr)     ; (base, offset, count)

    ; NOTE: BitReverse, BitCount, FindILsb, FindSMsb, FindUMsb are already
    ; defined earlier in this file as core bitwise operations

    ; ==========================================================================
    ; Image Query Operations
    ; ==========================================================================
    (ImageQuerySize Expr)          ; Get image dimensions
    (ImageQuerySizeLod Expr Expr)  ; Get image dimensions at LOD
    (ImageQueryLevels Expr)        ; Get number of mip levels
    (ImageQuerySamples Expr)       ; Get number of samples
    (ImageQueryLod Expr Expr)      ; Query LOD for coordinates
)

; =============================================================================
; RVSDG Region Types
; =============================================================================

; A Region represents a computation with inputs and outputs.
; Regions are used inside Gamma and Theta nodes.

; ExprList for multi-output regions
(datatype ExprList
    (ENil)
    (ECons Expr ExprList)
)

; Helper to build lists - removed self-referential rule that caused cycles

; =============================================================================
; Additional Expr Constructors Using ExprList
; =============================================================================
; These are added to the Expr datatype after ExprList is defined

; VectorShuffle - shuffle two vectors using mask indices
; (VecShuffle vec1 vec2 mask) where mask is a list of indices
(function VecShuffle (Expr Expr ExprList) Expr :merge old)

; Composite operations (general, works for structs too)
(function CompositeConstruct (ExprList) Expr :merge old)
(function CompositeExtract (Expr i64) Expr :merge old)
(function CompositeInsert (Expr Expr i64) Expr :merge old)

; CompositeExtract from CompositeConstruct rules - ONE-DIRECTIONAL to prevent explosion
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ENil))) 0)))
      ((union e a)))
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ECons b (ENil)))) 0)))
      ((union e a)))
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ECons b (ENil)))) 1)))
      ((union e b)))
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ECons b (ECons c (ENil))))) 0)))
      ((union e a)))
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ECons b (ECons c (ENil))))) 1)))
      ((union e b)))
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ECons b (ECons c (ENil))))) 2)))
      ((union e c)))
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ECons b (ECons c (ECons d (ENil)))))) 0)))
      ((union e a)))
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ECons b (ECons c (ECons d (ENil)))))) 1)))
      ((union e b)))
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ECons b (ECons c (ECons d (ENil)))))) 2)))
      ((union e c)))
(rule ((= e (CompositeExtract (CompositeConstruct (ECons a (ECons b (ECons c (ECons d (ENil)))))) 3)))
      ((union e d)))

; =============================================================================
; CompositeInsert Optimization (Dead Insert Elimination)
; =============================================================================

; Insert then extract at same index returns inserted value - ONE-DIRECTIONAL
(rule ((= e (CompositeExtract (CompositeInsert composite val 0) 0)))
      ((union e val)))
(rule ((= e (CompositeExtract (CompositeInsert composite val 1) 1)))
      ((union e val)))
(rule ((= e (CompositeExtract (CompositeInsert composite val 2) 2)))
      ((union e val)))
(rule ((= e (CompositeExtract (CompositeInsert composite val 3) 3)))
      ((union e val)))

; Insert then extract at different index returns original composite element
; These rules require the original CompositeExtract to exist in the e-graph
; We match both the outer extraction and the original extraction, then union them
(rule ((= outer (CompositeExtract (CompositeInsert composite val 0) 1))
       (= inner (CompositeExtract composite 1)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 0) 2))
       (= inner (CompositeExtract composite 2)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 0) 3))
       (= inner (CompositeExtract composite 3)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 1) 0))
       (= inner (CompositeExtract composite 0)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 1) 2))
       (= inner (CompositeExtract composite 2)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 1) 3))
       (= inner (CompositeExtract composite 3)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 2) 0))
       (= inner (CompositeExtract composite 0)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 2) 1))
       (= inner (CompositeExtract composite 1)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 2) 3))
       (= inner (CompositeExtract composite 3)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 3) 0))
       (= inner (CompositeExtract composite 0)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 3) 1))
       (= inner (CompositeExtract composite 1)))
      ((union outer inner)))
(rule ((= outer (CompositeExtract (CompositeInsert composite val 3) 2))
       (= inner (CompositeExtract composite 2)))
      ((union outer inner)))

; Inserting value extracted from same position is identity
(rule ((= e (CompositeInsert composite (CompositeExtract composite 0) 0)))
      ((union e composite)))
(rule ((= e (CompositeInsert composite (CompositeExtract composite 1) 1)))
      ((union e composite)))
(rule ((= e (CompositeInsert composite (CompositeExtract composite 2) 2)))
      ((union e composite)))
(rule ((= e (CompositeInsert composite (CompositeExtract composite 3) 3)))
      ((union e composite)))

; =============================================================================
; CompositeExtractFeedingConstruct (C++ parity)
; =============================================================================
; When constructing a composite from extractions of the same source at matching
; indices, simplify to use the original source

; Vec2: Construct(Extract(v,0), Extract(v,1)) = v
(rule ((= e (CompositeConstruct (ECons (CompositeExtract v 0) (ECons (CompositeExtract v 1) (ENil))))))
      ((union e v)))

; Vec3: Construct(Extract(v,0), Extract(v,1), Extract(v,2)) = v
(rule ((= e (CompositeConstruct (ECons (CompositeExtract v 0) (ECons (CompositeExtract v 1) (ECons (CompositeExtract v 2) (ENil)))))))
      ((union e v)))

; Vec4: Construct(Extract(v,0), Extract(v,1), Extract(v,2), Extract(v,3)) = v
(rule ((= e (CompositeConstruct (ECons (CompositeExtract v 0) (ECons (CompositeExtract v 1) (ECons (CompositeExtract v 2) (ECons (CompositeExtract v 3) (ENil))))))))
      ((union e v)))

; Same pattern for Vec2/3/4 constructors
(rule ((= e (Vec2 (CompositeExtract v 0) (CompositeExtract v 1))))
      ((union e v)))
(rule ((= e (Vec3 (CompositeExtract v 0) (CompositeExtract v 1) (CompositeExtract v 2))))
      ((union e v)))
(rule ((= e (Vec4 (CompositeExtract v 0) (CompositeExtract v 1) (CompositeExtract v 2) (CompositeExtract v 3))))
      ((union e v)))

; Same for VecExtract (vector-specific extraction)
(rule ((= e (Vec2 (VecExtract v 0) (VecExtract v 1))))
      ((union e v)))
(rule ((= e (Vec3 (VecExtract v 0) (VecExtract v 1) (VecExtract v 2))))
      ((union e v)))
(rule ((= e (Vec4 (VecExtract v 0) (VecExtract v 1) (VecExtract v 2) (VecExtract v 3))))
      ((union e v)))

; =============================================================================
; Undef (Undefined Value) Optimization Rules
; =============================================================================
; OpUndef represents an undefined value. Operations on Undef can often be
; optimized away or simplified. These rules implement C++ StoringUndef and
; related optimizations.

; Selecting Undef when condition is known - ONE-DIRECTIONAL
; Gamma(true, Undef, x) can be simplified (x is always returned if cond is false)
; But we don't know which branch is taken without constant condition

; Operations that absorb Undef:
; - Storing Undef is a dead store (handled in memory.egg via StoreMem)
; - CompositeExtract from Undef is Undef
(rule ((= e (CompositeExtract (Undef) _)))
      ((union e (Undef))))
(rule ((= e (VecExtract (Undef) _)))
      ((union e (Undef))))

; Operations where one Undef operand makes result Undef:
; Arithmetic with Undef propagates to Undef (conservative but safe)
; Note: Some operations like x | 0xFFFFFFFF don't need the other operand,
; but we're conservative here.

; Multiplication by zero beats Undef (0 * Undef = 0)
(rule ((= e (Mul (Const 0) (Undef))))
      ((union e (Const 0))))
(rule ((= e (Mul (Undef) (Const 0))))
      ((union e (Const 0))))
(rule ((= e (FMul (Const 0) (Undef))))
      ((union e (Const 0))))
(rule ((= e (FMul (Undef) (Const 0))))
      ((union e (Const 0))))

; Bitwise operations that can determine result:
; x & 0 = 0 regardless of x (including Undef)
(rule ((= e (BitAnd (Const 0) (Undef))))
      ((union e (Const 0))))
(rule ((= e (BitAnd (Undef) (Const 0))))
      ((union e (Const 0))))

; x | -1 = -1 regardless of x (including Undef)
(rule ((= e (BitOr (Const -1) (Undef))))
      ((union e (Const -1))))
(rule ((= e (BitOr (Undef) (Const -1))))
      ((union e (Const -1))))

; Logical operations that can determine result:
; false && x = false
(rule ((= e (LogAnd (Const 0) (Undef))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (Undef) (Const 0))))
      ((union e (Const 0))))

; true || x = true
(rule ((= e (LogOr (Const 1) (Undef))))
      ((union e (Const 1))))
(rule ((= e (LogOr (Undef) (Const 1))))
      ((union e (Const 1))))

; CopyObject of Undef is Undef
(rule ((= e (CopyObject (Undef))))
      ((union e (Undef))))

; =============================================================================
; Effect Sort (side effects and control flow)
; =============================================================================

(datatype Effect
    ; No effect (identity)
    (Pure)

    ; Return from function
    (Return)
    (ReturnValue Expr)

    ; Sequence two effects
    (Seq Effect Effect)

    ; Conditional effect (Gamma over effects)
    ; (EffGamma cond then_effect else_effect)
    (EffGamma Expr Effect Effect)

    ; Unreachable (dead code)
    (Unreachable)
)

; =============================================================================
; Liveness Tracking for DCE (Dead Code Elimination)
; =============================================================================
; Live expressions are reachable from roots (side-effecting instructions).
; DCE happens entirely in the e-graph during saturation.
;
; Root: Marks an Effect as a program root (entry point for liveness)
; Live: Marks an Expr as live (reachable from a root)
;
; The Rust code marks effect terms as Root, then these rules propagate
; liveness through the entire program during saturation.

(relation Root (Effect))
(relation Live (Expr))

; Forward declarations for condition analysis (used by EffGamma root propagation below)
; Full rules defined later in the "Condition Analysis for Partial DCE" section
(relation CanBeTrue (Expr))
(relation CanBeFalse (Expr))

; =============================================================================
; Root Effects propagate liveness to their operands
; =============================================================================

; ReturnValue: the returned expression is live
(rule ((Root e) (= e (ReturnValue x))) ((Live x)))

; EffGamma: condition is always live, branches depend on condition value
(rule ((Root e) (= e (EffGamma c t f))) ((Live c)))
(rule ((Root e) (= e (EffGamma c t f)) (CanBeTrue c)) ((Root t)))
(rule ((Root e) (= e (EffGamma c t f)) (CanBeFalse c)) ((Root f)))

; Seq: both effects in a sequence are roots if the sequence is
(rule ((Root e) (= e (Seq a b))) ((Root a) (Root b)))

; Pure and Return have no expressions to mark live
; Unreachable is dead by definition

; Propagate liveness through arithmetic operations
(rule ((Live e) (= e (Add a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (Sub a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (Mul a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (Neg a))) ((Live a)))
(rule ((Live e) (= e (SDiv a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (UDiv a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SRem a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SMod a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (UMod a b))) ((Live a) (Live b)))

; Propagate liveness through bitwise operations
(rule ((Live e) (= e (Shl a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (ShrS a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (ShrU a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (BitAnd a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (BitOr a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (BitXor a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (BitNot a))) ((Live a)))
(rule ((Live e) (= e (BitReverse a))) ((Live a)))
(rule ((Live e) (= e (RotL a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (RotR a b))) ((Live a) (Live b)))

; Propagate liveness through comparison operations
(rule ((Live e) (= e (Eq a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (Ne a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SLt a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SLe a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SGt a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SGe a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (ULt a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (ULe a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (UGt a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (UGe a b))) ((Live a) (Live b)))

; Propagate liveness through min/max operations
(rule ((Live e) (= e (SMin a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SMax a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (UMin a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (UMax a b))) ((Live a) (Live b)))

; Propagate liveness through logical operations
(rule ((Live e) (= e (LogNot a))) ((Live a)))
(rule ((Live e) (= e (LogAnd a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (LogOr a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (LogEq a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (LogNe a b))) ((Live a) (Live b)))

; =============================================================================
; Condition Analysis for Partial DCE
; =============================================================================
; CanBeTrue/CanBeFalse track whether a condition can have a particular value.
; This enables partial dead code elimination - if we know a branch is never
; taken, we don't need to mark its contents as live.
; (Relation declarations are at top with Root/Live)

; Constants have known truth values
(rule ((= e (Const 0))) ((CanBeFalse e)))
(rule ((= e (Const c)) (!= c 0)) ((CanBeTrue e)))

; By default, any non-constant expression can be either true or false
; (conservative: assume both branches are possible)
; We use Sym as a proxy for "unknown runtime value"
(rule ((= e (Sym s))) ((CanBeTrue e) (CanBeFalse e)))

; Propagate through logical operations
(rule ((= e (LogNot x)) (CanBeTrue x)) ((CanBeFalse e)))
(rule ((= e (LogNot x)) (CanBeFalse x)) ((CanBeTrue e)))

; LogAnd can be true only if both can be true
(rule ((= e (LogAnd a b)) (CanBeTrue a) (CanBeTrue b)) ((CanBeTrue e)))
; LogAnd can be false if either can be false
(rule ((= e (LogAnd a b)) (CanBeFalse a)) ((CanBeFalse e)))
(rule ((= e (LogAnd a b)) (CanBeFalse b)) ((CanBeFalse e)))

; LogOr can be false only if both can be false
(rule ((= e (LogOr a b)) (CanBeFalse a) (CanBeFalse b)) ((CanBeFalse e)))
; LogOr can be true if either can be true
(rule ((= e (LogOr a b)) (CanBeTrue a)) ((CanBeTrue e)))
(rule ((= e (LogOr a b)) (CanBeTrue b)) ((CanBeTrue e)))

; Comparisons can generally be either (conservative)
; More precise rules would require value range analysis
(rule ((= e (Eq a b))) ((CanBeTrue e) (CanBeFalse e)))
(rule ((= e (Ne a b))) ((CanBeTrue e) (CanBeFalse e)))
(rule ((= e (SLt a b))) ((CanBeTrue e) (CanBeFalse e)))
(rule ((= e (SLe a b))) ((CanBeTrue e) (CanBeFalse e)))
(rule ((= e (SGt a b))) ((CanBeTrue e) (CanBeFalse e)))
(rule ((= e (SGe a b))) ((CanBeTrue e) (CanBeFalse e)))
(rule ((= e (ULt a b))) ((CanBeTrue e) (CanBeFalse e)))
(rule ((= e (ULe a b))) ((CanBeTrue e) (CanBeFalse e)))
(rule ((= e (UGt a b))) ((CanBeTrue e) (CanBeFalse e)))
(rule ((= e (UGe a b))) ((CanBeTrue e) (CanBeFalse e)))

; Gamma/Select results inherit condition properties
(rule ((= e (Gamma c t f)) (CanBeTrue c)) ((CanBeTrue e) (CanBeFalse e)))
(rule ((= e (Gamma c t f)) (CanBeFalse c)) ((CanBeTrue e) (CanBeFalse e)))

; =============================================================================
; RVSDG-Aware Liveness for Partial DCE
; =============================================================================
; Propagate liveness through control flow with branch awareness.
; Only mark a branch as live if the condition can take that path.

; Condition is always live if the Gamma is live
(rule ((Live e) (= e (Gamma c t f))) ((Live c)))
(rule ((Live e) (= e (Select c t f))) ((Live c)))
(rule ((Live e) (= e (If c t f))) ((Live c)))

; Then branch is only live if condition can be true
(rule ((Live e) (= e (Gamma c t f)) (CanBeTrue c)) ((Live t)))
(rule ((Live e) (= e (Select c t f)) (CanBeTrue c)) ((Live t)))
(rule ((Live e) (= e (If c t f)) (CanBeTrue c)) ((Live t)))

; Else branch is only live if condition can be false
(rule ((Live e) (= e (Gamma c t f)) (CanBeFalse c)) ((Live f)))
(rule ((Live e) (= e (Select c t f)) (CanBeFalse c)) ((Live f)))
(rule ((Live e) (= e (If c t f)) (CanBeFalse c)) ((Live f)))

; Propagate liveness through Theta (loops)
; Loop body is only live if the loop can execute (condition can be true)
(rule ((Live e) (= e (Theta c body init))) ((Live init)))
(rule ((Live e) (= e (Theta c body init)) (CanBeTrue c)) ((Live c) (Live body)))
(rule ((Live e) (= e (LoopInvariant x))) ((Live x)))

; Propagate liveness through floating-point operations
(rule ((Live e) (= e (FAdd a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FSub a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FMul a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FDiv a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FNeg a))) ((Live a)))
(rule ((Live e) (= e (FRem a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FMin a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FMax a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FAbs a))) ((Live a)))
(rule ((Live e) (= e (FFloor a))) ((Live a)))
(rule ((Live e) (= e (FCeil a))) ((Live a)))
(rule ((Live e) (= e (FTrunc a))) ((Live a)))
(rule ((Live e) (= e (FRound a))) ((Live a)))

; Propagate liveness through floating-point comparisons
(rule ((Live e) (= e (FOrdEq a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FOrdNe a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FOrdLt a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FOrdLe a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FOrdGt a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FOrdGe a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FUnordEq a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FUnordNe a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FUnordLt a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FUnordLe a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FUnordGt a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FUnordGe a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (IsNan a))) ((Live a)))
(rule ((Live e) (= e (IsInf a))) ((Live a)))

; Propagate liveness through vector operations
(rule ((Live e) (= e (VecExtract v _))) ((Live v)))
(rule ((Live e) (= e (Vec2 a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (Vec3 a b c))) ((Live a) (Live b) (Live c)))
(rule ((Live e) (= e (Vec4 a b c d))) ((Live a) (Live b) (Live c) (Live d)))
(rule ((Live e) (= e (VecInsert v s _))) ((Live v) (Live s)))
(rule ((Live e) (= e (VecShuffle2 a b _ _))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecShuffle3 a b _ _ _))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecShuffle4 a b _ _ _ _))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecBroadcast2 a))) ((Live a)))
(rule ((Live e) (= e (VecBroadcast3 a))) ((Live a)))
(rule ((Live e) (= e (VecBroadcast4 a))) ((Live a)))
(rule ((Live e) (= e (VecAdd a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecSub a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecMul a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecDiv a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecNeg a))) ((Live a)))
(rule ((Live e) (= e (VecFAdd a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecFSub a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecFMul a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecFDiv a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecFNeg a))) ((Live a)))
(rule ((Live e) (= e (Dot a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (VecTimesScalar v s))) ((Live v) (Live s)))

; Propagate liveness through matrix operations
(rule ((Live e) (= e (MatTimesScalar m s))) ((Live m) (Live s)))
(rule ((Live e) (= e (MatTimesVec m v))) ((Live m) (Live v)))
(rule ((Live e) (= e (VecTimesMat v m))) ((Live v) (Live m)))
(rule ((Live e) (= e (MatTimesMat a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (Transpose m))) ((Live m)))
(rule ((Live e) (= e (OuterProduct a b))) ((Live a) (Live b)))

; Propagate liveness through type conversions
(rule ((Live e) (= e (ConvertFToS a))) ((Live a)))
(rule ((Live e) (= e (ConvertFToU a))) ((Live a)))
(rule ((Live e) (= e (ConvertSToF a))) ((Live a)))
(rule ((Live e) (= e (ConvertUToF a))) ((Live a)))
(rule ((Live e) (= e (SConvert a))) ((Live a)))
(rule ((Live e) (= e (UConvert a))) ((Live a)))
(rule ((Live e) (= e (FConvert a))) ((Live a)))
(rule ((Live e) (= e (Bitcast a))) ((Live a)))
(rule ((Live e) (= e (QuantizeToF16 a))) ((Live a)))

; Propagate liveness through composite operations
(rule ((Live e) (= e (CompositeExtract a _))) ((Live a)))
(rule ((Live e) (= e (CompositeInsert a b _))) ((Live a) (Live b)))

; Propagate liveness through CopyObject
(rule ((Live e) (= e (CopyObject x))) ((Live x)))

; Propagate liveness through Sym (external references are always live if referenced)
; Note: Sym nodes don't have subexpressions, so no propagation needed

; =============================================================================
; Copy Propagation (OpCopyObject elimination)
; =============================================================================
; CopyObject is always equivalent to its operand

(rule ((= e (CopyObject x)))
      ((union e x)))

; =============================================================================
; Insert-to-Construct Transformation
; =============================================================================
; A chain of inserts covering all positions becomes a Construct

; Vec2: Insert(Insert(_, v0, 0), v1, 1) = Vec2(v0, v1)
; Note: base is ignored when all positions are overwritten
(rule ((= result (CompositeInsert (CompositeInsert _ v0 0) v1 1)))
      ((union result (Vec2 v0 v1))))

; Vec3: Insert(Insert(Insert(_, v0, 0), v1, 1), v2, 2) = Vec3(v0, v1, v2)
(rule ((= result (CompositeInsert (CompositeInsert (CompositeInsert _ v0 0) v1 1) v2 2)))
      ((union result (Vec3 v0 v1 v2))))

; Vec4: Insert(Insert(Insert(Insert(_, v0, 0), v1, 1), v2, 2), v3, 3) = Vec4(v0, v1, v2, v3)
(rule ((= result (CompositeInsert (CompositeInsert (CompositeInsert (CompositeInsert _ v0 0) v1 1) v2 2) v3 3)))
      ((union result (Vec4 v0 v1 v2 v3))))

; Also using VecInsert constructor
(rule ((= result (VecInsert (VecInsert _ v0 0) v1 1)))
      ((union result (Vec2 v0 v1))))
(rule ((= result (VecInsert (VecInsert (VecInsert _ v0 0) v1 1) v2 2)))
      ((union result (Vec3 v0 v1 v2))))
(rule ((= result (VecInsert (VecInsert (VecInsert (VecInsert _ v0 0) v1 1) v2 2) v3 3)))
      ((union result (Vec4 v0 v1 v2 v3))))

; =============================================================================
; Liveness Propagation for GLSL Extended Instructions
; =============================================================================
; These complete the DCE support for all GLSL.std.450 operations

; Math functions
(rule ((Live e) (= e (Sqrt a))) ((Live a)))
(rule ((Live e) (= e (InverseSqrt a))) ((Live a)))
(rule ((Live e) (= e (Exp a))) ((Live a)))
(rule ((Live e) (= e (Exp2 a))) ((Live a)))
(rule ((Live e) (= e (Log a))) ((Live a)))
(rule ((Live e) (= e (Log2 a))) ((Live a)))
(rule ((Live e) (= e (Pow a b))) ((Live a) (Live b)))

; Trigonometric functions
(rule ((Live e) (= e (Sin a))) ((Live a)))
(rule ((Live e) (= e (Cos a))) ((Live a)))
(rule ((Live e) (= e (Tan a))) ((Live a)))
(rule ((Live e) (= e (Asin a))) ((Live a)))
(rule ((Live e) (= e (Acos a))) ((Live a)))
(rule ((Live e) (= e (Atan a))) ((Live a)))
(rule ((Live e) (= e (Atan2 a b))) ((Live a) (Live b)))

; Hyperbolic functions
(rule ((Live e) (= e (Sinh a))) ((Live a)))
(rule ((Live e) (= e (Cosh a))) ((Live a)))
(rule ((Live e) (= e (Tanh a))) ((Live a)))
(rule ((Live e) (= e (Asinh a))) ((Live a)))
(rule ((Live e) (= e (Acosh a))) ((Live a)))
(rule ((Live e) (= e (Atanh a))) ((Live a)))

; Interpolation and clamping
(rule ((Live e) (= e (FMix a b t))) ((Live a) (Live b) (Live t)))
(rule ((Live e) (= e (SmoothStep e0 e1 x))) ((Live e0) (Live e1) (Live x)))
(rule ((Live e) (= e (FClamp x lo hi))) ((Live x) (Live lo) (Live hi)))
(rule ((Live e) (= e (SClamp x lo hi))) ((Live x) (Live lo) (Live hi)))
(rule ((Live e) (= e (UClamp x lo hi))) ((Live x) (Live lo) (Live hi)))
(rule ((Live e) (= e (NClamp x lo hi))) ((Live x) (Live lo) (Live hi)))

; Geometry functions
(rule ((Live e) (= e (Cross a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (Normalize a))) ((Live a)))
(rule ((Live e) (= e (Length a))) ((Live a)))
(rule ((Live e) (= e (Distance a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (Reflect i n))) ((Live i) (Live n)))
(rule ((Live e) (= e (Refract i n eta))) ((Live i) (Live n) (Live eta)))
(rule ((Live e) (= e (FaceForward n i nref))) ((Live n) (Live i) (Live nref)))

; Additional math
(rule ((Live e) (= e (Fma a b c))) ((Live a) (Live b) (Live c)))
(rule ((Live e) (= e (Fract a))) ((Live a)))
(rule ((Live e) (= e (Modf a))) ((Live a)))
(rule ((Live e) (= e (ModfStruct a))) ((Live a)))
(rule ((Live e) (= e (Ldexp a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (Frexp a))) ((Live a)))
(rule ((Live e) (= e (FrexpStruct a))) ((Live a)))
(rule ((Live e) (= e (Step e x))) ((Live e) (Live x)))

; Sign and absolute value
(rule ((Live e) (= e (Sign a))) ((Live a)))
(rule ((Live e) (= e (FSign a))) ((Live a)))
(rule ((Live e) (= e (SAbs a))) ((Live a)))

; Bit manipulation
(rule ((Live e) (= e (FindILsb a))) ((Live a)))
(rule ((Live e) (= e (FindSMsb a))) ((Live a)))
(rule ((Live e) (= e (FindUMsb a))) ((Live a)))
(rule ((Live e) (= e (BitCount a))) ((Live a)))

; NaN-ignoring min/max
(rule ((Live e) (= e (NMin a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (NMax a b))) ((Live a) (Live b)))

; Pack/Unpack operations
(rule ((Live e) (= e (PackHalf2x16 a))) ((Live a)))
(rule ((Live e) (= e (UnpackHalf2x16 a))) ((Live a)))
(rule ((Live e) (= e (PackSnorm4x8 a))) ((Live a)))
(rule ((Live e) (= e (UnpackSnorm4x8 a))) ((Live a)))
(rule ((Live e) (= e (PackSnorm2x16 a))) ((Live a)))
(rule ((Live e) (= e (UnpackSnorm2x16 a))) ((Live a)))
(rule ((Live e) (= e (PackUnorm4x8 a))) ((Live a)))
(rule ((Live e) (= e (UnpackUnorm4x8 a))) ((Live a)))
(rule ((Live e) (= e (PackUnorm2x16 a))) ((Live a)))
(rule ((Live e) (= e (UnpackUnorm2x16 a))) ((Live a)))
(rule ((Live e) (= e (PackDouble2x32 a))) ((Live a)))
(rule ((Live e) (= e (UnpackDouble2x32 a))) ((Live a)))

; Radians/Degrees conversion
(rule ((Live e) (= e (Radians a))) ((Live a)))
(rule ((Live e) (= e (Degrees a))) ((Live a)))

; Determinant and inverse
(rule ((Live e) (= e (Determinant m))) ((Live m)))
(rule ((Live e) (= e (MatInverse m))) ((Live m)))

; =============================================================================
; Liveness for Memory Operations
; =============================================================================

; Load: both pointer and memory state are live
(rule ((Live e) (= e (Load ptr mem))) ((Live ptr) (Live mem)))

; StoreMem: pointer, value, and previous state are live
(rule ((Live e) (= e (StoreMem ptr val prev))) ((Live ptr) (Live val) (Live prev)))

; MergeMem: condition and both branch states are live
(rule ((Live e) (= e (MergeMem cond then_mem else_mem)))
      ((Live cond) (Live then_mem) (Live else_mem)))

; LoopMem: condition, body state, and init state are live
(rule ((Live e) (= e (LoopMem cond body init)))
      ((Live cond) (Live body) (Live init)))

; Var is a leaf - no propagation needed
(rule ((Live e) (= e (Var _ _))) ())

; Access chains propagate to base
(rule ((Live e) (= e (AccessChain1 base _))) ((Live base)))
(rule ((Live e) (= e (AccessChain2 base _ _))) ((Live base)))
(rule ((Live e) (= e (AccessChain3 base _ _ _))) ((Live base)))
(rule ((Live e) (= e (AccessChainDyn base idx))) ((Live base) (Live idx)))

; Image operations
(rule ((Live e) (= e (ImageSample img coord))) ((Live img) (Live coord)))
(rule ((Live e) (= e (ImageFetch img coord))) ((Live img) (Live coord)))
(rule ((Live e) (= e (ImageRead img coord))) ((Live img) (Live coord)))
(rule ((Live e) (= e (ImageWrite img coord data mem)))
      ((Live img) (Live coord) (Live data) (Live mem)))
(rule ((Live e) (= e (SampledImage img sampler))) ((Live img) (Live sampler)))
(rule ((Live e) (= e (Image sampled))) ((Live sampled)))

; Atomic operations
(rule ((Live e) (= e (AtomicLoad ptr mem))) ((Live ptr) (Live mem)))
(rule ((Live e) (= e (AtomicStore ptr val mem))) ((Live ptr) (Live val) (Live mem)))
(rule ((Live e) (= e (AtomicExchange ptr val mem))) ((Live ptr) (Live val) (Live mem)))
(rule ((Live e) (= e (AtomicCompareExchange ptr cmp val mem)))
      ((Live ptr) (Live cmp) (Live val) (Live mem)))
(rule ((Live e) (= e (AtomicIAdd ptr val mem))) ((Live ptr) (Live val) (Live mem)))
(rule ((Live e) (= e (AtomicISub ptr val mem))) ((Live ptr) (Live val) (Live mem)))
(rule ((Live e) (= e (AtomicSMin ptr val mem))) ((Live ptr) (Live val) (Live mem)))
(rule ((Live e) (= e (AtomicUMin ptr val mem))) ((Live ptr) (Live val) (Live mem)))
(rule ((Live e) (= e (AtomicSMax ptr val mem))) ((Live ptr) (Live val) (Live mem)))
(rule ((Live e) (= e (AtomicUMax ptr val mem))) ((Live ptr) (Live val) (Live mem)))
(rule ((Live e) (= e (AtomicAnd ptr val mem))) ((Live ptr) (Live val) (Live mem)))
(rule ((Live e) (= e (AtomicOr ptr val mem))) ((Live ptr) (Live val) (Live mem)))
(rule ((Live e) (= e (AtomicXor ptr val mem))) ((Live ptr) (Live val) (Live mem)))

; Subgroup operations
(rule ((Live e) (= e (GroupElect))) ())
(rule ((Live e) (= e (GroupAll pred))) ((Live pred)))
(rule ((Live e) (= e (GroupAny pred))) ((Live pred)))
(rule ((Live e) (= e (GroupAllEqual val))) ((Live val)))
(rule ((Live e) (= e (GroupBroadcast val id))) ((Live val) (Live id)))
(rule ((Live e) (= e (GroupBroadcastFirst val))) ((Live val)))
(rule ((Live e) (= e (GroupShuffle val id))) ((Live val) (Live id)))
(rule ((Live e) (= e (GroupShuffleXor val mask))) ((Live val) (Live mask)))
(rule ((Live e) (= e (GroupIAdd val))) ((Live val)))
(rule ((Live e) (= e (GroupFAdd val))) ((Live val)))
(rule ((Live e) (= e (GroupIMul val))) ((Live val)))
(rule ((Live e) (= e (GroupFMul val))) ((Live val)))
(rule ((Live e) (= e (GroupSMin val))) ((Live val)))
(rule ((Live e) (= e (GroupUMin val))) ((Live val)))
(rule ((Live e) (= e (GroupFMin val))) ((Live val)))
(rule ((Live e) (= e (GroupSMax val))) ((Live val)))
(rule ((Live e) (= e (GroupUMax val))) ((Live val)))
(rule ((Live e) (= e (GroupFMax val))) ((Live val)))
(rule ((Live e) (= e (GroupBitAnd val))) ((Live val)))
(rule ((Live e) (= e (GroupBitOr val))) ((Live val)))
(rule ((Live e) (= e (GroupBitXor val))) ((Live val)))
(rule ((Live e) (= e (GroupLogAnd val))) ((Live val)))
(rule ((Live e) (= e (GroupLogOr val))) ((Live val)))
(rule ((Live e) (= e (GroupLogXor val))) ((Live val)))

; =============================================================================
; Liveness for Bitfield Operations
; =============================================================================

(rule ((Live e) (= e (BitFieldInsert base insert offset count)))
      ((Live base) (Live insert) (Live offset) (Live count)))
(rule ((Live e) (= e (BitFieldSExtract base offset count)))
      ((Live base) (Live offset) (Live count)))
(rule ((Live e) (= e (BitFieldUExtract base offset count)))
      ((Live base) (Live offset) (Live count)))
; NOTE: BitReverse, BitCount, FindILsb, FindSMsb, FindUMsb liveness rules
; are already defined in the main bitwise liveness section above

; =============================================================================
; Liveness for Image Query Operations
; =============================================================================

(rule ((Live e) (= e (ImageQuerySize img))) ((Live img)))
(rule ((Live e) (= e (ImageQuerySizeLod img lod))) ((Live img) (Live lod)))
(rule ((Live e) (= e (ImageQueryLevels img))) ((Live img)))
(rule ((Live e) (= e (ImageQuerySamples img))) ((Live img)))
(rule ((Live e) (= e (ImageQueryLod img coord))) ((Live img) (Live coord)))

; =============================================================================
; Liveness for Function Calls
; =============================================================================

(rule ((Live e) (= e (Call1 _ a))) ((Live a)))
(rule ((Live e) (= e (Call2 _ a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (Call3 _ a b c))) ((Live a) (Live b) (Live c)))
(rule ((Live e) (= e (Call4 _ a b c d))) ((Live a) (Live b) (Live c) (Live d)))
(rule ((Live e) (= e (Subst body _ val))) ((Live body) (Live val)))
(rule ((Live e) (= e (Arg _))) ())

; =============================================================================
; Liveness for Specialization Constants
; =============================================================================

; SpecConst is a leaf
(rule ((Live e) (= e (SpecConst _ _))) ())

; Spec constant operations
(rule ((Live e) (= e (SpecAdd a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SpecSub a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SpecMul a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SpecSDiv a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SpecUDiv a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SpecSMod a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SpecUMod a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SpecShl a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SpecShrS a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SpecShrU a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SpecBitAnd a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SpecBitOr a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SpecBitXor a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SpecEq a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SpecNe a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SpecSLt a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SpecULt a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (SpecSelect c t f))) ((Live c) (Live t) (Live f)))

; =============================================================================
; Liveness for Loop Unrolling
; =============================================================================

(rule ((Live e) (= e (BoundedTheta _ body init))) ((Live body) (Live init)))
(rule ((Live e) (= e (LoopIter _ val))) ((Live val)))

; =============================================================================
; Liveness for Derivative Operations
; =============================================================================

(rule ((Live e) (= e (DPdx a))) ((Live a)))
(rule ((Live e) (= e (DPdy a))) ((Live a)))
(rule ((Live e) (= e (DPdxFine a))) ((Live a)))
(rule ((Live e) (= e (DPdyFine a))) ((Live a)))
(rule ((Live e) (= e (DPdxCoarse a))) ((Live a)))
(rule ((Live e) (= e (DPdyCoarse a))) ((Live a)))
(rule ((Live e) (= e (Fwidth a))) ((Live a)))
(rule ((Live e) (= e (FwidthFine a))) ((Live a)))
(rule ((Live e) (= e (FwidthCoarse a))) ((Live a)))

; InitMem is a leaf
(rule ((Live e) (= e (InitMem))) ())
