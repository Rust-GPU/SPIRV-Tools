(rule ((Live e) (= e (FAdd a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FSub a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FMul a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FDiv a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FNeg a))) ((Live a)))
(rule ((Live e) (= e (FRem a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FMin a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FMax a b))) ((Live a) (Live b)))
(rule ((Live e) (= e (FAbs a))) ((Live a)))
(rule ((Live e) (= e (FFloor a))) ((Live a)))
(rule ((Live e) (= e (FCeil a))) ((Live a)))
(rule ((Live e) (= e (FTrunc a))) ((Live a)))
(rule ((Live e) (= e (FRound a))) ((Live a)))

