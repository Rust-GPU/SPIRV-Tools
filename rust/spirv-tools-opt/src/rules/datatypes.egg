(constructor FOrdNe (FloatExpr FloatExpr) BoolExpr)
(constructor FOrdLt (FloatExpr FloatExpr) BoolExpr)
(constructor FOrdLe (FloatExpr FloatExpr) BoolExpr)
(constructor FOrdGt (FloatExpr FloatExpr) BoolExpr)
(constructor FOrdGe (FloatExpr FloatExpr) BoolExpr)

