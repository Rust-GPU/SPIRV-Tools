(constructor GroupAllEqual (Expr) BoolExpr)
(constructor GroupLogAnd (BoolExpr) BoolExpr)
(constructor GroupLogOr (BoolExpr) BoolExpr)
(constructor GroupLogXor (BoolExpr) BoolExpr)

; Vector boolean predicates
(constructor Any (Expr) BoolExpr)
(constructor All (Expr) BoolExpr)

; Overflow/comparison predicates (return bool from int ops)
(constructor AddOverflows (IntExpr IntExpr) BoolExpr)
(constructor SubOverflows (IntExpr IntExpr) BoolExpr)
(constructor MulOverflows (IntExpr IntExpr) BoolExpr)
(constructor FApproxEq (FloatExpr FloatExpr) BoolExpr)

; =============================================================================
; Bridge Constructors — Connect typed sorts to Expr
; =============================================================================
; Used when typed scalar values need to participate in type-agnostic
; operations (vectors, memory, effects).

(constructor IntToExpr (IntExpr) Expr)
(constructor FloatToExpr (FloatExpr) Expr)
(constructor BoolToExpr (BoolExpr) Expr)

; Reverse bridges — for when Expr values feed into typed operations
; (e.g., VecExtract result used in FMul)
(constructor ExprToInt (Expr) IntExpr)
(constructor ExprToFloat (Expr) FloatExpr)
(constructor ExprToBool (Expr) BoolExpr)

; Round-trip cancellation: bridge(reverse-bridge(x)) = x
; These are essential for typed substitution to produce simplified results.
(rule ((= e (ExprToInt (IntToExpr x)))) ((union e x)))
(rule ((= e (ExprToFloat (FloatToExpr x)))) ((union e x)))
(rule ((= e (ExprToBool (BoolToExpr x)))) ((union e x)))
(rule ((= e (IntToExpr (ExprToInt x)))) ((union e x)))
(rule ((= e (FloatToExpr (ExprToFloat x)))) ((union e x)))
(rule ((= e (BoolToExpr (ExprToBool x)))) ((union e x)))

; =============================================================================
; Expr — Type-agnostic operations (vectors, matrices, memory, images, etc.)
; =============================================================================

; Generic control flow (for non-scalar types like vectors, structs)
(constructor Gamma (BoolExpr Expr Expr) Expr)
(constructor Select (BoolExpr Expr Expr) Expr)
(constructor If (BoolExpr Expr Expr) Expr)
(constructor Theta (BoolExpr Expr Expr) Expr)
(constructor LoopVar () Expr)
(constructor LoopInvariant (Expr) Expr)
(constructor Sym (String) Expr)
(constructor CopyObject (Expr) Expr)
(constructor Undef () Expr)
(constructor Arg (i64) Expr)

; Vector construction and extraction
(constructor Vec2 (Expr Expr) Expr)
(constructor Vec3 (Expr Expr Expr) Expr)
(constructor Vec4 (Expr Expr Expr Expr) Expr)
(constructor VecExtract (Expr i64) Expr)
(constructor VecInsert (Expr Expr i64) Expr)
(constructor VecShuffle2 (Expr Expr i64 i64) Expr)
(constructor VecShuffle3 (Expr Expr i64 i64 i64) Expr)
(constructor VecShuffle4 (Expr Expr i64 i64 i64 i64) Expr)
