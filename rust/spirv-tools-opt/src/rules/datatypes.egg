(constructor ConvertSToF (IntExpr) FloatExpr)
(constructor ConvertUToF (IntExpr) FloatExpr)
(constructor FConvert (FloatExpr) FloatExpr)

; Unpacking (int input → vector/float result kept in Expr for vec returns)
; Note: Unpack ops return vectors, so they stay in Expr via cross-sort constructors below

; Typed control flow
(constructor FSym (String) FloatExpr)
(constructor GammaF (BoolExpr FloatExpr FloatExpr) FloatExpr)
(constructor SelectF (BoolExpr FloatExpr FloatExpr) FloatExpr)
(constructor IfF (BoolExpr FloatExpr FloatExpr) FloatExpr)
(constructor ThetaF (BoolExpr FloatExpr FloatExpr) FloatExpr)
(constructor LoopVarF () FloatExpr)
(constructor LoopInvariantF (FloatExpr) FloatExpr)
(constructor CopyF (FloatExpr) FloatExpr)

; Subgroup float reductions
(constructor GroupFAdd (FloatExpr) FloatExpr)
(constructor GroupFMul (FloatExpr) FloatExpr)
(constructor GroupFMin (FloatExpr) FloatExpr)
(constructor GroupFMax (FloatExpr) FloatExpr)

