; =============================================================================
; GLSL Extended Instruction Rules
; =============================================================================

; =============================================================================
; FMix (Linear Interpolation)
; =============================================================================

; FMix(a, a, t) = a - ONE-DIRECTIONAL
(rule ((= e (FMix a a t)))
      ((union e a)))

; FMix(a, b, 0) = a - ONE-DIRECTIONAL (when t=0.0, return first arg)
(rule ((= e (FMix a b (FConst c))) (= c 0.0))
      ((union e a)))

; FMix(a, b, 1) = b - ONE-DIRECTIONAL (when t=1.0, return second arg)
(rule ((= e (FMix a b (FConst c))) (= c 1.0))
      ((union e b)))

; RedundantFMix from C++ - matches GLSL FMix folding rules

; =============================================================================
; Clamp Operations
; =============================================================================

; Clamp with equal bounds returns the bound - ONE-DIRECTIONAL
(rule ((= e (FClamp x a a)))
      ((union e a)))
(rule ((= e (SClamp x a a)))
      ((union e a)))
(rule ((= e (UClamp x a a)))
      ((union e a)))

; Clamp is idempotent when bounds are the same - ONE-DIRECTIONAL
(rule ((= e (FClamp (FClamp x lo hi) lo hi)))
      ((union e (FClamp x lo hi))))
(rule ((= e (SClamp (SClamp x lo hi) lo hi)))
      ((union e (SClamp x lo hi))))
(rule ((= e (UClamp (UClamp x lo hi) lo hi)))
      ((union e (UClamp x lo hi))))

; =============================================================================
; Clamp Feeding Comparison (C++ FoldFClampFeedingCompare parity)
; =============================================================================
; When a clamped value is compared against a bound, we can simplify based on
; the clamp constraining the value range.

; FClamp(x, lo, hi) < lo => false (clamped value is always >= lo)
(rule ((= e (FOrdLt (FClamp x lo hi) lo)))
      ((union e (BoolConst 0))))
(rule ((= e (FUnordLt (FClamp x lo hi) lo)))
      ((union e (BoolConst 0))))

; FClamp(x, lo, hi) > hi => false (clamped value is always <= hi)
(rule ((= e (FOrdGt (FClamp x lo hi) hi)))
      ((union e (BoolConst 0))))
(rule ((= e (FUnordGt (FClamp x lo hi) hi)))
      ((union e (BoolConst 0))))

; FClamp(x, lo, hi) >= lo => true (clamped value is always >= lo)
(rule ((= e (FOrdGe (FClamp x lo hi) lo)))
      ((union e (BoolConst 1))))
(rule ((= e (FUnordGe (FClamp x lo hi) lo)))
      ((union e (BoolConst 1))))

; FClamp(x, lo, hi) <= hi => true (clamped value is always <= hi)
(rule ((= e (FOrdLe (FClamp x lo hi) hi)))
      ((union e (BoolConst 1))))
(rule ((= e (FUnordLe (FClamp x lo hi) hi)))
      ((union e (BoolConst 1))))

; lo < FClamp(x, lo, hi) => x > lo (clamp is > lo iff x is > lo)
; This is more complex - simplified form: just compare x directly
; lo <= FClamp(x, lo, hi) => true
(rule ((= e (FOrdLe lo (FClamp x lo hi))))
      ((union e (BoolConst 1))))
(rule ((= e (FUnordLe lo (FClamp x lo hi))))
      ((union e (BoolConst 1))))

; hi >= FClamp(x, lo, hi) => true
(rule ((= e (FOrdGe hi (FClamp x lo hi))))
      ((union e (BoolConst 1))))
(rule ((= e (FUnordGe hi (FClamp x lo hi))))
      ((union e (BoolConst 1))))

; Similar rules for signed integer clamp
; SClamp(x, lo, hi) < lo => false
(rule ((= e (SLt (SClamp x lo hi) lo)))
      ((union e (BoolConst 0))))
; SClamp(x, lo, hi) > hi => false
(rule ((= e (SGt (SClamp x lo hi) hi)))
      ((union e (BoolConst 0))))
; SClamp(x, lo, hi) >= lo => true
(rule ((= e (SGe (SClamp x lo hi) lo)))
      ((union e (BoolConst 1))))
; SClamp(x, lo, hi) <= hi => true
(rule ((= e (SLe (SClamp x lo hi) hi)))
      ((union e (BoolConst 1))))

; Similar rules for unsigned integer clamp
; UClamp(x, lo, hi) < lo => false
(rule ((= e (ULt (UClamp x lo hi) lo)))
      ((union e (BoolConst 0))))
; UClamp(x, lo, hi) > hi => false
(rule ((= e (UGt (UClamp x lo hi) hi)))
      ((union e (BoolConst 0))))
; UClamp(x, lo, hi) >= lo => true
(rule ((= e (UGe (UClamp x lo hi) lo)))
      ((union e (BoolConst 1))))
; UClamp(x, lo, hi) <= hi => true
(rule ((= e (ULe (UClamp x lo hi) hi)))
      ((union e (BoolConst 1))))

; =============================================================================
; Min/Max Simplifications
; =============================================================================

; Note: FMin/FMax idempotent, commutative, associative rules are in floating_point.egg

; Recognize clamp expressed as nested min/max - ONE-DIRECTIONAL
; max(lo, min(x, hi)) = clamp(x, lo, hi) - prefer the compact clamp form
(rule ((= e (FMax lo (FMin x hi))))
      ((union e (FClamp x lo hi))))

; =============================================================================
; Square Root and Inverse Square Root
; =============================================================================

; sqrt(x*x) = abs(x) (for non-negative x conceptually)
; InverseSqrt(1) = 1
; InverseSqrt(InverseSqrt(x)) related to sqrt

; Sqrt of 1 is 1 (conceptual - needs float constant support)
; InverseSqrt * Sqrt = 1 (conceptual)

; x * InverseSqrt(x) = Sqrt(x) (strength reduction) - ONE-DIRECTIONAL
(rule ((= e (FMul x (InverseSqrt x))))
      ((union e (Sqrt x))))
(rule ((= e (FMul (InverseSqrt x) x)))
      ((union e (Sqrt x))))

; 1.0 / Sqrt(x) = InverseSqrt(x) - ONE-DIRECTIONAL (prefer InverseSqrt)
(rule ((= e (FDiv (FConst c) (Sqrt x))) (= c 1.0))
      ((union e (InverseSqrt x))))

; Sqrt(x) * Sqrt(x) = x - ONE-DIRECTIONAL
(rule ((= e (FMul (Sqrt x) (Sqrt x))))
      ((union e x)))

; =============================================================================
; Exponential and Logarithm
; =============================================================================

; Log(Exp(x)) = x - ONE-DIRECTIONAL
(rule ((= e (Log (Exp x))))
      ((union e x)))

; Exp(Log(x)) = x (for positive x) - ONE-DIRECTIONAL
(rule ((= e (Exp (Log x))))
      ((union e x)))

; Log2(Exp2(x)) = x - ONE-DIRECTIONAL
(rule ((= e (Log2 (Exp2 x))))
      ((union e x)))

; Exp2(Log2(x)) = x - ONE-DIRECTIONAL
(rule ((= e (Exp2 (Log2 x))))
      ((union e x)))

; Exp(0) = 1 - ONE-DIRECTIONAL
(rule ((= e (Exp (FConst c))) (= c 0.0))
      ((union e (FConst 1.0))))
(rule ((= e (Exp2 (FConst c))) (= c 0.0))
      ((union e (FConst 1.0))))

; Log(1) = 0 - ONE-DIRECTIONAL
(rule ((= e (Log (FConst c))) (= c 1.0))
      ((union e (FConst 0.0))))
(rule ((= e (Log2 (FConst c))) (= c 1.0))
      ((union e (FConst 0.0))))

; Exp(a) * Exp(b) = Exp(a + b) - ONE-DIRECTIONAL (combine exps)
(rule ((= e (FMul (Exp a) (Exp b))))
      ((union e (Exp (FAdd a b)))))
(rule ((= e (FMul (Exp2 a) (Exp2 b))))
      ((union e (Exp2 (FAdd a b)))))

; Log(a) + Log(b) = Log(a * b) - ONE-DIRECTIONAL (combine logs)
(rule ((= e (FAdd (Log a) (Log b))))
      ((union e (Log (FMul a b)))))
(rule ((= e (FAdd (Log2 a) (Log2 b))))
      ((union e (Log2 (FMul a b)))))

; Log(a) - Log(b) = Log(a / b) - ONE-DIRECTIONAL (combine logs)
(rule ((= e (FSub (Log a) (Log b))))
      ((union e (Log (FDiv a b)))))
(rule ((= e (FSub (Log2 a) (Log2 b))))
      ((union e (Log2 (FDiv a b)))))

; =============================================================================
; Power Function
; =============================================================================

; Pow(x, 0) = 1 (conceptual)
; Pow(x, 1) = x
; Pow(x, 2) = x * x

; Pow(x, -1) = 1/x - defined in floating_point.egg

; Pow expressed via Exp/Log: Pow(a, b) = Exp(b * Log(a))
; This enables more algebraic manipulation

; =============================================================================
; Trigonometric Functions
; =============================================================================

; Sin(0) = 0 - ONE-DIRECTIONAL
(rule ((= e (Sin (FConst c))) (= c 0.0))
      ((union e (FConst 0.0))))

; Cos(0) = 1 - ONE-DIRECTIONAL
(rule ((= e (Cos (FConst c))) (= c 0.0))
      ((union e (FConst 1.0))))

; Tan(0) = 0 - ONE-DIRECTIONAL
(rule ((= e (Tan (FConst c))) (= c 0.0))
      ((union e (FConst 0.0))))

; Sinh(0) = 0, Cosh(0) = 1, Tanh(0) = 0 - ONE-DIRECTIONAL
(rule ((= e (Sinh (FConst c))) (= c 0.0))
      ((union e (FConst 0.0))))
(rule ((= e (Cosh (FConst c))) (= c 0.0))
      ((union e (FConst 1.0))))
(rule ((= e (Tanh (FConst c))) (= c 0.0))
      ((union e (FConst 0.0))))

; Negation pulling - ONE-DIRECTIONAL (pull FNeg outside trig functions)
; Sin(-x) = -Sin(x)
(rule ((= e (Sin (FNeg x))))
      ((union e (FNeg (Sin x)))))
; Cos(-x) = Cos(x) (even function)
(rule ((= e (Cos (FNeg x))))
      ((union e (Cos x))))
; Tan(-x) = -Tan(x)
(rule ((= e (Tan (FNeg x))))
      ((union e (FNeg (Tan x)))))

; Sinh/Cosh/Tanh negation - ONE-DIRECTIONAL
; Sinh(-x) = -Sinh(x)
(rule ((= e (Sinh (FNeg x))))
      ((union e (FNeg (Sinh x)))))
; Cosh(-x) = Cosh(x) (even function)
(rule ((= e (Cosh (FNeg x))))
      ((union e (Cosh x))))
; Tanh(-x) = -Tanh(x)
(rule ((= e (Tanh (FNeg x))))
      ((union e (FNeg (Tanh x)))))

; Inverse trig cancellations (valid for principal value ranges) - ONE-DIRECTIONAL
; Note: These are mathematically valid only in restricted domains,
; but for shader optimization we assume inputs are in valid ranges
(rule ((= e (Asin (Sin x))))
      ((union e x)))
(rule ((= e (Acos (Cos x))))
      ((union e x)))
(rule ((= e (Atan (Tan x))))
      ((union e x)))
(rule ((= e (Sin (Asin x))))
      ((union e x)))
(rule ((= e (Cos (Acos x))))
      ((union e x)))
(rule ((= e (Tan (Atan x))))
      ((union e x)))

; Inverse hyperbolic cancellations - ONE-DIRECTIONAL
(rule ((= e (Asinh (Sinh x))))
      ((union e x)))
(rule ((= e (Sinh (Asinh x))))
      ((union e x)))
(rule ((= e (Acosh (Cosh x))))
      ((union e x)))
(rule ((= e (Cosh (Acosh x))))
      ((union e x)))
(rule ((= e (Atanh (Tanh x))))
      ((union e x)))
(rule ((= e (Tanh (Atanh x))))
      ((union e x)))

; Recognize Tan pattern - ONE-DIRECTIONAL (prefer Tan over Sin/Cos)
; Sin(x) / Cos(x) = Tan(x)
(rule ((= e (FDiv (Sin x) (Cos x))))
      ((union e (Tan x))))

; sin^2 + cos^2 = 1 (Pythagorean identity)
; This is hard to express directly but can help with extraction

; =============================================================================
; Fused Multiply-Add
; =============================================================================

; Fma(a, b, c) = a*b + c (definition, for expansion if needed)
; But prefer Fma when available (single rounding, faster)

; DISABLED: Fma recognition — fires on every FAdd(FMul(...), ...) pattern,
; creating new Fma nodes that cause exponential growth in matrix-heavy shaders.
; Fma simplification rules below still work if Fma is already in the graph.
; (rule ((= e (FAdd (FMul a b) c)))
;       ((union e (Fma a b c))))
; (rule ((= e (FAdd c (FMul a b))))
;       ((union e (Fma a b c))))

; Fma with zero - ONE-DIRECTIONAL (simplify, don't expand)
(rule ((= e (Fma a b (FConst c))) (= c 0.0))
      ((union e (FMul a b))))

; Fma with one - ONE-DIRECTIONAL (simplify, don't expand)
(rule ((= e (Fma (FConst c) b d)) (= c 1.0))
      ((union e (FAdd b d))))
(rule ((= e (Fma a (FConst c) d)) (= c 1.0))
      ((union e (FAdd a d))))

; =============================================================================
; Absolute Value and Sign
; =============================================================================

; Note: FAbs(FAbs x) = FAbs x is in floating_point.egg

; SAbs idempotent - ONE-DIRECTIONAL
(rule ((= e (SAbs (SAbs x))))
      ((union e (SAbs x))))

; SAbs of negation - ONE-DIRECTIONAL
(rule ((= e (SAbs (Neg x))))
      ((union e (SAbs x))))

; sign(sign(x)) simplification - ONE-DIRECTIONAL
(rule ((= e (FSign (FSign x))))
      ((union e (FSign x))))
(rule ((= e (Sign (Sign x))))
      ((union e (Sign x))))

; abs(x) * sign(x) = x - ONE-DIRECTIONAL
(rule ((= e (FMul (FAbs x) (FSign x))))
      ((union e x)))
(rule ((= e (FMul (FSign x) (FAbs x))))
      ((union e x)))

; =============================================================================
; Length, Distance, Normalize
; =============================================================================

; Distance(a, a) = 0
; Note: This would produce a float zero, not FConst 0.0

; Length of normalized vector is 1
; Normalize(Normalize(x)) = Normalize(x) (idempotent for non-zero) - ONE-DIRECTIONAL
(rule ((= e (Normalize (Normalize x))))
      ((union e (Normalize x))))

; =============================================================================
; Cross Product
; =============================================================================

; Cross product anti-commutativity: a x b = -(b x a) - ONE-DIRECTIONAL
; Only apply when we can simplify the negation (avoid cycles)
; Recognize VecNeg(Cross(b,a)) = Cross(a,b)
(rule ((= e (VecNeg (Cross b a))))
      ((union e (Cross a b))))

; Cross product with self is zero vector
; (rewrite (Cross a a) (Vec3 (FloatToExpr (FConst 0.0)) (FloatToExpr (FConst 0.0)) (FloatToExpr (FConst 0.0))))
; Disabled: Need proper vector zero representation

; =============================================================================
; Reflect and Refract
; =============================================================================

; Reflect with zero normal (conceptual)
; Reflect(I, N) = I - 2*dot(N,I)*N

; =============================================================================
; Step Function
; =============================================================================

; Step(edge, x) = 0 if x < edge, else 1
; Step(a, a) = 1 (x >= edge when x == edge)

; =============================================================================
; SmoothStep
; =============================================================================

; SmoothStep(a, b, a) = 0 (at left edge)
; SmoothStep(a, b, b) = 1 (at right edge)
; SmoothStep(a, a, x) = undefined/clamped

; =============================================================================
; Fract
; =============================================================================

; Recognize Fract pattern - ONE-DIRECTIONAL (prefer Fract over FSub/FFloor)
; x - Floor(x) = Fract(x)
(rule ((= e (FSub x (FFloor x))))
      ((union e (Fract x))))

; Fract(Fract(x)) = Fract(x) (idempotent for positive x) - ONE-DIRECTIONAL
(rule ((= e (Fract (Fract x))))
      ((union e (Fract x))))

; =============================================================================
; Bit Manipulation (GLSL)
; =============================================================================

; BitCount(0) = 0 (conceptual)
; FindILsb(0) = -1 (conceptual)
; FindSMsb/FindUMsb patterns

; BitCount of constant 0
(rule ((= e (BitCount (Const 0))))
      ((union e (Const 0))))

; FindILsb of 0 returns -1
(rule ((= e (FindILsb (Const 0))))
      ((union e (Const -1))))

; FindSMsb of 0 returns -1
(rule ((= e (FindSMsb (Const 0))))
      ((union e (Const -1))))

; FindUMsb of 0 returns -1
(rule ((= e (FindUMsb (Const 0))))
      ((union e (Const -1))))

; =============================================================================
; Additional GLSL Simplifications (C++ Parity)
; =============================================================================

; Sqrt simplifications - defined in floating_point.egg
; Pow simplifications - defined in floating_point.egg

; Clamp with value already within bounds
; clamp(clamp(x, a, b), a, b) = clamp(x, a, b) - already covered above

; FMix edge cases
; FMix(x, y, 0) = x
; FMix(x, y, 1) = y
; These require float constants which we represent as FConst

; Step simplifications
; step(e, x) where x >= e returns 1, x < e returns 0
; These require runtime knowledge

; SmoothStep edge cases - ONE-DIRECTIONAL
(rule ((= e (SmoothStep x x t)))
      ((union e x)))

; Distance of same vector is 0
; Distance(v, v) = 0.0 - needs float zero

; Length of zero vector is 0
; Normalize of unit vector is itself

; Cross product of parallel vectors is zero
; Cross(v, v) = vec3(0) - needs vector zero

; =============================================================================
; Sign and Absolute Value Relationships
; =============================================================================

; sign(-x) = -sign(x) - ONE-DIRECTIONAL
(rule ((= e (FSign (FNeg x))))
      ((union e (FNeg (FSign x)))))
(rule ((= e (Sign (Neg x))))
      ((union e (Neg (Sign x)))))

; abs(abs(x)) = abs(x) - already in floating_point.egg for FAbs

; sign(abs(x)) = sign(x) when x != 0
; This is more complex to express

; Note: Radians/Degrees and NMin/NMax/NClamp rules are in type_conversion.egg
; Note: Pack/Unpack rules are in type_conversion.egg

; =============================================================================
; Ldexp and Frexp Relationships
; =============================================================================

; Ldexp(x, 0) = x (multiply by 2^0 = 1)
; This would need integer 0 constant detection

; =============================================================================
; Fma Optimizations (beyond what's above)
; =============================================================================

; Fma(0, b, c) = c - ONE-DIRECTIONAL
(rule ((= e (Fma (FConst c1) b c)) (= c1 0.0))
      ((union e c)))
(rule ((= e (Fma a (FConst c1) c)) (= c1 0.0))
      ((union e c)))

; Fma(a, b, 0) = a * b - already covered above

; Fma(-1, b, c) = c - b - ONE-DIRECTIONAL
(rule ((= e (Fma (FConst c1) b c)) (= c1 -1.0))
      ((union e (FSub c b))))
(rule ((= e (Fma a (FConst c1) c)) (= c1 -1.0))
      ((union e (FSub c a))))

; =============================================================================
; Additional GLSL Loop Invariant Rules
; =============================================================================

; Trig functions loop invariant (some already in rvsdg.egg, add remaining) - ONE-DIRECTIONAL
(rule ((= e (Asin (LoopInvariantF x))))
      ((union e (LoopInvariantF (Asin x)))))
(rule ((= e (Acos (LoopInvariantF x))))
      ((union e (LoopInvariantF (Acos x)))))
(rule ((= e (Atan (LoopInvariantF x))))
      ((union e (LoopInvariantF (Atan x)))))
(rule ((= e (Atan2 (LoopInvariantF a) (LoopInvariantF b))))
      ((union e (LoopInvariantF (Atan2 a b)))))
(rule ((= e (Sinh (LoopInvariantF x))))
      ((union e (LoopInvariantF (Sinh x)))))
(rule ((= e (Cosh (LoopInvariantF x))))
      ((union e (LoopInvariantF (Cosh x)))))
(rule ((= e (Tanh (LoopInvariantF x))))
      ((union e (LoopInvariantF (Tanh x)))))
(rule ((= e (Asinh (LoopInvariantF x))))
      ((union e (LoopInvariantF (Asinh x)))))
(rule ((= e (Acosh (LoopInvariantF x))))
      ((union e (LoopInvariantF (Acosh x)))))
(rule ((= e (Atanh (LoopInvariantF x))))
      ((union e (LoopInvariantF (Atanh x)))))

; Mixed functions loop invariant - ONE-DIRECTIONAL
(rule ((= e (FMix (LoopInvariantF a) (LoopInvariantF b) (LoopInvariantF t))))
      ((union e (LoopInvariantF (FMix a b t)))))
(rule ((= e (SmoothStep (LoopInvariantF e0) (LoopInvariantF e1) (LoopInvariantF x))))
      ((union e (LoopInvariantF (SmoothStep e0 e1 x)))))
(rule ((= e (Step (LoopInvariantF e) (LoopInvariantF x))))
      ((union e (LoopInvariantF (Step e x)))))
(rule ((= e (FClamp (LoopInvariantF x) (LoopInvariantF lo) (LoopInvariantF hi))))
      ((union e (LoopInvariantF (FClamp x lo hi)))))
(rule ((= e (SClamp (LoopInvariantI x) (LoopInvariantI lo) (LoopInvariantI hi))))
      ((union e (LoopInvariantI (SClamp x lo hi)))))
(rule ((= e (UClamp (LoopInvariantI x) (LoopInvariantI lo) (LoopInvariantI hi))))
      ((union e (LoopInvariantI (UClamp x lo hi)))))

; Geometry functions loop invariant - ONE-DIRECTIONAL
; Note: Distance, Reflect, Refract, FaceForward take Expr arguments
(rule ((= e (Distance (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariantF (Distance a b)))))
(rule ((= e (Reflect (LoopInvariant i) (LoopInvariant n))))
      ((union e (LoopInvariant (Reflect i n)))))
(rule ((= e (Refract (LoopInvariant i) (LoopInvariant n) (LoopInvariant eta))))
      ((union e (LoopInvariant (Refract i n eta)))))
(rule ((= e (FaceForward (LoopInvariant n) (LoopInvariant i) (LoopInvariant nref))))
      ((union e (LoopInvariant (FaceForward n i nref)))))

; Fract and Modf loop invariant - ONE-DIRECTIONAL
(rule ((= e (Fract (LoopInvariantF x))))
      ((union e (LoopInvariantF (Fract x)))))
(rule ((= e (Modf (LoopInvariantF x))))
      ((union e (LoopInvariantF (Modf x)))))
(rule ((= e (ModfStruct (LoopInvariantF x))))
      ((union e (LoopInvariant (ModfStruct x)))))
(rule ((= e (FSign (LoopInvariantF x))))
      ((union e (LoopInvariantF (FSign x)))))
(rule ((= e (SAbs (LoopInvariantI x))))
      ((union e (LoopInvariantI (SAbs x)))))
(rule ((= e (Fma (LoopInvariantF a) (LoopInvariantF b) (LoopInvariantF c))))
      ((union e (LoopInvariantF (Fma a b c)))))

; Bit manipulation loop invariant - ONE-DIRECTIONAL
(rule ((= e (BitCount (LoopInvariantI x))))
      ((union e (LoopInvariantI (BitCount x)))))
(rule ((= e (FindILsb (LoopInvariantI x))))
      ((union e (LoopInvariantI (FindILsb x)))))
(rule ((= e (FindSMsb (LoopInvariantI x))))
      ((union e (LoopInvariantI (FindSMsb x)))))
(rule ((= e (FindUMsb (LoopInvariantI x))))
      ((union e (LoopInvariantI (FindUMsb x)))))
(rule ((= e (BitReverse (LoopInvariantI x))))
      ((union e (LoopInvariantI (BitReverse x)))))

; =============================================================================
; Gamma Distribution for GLSL Functions
; =============================================================================
; Note: Most Gamma distribution rules are in rvsdg.egg. Here we only add
; specialized GLSL patterns not covered there.

; Clamp with same bounds: select(c, clamp(a, lo, hi), clamp(b, lo, hi)) = clamp(select(c, a, b), lo, hi)
; ONE-DIRECTIONAL (prefer clamp outside gamma)
(rule ((= e (GammaF c (FClamp a lo hi) (FClamp b lo hi))))
      ((union e (FClamp (GammaF c a b) lo hi))))
(rule ((= e (GammaI c (SClamp a lo hi) (SClamp b lo hi))))
      ((union e (SClamp (GammaI c a b) lo hi))))
(rule ((= e (GammaI c (UClamp a lo hi) (UClamp b lo hi))))
      ((union e (UClamp (GammaI c a b) lo hi))))

; =============================================================================
; More FMix Optimizations
; =============================================================================

; FMix is linear in first two arguments
; FMix(a, b, t) = a * (1-t) + b * t
; FMix(x, x, t) = x (already covered)

; FMix with constant t
; FMix(a, b, 0.5) = (a + b) / 2 (midpoint)

; Recognize FMix pattern - ONE-DIRECTIONAL (prefer FMix over expanded form)
; a * (1-t) + b * t = FMix(a, b, t)
(rule ((= e (FAdd (FMul a (FSub (FConst c) t)) (FMul b t))) (= c 1.0))
      ((union e (FMix a b t))))

; =============================================================================
; Pow Optimization Patterns
; =============================================================================

; Pow(x, 0.5) = Sqrt(x)
; Pow(x, -0.5) = InverseSqrt(x)
; Note: These need float constant representation

; Pow(x, n) for small integer n can be expanded
; Pow(x, 3) = x * x * x

; =============================================================================
; Sqrt/InverseSqrt Additional Rules
; =============================================================================

; InverseSqrt(x) * InverseSqrt(y) = InverseSqrt(x * y) - ONE-DIRECTIONAL
(rule ((= e (FMul (InverseSqrt x) (InverseSqrt y))))
      ((union e (InverseSqrt (FMul x y)))))

; Sqrt(x) / Sqrt(y) = Sqrt(x/y) - ONE-DIRECTIONAL
(rule ((= e (FDiv (Sqrt x) (Sqrt y))))
      ((union e (Sqrt (FDiv x y)))))

; InverseSqrt(x) / InverseSqrt(y) = Sqrt(x/y) / x (complex)

; =============================================================================
; Trigonometric Identities
; =============================================================================

; sin(x)^2 + cos(x)^2 = 1 is hard to match directly
; But we can recognize: 1 - sin(x)^2 = cos(x)^2

; sin(2x) = 2*sin(x)*cos(x) (double angle)
; cos(2x) = cos^2(x) - sin^2(x)

; sin(a+b) and cos(a+b) expansions are complex

; =============================================================================
; Atan2 Simplifications
; =============================================================================

; Atan2(y, x) where both are constants would be folded
; Atan2(0, x) = 0 when x > 0, pi when x < 0
; Atan2(y, 0) = pi/2 when y > 0, -pi/2 when y < 0

; Atan2(y, x) = Atan(y/x) when x > 0 (quadrant I or IV)

; =============================================================================
; Ldexp Simplifications
; =============================================================================

; Ldexp(x, 0) = x (multiply by 2^0 = 1) - ONE-DIRECTIONAL
; Note: Ldexp exponent is IntExpr, so (Const 0) is correct
(rule ((= e (Ldexp x (Const 0))))
      ((union e x)))

; Ldexp(x, 1) = x * 2 - ONE-DIRECTIONAL
; Note: Ldexp exponent is INTEGER (IntExpr), so (Const 1) is correct
; Output is FloatExpr, so we use FConst 2.0
(rule ((= e (Ldexp x (Const 1))))
      ((union e (FMul x (FConst 2.0)))))

; Ldexp(x, -1) = x / 2 = x * 0.5

; =============================================================================
; IsNan/IsInf Simplifications
; =============================================================================

; IsNan(constant) = false for non-NaN constants
; IsInf(constant) = false for finite constants

; IsNan on integer converted to float is always false - ONE-DIRECTIONAL
; Note: IsNan(FloatExpr) -> BoolExpr, ConvertSToF(IntExpr) -> FloatExpr
(rule ((= e (IsNan (ConvertSToF x))))
      ((union e (BoolConst 0))))
(rule ((= e (IsNan (ConvertUToF x))))
      ((union e (BoolConst 0))))

; =============================================================================
; VecFMix Decomposition (C++ FMixFeedingExtract parity)
; =============================================================================
; VecFMix(Expr, Expr, Expr) -> Expr is the vector variant of FMix.
; Decompose VecExtract(VecFMix(x, y, a), i) into scalar FMix on elements.
; Existing scalar FMix rules (FMix(a,b,0)=a, FMix(a,b,1)=b, FMix(a,a,t)=a)
; then fire to optimize each component.

(rule ((= e (VecExtract (VecFMix x y a) 0)))
      ((union e (FloatToExpr (FMix (ExprToFloat (VecExtract x 0))
                                    (ExprToFloat (VecExtract y 0))
                                    (ExprToFloat (VecExtract a 0)))))))
(rule ((= e (VecExtract (VecFMix x y a) 1)))
      ((union e (FloatToExpr (FMix (ExprToFloat (VecExtract x 1))
                                    (ExprToFloat (VecExtract y 1))
                                    (ExprToFloat (VecExtract a 1)))))))
(rule ((= e (VecExtract (VecFMix x y a) 2)))
      ((union e (FloatToExpr (FMix (ExprToFloat (VecExtract x 2))
                                    (ExprToFloat (VecExtract y 2))
                                    (ExprToFloat (VecExtract a 2)))))))
(rule ((= e (VecExtract (VecFMix x y a) 3)))
      ((union e (FloatToExpr (FMix (ExprToFloat (VecExtract x 3))
                                    (ExprToFloat (VecExtract y 3))
                                    (ExprToFloat (VecExtract a 3)))))))

