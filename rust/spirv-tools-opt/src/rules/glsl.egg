; =============================================================================
; GLSL Extended Instruction Rules
; =============================================================================

; =============================================================================
; FMix (Linear Interpolation)
; =============================================================================

; FMix(a, a, t) = a - ONE-DIRECTIONAL
(rule ((= e (FMix a a t)))
      ((union e a)))

; FMix(a, b, 0) = a - ONE-DIRECTIONAL (when t=0, return first arg)
(rule ((= e (FMix a b (Const 0))))
      ((union e a)))

; FMix(a, b, 1) = b - ONE-DIRECTIONAL (when t=1, return second arg)
(rule ((= e (FMix a b (Const 1))))
      ((union e b)))

; RedundantFMix from C++ - matches GLSL FMix folding rules

; =============================================================================
; Clamp Operations
; =============================================================================

; Clamp with equal bounds returns the bound - ONE-DIRECTIONAL
(rule ((= e (FClamp x a a)))
      ((union e a)))
(rule ((= e (SClamp x a a)))
      ((union e a)))
(rule ((= e (UClamp x a a)))
      ((union e a)))

; Clamp is idempotent when bounds are the same
(rewrite (FClamp (FClamp x lo hi) lo hi) (FClamp x lo hi))
(rewrite (SClamp (SClamp x lo hi) lo hi) (SClamp x lo hi))
(rewrite (UClamp (UClamp x lo hi) lo hi) (UClamp x lo hi))

; =============================================================================
; Clamp Feeding Comparison (C++ FoldFClampFeedingCompare parity)
; =============================================================================
; When a clamped value is compared against a bound, we can simplify based on
; the clamp constraining the value range.

; FClamp(x, lo, hi) < lo => false (clamped value is always >= lo)
(rule ((= e (FOrdLt (FClamp x lo hi) lo)))
      ((union e (Const 0))))
(rule ((= e (FUnordLt (FClamp x lo hi) lo)))
      ((union e (Const 0))))

; FClamp(x, lo, hi) > hi => false (clamped value is always <= hi)
(rule ((= e (FOrdGt (FClamp x lo hi) hi)))
      ((union e (Const 0))))
(rule ((= e (FUnordGt (FClamp x lo hi) hi)))
      ((union e (Const 0))))

; FClamp(x, lo, hi) >= lo => true (clamped value is always >= lo)
(rule ((= e (FOrdGe (FClamp x lo hi) lo)))
      ((union e (Const 1))))
(rule ((= e (FUnordGe (FClamp x lo hi) lo)))
      ((union e (Const 1))))

; FClamp(x, lo, hi) <= hi => true (clamped value is always <= hi)
(rule ((= e (FOrdLe (FClamp x lo hi) hi)))
      ((union e (Const 1))))
(rule ((= e (FUnordLe (FClamp x lo hi) hi)))
      ((union e (Const 1))))

; lo < FClamp(x, lo, hi) => x > lo (clamp is > lo iff x is > lo)
; This is more complex - simplified form: just compare x directly
; lo <= FClamp(x, lo, hi) => true
(rule ((= e (FOrdLe lo (FClamp x lo hi))))
      ((union e (Const 1))))
(rule ((= e (FUnordLe lo (FClamp x lo hi))))
      ((union e (Const 1))))

; hi >= FClamp(x, lo, hi) => true
(rule ((= e (FOrdGe hi (FClamp x lo hi))))
      ((union e (Const 1))))
(rule ((= e (FUnordGe hi (FClamp x lo hi))))
      ((union e (Const 1))))

; Similar rules for signed integer clamp
; SClamp(x, lo, hi) < lo => false
(rule ((= e (SLt (SClamp x lo hi) lo)))
      ((union e (Const 0))))
; SClamp(x, lo, hi) > hi => false
(rule ((= e (SGt (SClamp x lo hi) hi)))
      ((union e (Const 0))))
; SClamp(x, lo, hi) >= lo => true
(rule ((= e (SGe (SClamp x lo hi) lo)))
      ((union e (Const 1))))
; SClamp(x, lo, hi) <= hi => true
(rule ((= e (SLe (SClamp x lo hi) hi)))
      ((union e (Const 1))))

; Similar rules for unsigned integer clamp
; UClamp(x, lo, hi) < lo => false
(rule ((= e (ULt (UClamp x lo hi) lo)))
      ((union e (Const 0))))
; UClamp(x, lo, hi) > hi => false
(rule ((= e (UGt (UClamp x lo hi) hi)))
      ((union e (Const 0))))
; UClamp(x, lo, hi) >= lo => true
(rule ((= e (UGe (UClamp x lo hi) lo)))
      ((union e (Const 1))))
; UClamp(x, lo, hi) <= hi => true
(rule ((= e (ULe (UClamp x lo hi) hi)))
      ((union e (Const 1))))

; =============================================================================
; Min/Max Simplifications
; =============================================================================

; Note: FMin/FMax idempotent, commutative, associative rules are in floating_point.egg

; Clamp expressed as nested min/max
; clamp(x, lo, hi) = max(lo, min(x, hi))
(rewrite (FClamp x lo hi) (FMax lo (FMin x hi)))

; =============================================================================
; Square Root and Inverse Square Root
; =============================================================================

; sqrt(x*x) = abs(x) (for non-negative x conceptually)
; InverseSqrt(1) = 1
; InverseSqrt(InverseSqrt(x)) related to sqrt

; Sqrt of 1 is 1 (conceptual - needs float constant support)
; InverseSqrt * Sqrt = 1 (conceptual)

; x * InverseSqrt(x) = Sqrt(x) (strength reduction)
(rewrite (FMul x (InverseSqrt x)) (Sqrt x))
(rewrite (FMul (InverseSqrt x) x) (Sqrt x))

; 1 / Sqrt(x) = InverseSqrt(x)
(rewrite (FDiv (Const 1) (Sqrt x)) (InverseSqrt x))

; Sqrt(x) * Sqrt(x) = x - ONE-DIRECTIONAL
(rule ((= e (FMul (Sqrt x) (Sqrt x))))
      ((union e x)))

; =============================================================================
; Exponential and Logarithm
; =============================================================================

; Log(Exp(x)) = x - ONE-DIRECTIONAL
(rule ((= e (Log (Exp x))))
      ((union e x)))

; Exp(Log(x)) = x (for positive x) - ONE-DIRECTIONAL
(rule ((= e (Exp (Log x))))
      ((union e x)))

; Log2(Exp2(x)) = x - ONE-DIRECTIONAL
(rule ((= e (Log2 (Exp2 x))))
      ((union e x)))

; Exp2(Log2(x)) = x - ONE-DIRECTIONAL
(rule ((= e (Exp2 (Log2 x))))
      ((union e x)))

; Exp(0) = 1, Log(1) = 0 (conceptual - needs constants)

; Exp(a + b) = Exp(a) * Exp(b)
(rewrite (Exp (FAdd a b)) (FMul (Exp a) (Exp b)))
(rewrite (Exp2 (FAdd a b)) (FMul (Exp2 a) (Exp2 b)))

; Log(a * b) = Log(a) + Log(b)
(rewrite (Log (FMul a b)) (FAdd (Log a) (Log b)))
(rewrite (Log2 (FMul a b)) (FAdd (Log2 a) (Log2 b)))

; Log(a / b) = Log(a) - Log(b)
(rewrite (Log (FDiv a b)) (FSub (Log a) (Log b)))
(rewrite (Log2 (FDiv a b)) (FSub (Log2 a) (Log2 b)))

; =============================================================================
; Power Function
; =============================================================================

; Pow(x, 0) = 1 (conceptual)
; Pow(x, 1) = x
; Pow(x, 2) = x * x

; Pow(x, -1) = 1/x
(rewrite (Pow x (Const -1)) (FDiv (Const 1) x))

; Pow expressed via Exp/Log: Pow(a, b) = Exp(b * Log(a))
; This enables more algebraic manipulation

; =============================================================================
; Trigonometric Functions
; =============================================================================

; sin(0) = 0, cos(0) = 1, tan(0) = 0 (conceptual)

; Double negation
(rewrite (Sin (FNeg x)) (FNeg (Sin x)))
(rewrite (Cos (FNeg x)) (Cos x))
(rewrite (Tan (FNeg x)) (FNeg (Tan x)))

; Sinh/Cosh/Tanh negation
(rewrite (Sinh (FNeg x)) (FNeg (Sinh x)))
(rewrite (Cosh (FNeg x)) (Cosh x))
(rewrite (Tanh (FNeg x)) (FNeg (Tanh x)))

; Inverse trig cancellations (valid for principal value ranges) - ONE-DIRECTIONAL
; Note: These are mathematically valid only in restricted domains,
; but for shader optimization we assume inputs are in valid ranges
(rule ((= e (Asin (Sin x))))
      ((union e x)))
(rule ((= e (Acos (Cos x))))
      ((union e x)))
(rule ((= e (Atan (Tan x))))
      ((union e x)))
(rule ((= e (Sin (Asin x))))
      ((union e x)))
(rule ((= e (Cos (Acos x))))
      ((union e x)))
(rule ((= e (Tan (Atan x))))
      ((union e x)))

; Inverse hyperbolic cancellations - ONE-DIRECTIONAL
(rule ((= e (Asinh (Sinh x))))
      ((union e x)))
(rule ((= e (Sinh (Asinh x))))
      ((union e x)))
(rule ((= e (Acosh (Cosh x))))
      ((union e x)))
(rule ((= e (Cosh (Acosh x))))
      ((union e x)))
(rule ((= e (Atanh (Tanh x))))
      ((union e x)))
(rule ((= e (Tanh (Atanh x))))
      ((union e x)))

; Tan = Sin / Cos
(rewrite (Tan x) (FDiv (Sin x) (Cos x)))

; sin^2 + cos^2 = 1 (Pythagorean identity)
; This is hard to express directly but can help with extraction

; =============================================================================
; Fused Multiply-Add
; =============================================================================

; Fma(a, b, c) = a*b + c (definition, for expansion if needed)
; But prefer Fma when available (single rounding, faster)

; Recognize Fma patterns
(rewrite (FAdd (FMul a b) c) (Fma a b c))
(rewrite (FAdd c (FMul a b)) (Fma a b c))

; Fma with zero
(rewrite (Fma a b (Const 0)) (FMul a b))

; Fma with one
(rewrite (Fma (Const 1) b c) (FAdd b c))
(rewrite (Fma a (Const 1) c) (FAdd a c))

; =============================================================================
; Absolute Value and Sign
; =============================================================================

; Note: FAbs(FAbs x) = FAbs x is in floating_point.egg

; SAbs idempotent
(rewrite (SAbs (SAbs x)) (SAbs x))

; SAbs of negation
(rewrite (SAbs (Neg x)) (SAbs x))

; sign(sign(x)) simplification
(rewrite (FSign (FSign x)) (FSign x))
(rewrite (Sign (Sign x)) (Sign x))

; abs(x) * sign(x) = x - ONE-DIRECTIONAL
(rule ((= e (FMul (FAbs x) (FSign x))))
      ((union e x)))
(rule ((= e (FMul (FSign x) (FAbs x))))
      ((union e x)))

; =============================================================================
; Length, Distance, Normalize
; =============================================================================

; Distance(a, a) = 0
; Note: This would produce a float zero, not Const 0

; Length of normalized vector is 1
; Normalize(Normalize(x)) = Normalize(x) (idempotent for non-zero)
(rewrite (Normalize (Normalize x)) (Normalize x))

; =============================================================================
; Cross Product
; =============================================================================

; Cross product anti-commutativity: a × b = -(b × a)
(rewrite (Cross a b) (VecNeg (Cross b a)))

; Cross product with self is zero vector
; (rewrite (Cross a a) (Vec3 (Const 0) (Const 0) (Const 0)))
; Disabled: Need float zero representation

; =============================================================================
; Reflect and Refract
; =============================================================================

; Reflect with zero normal (conceptual)
; Reflect(I, N) = I - 2*dot(N,I)*N

; =============================================================================
; Step Function
; =============================================================================

; Step(edge, x) = 0 if x < edge, else 1
; Step(a, a) = 1 (x >= edge when x == edge)

; =============================================================================
; SmoothStep
; =============================================================================

; SmoothStep(a, b, a) = 0 (at left edge)
; SmoothStep(a, b, b) = 1 (at right edge)
; SmoothStep(a, a, x) = undefined/clamped

; =============================================================================
; Fract
; =============================================================================

; Fract(x) = x - Floor(x) (definition)
(rewrite (Fract x) (FSub x (FFloor x)))

; Fract(Fract(x)) = Fract(x) (idempotent for positive x)
(rewrite (Fract (Fract x)) (Fract x))

; =============================================================================
; Bit Manipulation (GLSL)
; =============================================================================

; BitCount(0) = 0 (conceptual)
; FindILsb(0) = -1 (conceptual)
; FindSMsb/FindUMsb patterns

; BitCount of constant 0
(rule ((= e (BitCount (Const 0))))
      ((union e (Const 0))))

; FindILsb of 0 returns -1
(rule ((= e (FindILsb (Const 0))))
      ((union e (Const -1))))

; FindSMsb of 0 returns -1
(rule ((= e (FindSMsb (Const 0))))
      ((union e (Const -1))))

; FindUMsb of 0 returns -1
(rule ((= e (FindUMsb (Const 0))))
      ((union e (Const -1))))

; =============================================================================
; Additional GLSL Simplifications (C++ Parity)
; =============================================================================

; Sqrt simplifications
(rewrite (Sqrt (FMul x x)) (FAbs x))

; Pow simplifications
(rewrite (Pow x (Const 0)) (Const 1))
(rewrite (Pow x (Const 2)) (FMul x x))

; Clamp with value already within bounds
; clamp(clamp(x, a, b), a, b) = clamp(x, a, b) - already covered above

; FMix edge cases
; FMix(x, y, 0) = x
; FMix(x, y, 1) = y
; These require float constants which we represent as Const

; Step simplifications
; step(e, x) where x >= e returns 1, x < e returns 0
; These require runtime knowledge

; SmoothStep edge cases - ONE-DIRECTIONAL
(rule ((= e (SmoothStep x x t)))
      ((union e x)))

; Distance of same vector is 0
; Distance(v, v) = 0.0 - needs float zero

; Length of zero vector is 0
; Normalize of unit vector is itself

; Cross product of parallel vectors is zero
; Cross(v, v) = vec3(0) - needs vector zero

; =============================================================================
; Sign and Absolute Value Relationships
; =============================================================================

; sign(-x) = -sign(x)
(rewrite (FSign (FNeg x)) (FNeg (FSign x)))
(rewrite (Sign (Neg x)) (Neg (Sign x)))

; abs(abs(x)) = abs(x) - already in floating_point.egg for FAbs

; sign(abs(x)) = sign(x) when x != 0
; This is more complex to express

; Note: Radians/Degrees and NMin/NMax/NClamp rules are in type_conversion.egg
; Note: Pack/Unpack rules are in type_conversion.egg

; =============================================================================
; Ldexp and Frexp Relationships
; =============================================================================

; Ldexp(x, 0) = x (multiply by 2^0 = 1)
; This would need integer 0 constant detection

; =============================================================================
; Fma Optimizations (beyond what's above)
; =============================================================================

; Fma(0, b, c) = c - ONE-DIRECTIONAL
(rule ((= e (Fma (Const 0) b c)))
      ((union e c)))
(rule ((= e (Fma a (Const 0) c)))
      ((union e c)))

; Fma(a, b, 0) = a * b - already covered

; Fma(-1, b, c) = c - b
(rewrite (Fma (Const -1) b c) (FSub c b))
(rewrite (Fma a (Const -1) c) (FSub c a))

; =============================================================================
; Additional GLSL Loop Invariant Rules
; =============================================================================

; Trig functions loop invariant (some already in rvsdg.egg, add remaining)
(rewrite (Asin (LoopInvariant x)) (LoopInvariant (Asin x)))
(rewrite (Acos (LoopInvariant x)) (LoopInvariant (Acos x)))
(rewrite (Atan (LoopInvariant x)) (LoopInvariant (Atan x)))
(rewrite (Atan2 (LoopInvariant a) (LoopInvariant b)) (LoopInvariant (Atan2 a b)))
(rewrite (Sinh (LoopInvariant x)) (LoopInvariant (Sinh x)))
(rewrite (Cosh (LoopInvariant x)) (LoopInvariant (Cosh x)))
(rewrite (Tanh (LoopInvariant x)) (LoopInvariant (Tanh x)))
(rewrite (Asinh (LoopInvariant x)) (LoopInvariant (Asinh x)))
(rewrite (Acosh (LoopInvariant x)) (LoopInvariant (Acosh x)))
(rewrite (Atanh (LoopInvariant x)) (LoopInvariant (Atanh x)))

; Mixed functions loop invariant
(rewrite (FMix (LoopInvariant a) (LoopInvariant b) (LoopInvariant t)) (LoopInvariant (FMix a b t)))
(rewrite (SmoothStep (LoopInvariant e0) (LoopInvariant e1) (LoopInvariant x)) (LoopInvariant (SmoothStep e0 e1 x)))
(rewrite (Step (LoopInvariant e) (LoopInvariant x)) (LoopInvariant (Step e x)))
(rewrite (FClamp (LoopInvariant x) (LoopInvariant lo) (LoopInvariant hi)) (LoopInvariant (FClamp x lo hi)))
(rewrite (SClamp (LoopInvariant x) (LoopInvariant lo) (LoopInvariant hi)) (LoopInvariant (SClamp x lo hi)))
(rewrite (UClamp (LoopInvariant x) (LoopInvariant lo) (LoopInvariant hi)) (LoopInvariant (UClamp x lo hi)))

; Geometry functions loop invariant
(rewrite (Distance (LoopInvariant a) (LoopInvariant b)) (LoopInvariant (Distance a b)))
(rewrite (Reflect (LoopInvariant i) (LoopInvariant n)) (LoopInvariant (Reflect i n)))
(rewrite (Refract (LoopInvariant i) (LoopInvariant n) (LoopInvariant eta)) (LoopInvariant (Refract i n eta)))
(rewrite (FaceForward (LoopInvariant n) (LoopInvariant i) (LoopInvariant nref)) (LoopInvariant (FaceForward n i nref)))

; Fract and Modf loop invariant
(rewrite (Fract (LoopInvariant x)) (LoopInvariant (Fract x)))
(rewrite (Modf (LoopInvariant x)) (LoopInvariant (Modf x)))
(rewrite (ModfStruct (LoopInvariant x)) (LoopInvariant (ModfStruct x)))
(rewrite (FSign (LoopInvariant x)) (LoopInvariant (FSign x)))
(rewrite (SAbs (LoopInvariant x)) (LoopInvariant (SAbs x)))
(rewrite (Fma (LoopInvariant a) (LoopInvariant b) (LoopInvariant c)) (LoopInvariant (Fma a b c)))

; Bit manipulation loop invariant
(rewrite (BitCount (LoopInvariant x)) (LoopInvariant (BitCount x)))
(rewrite (FindILsb (LoopInvariant x)) (LoopInvariant (FindILsb x)))
(rewrite (FindSMsb (LoopInvariant x)) (LoopInvariant (FindSMsb x)))
(rewrite (FindUMsb (LoopInvariant x)) (LoopInvariant (FindUMsb x)))
(rewrite (BitReverse (LoopInvariant x)) (LoopInvariant (BitReverse x)))

; =============================================================================
; Gamma Distribution for GLSL Functions
; =============================================================================
; Note: Most Gamma distribution rules are in rvsdg.egg. Here we only add
; specialized GLSL patterns not covered there.

; Clamp with same bounds: select(c, clamp(a, lo, hi), clamp(b, lo, hi)) = clamp(select(c, a, b), lo, hi)
(rewrite (Gamma c (FClamp a lo hi) (FClamp b lo hi)) (FClamp (Gamma c a b) lo hi))
(rewrite (Gamma c (SClamp a lo hi) (SClamp b lo hi)) (SClamp (Gamma c a b) lo hi))
(rewrite (Gamma c (UClamp a lo hi) (UClamp b lo hi)) (UClamp (Gamma c a b) lo hi))

; =============================================================================
; More FMix Optimizations
; =============================================================================

; FMix is linear in first two arguments
; FMix(a, b, t) = a * (1-t) + b * t
; FMix(x, x, t) = x (already covered)

; FMix with constant t
; FMix(a, b, 0.5) = (a + b) / 2 (midpoint)

; FMix expansion for optimization
; Note: We prefer Fma form when available
(rewrite (FMix a b t) (FAdd (FMul a (FSub (Const 1) t)) (FMul b t)))

; =============================================================================
; Pow Optimization Patterns
; =============================================================================

; Pow(x, 0.5) = Sqrt(x)
; Pow(x, -0.5) = InverseSqrt(x)
; Note: These need float constant representation

; Pow(x, n) for small integer n can be expanded
; Pow(x, 3) = x * x * x

; =============================================================================
; Sqrt/InverseSqrt Additional Rules
; =============================================================================

; InverseSqrt(x) * InverseSqrt(y) = InverseSqrt(x * y)
(rewrite (FMul (InverseSqrt x) (InverseSqrt y)) (InverseSqrt (FMul x y)))

; Sqrt(x) / Sqrt(y) = Sqrt(x/y)
(rewrite (FDiv (Sqrt x) (Sqrt y)) (Sqrt (FDiv x y)))

; InverseSqrt(x) / InverseSqrt(y) = Sqrt(x/y) / x (complex)

; =============================================================================
; Trigonometric Identities
; =============================================================================

; sin(x)^2 + cos(x)^2 = 1 is hard to match directly
; But we can recognize: 1 - sin(x)^2 = cos(x)^2

; sin(2x) = 2*sin(x)*cos(x) (double angle)
; cos(2x) = cos^2(x) - sin^2(x)

; sin(a+b) and cos(a+b) expansions are complex

; =============================================================================
; Atan2 Simplifications
; =============================================================================

; Atan2(y, x) where both are constants would be folded
; Atan2(0, x) = 0 when x > 0, pi when x < 0
; Atan2(y, 0) = pi/2 when y > 0, -pi/2 when y < 0

; Atan2(y, x) = Atan(y/x) when x > 0 (quadrant I or IV)

; =============================================================================
; Ldexp Simplifications
; =============================================================================

; Ldexp(x, 0) = x (multiply by 2^0 = 1) - ONE-DIRECTIONAL
(rule ((= e (Ldexp x (Const 0))))
      ((union e x)))

; Ldexp(x, 1) = x * 2
(rewrite (Ldexp x (Const 1)) (FMul x (Const 2)))

; Ldexp(x, -1) = x / 2 = x * 0.5

; =============================================================================
; IsNan/IsInf Simplifications
; =============================================================================

; IsNan(constant) = false for non-NaN constants
; IsInf(constant) = false for finite constants

; IsNan on integer converted to float is always false
(rewrite (IsNan (ConvertSToF x)) (Const 0))
(rewrite (IsNan (ConvertUToF x)) (Const 0))

; =============================================================================
; FMix Feeding Extract (C++ FMixFeedingExtract parity)
; =============================================================================
; When extracting from a FMix with constant 0 or 1 interpolant, extract from endpoint
; Note: VecExtract has a fixed index, so we enumerate concrete indices

; VecExtract(FMix(x, y, 0), i) = VecExtract(x, i)
(rule ((= e (VecExtract (FMix x y (Const 0)) 0)))
      ((union e (VecExtract x 0))))
(rule ((= e (VecExtract (FMix x y (Const 0)) 1)))
      ((union e (VecExtract x 1))))
(rule ((= e (VecExtract (FMix x y (Const 0)) 2)))
      ((union e (VecExtract x 2))))
(rule ((= e (VecExtract (FMix x y (Const 0)) 3)))
      ((union e (VecExtract x 3))))

; VecExtract(FMix(x, y, 1), i) = VecExtract(y, i)
(rule ((= e (VecExtract (FMix x y (Const 1)) 0)))
      ((union e (VecExtract y 0))))
(rule ((= e (VecExtract (FMix x y (Const 1)) 1)))
      ((union e (VecExtract y 1))))
(rule ((= e (VecExtract (FMix x y (Const 1)) 2)))
      ((union e (VecExtract y 2))))
(rule ((= e (VecExtract (FMix x y (Const 1)) 3)))
      ((union e (VecExtract y 3))))

; =============================================================================
; FMix Distribution (when interpolant is same)
; =============================================================================

; VecExtract(FMix(x, y, t), i) when all are vectors can distribute
; This is less common but valid for component-wise operations

; FMix with extraction from same index
; VecExtract(FMix(x, y, t), i) = FMix(VecExtract(x, i), VecExtract(y, i), t)
; when t is scalar
(rewrite (VecExtract (FMix x y t) 0) (FMix (VecExtract x 0) (VecExtract y 0) t))
(rewrite (VecExtract (FMix x y t) 1) (FMix (VecExtract x 1) (VecExtract y 1) t))
(rewrite (VecExtract (FMix x y t) 2) (FMix (VecExtract x 2) (VecExtract y 2) t))
(rewrite (VecExtract (FMix x y t) 3) (FMix (VecExtract x 3) (VecExtract y 3) t))

; =============================================================================
; SmoothStep Feeding Extract
; =============================================================================

; Similar pattern for SmoothStep
(rewrite (VecExtract (SmoothStep e0 e1 x) 0) (SmoothStep (VecExtract e0 0) (VecExtract e1 0) (VecExtract x 0)))
(rewrite (VecExtract (SmoothStep e0 e1 x) 1) (SmoothStep (VecExtract e0 1) (VecExtract e1 1) (VecExtract x 1)))
(rewrite (VecExtract (SmoothStep e0 e1 x) 2) (SmoothStep (VecExtract e0 2) (VecExtract e1 2) (VecExtract x 2)))
(rewrite (VecExtract (SmoothStep e0 e1 x) 3) (SmoothStep (VecExtract e0 3) (VecExtract e1 3) (VecExtract x 3)))

; =============================================================================
; Clamp Feeding Extract
; =============================================================================

; VecExtract(FClamp(x, lo, hi), i) = FClamp(VecExtract(x, i), VecExtract(lo, i), VecExtract(hi, i))
(rewrite (VecExtract (FClamp x lo hi) 0) (FClamp (VecExtract x 0) (VecExtract lo 0) (VecExtract hi 0)))
(rewrite (VecExtract (FClamp x lo hi) 1) (FClamp (VecExtract x 1) (VecExtract lo 1) (VecExtract hi 1)))
(rewrite (VecExtract (FClamp x lo hi) 2) (FClamp (VecExtract x 2) (VecExtract lo 2) (VecExtract hi 2)))
(rewrite (VecExtract (FClamp x lo hi) 3) (FClamp (VecExtract x 3) (VecExtract lo 3) (VecExtract hi 3)))

; =============================================================================
; Step Feeding Extract
; =============================================================================

; VecExtract(Step(edge, x), i) = Step(VecExtract(edge, i), VecExtract(x, i))
(rewrite (VecExtract (Step edge x) 0) (Step (VecExtract edge 0) (VecExtract x 0)))
(rewrite (VecExtract (Step edge x) 1) (Step (VecExtract edge 1) (VecExtract x 1)))
(rewrite (VecExtract (Step edge x) 2) (Step (VecExtract edge 2) (VecExtract x 2)))
(rewrite (VecExtract (Step edge x) 3) (Step (VecExtract edge 3) (VecExtract x 3)))
