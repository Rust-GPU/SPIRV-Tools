; =============================================================================
; Function Inlining Support for E-Graph Optimization
; =============================================================================
;
; This module provides comprehensive function inlining support in the e-graph.
; Function inlining replaces a call site with the function body, substituting
; arguments for parameters.
;
; Key concepts:
; - Call1/2/3/4: Function calls with 1-4 arguments
; - Subst: Substitute a value for an argument reference (Arg n)
; - FuncDef: Function definition binding a name to a body
; - EffSubst: Substitution for effectful function bodies
;
; Inlining benefits:
; - Enables cross-function optimization (constant propagation, CSE)
; - Eliminates call overhead
; - Allows specialized code generation per call site
;
; NOTE: Subst(Expr, i64, Expr) -> Expr operates at the Expr sort level.
; Constructors that now produce typed sorts (IntExpr, FloatExpr, BoolExpr)
; cannot appear as the body of Subst since they are not Expr. Substitution
; through typed expressions happens via bridge constructors (IntToExpr,
; FloatToExpr, BoolToExpr). Only Expr-sort constructors need Subst rules.
;
; =============================================================================
; SECTION 1: Core Substitution Rules
; =============================================================================
; Subst(body, n, val) replaces Arg(n) with val in body.
; These rules push substitution down through all Expr-sort expression forms.

; Base case: Substituting for Arg(n) with matching index
(rule ((= e (Subst (Arg n) n val)))
      ((union e val)))

; Arg with non-matching index is unchanged
; We handle specific common cases since egglog can't express inequality
; Subst(Arg(0), 1, val) = Arg(0), Subst(Arg(1), 0, val) = Arg(1), etc.
(rule ((= e (Subst (Arg 0) 1 _))) ((union e (Arg 0))))
(rule ((= e (Subst (Arg 0) 2 _))) ((union e (Arg 0))))
(rule ((= e (Subst (Arg 0) 3 _))) ((union e (Arg 0))))
(rule ((= e (Subst (Arg 1) 0 _))) ((union e (Arg 1))))
(rule ((= e (Subst (Arg 1) 2 _))) ((union e (Arg 1))))
(rule ((= e (Subst (Arg 1) 3 _))) ((union e (Arg 1))))
(rule ((= e (Subst (Arg 2) 0 _))) ((union e (Arg 2))))
(rule ((= e (Subst (Arg 2) 1 _))) ((union e (Arg 2))))
(rule ((= e (Subst (Arg 2) 3 _))) ((union e (Arg 2))))
(rule ((= e (Subst (Arg 3) 0 _))) ((union e (Arg 3))))
(rule ((= e (Subst (Arg 3) 1 _))) ((union e (Arg 3))))
(rule ((= e (Subst (Arg 3) 2 _))) ((union e (Arg 3))))

; Leaf Expr-sort constants unaffected by substitution
(rule ((= e (Subst (Sym s) _ _)))
      ((union e (Sym s))))
(rule ((= e (Subst (Undef) _ _)))
      ((union e (Undef))))

; NOTE: Subst rules for Const, Const64, and BoolConst have been removed.
; These are now IntExpr/BoolExpr sort, not Expr, so they cannot appear as
; the body of Subst(Expr, i64, Expr).

; =============================================================================
; SECTION 1b: Bridge Substitution (typed sort traversal)
; =============================================================================
; When Subst encounters a bridge constructor (IntToExpr, FloatToExpr, BoolToExpr),
; it pushes substitution into the typed expression via SubstI/SubstF/SubstB.
; This handles cases like Subst(IntToExpr(Add(ExprToInt(Arg(0)), Const(1))), 0, val).

(rule ((= e (Subst (IntToExpr x) idx val)))
      ((union e (IntToExpr (SubstI x idx val)))))
(rule ((= e (Subst (FloatToExpr x) idx val)))
      ((union e (FloatToExpr (SubstF x idx val)))))
(rule ((= e (Subst (BoolToExpr x) idx val)))
      ((union e (BoolToExpr (SubstB x idx val)))))

; --- SubstI: Substitution within IntExpr ---

; Bridge back to Expr: ExprToInt(Arg(n)) is where Args live
(rule ((= e (SubstI (ExprToInt (Arg n)) n val)))
      ((union e (ExprToInt val))))
(rule ((= e (SubstI (ExprToInt (Arg 0)) 1 _))) ((union e (ExprToInt (Arg 0)))))
(rule ((= e (SubstI (ExprToInt (Arg 0)) 2 _))) ((union e (ExprToInt (Arg 0)))))
(rule ((= e (SubstI (ExprToInt (Arg 0)) 3 _))) ((union e (ExprToInt (Arg 0)))))
(rule ((= e (SubstI (ExprToInt (Arg 1)) 0 _))) ((union e (ExprToInt (Arg 1)))))
(rule ((= e (SubstI (ExprToInt (Arg 1)) 2 _))) ((union e (ExprToInt (Arg 1)))))
(rule ((= e (SubstI (ExprToInt (Arg 1)) 3 _))) ((union e (ExprToInt (Arg 1)))))
(rule ((= e (SubstI (ExprToInt (Arg 2)) 0 _))) ((union e (ExprToInt (Arg 2)))))
(rule ((= e (SubstI (ExprToInt (Arg 2)) 1 _))) ((union e (ExprToInt (Arg 2)))))
(rule ((= e (SubstI (ExprToInt (Arg 2)) 3 _))) ((union e (ExprToInt (Arg 2)))))
(rule ((= e (SubstI (ExprToInt (Arg 3)) 0 _))) ((union e (ExprToInt (Arg 3)))))
(rule ((= e (SubstI (ExprToInt (Arg 3)) 1 _))) ((union e (ExprToInt (Arg 3)))))
(rule ((= e (SubstI (ExprToInt (Arg 3)) 2 _))) ((union e (ExprToInt (Arg 3)))))

; For other Expr sub-expressions, push Subst through and re-bridge
(rule ((= e (SubstI (ExprToInt x) idx val)))
      ((union e (ExprToInt (Subst x idx val)))))

; Leaf nodes (no Args possible)
(rule ((= e (SubstI (Const c) _ _))) ((union e (Const c))))
(rule ((= e (SubstI (Const64 c) _ _))) ((union e (Const64 c))))
(rule ((= e (SubstI (ISym s) _ _))) ((union e (ISym s))))
(rule ((= e (SubstI (LoopVarI) _ _))) ((union e (LoopVarI))))

; Unary IntExpr operations
(rule ((= e (SubstI (Neg x) idx val))) ((union e (Neg (SubstI x idx val)))))
(rule ((= e (SubstI (SAbs x) idx val))) ((union e (SAbs (SubstI x idx val)))))
(rule ((= e (SubstI (Sign x) idx val))) ((union e (Sign (SubstI x idx val)))))
(rule ((= e (SubstI (BitNot x) idx val))) ((union e (BitNot (SubstI x idx val)))))
(rule ((= e (SubstI (BitReverse x) idx val))) ((union e (BitReverse (SubstI x idx val)))))
(rule ((= e (SubstI (FindILsb x) idx val))) ((union e (FindILsb (SubstI x idx val)))))
(rule ((= e (SubstI (FindSMsb x) idx val))) ((union e (FindSMsb (SubstI x idx val)))))
(rule ((= e (SubstI (FindUMsb x) idx val))) ((union e (FindUMsb (SubstI x idx val)))))
(rule ((= e (SubstI (BitCount x) idx val))) ((union e (BitCount (SubstI x idx val)))))
(rule ((= e (SubstI (SConvert x) idx val))) ((union e (SConvert (SubstI x idx val)))))
(rule ((= e (SubstI (UConvert x) idx val))) ((union e (UConvert (SubstI x idx val)))))
(rule ((= e (SubstI (LoopInvariantI x) idx val))) ((union e (LoopInvariantI (SubstI x idx val)))))
(rule ((= e (SubstI (CopyI x) idx val))) ((union e (CopyI (SubstI x idx val)))))

; Binary IntExpr operations
(rule ((= e (SubstI (Add x y) idx val))) ((union e (Add (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (Sub x y) idx val))) ((union e (Sub (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (Mul x y) idx val))) ((union e (Mul (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (SDiv x y) idx val))) ((union e (SDiv (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (UDiv x y) idx val))) ((union e (UDiv (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (SRem x y) idx val))) ((union e (SRem (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (SMod x y) idx val))) ((union e (SMod (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (UMod x y) idx val))) ((union e (UMod (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (Shl x y) idx val))) ((union e (Shl (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (ShrS x y) idx val))) ((union e (ShrS (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (ShrU x y) idx val))) ((union e (ShrU (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (BitAnd x y) idx val))) ((union e (BitAnd (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (BitOr x y) idx val))) ((union e (BitOr (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (BitXor x y) idx val))) ((union e (BitXor (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (RotL x y) idx val))) ((union e (RotL (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (RotR x y) idx val))) ((union e (RotR (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (SMin x y) idx val))) ((union e (SMin (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (SMax x y) idx val))) ((union e (SMax (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (UMin x y) idx val))) ((union e (UMin (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstI (UMax x y) idx val))) ((union e (UMax (SubstI x idx val) (SubstI y idx val)))))

; Ternary IntExpr operations
(rule ((= e (SubstI (SClamp x lo hi) idx val))) ((union e (SClamp (SubstI x idx val) (SubstI lo idx val) (SubstI hi idx val)))))
(rule ((= e (SubstI (UClamp x lo hi) idx val))) ((union e (UClamp (SubstI x idx val) (SubstI lo idx val) (SubstI hi idx val)))))
(rule ((= e (SubstI (BitFieldInsert a b c d) idx val))) ((union e (BitFieldInsert (SubstI a idx val) (SubstI b idx val) (SubstI c idx val) (SubstI d idx val)))))
(rule ((= e (SubstI (BitFieldSExtract a b c) idx val))) ((union e (BitFieldSExtract (SubstI a idx val) (SubstI b idx val) (SubstI c idx val)))))
(rule ((= e (SubstI (BitFieldUExtract a b c) idx val))) ((union e (BitFieldUExtract (SubstI a idx val) (SubstI b idx val) (SubstI c idx val)))))

; Cross-type conversions within IntExpr
(rule ((= e (SubstI (ConvertFToS x) idx val))) ((union e (ConvertFToS (SubstF x idx val)))))
(rule ((= e (SubstI (ConvertFToU x) idx val))) ((union e (ConvertFToU (SubstF x idx val)))))

; Typed control flow within IntExpr
(rule ((= e (SubstI (GammaI c t f) idx val))) ((union e (GammaI (SubstB c idx val) (SubstI t idx val) (SubstI f idx val)))))
(rule ((= e (SubstI (SelectI c t f) idx val))) ((union e (SelectI (SubstB c idx val) (SubstI t idx val) (SubstI f idx val)))))
(rule ((= e (SubstI (ThetaI c b i) idx val))) ((union e (ThetaI (SubstB c idx val) (SubstI b idx val) (SubstI i idx val)))))

; Pack operations (take Expr, return IntExpr)
(rule ((= e (SubstI (PackHalf2x16 x) idx val))) ((union e (PackHalf2x16 (Subst x idx val)))))
(rule ((= e (SubstI (PackSnorm4x8 x) idx val))) ((union e (PackSnorm4x8 (Subst x idx val)))))
(rule ((= e (SubstI (PackSnorm2x16 x) idx val))) ((union e (PackSnorm2x16 (Subst x idx val)))))
(rule ((= e (SubstI (PackUnorm4x8 x) idx val))) ((union e (PackUnorm4x8 (Subst x idx val)))))
(rule ((= e (SubstI (PackUnorm2x16 x) idx val))) ((union e (PackUnorm2x16 (Subst x idx val)))))
(rule ((= e (SubstI (PackDouble2x32 x) idx val))) ((union e (PackDouble2x32 (Subst x idx val)))))

; Subgroup reductions
(rule ((= e (SubstI (GroupIAdd x) idx val))) ((union e (GroupIAdd (SubstI x idx val)))))
(rule ((= e (SubstI (GroupIMul x) idx val))) ((union e (GroupIMul (SubstI x idx val)))))
(rule ((= e (SubstI (GroupSMin x) idx val))) ((union e (GroupSMin (SubstI x idx val)))))
(rule ((= e (SubstI (GroupUMin x) idx val))) ((union e (GroupUMin (SubstI x idx val)))))
(rule ((= e (SubstI (GroupSMax x) idx val))) ((union e (GroupSMax (SubstI x idx val)))))
(rule ((= e (SubstI (GroupUMax x) idx val))) ((union e (GroupUMax (SubstI x idx val)))))
(rule ((= e (SubstI (GroupBitAnd x) idx val))) ((union e (GroupBitAnd (SubstI x idx val)))))
(rule ((= e (SubstI (GroupBitOr x) idx val))) ((union e (GroupBitOr (SubstI x idx val)))))
(rule ((= e (SubstI (GroupBitXor x) idx val))) ((union e (GroupBitXor (SubstI x idx val)))))

; --- SubstF: Substitution within FloatExpr ---

; Bridge back to Expr
(rule ((= e (SubstF (ExprToFloat (Arg n)) n val)))
      ((union e (ExprToFloat val))))
(rule ((= e (SubstF (ExprToFloat x) idx val)))
      ((union e (ExprToFloat (Subst x idx val)))))

; Leaf nodes
(rule ((= e (SubstF (FConst c) _ _))) ((union e (FConst c))))
(rule ((= e (SubstF (FSym s) _ _))) ((union e (FSym s))))
(rule ((= e (SubstF (LoopVarF) _ _))) ((union e (LoopVarF))))

; Unary FloatExpr operations
(rule ((= e (SubstF (FNeg x) idx val))) ((union e (FNeg (SubstF x idx val)))))
(rule ((= e (SubstF (FAbs x) idx val))) ((union e (FAbs (SubstF x idx val)))))
(rule ((= e (SubstF (FSign x) idx val))) ((union e (FSign (SubstF x idx val)))))
(rule ((= e (SubstF (FFloor x) idx val))) ((union e (FFloor (SubstF x idx val)))))
(rule ((= e (SubstF (FCeil x) idx val))) ((union e (FCeil (SubstF x idx val)))))
(rule ((= e (SubstF (FRound x) idx val))) ((union e (FRound (SubstF x idx val)))))
(rule ((= e (SubstF (FTrunc x) idx val))) ((union e (FTrunc (SubstF x idx val)))))
(rule ((= e (SubstF (Sqrt x) idx val))) ((union e (Sqrt (SubstF x idx val)))))
(rule ((= e (SubstF (InverseSqrt x) idx val))) ((union e (InverseSqrt (SubstF x idx val)))))
(rule ((= e (SubstF (Exp x) idx val))) ((union e (Exp (SubstF x idx val)))))
(rule ((= e (SubstF (Exp2 x) idx val))) ((union e (Exp2 (SubstF x idx val)))))
(rule ((= e (SubstF (Log x) idx val))) ((union e (Log (SubstF x idx val)))))
(rule ((= e (SubstF (Log2 x) idx val))) ((union e (Log2 (SubstF x idx val)))))
(rule ((= e (SubstF (Sin x) idx val))) ((union e (Sin (SubstF x idx val)))))
(rule ((= e (SubstF (Cos x) idx val))) ((union e (Cos (SubstF x idx val)))))
(rule ((= e (SubstF (Tan x) idx val))) ((union e (Tan (SubstF x idx val)))))
(rule ((= e (SubstF (Asin x) idx val))) ((union e (Asin (SubstF x idx val)))))
(rule ((= e (SubstF (Acos x) idx val))) ((union e (Acos (SubstF x idx val)))))
(rule ((= e (SubstF (Atan x) idx val))) ((union e (Atan (SubstF x idx val)))))
(rule ((= e (SubstF (Sinh x) idx val))) ((union e (Sinh (SubstF x idx val)))))
(rule ((= e (SubstF (Cosh x) idx val))) ((union e (Cosh (SubstF x idx val)))))
(rule ((= e (SubstF (Tanh x) idx val))) ((union e (Tanh (SubstF x idx val)))))
(rule ((= e (SubstF (Asinh x) idx val))) ((union e (Asinh (SubstF x idx val)))))
(rule ((= e (SubstF (Acosh x) idx val))) ((union e (Acosh (SubstF x idx val)))))
(rule ((= e (SubstF (Atanh x) idx val))) ((union e (Atanh (SubstF x idx val)))))
(rule ((= e (SubstF (Fract x) idx val))) ((union e (Fract (SubstF x idx val)))))
(rule ((= e (SubstF (Radians x) idx val))) ((union e (Radians (SubstF x idx val)))))
(rule ((= e (SubstF (Degrees x) idx val))) ((union e (Degrees (SubstF x idx val)))))
(rule ((= e (SubstF (DPdx x) idx val))) ((union e (DPdx (SubstF x idx val)))))
(rule ((= e (SubstF (DPdy x) idx val))) ((union e (DPdy (SubstF x idx val)))))
(rule ((= e (SubstF (Fwidth x) idx val))) ((union e (Fwidth (SubstF x idx val)))))
(rule ((= e (SubstF (QuantizeToF16 x) idx val))) ((union e (QuantizeToF16 (SubstF x idx val)))))
(rule ((= e (SubstF (FConvert x) idx val))) ((union e (FConvert (SubstF x idx val)))))
(rule ((= e (SubstF (LoopInvariantF x) idx val))) ((union e (LoopInvariantF (SubstF x idx val)))))
(rule ((= e (SubstF (CopyF x) idx val))) ((union e (CopyF (SubstF x idx val)))))

; Binary FloatExpr operations
(rule ((= e (SubstF (FAdd x y) idx val))) ((union e (FAdd (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstF (FSub x y) idx val))) ((union e (FSub (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstF (FMul x y) idx val))) ((union e (FMul (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstF (FDiv x y) idx val))) ((union e (FDiv (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstF (FRem x y) idx val))) ((union e (FRem (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstF (FMod x y) idx val))) ((union e (FMod (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstF (FMin x y) idx val))) ((union e (FMin (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstF (FMax x y) idx val))) ((union e (FMax (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstF (NMin x y) idx val))) ((union e (NMin (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstF (NMax x y) idx val))) ((union e (NMax (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstF (Pow x y) idx val))) ((union e (Pow (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstF (Atan2 x y) idx val))) ((union e (Atan2 (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstF (Step x y) idx val))) ((union e (Step (SubstF x idx val) (SubstF y idx val)))))

; Mixed-sort binary (Ldexp takes FloatExpr and IntExpr)
(rule ((= e (SubstF (Ldexp x y) idx val))) ((union e (Ldexp (SubstF x idx val) (SubstI y idx val)))))

; Ternary FloatExpr operations
(rule ((= e (SubstF (Fma x y z) idx val))) ((union e (Fma (SubstF x idx val) (SubstF y idx val) (SubstF z idx val)))))
(rule ((= e (SubstF (FMix x y z) idx val))) ((union e (FMix (SubstF x idx val) (SubstF y idx val) (SubstF z idx val)))))
(rule ((= e (SubstF (SmoothStep x y z) idx val))) ((union e (SmoothStep (SubstF x idx val) (SubstF y idx val) (SubstF z idx val)))))
(rule ((= e (SubstF (FClamp x y z) idx val))) ((union e (FClamp (SubstF x idx val) (SubstF y idx val) (SubstF z idx val)))))
(rule ((= e (SubstF (NClamp x y z) idx val))) ((union e (NClamp (SubstF x idx val) (SubstF y idx val) (SubstF z idx val)))))

; Cross-type conversions within FloatExpr
(rule ((= e (SubstF (ConvertSToF x) idx val))) ((union e (ConvertSToF (SubstI x idx val)))))
(rule ((= e (SubstF (ConvertUToF x) idx val))) ((union e (ConvertUToF (SubstI x idx val)))))

; Geometry ops (take Expr, return FloatExpr)
(rule ((= e (SubstF (Length x) idx val))) ((union e (Length (Subst x idx val)))))
(rule ((= e (SubstF (Dot x y) idx val))) ((union e (Dot (Subst x idx val) (Subst y idx val)))))
(rule ((= e (SubstF (Distance x y) idx val))) ((union e (Distance (Subst x idx val) (Subst y idx val)))))
(rule ((= e (SubstF (Determinant x) idx val))) ((union e (Determinant (Subst x idx val)))))

; Typed control flow within FloatExpr
(rule ((= e (SubstF (GammaF c t f) idx val))) ((union e (GammaF (SubstB c idx val) (SubstF t idx val) (SubstF f idx val)))))
(rule ((= e (SubstF (SelectF c t f) idx val))) ((union e (SelectF (SubstB c idx val) (SubstF t idx val) (SubstF f idx val)))))
(rule ((= e (SubstF (ThetaF c b i) idx val))) ((union e (ThetaF (SubstB c idx val) (SubstF b idx val) (SubstF i idx val)))))

; Subgroup float reductions
(rule ((= e (SubstF (GroupFAdd x) idx val))) ((union e (GroupFAdd (SubstF x idx val)))))
(rule ((= e (SubstF (GroupFMul x) idx val))) ((union e (GroupFMul (SubstF x idx val)))))
(rule ((= e (SubstF (GroupFMin x) idx val))) ((union e (GroupFMin (SubstF x idx val)))))
(rule ((= e (SubstF (GroupFMax x) idx val))) ((union e (GroupFMax (SubstF x idx val)))))

; --- SubstB: Substitution within BoolExpr ---

; Bridge back to Expr
(rule ((= e (SubstB (ExprToBool (Arg n)) n val)))
      ((union e (ExprToBool val))))
(rule ((= e (SubstB (ExprToBool x) idx val)))
      ((union e (ExprToBool (Subst x idx val)))))

; Leaf nodes
(rule ((= e (SubstB (BoolConst c) _ _))) ((union e (BoolConst c))))
(rule ((= e (SubstB (BSym s) _ _))) ((union e (BSym s))))
(rule ((= e (SubstB (LoopVarB) _ _))) ((union e (LoopVarB))))
(rule ((= e (SubstB (GroupElect) _ _))) ((union e (GroupElect))))

; Logical operations
(rule ((= e (SubstB (LogNot x) idx val))) ((union e (LogNot (SubstB x idx val)))))
(rule ((= e (SubstB (LogAnd x y) idx val))) ((union e (LogAnd (SubstB x idx val) (SubstB y idx val)))))
(rule ((= e (SubstB (LogOr x y) idx val))) ((union e (LogOr (SubstB x idx val) (SubstB y idx val)))))
(rule ((= e (SubstB (LogEq x y) idx val))) ((union e (LogEq (SubstB x idx val) (SubstB y idx val)))))
(rule ((= e (SubstB (LogNe x y) idx val))) ((union e (LogNe (SubstB x idx val) (SubstB y idx val)))))

; Integer comparisons (take IntExpr operands)
(rule ((= e (SubstB (Eq x y) idx val))) ((union e (Eq (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstB (Ne x y) idx val))) ((union e (Ne (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstB (SLt x y) idx val))) ((union e (SLt (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstB (SLe x y) idx val))) ((union e (SLe (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstB (SGt x y) idx val))) ((union e (SGt (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstB (SGe x y) idx val))) ((union e (SGe (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstB (ULt x y) idx val))) ((union e (ULt (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstB (ULe x y) idx val))) ((union e (ULe (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstB (UGt x y) idx val))) ((union e (UGt (SubstI x idx val) (SubstI y idx val)))))
(rule ((= e (SubstB (UGe x y) idx val))) ((union e (UGe (SubstI x idx val) (SubstI y idx val)))))

; Float comparisons (take FloatExpr operands)
(rule ((= e (SubstB (FOrdEq x y) idx val))) ((union e (FOrdEq (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstB (FOrdNe x y) idx val))) ((union e (FOrdNe (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstB (FOrdLt x y) idx val))) ((union e (FOrdLt (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstB (FOrdLe x y) idx val))) ((union e (FOrdLe (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstB (FOrdGt x y) idx val))) ((union e (FOrdGt (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstB (FOrdGe x y) idx val))) ((union e (FOrdGe (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstB (FEq x y) idx val))) ((union e (FEq (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstB (FNe x y) idx val))) ((union e (FNe (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstB (FLt x y) idx val))) ((union e (FLt (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstB (FLe x y) idx val))) ((union e (FLe (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstB (FGt x y) idx val))) ((union e (FGt (SubstF x idx val) (SubstF y idx val)))))
(rule ((= e (SubstB (FGe x y) idx val))) ((union e (FGe (SubstF x idx val) (SubstF y idx val)))))

; FP predicates
(rule ((= e (SubstB (IsNan x) idx val))) ((union e (IsNan (SubstF x idx val)))))
(rule ((= e (SubstB (IsInf x) idx val))) ((union e (IsInf (SubstF x idx val)))))

; Typed control flow within BoolExpr
(rule ((= e (SubstB (GammaB c t f) idx val))) ((union e (GammaB (SubstB c idx val) (SubstB t idx val) (SubstB f idx val)))))
(rule ((= e (SubstB (SelectB c t f) idx val))) ((union e (SelectB (SubstB c idx val) (SubstB t idx val) (SubstB f idx val)))))
(rule ((= e (SubstB (ThetaB c b i) idx val))) ((union e (ThetaB (SubstB c idx val) (SubstB b idx val) (SubstB i idx val)))))
(rule ((= e (SubstB (LoopInvariantB x) idx val))) ((union e (LoopInvariantB (SubstB x idx val)))))
(rule ((= e (SubstB (CopyB x) idx val))) ((union e (CopyB (SubstB x idx val)))))

; Subgroup bool ops
(rule ((= e (SubstB (GroupAll x) idx val))) ((union e (GroupAll (SubstB x idx val)))))
(rule ((= e (SubstB (GroupAny x) idx val))) ((union e (GroupAny (SubstB x idx val)))))
(rule ((= e (SubstB (GroupAllEqual x) idx val))) ((union e (GroupAllEqual (Subst x idx val)))))
(rule ((= e (SubstB (GroupLogAnd x) idx val))) ((union e (GroupLogAnd (SubstB x idx val)))))
(rule ((= e (SubstB (GroupLogOr x) idx val))) ((union e (GroupLogOr (SubstB x idx val)))))
(rule ((= e (SubstB (GroupLogXor x) idx val))) ((union e (GroupLogXor (SubstB x idx val)))))
(rule ((= e (SubstB (Any x) idx val))) ((union e (Any (Subst x idx val)))))
(rule ((= e (SubstB (All x) idx val))) ((union e (All (Subst x idx val)))))

; =============================================================================
; SECTION 2: Control Flow Substitution (Gamma/Theta)
; =============================================================================
; Gamma/Select/If/Theta conditions are now BoolExpr. Since Subst operates
; on Expr, the BoolExpr condition cannot contain Arg (which is Expr sort).
; Therefore, we pass the condition through unchanged and only substitute
; into the Expr-sort operands.

(rule ((= e (Subst (Gamma c t f) idx val)))
      ((union e (Gamma c (Subst t idx val) (Subst f idx val)))))
(rule ((= e (Subst (Select c t f) idx val)))
      ((union e (Select c (Subst t idx val) (Subst f idx val)))))
(rule ((= e (Subst (If c t f) idx val)))
      ((union e (If c (Subst t idx val) (Subst f idx val)))))

; Theta node substitution (careful with LoopVar)
; Theta condition is BoolExpr - passed through unchanged
(rule ((= e (Subst (Theta cond body init) idx val)))
      ((union e (Theta cond (Subst body idx val) (Subst init idx val)))))

; LoopVar is not affected by substitution (different binding scope)
(rule ((= e (Subst (LoopVar) _ _)))
      ((union e (LoopVar))))

; LoopInvariant substitution
(rule ((= e (Subst (LoopInvariant x) idx val)))
      ((union e (LoopInvariant (Subst x idx val)))))

; BoundedTheta substitution (trip count is i64 literal, not affected)
(rule ((= e (Subst (BoundedTheta n body init) idx val)))
      ((union e (BoundedTheta n (Subst body idx val) (Subst init idx val)))))

; =============================================================================
; SECTION 3: Vector Operation Substitution
; =============================================================================

(rule ((= e (Subst (Vec2 a b) idx val)))
      ((union e (Vec2 (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (Vec3 a b c) idx val)))
      ((union e (Vec3 (Subst a idx val) (Subst b idx val) (Subst c idx val)))))
(rule ((= e (Subst (Vec4 a b c d) idx val)))
      ((union e (Vec4 (Subst a idx val) (Subst b idx val) (Subst c idx val) (Subst d idx val)))))

(rule ((= e (Subst (VecExtract v i) idx val)))
      ((union e (VecExtract (Subst v idx val) i))))
(rule ((= e (Subst (VecInsert v s i) idx val)))
      ((union e (VecInsert (Subst v idx val) (Subst s idx val) i))))

(rule ((= e (Subst (VecBroadcast2 a) idx val)))
      ((union e (VecBroadcast2 (Subst a idx val)))))
(rule ((= e (Subst (VecBroadcast3 a) idx val)))
      ((union e (VecBroadcast3 (Subst a idx val)))))
(rule ((= e (Subst (VecBroadcast4 a) idx val)))
      ((union e (VecBroadcast4 (Subst a idx val)))))

(rule ((= e (Subst (VecAdd a b) idx val)))
      ((union e (VecAdd (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (VecSub a b) idx val)))
      ((union e (VecSub (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (VecMul a b) idx val)))
      ((union e (VecMul (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (VecDiv a b) idx val)))
      ((union e (VecDiv (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (VecNeg a) idx val)))
      ((union e (VecNeg (Subst a idx val)))))
(rule ((= e (Subst (VecFAdd a b) idx val)))
      ((union e (VecFAdd (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (VecFSub a b) idx val)))
      ((union e (VecFSub (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (VecFMul a b) idx val)))
      ((union e (VecFMul (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (VecFDiv a b) idx val)))
      ((union e (VecFDiv (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (VecFNeg a) idx val)))
      ((union e (VecFNeg (Subst a idx val)))))

(rule ((= e (Subst (VecTimesScalar v s) idx val)))
      ((union e (VecTimesScalar (Subst v idx val) (Subst s idx val)))))

; Shuffle operations (indices are constants, not affected)
(rule ((= e (Subst (VecShuffle2 v1 v2 i0 i1) idx val)))
      ((union e (VecShuffle2 (Subst v1 idx val) (Subst v2 idx val) i0 i1))))
(rule ((= e (Subst (VecShuffle3 v1 v2 i0 i1 i2) idx val)))
      ((union e (VecShuffle3 (Subst v1 idx val) (Subst v2 idx val) i0 i1 i2))))
(rule ((= e (Subst (VecShuffle4 v1 v2 i0 i1 i2 i3) idx val)))
      ((union e (VecShuffle4 (Subst v1 idx val) (Subst v2 idx val) i0 i1 i2 i3))))

; =============================================================================
; SECTION 4: Matrix Operation Substitution
; =============================================================================

(rule ((= e (Subst (MatTimesScalar m s) idx val)))
      ((union e (MatTimesScalar (Subst m idx val) (Subst s idx val)))))
(rule ((= e (Subst (MatTimesVec m v) idx val)))
      ((union e (MatTimesVec (Subst m idx val) (Subst v idx val)))))
(rule ((= e (Subst (VecTimesMat v m) idx val)))
      ((union e (VecTimesMat (Subst v idx val) (Subst m idx val)))))
(rule ((= e (Subst (MatTimesMat a b) idx val)))
      ((union e (MatTimesMat (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (Transpose m) idx val)))
      ((union e (Transpose (Subst m idx val)))))
(rule ((= e (Subst (OuterProduct a b) idx val)))
      ((union e (OuterProduct (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (MatInverse m) idx val)))
      ((union e (MatInverse (Subst m idx val)))))

; =============================================================================
; SECTION 5: Geometric Operation Substitution (Expr-sort only)
; =============================================================================
; Only Expr-sort geometric ops remain. Dot, Length, Distance, Determinant
; return FloatExpr so their Subst rules have been removed.

(rule ((= e (Subst (Cross a b) idx val)))
      ((union e (Cross (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (Normalize a) idx val)))
      ((union e (Normalize (Subst a idx val)))))
(rule ((= e (Subst (Reflect i n) idx val)))
      ((union e (Reflect (Subst i idx val) (Subst n idx val)))))
(rule ((= e (Subst (Refract i n eta) idx val)))
      ((union e (Refract (Subst i idx val) (Subst n idx val) (Subst eta idx val)))))
(rule ((= e (Subst (FaceForward n i nref) idx val)))
      ((union e (FaceForward (Subst n idx val) (Subst i idx val) (Subst nref idx val)))))

; =============================================================================
; SECTION 6: Type Conversion Substitution (Expr-sort only)
; =============================================================================
; Only Bitcast remains as Expr -> Expr. All other conversions produce typed
; sorts (IntExpr, FloatExpr) and have been removed.

(rule ((= e (Subst (Bitcast a) idx val)))
      ((union e (Bitcast (Subst a idx val)))))

; =============================================================================
; SECTION 7: Memory Operation Substitution
; =============================================================================

; Memory state operations
(rule ((= e (Subst (InitMem) _ _)))
      ((union e (InitMem))))
(rule ((= e (Subst (Load ptr mem) idx val)))
      ((union e (Load (Subst ptr idx val) (Subst mem idx val)))))
(rule ((= e (Subst (StoreMem ptr v mem) idx val)))
      ((union e (StoreMem (Subst ptr idx val) (Subst v idx val) (Subst mem idx val)))))

; MergeMem condition is BoolExpr - passed through unchanged
(rule ((= e (Subst (MergeMem c t f) idx val)))
      ((union e (MergeMem c (Subst t idx val) (Subst f idx val)))))

; LoopMem condition is BoolExpr - passed through unchanged
(rule ((= e (Subst (LoopMem c b i) idx val)))
      ((union e (LoopMem c (Subst b idx val) (Subst i idx val)))))

; Pointers and access chains
(rule ((= e (Subst (Var name sc) _ _)))
      ((union e (Var name sc))))
(rule ((= e (Subst (AccessChain1 base i) idx val)))
      ((union e (AccessChain1 (Subst base idx val) i))))
(rule ((= e (Subst (AccessChain2 base i j) idx val)))
      ((union e (AccessChain2 (Subst base idx val) i j))))
(rule ((= e (Subst (AccessChain3 base i j k) idx val)))
      ((union e (AccessChain3 (Subst base idx val) i j k))))
(rule ((= e (Subst (AccessChainDyn base i) idx val)))
      ((union e (AccessChainDyn (Subst base idx val) (Subst i idx val)))))

; Image operations
(rule ((= e (Subst (ImageSample img coord) idx val)))
      ((union e (ImageSample (Subst img idx val) (Subst coord idx val)))))
(rule ((= e (Subst (ImageFetch img coord) idx val)))
      ((union e (ImageFetch (Subst img idx val) (Subst coord idx val)))))
(rule ((= e (Subst (ImageRead img coord) idx val)))
      ((union e (ImageRead (Subst img idx val) (Subst coord idx val)))))
(rule ((= e (Subst (SampledImage img sampler) idx val)))
      ((union e (SampledImage (Subst img idx val) (Subst sampler idx val)))))
(rule ((= e (Subst (Image a) idx val)))
      ((union e (Image (Subst a idx val)))))
(rule ((= e (Subst (ImageWrite img coord data mem) idx val)))
      ((union e (ImageWrite (Subst img idx val) (Subst coord idx val) (Subst data idx val) (Subst mem idx val)))))

; Atomic operations
(rule ((= e (Subst (AtomicLoad ptr mem) idx val)))
      ((union e (AtomicLoad (Subst ptr idx val) (Subst mem idx val)))))
(rule ((= e (Subst (AtomicStore ptr v mem) idx val)))
      ((union e (AtomicStore (Subst ptr idx val) (Subst v idx val) (Subst mem idx val)))))
(rule ((= e (Subst (AtomicExchange ptr v mem) idx val)))
      ((union e (AtomicExchange (Subst ptr idx val) (Subst v idx val) (Subst mem idx val)))))
(rule ((= e (Subst (AtomicCompareExchange ptr cmp v mem) idx val)))
      ((union e (AtomicCompareExchange (Subst ptr idx val) (Subst cmp idx val) (Subst v idx val) (Subst mem idx val)))))
(rule ((= e (Subst (AtomicIAdd ptr v mem) idx val)))
      ((union e (AtomicIAdd (Subst ptr idx val) (Subst v idx val) (Subst mem idx val)))))
(rule ((= e (Subst (AtomicISub ptr v mem) idx val)))
      ((union e (AtomicISub (Subst ptr idx val) (Subst v idx val) (Subst mem idx val)))))
(rule ((= e (Subst (AtomicSMin ptr v mem) idx val)))
      ((union e (AtomicSMin (Subst ptr idx val) (Subst v idx val) (Subst mem idx val)))))
(rule ((= e (Subst (AtomicUMin ptr v mem) idx val)))
      ((union e (AtomicUMin (Subst ptr idx val) (Subst v idx val) (Subst mem idx val)))))
(rule ((= e (Subst (AtomicSMax ptr v mem) idx val)))
      ((union e (AtomicSMax (Subst ptr idx val) (Subst v idx val) (Subst mem idx val)))))
(rule ((= e (Subst (AtomicUMax ptr v mem) idx val)))
      ((union e (AtomicUMax (Subst ptr idx val) (Subst v idx val) (Subst mem idx val)))))
(rule ((= e (Subst (AtomicAnd ptr v mem) idx val)))
      ((union e (AtomicAnd (Subst ptr idx val) (Subst v idx val) (Subst mem idx val)))))
(rule ((= e (Subst (AtomicOr ptr v mem) idx val)))
      ((union e (AtomicOr (Subst ptr idx val) (Subst v idx val) (Subst mem idx val)))))
(rule ((= e (Subst (AtomicXor ptr v mem) idx val)))
      ((union e (AtomicXor (Subst ptr idx val) (Subst v idx val) (Subst mem idx val)))))

; =============================================================================
; SECTION 8: Subgroup Operation Substitution (Expr-sort only)
; =============================================================================
; Only Expr-sort subgroup ops remain: GroupBroadcast, GroupBroadcastFirst,
; GroupShuffle, GroupShuffleXor. All other subgroup ops now produce typed
; sorts (IntExpr, FloatExpr, BoolExpr) and have been removed.

(rule ((= e (Subst (GroupBroadcast a lane) idx val)))
      ((union e (GroupBroadcast (Subst a idx val) (Subst lane idx val)))))
(rule ((= e (Subst (GroupBroadcastFirst a) idx val)))
      ((union e (GroupBroadcastFirst (Subst a idx val)))))
(rule ((= e (Subst (GroupShuffle a lane) idx val)))
      ((union e (GroupShuffle (Subst a idx val) (Subst lane idx val)))))
(rule ((= e (Subst (GroupShuffleXor a mask) idx val)))
      ((union e (GroupShuffleXor (Subst a idx val) (Subst mask idx val)))))

; =============================================================================
; SECTION 9: Image Query Substitution
; =============================================================================

(rule ((= e (Subst (ImageQuerySize img) idx val)))
      ((union e (ImageQuerySize (Subst img idx val)))))
(rule ((= e (Subst (ImageQuerySizeLod img lod) idx val)))
      ((union e (ImageQuerySizeLod (Subst img idx val) (Subst lod idx val)))))
(rule ((= e (Subst (ImageQueryLevels img) idx val)))
      ((union e (ImageQueryLevels (Subst img idx val)))))
(rule ((= e (Subst (ImageQuerySamples img) idx val)))
      ((union e (ImageQuerySamples (Subst img idx val)))))
(rule ((= e (Subst (ImageQueryLod img coord) idx val)))
      ((union e (ImageQueryLod (Subst img idx val) (Subst coord idx val)))))

; =============================================================================
; SECTION 10: CopyObject Substitution
; =============================================================================

(rule ((= e (Subst (CopyObject a) idx val)))
      ((union e (CopyObject (Subst a idx val)))))

; =============================================================================
; SECTION 11: Multi-Argument Substitution Helpers
; =============================================================================
; For functions with multiple arguments, we chain substitutions.
; Subst2(body, val0, val1) = Subst(Subst(body, 0, val0), 1, val1)
; This enables: Call2(f, a, b) = Subst2(body_of_f, a, b)
; Note: Subst2/3/4 are defined as datatype constructors in datatypes.egg

; Subst2(body, v0, v1) = Subst(Subst(body, 0, v0), 1, v1)
(rule ((= e (Subst2 body v0 v1)))
      ((union e (Subst (Subst body 0 v0) 1 v1))))

; Subst3(body, v0, v1, v2) = Subst(Subst(Subst(body, 0, v0), 1, v1), 2, v2)
(rule ((= e (Subst3 body v0 v1 v2)))
      ((union e (Subst (Subst (Subst body 0 v0) 1 v1) 2 v2))))

; Subst4(body, v0, v1, v2, v3) = ...
(rule ((= e (Subst4 body v0 v1 v2 v3)))
      ((union e (Subst (Subst (Subst (Subst body 0 v0) 1 v1) 2 v2) 3 v3))))

; =============================================================================
; SECTION 12: Substitution Optimizations
; =============================================================================
; When substitution doesn't change anything, simplify.

; Subst into expression that doesn't contain Arg(idx) = original expression
; This is hard to express without liveness analysis, but some cases are obvious:

; Nested Subst with same index - inner one takes precedence
; Subst(Subst(body, n, v1), n, v2) = Subst(body, n, v2)
; (The outer substitution shadows the inner one for Arg(n))
(rule ((= e (Subst (Subst body n v1) n v2)))
      ((union e (Subst body n v2))))

; Substituting same value has no effect - identity
; This enables better CSE when the same value is passed through
; (Note: this rule is the same as the base case in Section 1)

; =============================================================================
; SECTION 13: Liveness Propagation
; =============================================================================
; Subst propagates liveness to both body and value

(rule ((Live e) (= e (Subst body idx val)))
      ((Live body) (Live val)))
(rule ((Live e) (= e (Subst2 body v0 v1)))
      ((Live body) (Live v0) (Live v1)))
(rule ((Live e) (= e (Subst3 body v0 v1 v2)))
      ((Live body) (Live v0) (Live v1) (Live v2)))
(rule ((Live e) (= e (Subst4 body v0 v1 v2 v3)))
      ((Live body) (Live v0) (Live v1) (Live v2) (Live v3)))

; Arg is a leaf - no sub-expressions to propagate
(rule ((Live e) (= e (Arg _))) ())

; Call liveness propagates to arguments
(rule ((Live e) (= e (Call1 _ a)))
      ((Live a)))
(rule ((Live e) (= e (Call2 _ a b)))
      ((Live a) (Live b)))
(rule ((Live e) (= e (Call3 _ a b c)))
      ((Live a) (Live b) (Live c)))
(rule ((Live e) (= e (Call4 _ a b c d)))
      ((Live a) (Live b) (Live c) (Live d)))

; =============================================================================
; SECTION 14: Constant Folding After Substitution
; =============================================================================
; After substituting a constant for an argument, further simplifications apply.
; These are handled by the existing arithmetic/logical rules, but we note that
; Subst(Add(Arg(0), Arg(0)), 0, (Const 5)) = Add(Const 5, Const 5) = Const 10
; The Subst rules above expand this, then constant folding kicks in.
; NOTE: With typed sorts, this now works through bridge constructors.

; =============================================================================
; SECTION 15: Nested Call Inlining
; =============================================================================
; When a function body contains a call, and both get inlined, the inner call
; also gets expanded. This happens naturally through the e-graph saturation.
;
; f(x) = g(x + 1)
; g(y) = y * 2
;
; Call1("f", 5)
;   = Subst(g(Arg(0) + 1), 0, 5)    ; inline f
;   = Call1("g", 5 + 1)              ; after Subst expansion
;   = Call1("g", 6)                  ; constant fold
;   = Subst(Arg(0) * 2, 0, 6)        ; inline g
;   = 6 * 2 = 12                     ; constant fold

; =============================================================================
; SECTION 16: Spec Constant Operation Substitution
; =============================================================================
; All Spec* ops are Expr sort, so Subst rules are preserved.

(rule ((= e (Subst (SpecConst id def) _ _)))
      ((union e (SpecConst id def))))
(rule ((= e (Subst (SpecAdd a b) idx val)))
      ((union e (SpecAdd (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SpecSub a b) idx val)))
      ((union e (SpecSub (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SpecMul a b) idx val)))
      ((union e (SpecMul (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SpecSDiv a b) idx val)))
      ((union e (SpecSDiv (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SpecUDiv a b) idx val)))
      ((union e (SpecUDiv (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SpecSMod a b) idx val)))
      ((union e (SpecSMod (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SpecUMod a b) idx val)))
      ((union e (SpecUMod (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SpecShl a b) idx val)))
      ((union e (SpecShl (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SpecShrS a b) idx val)))
      ((union e (SpecShrS (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SpecShrU a b) idx val)))
      ((union e (SpecShrU (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SpecBitAnd a b) idx val)))
      ((union e (SpecBitAnd (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SpecBitOr a b) idx val)))
      ((union e (SpecBitOr (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SpecBitXor a b) idx val)))
      ((union e (SpecBitXor (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SpecEq a b) idx val)))
      ((union e (SpecEq (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SpecNe a b) idx val)))
      ((union e (SpecNe (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SpecSLt a b) idx val)))
      ((union e (SpecSLt (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SpecULt a b) idx val)))
      ((union e (SpecULt (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SpecSelect c t f) idx val)))
      ((union e (SpecSelect (Subst c idx val) (Subst t idx val) (Subst f idx val)))))

; =============================================================================
; SECTION 17: Loop Iteration Substitution
; =============================================================================

(rule ((= e (Subst (LoopIter n x) idx val)))
      ((union e (LoopIter n (Subst x idx val)))))
