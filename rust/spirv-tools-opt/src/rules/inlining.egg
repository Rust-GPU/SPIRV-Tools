(rule ((= e (Subst (Tan a) idx val)))
      ((union e (Tan (Subst a idx val)))))
(rule ((= e (Subst (Asin a) idx val)))
      ((union e (Asin (Subst a idx val)))))
(rule ((= e (Subst (Acos a) idx val)))
      ((union e (Acos (Subst a idx val)))))
(rule ((= e (Subst (Atan a) idx val)))
      ((union e (Atan (Subst a idx val)))))
(rule ((= e (Subst (Atan2 a b) idx val)))
      ((union e (Atan2 (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (Sinh a) idx val)))
      ((union e (Sinh (Subst a idx val)))))
(rule ((= e (Subst (Cosh a) idx val)))
      ((union e (Cosh (Subst a idx val)))))
(rule ((= e (Subst (Tanh a) idx val)))
