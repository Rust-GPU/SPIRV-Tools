(rule ((= e (Subst (Log2 a) idx val)))
      ((union e (Log2 (Subst a idx val)))))
(rule ((= e (Subst (Pow a b) idx val)))
      ((union e (Pow (Subst a idx val) (Subst b idx val)))))

