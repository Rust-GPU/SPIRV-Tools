; =============================================================================
; Function Inlining Support for E-Graph Optimization
; =============================================================================
;
; This module provides comprehensive function inlining support in the e-graph.
; Function inlining replaces a call site with the function body, substituting
; arguments for parameters.
;
; Key concepts:
; - Call1/2/3/4: Function calls with 1-4 arguments
; - Subst: Substitute a value for an argument reference (Arg n)
; - FuncDef: Function definition binding a name to a body
; - EffSubst: Substitution for effectful function bodies
;
; Inlining benefits:
; - Enables cross-function optimization (constant propagation, CSE)
; - Eliminates call overhead
; - Allows specialized code generation per call site
;
; =============================================================================
; SECTION 1: Core Substitution Rules
; =============================================================================
; Subst(body, n, val) replaces Arg(n) with val in body.
; These rules push substitution down through all expression forms.

; Base case: Substituting for Arg(n) with matching index
(rule ((= e (Subst (Arg n) n val)))
      ((union e val)))

; Arg with non-matching index is unchanged
; We handle specific common cases since egglog can't express inequality
; Subst(Arg(0), 1, val) = Arg(0), Subst(Arg(1), 0, val) = Arg(1), etc.
(rule ((= e (Subst (Arg 0) 1 _))) ((union e (Arg 0))))
(rule ((= e (Subst (Arg 0) 2 _))) ((union e (Arg 0))))
(rule ((= e (Subst (Arg 0) 3 _))) ((union e (Arg 0))))
(rule ((= e (Subst (Arg 1) 0 _))) ((union e (Arg 1))))
(rule ((= e (Subst (Arg 1) 2 _))) ((union e (Arg 1))))
(rule ((= e (Subst (Arg 1) 3 _))) ((union e (Arg 1))))
(rule ((= e (Subst (Arg 2) 0 _))) ((union e (Arg 2))))
(rule ((= e (Subst (Arg 2) 1 _))) ((union e (Arg 2))))
(rule ((= e (Subst (Arg 2) 3 _))) ((union e (Arg 2))))
(rule ((= e (Subst (Arg 3) 0 _))) ((union e (Arg 3))))
(rule ((= e (Subst (Arg 3) 1 _))) ((union e (Arg 3))))
(rule ((= e (Subst (Arg 3) 2 _))) ((union e (Arg 3))))

; Constants are unaffected by substitution
(rule ((= e (Subst (Const c) _ _)))
      ((union e (Const c))))
(rule ((= e (Subst (Const64 c) _ _)))
      ((union e (Const64 c))))
(rule ((= e (Subst (Sym s) _ _)))
      ((union e (Sym s))))
(rule ((= e (Subst (Undef) _ _)))
      ((union e (Undef))))

; =============================================================================
; SECTION 2: Arithmetic Operation Substitution
; =============================================================================

; Binary arithmetic
(rule ((= e (Subst (Add a b) idx val)))
      ((union e (Add (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (Sub a b) idx val)))
      ((union e (Sub (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (Mul a b) idx val)))
      ((union e (Mul (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SDiv a b) idx val)))
      ((union e (SDiv (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (UDiv a b) idx val)))
      ((union e (UDiv (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SRem a b) idx val)))
      ((union e (SRem (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SMod a b) idx val)))
      ((union e (SMod (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (UMod a b) idx val)))
      ((union e (UMod (Subst a idx val) (Subst b idx val)))))

; Unary arithmetic
(rule ((= e (Subst (Neg a) idx val)))
      ((union e (Neg (Subst a idx val)))))

; =============================================================================
; SECTION 3: Bitwise Operation Substitution
; =============================================================================

(rule ((= e (Subst (BitAnd a b) idx val)))
      ((union e (BitAnd (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (BitOr a b) idx val)))
      ((union e (BitOr (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (BitXor a b) idx val)))
      ((union e (BitXor (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (BitNot a) idx val)))
      ((union e (BitNot (Subst a idx val)))))
(rule ((= e (Subst (Shl a b) idx val)))
      ((union e (Shl (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (ShrS a b) idx val)))
      ((union e (ShrS (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (ShrU a b) idx val)))
      ((union e (ShrU (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (BitReverse a) idx val)))
      ((union e (BitReverse (Subst a idx val)))))
(rule ((= e (Subst (RotL a b) idx val)))
      ((union e (RotL (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (RotR a b) idx val)))
      ((union e (RotR (Subst a idx val) (Subst b idx val)))))

; =============================================================================
; SECTION 4: Comparison Operation Substitution
; =============================================================================

(rule ((= e (Subst (Eq a b) idx val)))
      ((union e (Eq (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (Ne a b) idx val)))
      ((union e (Ne (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SLt a b) idx val)))
      ((union e (SLt (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SLe a b) idx val)))
      ((union e (SLe (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SGt a b) idx val)))
      ((union e (SGt (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SGe a b) idx val)))
      ((union e (SGe (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (ULt a b) idx val)))
      ((union e (ULt (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (ULe a b) idx val)))
      ((union e (ULe (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (UGt a b) idx val)))
      ((union e (UGt (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (UGe a b) idx val)))
      ((union e (UGe (Subst a idx val) (Subst b idx val)))))

; Logical operations
(rule ((= e (Subst (LogNot a) idx val)))
      ((union e (LogNot (Subst a idx val)))))
(rule ((= e (Subst (LogAnd a b) idx val)))
      ((union e (LogAnd (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (LogOr a b) idx val)))
      ((union e (LogOr (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (LogEq a b) idx val)))
      ((union e (LogEq (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (LogNe a b) idx val)))
      ((union e (LogNe (Subst a idx val) (Subst b idx val)))))

; =============================================================================
; SECTION 5: Floating-Point Operation Substitution
; =============================================================================

(rule ((= e (Subst (FAdd a b) idx val)))
      ((union e (FAdd (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (FSub a b) idx val)))
      ((union e (FSub (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (FMul a b) idx val)))
      ((union e (FMul (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (FDiv a b) idx val)))
      ((union e (FDiv (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (FNeg a) idx val)))
      ((union e (FNeg (Subst a idx val)))))
(rule ((= e (Subst (FRem a b) idx val)))
      ((union e (FRem (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (FAbs a) idx val)))
      ((union e (FAbs (Subst a idx val)))))
(rule ((= e (Subst (FFloor a) idx val)))
      ((union e (FFloor (Subst a idx val)))))
(rule ((= e (Subst (FCeil a) idx val)))
      ((union e (FCeil (Subst a idx val)))))
(rule ((= e (Subst (FRound a) idx val)))
      ((union e (FRound (Subst a idx val)))))
(rule ((= e (Subst (FTrunc a) idx val)))
      ((union e (FTrunc (Subst a idx val)))))

; Floating-point comparisons
(rule ((= e (Subst (FOrdEq a b) idx val)))
      ((union e (FOrdEq (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (FOrdNe a b) idx val)))
      ((union e (FOrdNe (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (FOrdLt a b) idx val)))
      ((union e (FOrdLt (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (FOrdLe a b) idx val)))
      ((union e (FOrdLe (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (FOrdGt a b) idx val)))
      ((union e (FOrdGt (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (FOrdGe a b) idx val)))
      ((union e (FOrdGe (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (FUnordEq a b) idx val)))
      ((union e (FUnordEq (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (FUnordNe a b) idx val)))
      ((union e (FUnordNe (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (FUnordLt a b) idx val)))
      ((union e (FUnordLt (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (FUnordLe a b) idx val)))
      ((union e (FUnordLe (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (FUnordGt a b) idx val)))
      ((union e (FUnordGt (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (FUnordGe a b) idx val)))
      ((union e (FUnordGe (Subst a idx val) (Subst b idx val)))))

; FP predicates
(rule ((= e (Subst (IsNan a) idx val)))
      ((union e (IsNan (Subst a idx val)))))
(rule ((= e (Subst (IsInf a) idx val)))
      ((union e (IsInf (Subst a idx val)))))

; =============================================================================
; SECTION 6: Min/Max Substitution
; =============================================================================

(rule ((= e (Subst (SMin a b) idx val)))
      ((union e (SMin (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (SMax a b) idx val)))
      ((union e (SMax (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (UMin a b) idx val)))
      ((union e (UMin (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (UMax a b) idx val)))
      ((union e (UMax (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (FMin a b) idx val)))
      ((union e (FMin (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (FMax a b) idx val)))
      ((union e (FMax (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (NMin a b) idx val)))
      ((union e (NMin (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (NMax a b) idx val)))
      ((union e (NMax (Subst a idx val) (Subst b idx val)))))

; =============================================================================
; SECTION 7: Control Flow Substitution (Gamma/Theta)
; =============================================================================

(rule ((= e (Subst (Gamma c t f) idx val)))
      ((union e (Gamma (Subst c idx val) (Subst t idx val) (Subst f idx val)))))
(rule ((= e (Subst (Select c t f) idx val)))
      ((union e (Select (Subst c idx val) (Subst t idx val) (Subst f idx val)))))
(rule ((= e (Subst (If c t f) idx val)))
      ((union e (If (Subst c idx val) (Subst t idx val) (Subst f idx val)))))

; Theta node substitution (careful with LoopVar)
(rule ((= e (Subst (Theta cond body init) idx val)))
      ((union e (Theta (Subst cond idx val) (Subst body idx val) (Subst init idx val)))))

; LoopVar is not affected by substitution (different binding scope)
(rule ((= e (Subst (LoopVar) _ _)))
      ((union e (LoopVar))))

; LoopInvariant substitution
(rule ((= e (Subst (LoopInvariant x) idx val)))
      ((union e (LoopInvariant (Subst x idx val)))))

; BoundedTheta substitution
(rule ((= e (Subst (BoundedTheta n body init) idx val)))
      ((union e (BoundedTheta n (Subst body idx val) (Subst init idx val)))))

; =============================================================================
; SECTION 8: Vector Operation Substitution
; =============================================================================

(rule ((= e (Subst (Vec2 a b) idx val)))
      ((union e (Vec2 (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (Vec3 a b c) idx val)))
      ((union e (Vec3 (Subst a idx val) (Subst b idx val) (Subst c idx val)))))
(rule ((= e (Subst (Vec4 a b c d) idx val)))
      ((union e (Vec4 (Subst a idx val) (Subst b idx val) (Subst c idx val) (Subst d idx val)))))

(rule ((= e (Subst (VecExtract v i) idx val)))
      ((union e (VecExtract (Subst v idx val) i))))
(rule ((= e (Subst (VecInsert v s i) idx val)))
      ((union e (VecInsert (Subst v idx val) (Subst s idx val) i))))

(rule ((= e (Subst (VecBroadcast2 a) idx val)))
      ((union e (VecBroadcast2 (Subst a idx val)))))
(rule ((= e (Subst (VecBroadcast3 a) idx val)))
      ((union e (VecBroadcast3 (Subst a idx val)))))
(rule ((= e (Subst (VecBroadcast4 a) idx val)))
      ((union e (VecBroadcast4 (Subst a idx val)))))

(rule ((= e (Subst (VecAdd a b) idx val)))
      ((union e (VecAdd (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (VecSub a b) idx val)))
      ((union e (VecSub (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (VecMul a b) idx val)))
      ((union e (VecMul (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (VecDiv a b) idx val)))
      ((union e (VecDiv (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (VecNeg a) idx val)))
      ((union e (VecNeg (Subst a idx val)))))
(rule ((= e (Subst (VecFAdd a b) idx val)))
      ((union e (VecFAdd (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (VecFSub a b) idx val)))
      ((union e (VecFSub (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (VecFMul a b) idx val)))
      ((union e (VecFMul (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (VecFDiv a b) idx val)))
      ((union e (VecFDiv (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (VecFNeg a) idx val)))
      ((union e (VecFNeg (Subst a idx val)))))

(rule ((= e (Subst (Dot a b) idx val)))
      ((union e (Dot (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (VecTimesScalar v s) idx val)))
      ((union e (VecTimesScalar (Subst v idx val) (Subst s idx val)))))

; Shuffle operations (indices are constants, not affected)
(rule ((= e (Subst (VecShuffle2 v1 v2 i0 i1) idx val)))
      ((union e (VecShuffle2 (Subst v1 idx val) (Subst v2 idx val) i0 i1))))
(rule ((= e (Subst (VecShuffle3 v1 v2 i0 i1 i2) idx val)))
      ((union e (VecShuffle3 (Subst v1 idx val) (Subst v2 idx val) i0 i1 i2))))
(rule ((= e (Subst (VecShuffle4 v1 v2 i0 i1 i2 i3) idx val)))
      ((union e (VecShuffle4 (Subst v1 idx val) (Subst v2 idx val) i0 i1 i2 i3))))

; =============================================================================
; SECTION 9: Matrix Operation Substitution
; =============================================================================

(rule ((= e (Subst (MatTimesScalar m s) idx val)))
      ((union e (MatTimesScalar (Subst m idx val) (Subst s idx val)))))
(rule ((= e (Subst (MatTimesVec m v) idx val)))
      ((union e (MatTimesVec (Subst m idx val) (Subst v idx val)))))
(rule ((= e (Subst (VecTimesMat v m) idx val)))
      ((union e (VecTimesMat (Subst v idx val) (Subst m idx val)))))
(rule ((= e (Subst (MatTimesMat a b) idx val)))
      ((union e (MatTimesMat (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (Transpose m) idx val)))
      ((union e (Transpose (Subst m idx val)))))
(rule ((= e (Subst (OuterProduct a b) idx val)))
      ((union e (OuterProduct (Subst a idx val) (Subst b idx val)))))
(rule ((= e (Subst (Determinant m) idx val)))
      ((union e (Determinant (Subst m idx val)))))
(rule ((= e (Subst (MatInverse m) idx val)))
      ((union e (MatInverse (Subst m idx val)))))

