; =============================================================================
; Floating-Point Rewrite Rules
; =============================================================================
; NOTE: Float constants use FConst(f64) for the FloatExpr sort.
; Use direct f64 comparison (= c 0.0), (= c 1.0), etc. to check identity values.
; Use native f64 arithmetic (*, /, +, -) for constant folding.

; ONE-DIRECTIONAL to prevent e-graph explosion
; x * 1.0 = x (uses f64 identity check)
(rule ((= e (FMul x (FConst c))) (= c 1.0))
      ((union e x)))
(rule ((= e (FMul (FConst c) x)) (= c 1.0))
      ((union e x)))
; x + 0.0 = x (uses f64 identity check)
(rule ((= e (FAdd x (FConst c))) (= c 0.0))
      ((union e x)))
(rule ((= e (FAdd (FConst c) x)) (= c 0.0))
      ((union e x)))
(rule ((= e (FNeg (FNeg x))))
      ((union e x)))
; Idempotent rules - ONE-DIRECTIONAL
(rule ((= e (FFloor (FFloor x))))
      ((union e (FFloor x))))
(rule ((= e (FCeil (FCeil x))))
      ((union e (FCeil x))))
(rule ((= e (FTrunc (FTrunc x))))
      ((union e (FTrunc x))))
(rule ((= e (FRound (FRound x))))
      ((union e (FRound x))))
(rule ((= e (FAbs (FAbs x))))
      ((union e (FAbs x))))
(rule ((= e (FNeg (FAbs x))))
      ((union e (FAbs (FNeg x)))))

; =============================================================================
; Floating-Point Comparison Rules
; =============================================================================

; Ordered comparisons are false if either operand is NaN
; Reflexive ordered comparison (x == x is true unless NaN)
; (rewrite (FOrdEq x x) (LogNot (IsNan x)))  -- disabled, complex

; Unordered comparisons are true if either operand is NaN
; Reflexive unordered inequality (x != x is true only if NaN)
; (rewrite (FUnordNe x x) (IsNan x))  -- disabled, complex

; Negation of ordered vs unordered comparisons - ONE-DIRECTIONAL
; Remove LogNot by flipping comparison type
(rule ((= e (LogNot (FOrdEq a b))))
      ((union e (FUnordNe a b))))
(rule ((= e (LogNot (FOrdNe a b))))
      ((union e (FUnordEq a b))))
(rule ((= e (LogNot (FOrdLt a b))))
      ((union e (FUnordGe a b))))
(rule ((= e (LogNot (FOrdLe a b))))
      ((union e (FUnordGt a b))))
(rule ((= e (LogNot (FOrdGt a b))))
      ((union e (FUnordLe a b))))
(rule ((= e (LogNot (FOrdGe a b))))
      ((union e (FUnordLt a b))))
(rule ((= e (LogNot (FUnordEq a b))))
      ((union e (FOrdNe a b))))
(rule ((= e (LogNot (FUnordNe a b))))
      ((union e (FOrdEq a b))))
(rule ((= e (LogNot (FUnordLt a b))))
      ((union e (FOrdGe a b))))
(rule ((= e (LogNot (FUnordLe a b))))
      ((union e (FOrdGt a b))))
(rule ((= e (LogNot (FUnordGt a b))))
      ((union e (FOrdLe a b))))
(rule ((= e (LogNot (FUnordGe a b))))
      ((union e (FOrdLt a b))))

; Symmetry: a > b  <=>  b < a - ONE-DIRECTIONAL
; Canonicalize to "less than" form to prevent cycles
(rule ((= e (FOrdGt a b)))
      ((union e (FOrdLt b a))))
(rule ((= e (FOrdGe a b)))
      ((union e (FOrdLe b a))))
(rule ((= e (FUnordGt a b)))
      ((union e (FUnordLt b a))))
(rule ((= e (FUnordGe a b)))
      ((union e (FUnordLe b a))))

; =============================================================================
; Floating-Point Arithmetic Identities
; =============================================================================

; Subtraction as addition of negation - ONE-DIRECTIONAL
; FSub is the canonical form, don't expand to FAdd+FNeg (causes explosion)
(rule ((= e (FAdd a (FNeg b))))
      ((union e (FSub a b))))

; Multiply by zero (note: NaN * 0 = NaN, but this is common optimization) - ONE-DIRECTIONAL
(rule ((= e (FMul x (FConst c))) (= c 0.0))
      ((union e (FConst c))))
(rule ((= e (FMul (FConst c) x)) (= c 0.0))
      ((union e (FConst c))))

; Multiply by negative one - ONE-DIRECTIONAL
(rule ((= e (FMul x (FConst c))) (= c -1.0))
      ((union e (FNeg x))))
(rule ((= e (FMul (FConst c) x)) (= c -1.0))
      ((union e (FNeg x))))

; Divide by one - ONE-DIRECTIONAL
(rule ((= e (FDiv x (FConst c))) (= c 1.0))
      ((union e x)))

; Divide by negative one - ONE-DIRECTIONAL
(rule ((= e (FDiv x (FConst c))) (= c -1.0))
      ((union e (FNeg x))))

; x / x = 1.0 (fast-math: assumes x is not zero or NaN) - ONE-DIRECTIONAL
; Combined with FNeg distribution rules below, also handles -x/x and x/(-x)
(rule ((= e (FDiv x x)))
      ((union e (FConst 1.0))))

; x - x = 0 - ONE-DIRECTIONAL
(rule ((= e (FSub x x)))
      ((union e (FConst 0.0))))

; Negation of subtraction - ONE-DIRECTIONAL
(rule ((= e (FNeg (FSub a b))))
      ((union e (FSub b a))))

; Distributive property for negation - ONE-DIRECTIONAL to prevent explosion
; We pull FNeg OUT of FMul, not push IN (which would expand forever)
(rule ((= e (FMul (FNeg a) b)))
      ((union e (FNeg (FMul a b)))))
(rule ((= e (FMul a (FNeg b))))
      ((union e (FNeg (FMul a b)))))

; Double negation in multiplication cancels - ONE-DIRECTIONAL
(rule ((= e (FMul (FNeg a) (FNeg b))))
      ((union e (FMul a b))))

; Division with negation - ONE-DIRECTIONAL to prevent explosion
; We pull FNeg OUT of FDiv, not push IN
(rule ((= e (FDiv (FNeg a) b)))
      ((union e (FNeg (FDiv a b)))))
(rule ((= e (FDiv a (FNeg b))))
      ((union e (FNeg (FDiv a b)))))
(rule ((= e (FDiv (FNeg a) (FNeg b))))
      ((union e (FDiv a b))))

; =============================================================================
; Floating-Point Min/Max
; =============================================================================

; FMin/FMax are idempotent - ONE-DIRECTIONAL
(rule ((= e (FMin x x)))
      ((union e x)))
(rule ((= e (FMax x x)))
      ((union e x)))

; FMin/FMax associativity - ONE-DIRECTIONAL (right-associative canonical form)
(rule ((= e (FMin (FMin a b) c)))
      ((union e (FMin a (FMin b c)))))
(rule ((= e (FMax (FMax a b) c)))
      ((union e (FMax a (FMax b c)))))

; FMin/FMax commutativity - REMOVED to prevent e-graph explosion
; These bidirectional rules cause cycles: (FMin a b) <-> (FMin b a) <-> ...

; FMin/FMax with negation - ONE-DIRECTIONAL
(rule ((= e (FMin (FNeg a) (FNeg b))))
      ((union e (FNeg (FMax a b)))))
(rule ((= e (FMax (FNeg a) (FNeg b))))
      ((union e (FNeg (FMin a b)))))

; =============================================================================
; Floor/Ceil/Trunc/Round Relationships
; =============================================================================

; Floor of negation - ONE-DIRECTIONAL
(rule ((= e (FFloor (FNeg x))))
      ((union e (FNeg (FCeil x)))))
(rule ((= e (FCeil (FNeg x))))
      ((union e (FNeg (FFloor x)))))

; Trunc of negation (same sign behavior) - ONE-DIRECTIONAL
(rule ((= e (FTrunc (FNeg x))))
      ((union e (FNeg (FTrunc x)))))

; Round of negation - ONE-DIRECTIONAL
(rule ((= e (FRound (FNeg x))))
      ((union e (FNeg (FRound x)))))

; =============================================================================
; Additional Floating-Point Algebraic Identities
; =============================================================================

; FAdd/FMul commutativity - REMOVED to prevent e-graph explosion
; These bidirectional rules cause cycles: (FAdd a b) <-> (FAdd b a) <-> ...
; Commutativity is handled implicitly by the e-graph when both forms are present

; FAdd/FMul associativity - RESTRICTED to prevent explosion
; General associativity (FAdd (FAdd a b) c) -> (FAdd a (FAdd b c)) causes e-graph explosion:
;   1. FAdd(x, 0) = x via identity
;   2. Any FAdd(x, Y) matches FAdd(FAdd(x, 0), Y) and cascades endlessly
;
; Safe variant: Only apply when 'b' is an FAdd/FMul (not an FConst that could be 0 or 1).
; NOTE: FAdd associativity is safe with current workloads (only 11 matches at iter 3
; on sky-shader), but could exhibit Catalan blowup if a shader has deep FAdd chains
; with shared sub-expressions. Monitor if new shaders cause FAdd explosion.
(rule ((= e (FAdd (FAdd a b) c)) (= b (FAdd _ _)))
      ((union e (FAdd a (FAdd b c)))))
; DISABLED: FMul associativity causes exponential blowup on its own.
; With ~1,264 FMul nodes sharing e-classes (common in sky/lighting shaders),
; re-parenthesization creates 305K+ matches and 455K FMul tuples in one
; iteration via Catalan-number growth across shared sub-expressions.
; Constant chain merging (FMul(FMul(x, const_a), const_b) → FMul(x, const_a*b))
; is handled by dedicated rules below and does NOT need this.
; (rule ((= e (FMul (FMul a b) c)) (= b (FMul _ _)))
;       ((union e (FMul a (FMul b c)))))

; Factoring: a*c + b*c = (a+b)*c
; DISABLED: Creates a feedback loop with FMul associativity above.
; Factoring creates new FMul+FAdd nodes, associativity re-parenthesizes the
; new FMul nodes, exposing more factoring opportunities → exponential blowup.
; In the sky-shader, this explodes from 2,875 to 916,652 tuples in one iteration
; (305K associativity matches + 304K factoring matches).
; (rule ((= e (FAdd (FMul a c) (FMul b c))))
;       ((union e (FMul (FAdd a b) c))))
; (rule ((= e (FAdd (FMul c a) (FMul c b))))
;       ((union e (FMul c (FAdd a b)))))

; x + x = 2*x - ONE-DIRECTIONAL to prevent explosion
; (FMul x 2 -> FAdd x x would expand forever)
(rule ((= e (FAdd x x)))
      ((union e (FMul x (FConst 2.0)))))

; =============================================================================
; FP Division Optimization
; =============================================================================

; NOTE: General restructuring rules like (a/b)/c = a/(b*c) and a/(b/c) = (a*c)/b
; cause e-graph explosion because they unconditionally create new FMul nodes
; that then interact with other rules in cycles. Instead we have:
; 1. Specific rules for reciprocals (1/x patterns) - see below
; 2. Constant merging rules (x/a)/b = x/(a*b) when a,b are constants

; (a * b) / b = a (assuming no NaN/Inf issues) - ONE-DIRECTIONAL
(rule ((= e (FDiv (FMul a b) b)))
      ((union e a)))
(rule ((= e (FDiv (FMul b a) b)))
      ((union e a)))

; =============================================================================
; FP Min/Max Additional Rules
; =============================================================================

; Note: FMin/FMax negation rules are in the section above

; FMin/FMax absorption - ONE-DIRECTIONAL
(rule ((= e (FMin a (FMax a b))))
      ((union e a)))
(rule ((= e (FMin (FMax a b) a)))
      ((union e a)))
(rule ((= e (FMax a (FMin a b))))
      ((union e a)))
(rule ((= e (FMax (FMin a b) a)))
      ((union e a)))

; FMin/FMax idempotent within nesting - ONE-DIRECTIONAL
(rule ((= e (FMin (FMin a b) b)))
      ((union e (FMin a b))))
(rule ((= e (FMin a (FMin a b))))
      ((union e (FMin a b))))
(rule ((= e (FMax (FMax a b) b)))
      ((union e (FMax a b))))
(rule ((= e (FMax a (FMax a b))))
      ((union e (FMax a b))))

; =============================================================================
; Floating-Point Arithmetic Chain Merging (C++ MergeMulMul, etc.)
; =============================================================================
; NOTE: Using native f64 arithmetic for constant folding with FConst

; (x * a) * b = x * (a * b) for float constants
; Note: These rules assume fast-math style optimization (may affect precision)
(rule ((= e (FMul (FMul x (FConst a)) (FConst b))))
      ((union e (FMul x (FConst (* a b))))))
(rule ((= e (FMul (FConst b) (FMul x (FConst a)))))
      ((union e (FMul x (FConst (* a b))))))

; (x / a) / b = x / (a * b)
(rule ((= e (FDiv (FDiv x (FConst a)) (FConst b))))
      ((union e (FDiv x (FConst (* a b))))))

; (x * a) / b = x * (a / b)
; DISABLED: FDiv→FMul cross-interaction creates feedback loop with FMul chain merging.
; New FMul nodes from these rules feed back into FMul(FMul(x,c1),c2) chain merge,
; which creates more FMul nodes that re-enter FDiv cross rules. 252K matches at iter 7
; on mouse-shader with exponential growth. Pure FMul and FDiv chains are kept.
; (rule ((= e (FDiv (FMul x (FConst a)) (FConst b)))
;        (!= b 0.0))
;       ((union e (FMul x (FConst (/ a b))))))

; (x / a) * b = x * (b / a)
; DISABLED: Same feedback loop as above. 73K matches at iter 7 on mouse-shader.
; (rule ((= e (FMul (FDiv x (FConst a)) (FConst b)))
;        (!= a 0.0))
;       ((union e (FMul x (FConst (/ b a))))))

; (x + a) + b = x + (a + b)
(rule ((= e (FAdd (FAdd x (FConst a)) (FConst b))))
      ((union e (FAdd x (FConst (+ a b))))))
(rule ((= e (FAdd (FConst b) (FAdd x (FConst a)))))
      ((union e (FAdd x (FConst (+ a b))))))

; (x - a) - b = x - (a + b)
(rule ((= e (FSub (FSub x (FConst a)) (FConst b))))
      ((union e (FSub x (FConst (+ a b))))))

; (x + a) - b = x + (a - b)
(rule ((= e (FSub (FAdd x (FConst a)) (FConst b))))
      ((union e (FAdd x (FConst (- a b))))))

; (x - a) + b = x + (b - a)
(rule ((= e (FAdd (FSub x (FConst a)) (FConst b))))
      ((union e (FAdd x (FConst (- b a))))))

; =============================================================================
; Negate Chain Merging (C++ MergeNegateArithmetic)
; =============================================================================

; -(-x * y) = x * y (handled above)
; -(x * -y) = x * y (handled above)
; -(-x + y) = x - y via (FNeg (FAdd (FNeg a) b)) = FSub a b - but needs care
; Simplified: -(a + b) = -a - b (already have FNeg->FSub conversion)

; -(a - b) = b - a (already covered)

; =============================================================================
; Reciprocal Optimization
; =============================================================================

; 1.0 / (1.0 / x) = x - ONE-DIRECTIONAL
; Match any two constants that are both 1.0
(rule ((= e (FDiv (FConst c1) (FDiv (FConst c2) x))) (= c1 1.0) (= c2 1.0))
      ((union e x)))

; a / (b / c) = (a * c) / b - already covered above

; (a / b) / c = a / (b * c) - already covered above

; =============================================================================
; FRem Rules (C++ RedundantFMod)
; =============================================================================

; NOTE: FRem(0, x)→0, FMod(0, x)→0, and FDiv(0, x)→0 rules are intentionally
; NOT included as algebraic simplifications.
; While C++ has RedundantFMod/FDiv that fold these, they require the
; "IsFloatingPointFoldingAllowed" guard. Without it, FDiv(0, NaN)→0 is wrong
; (should be NaN) and would equate 0 and NaN in the e-graph if both the
; algebraic rule and constant folding rule fire. Constant folding handles
; the case when both operands are constants correctly.

; =============================================================================
; Generic Add/Sub Cancellation for FP (C++ MergeGenericAddSubArithmetic)
; =============================================================================

; (a - b) + b = a - ONE-DIRECTIONAL
(rule ((= e (FAdd (FSub a b) b)))
      ((union e a)))
(rule ((= e (FAdd b (FSub a b))))
      ((union e a)))

; (a + b) - b = a - ONE-DIRECTIONAL
(rule ((= e (FSub (FAdd a b) b)))
      ((union e a)))
(rule ((= e (FSub (FAdd b a) b)))
      ((union e a)))

; =============================================================================
; Negate Merging with FMul/FDiv (C++ MergeNegateMulDivArithmetic)
; =============================================================================
; Already covered via FNeg distribution rules

; =============================================================================
; Negate Merging with FAdd/FSub (C++ MergeNegateAddSubArithmetic)
; =============================================================================

; -(x + c) = -x - c = (-c) - x, but -x - c is simpler to express
; FNeg(FAdd(x, c)) = FSub(FNeg(c), x) but we already have FNeg dist over FAdd
; So we use: -(x + c) = -x + (-c) = FAdd(FNeg(x), FNeg(FConst(c)))
; But simpler: FNeg(x + c) already gets FSub via FAdd->FNeg rule

; -(x - c) = c - x (already handled via FNeg(FSub a b) = FSub b a)

; =============================================================================
; FAdd with Negate Merging (C++ MergeAddNegateArithmetic)
; =============================================================================

; (-x) + c = c - x - ONE-DIRECTIONAL
(rule ((= e (FAdd (FNeg x) (FConst c))))
      ((union e (FSub (FConst c) x))))
(rule ((= e (FAdd (FConst c) (FNeg x))))
      ((union e (FSub (FConst c) x))))

; =============================================================================
; FSub with Negate Merging (C++ MergeSubNegateArithmetic)
; =============================================================================

; (-x) - c = -(x + c) which is -FAdd(x, c), already handled by FNeg dist

; c - (-x) = c + x - ONE-DIRECTIONAL
(rule ((= e (FSub c (FNeg x))))
      ((union e (FAdd c x))))

; =============================================================================
; Mul/Div Cancellation (C++ MergeMulDivArithmetic)
; =============================================================================

; (y / x) * x = y - ONE-DIRECTIONAL
(rule ((= e (FMul (FDiv y x) x)))
      ((union e y)))
(rule ((= e (FMul x (FDiv y x))))
      ((union e y)))

; =============================================================================
; Merge FMul with FDiv (C++ MergeMulTest cases 8-9)
; =============================================================================
; c * (c' / x) = (c*c') / x - ONE-DIRECTIONAL
; Using native f64 multiplication for constant folding
(rule ((= e (FMul (FConst a) (FDiv (FConst b) x))))
      ((union e (FDiv (FConst (* a b)) x))))
(rule ((= e (FMul (FDiv (FConst a) x) (FConst b))))
      ((union e (FDiv (FConst (* a b)) x))))

; x * (y / x) = y - same as above with commutativity

; =============================================================================
; Additional C++ Parity Rules
; =============================================================================

; 0.0 - x = -x (C++ RedundantFSub) - ONE-DIRECTIONAL
(rule ((= e (FSub (FConst c) x)) (= c 0.0))
      ((union e (FNeg x))))

; Recognize x * (1.0/y) as x/y for simplification
; One-directional to prevent expansion that causes e-graph explosion.
; We don't expand x/y to x * (1/y) as that creates more nodes.
(rule ((= e (FMul x (FDiv (FConst c) y))) (= c 1.0))
      ((union e (FDiv x y))))
(rule ((= e (FMul (FDiv (FConst c) y) x)) (= c 1.0))
      ((union e (FDiv x y))))

; FMix (linear interpolation) identities when GLSL ext available
; FMix(a, b, 0) = a
; FMix(a, b, 1) = b
; FMix(a, a, t) = a
; These would be in glsl.egg when implemented

; =============================================================================
; Floating-Point Abs Rules
; =============================================================================

; FAbs of FAbs is FAbs (idempotent) - already have
; FAbs of FNeg gives FAbs - ONE-DIRECTIONAL
(rule ((= e (FAbs (FNeg x))))
      ((union e (FAbs x))))

; FAbs(x * x) = x * x (square is always non-negative)
; Note: Not quite right due to -0, but commonly optimized

; =============================================================================
; Advanced Reciprocal Chain Optimization (C++ ReciprocalFDiv)
; =============================================================================

; a / (1 / b) = a * b - ONE-DIRECTIONAL
(rule ((= e (FDiv a (FDiv (FConst c) b))) (= c 1.0))
      ((union e (FMul a b))))

; 1 / (a / b) = b / a - ONE-DIRECTIONAL
(rule ((= e (FDiv (FConst c) (FDiv a b))) (= c 1.0))
      ((union e (FDiv b a))))

; 1 / (a * b) for canonicalization (not expansion)
; Don't add expansion rules like (1/x) * (1/y) = 1/(x*y) as they expand

; (1/a) / (1/b) = b / a - ONE-DIRECTIONAL
(rule ((= e (FDiv (FDiv (FConst c1) a) (FDiv (FConst c2) b))) (= c1 1.0) (= c2 1.0))
      ((union e (FDiv b a))))

; =============================================================================
; Power Optimization Patterns
; =============================================================================
; NOTE: Pow takes two FloatExpr arguments, so we use direct f64 comparison.

; x * x = x^2 (for cost model, Pow may be more expensive)
; But Pow(x, 2) should reduce to x * x for extraction
(rule ((= e (Pow x (FConst c))) (= c 2.0))
      ((union e (FMul x x))))

; Pow(x, 3) = x * x * x - ONE-DIRECTIONAL (for powi(3) optimization - rust-gpu#516)
; We express this as FMul(FMul(x, x), x) to enable further CSE
(rule ((= e (Pow x (FConst c))) (= c 3.0))
      ((union e (FMul (FMul x x) x))))

; Pow(x, 4) = (x * x) * (x * x) - ONE-DIRECTIONAL (for powi(4) optimization)
; This uses only 2 multiplications instead of 3, and enables CSE of x*x
(rule ((= e (Pow x (FConst c))) (= c 4.0))
      ((union e (FMul (FMul x x) (FMul x x)))))

; Pow(x, 0) = 1 (assuming x != 0) - ONE-DIRECTIONAL
(rule ((= e (Pow x (FConst c))) (= c 0.0))
      ((union e (FConst 1.0))))

; Pow(x, 1) = x - ONE-DIRECTIONAL
(rule ((= e (Pow x (FConst c))) (= c 1.0))
      ((union e x)))

; Pow(1, n) = 1 - ONE-DIRECTIONAL
(rule ((= e (Pow (FConst c) n)) (= c 1.0))
      ((union e (FConst 1.0))))

; Pow(x, -1) = 1/x - ONE-DIRECTIONAL
(rule ((= e (Pow x (FConst c))) (= c -1.0))
      ((union e (FDiv (FConst 1.0) x))))

; =============================================================================
; Square Root and InverseSqrt Additional Patterns
; =============================================================================
; Note: Many InverseSqrt rules are in glsl.egg

; Sqrt(x^2) = |x| (not just x due to negative input)
; But for non-negative known values, Sqrt(x*x) = x

; Sqrt(x) / x = 1 / Sqrt(x) = InverseSqrt(x)
(rule ((= e (FDiv (Sqrt x) x)))
      ((union e (InverseSqrt x))))

; x / Sqrt(x) = Sqrt(x)
(rule ((= e (FDiv x (Sqrt x))))
      ((union e (Sqrt x))))

; Note: Sqrt(x) * Sqrt(x) = x is in glsl.egg

; InverseSqrt(x) * InverseSqrt(x) = 1/x
(rule ((= e (FMul (InverseSqrt x) (InverseSqrt x))))
      ((union e (FDiv (FConst 1.0) x))))

; =============================================================================
; Reciprocal Division Optimization (C++ ReciprocalFDiv)
; =============================================================================
; Division by a constant with an exact reciprocal can be converted to multiplication
; x / c = x * (1/c) when 1/c can be exactly represented
; This is always safe for floating-point and often faster

; General rule: x / const = x * (1/const) when const has an exact reciprocal
; Uses f64-has-exact-recip primitive to check if reciprocal is exact (power of 2)
; Uses f64-recip primitive to compute the reciprocal
(rule ((= e (FDiv x (FConst c))) (f64-has-exact-recip c))
      ((union e (FMul x (FConst (f64-recip c))))))

; =============================================================================
; Additional Sound FP Optimizations
; =============================================================================

; FAbs(x) * FAbs(x) = x * x (both are non-negative squared) - ONE-DIRECTIONAL
(rule ((= e (FMul (FAbs x) (FAbs x))))
      ((union e (FMul x x))))

; Pow(x, 0.5) = Sqrt(x) - ONE-DIRECTIONAL
(rule ((= e (Pow x (FConst c))) (= c 0.5))
      ((union e (Sqrt x))))

; Pow(x, -0.5) = InverseSqrt(x) - ONE-DIRECTIONAL
(rule ((= e (Pow x (FConst c))) (= c -0.5))
      ((union e (InverseSqrt x))))

; Sqrt(1.0) = 1.0 - ONE-DIRECTIONAL
(rule ((= e (Sqrt (FConst c))) (= c 1.0))
      ((union e (FConst 1.0))))

; InverseSqrt(1.0) = 1.0 - ONE-DIRECTIONAL
(rule ((= e (InverseSqrt (FConst c))) (= c 1.0))
      ((union e (FConst 1.0))))

; FAbs(0.0) = 0.0 - ONE-DIRECTIONAL
(rule ((= e (FAbs (FConst c))) (= c 0.0))
      ((union e (FConst 0.0))))
