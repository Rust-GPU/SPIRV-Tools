; =============================================================================
; Floating-Point Rewrite Rules
; =============================================================================

(rewrite (FMul x (Const 1)) x)
(rewrite (FAdd x (Const 0)) x)
(rewrite (FNeg (FNeg x)) x)
(rewrite (FFloor (FFloor x)) (FFloor x))
(rewrite (FCeil (FCeil x)) (FCeil x))
(rewrite (FTrunc (FTrunc x)) (FTrunc x))
(rewrite (FRound (FRound x)) (FRound x))
(rewrite (FAbs (FAbs x)) (FAbs x))
(rewrite (FNeg (FAbs x)) (FAbs (FNeg x)))

; =============================================================================
; Floating-Point Comparison Rules
; =============================================================================

; Ordered comparisons are false if either operand is NaN
; Reflexive ordered comparison (x == x is true unless NaN)
; (rewrite (FOrdEq x x) (LogNot (IsNan x)))  -- disabled, complex

; Unordered comparisons are true if either operand is NaN
; Reflexive unordered inequality (x != x is true only if NaN)
; (rewrite (FUnordNe x x) (IsNan x))  -- disabled, complex

; Negation of ordered vs unordered comparisons
(rewrite (LogNot (FOrdEq a b)) (FUnordNe a b))
(rewrite (LogNot (FOrdNe a b)) (FUnordEq a b))
(rewrite (LogNot (FOrdLt a b)) (FUnordGe a b))
(rewrite (LogNot (FOrdLe a b)) (FUnordGt a b))
(rewrite (LogNot (FOrdGt a b)) (FUnordLe a b))
(rewrite (LogNot (FOrdGe a b)) (FUnordLt a b))
(rewrite (LogNot (FUnordEq a b)) (FOrdNe a b))
(rewrite (LogNot (FUnordNe a b)) (FOrdEq a b))
(rewrite (LogNot (FUnordLt a b)) (FOrdGe a b))
(rewrite (LogNot (FUnordLe a b)) (FOrdGt a b))
(rewrite (LogNot (FUnordGt a b)) (FOrdLe a b))
(rewrite (LogNot (FUnordGe a b)) (FOrdLt a b))

; Symmetry: a > b  <=>  b < a
(rewrite (FOrdGt a b) (FOrdLt b a))
(rewrite (FOrdGe a b) (FOrdLe b a))
(rewrite (FUnordGt a b) (FUnordLt b a))
(rewrite (FUnordGe a b) (FUnordLe b a))

; =============================================================================
; Floating-Point Arithmetic Identities
; =============================================================================

; Subtraction as addition of negation
(rewrite (FSub a b) (FAdd a (FNeg b)))

; Multiply by zero (note: NaN * 0 = NaN, but this is common optimization)
(rewrite (FMul x (Const 0)) (Const 0))
(rewrite (FMul (Const 0) x) (Const 0))

; Multiply by negative one
(rewrite (FMul x (Const -1)) (FNeg x))
(rewrite (FMul (Const -1) x) (FNeg x))

; Divide by one
(rewrite (FDiv x (Const 1)) x)

; Divide by negative one
(rewrite (FDiv x (Const -1)) (FNeg x))

; x / x = 1 (assuming not zero or NaN)
; Note: commented out due to NaN/zero concerns
; (rewrite (FDiv x x) (Const 1))

; x - x = 0
(rewrite (FSub x x) (Const 0))

; Negation of subtraction
(rewrite (FNeg (FSub a b)) (FSub b a))

; Distributive property for negation
(rewrite (FMul (FNeg a) b) (FNeg (FMul a b)))
(rewrite (FMul a (FNeg b)) (FNeg (FMul a b)))

; Double negation in multiplication cancels
(rewrite (FMul (FNeg a) (FNeg b)) (FMul a b))

; Division with negation
(rewrite (FDiv (FNeg a) b) (FNeg (FDiv a b)))
(rewrite (FDiv a (FNeg b)) (FNeg (FDiv a b)))
(rewrite (FDiv (FNeg a) (FNeg b)) (FDiv a b))

; =============================================================================
; Floating-Point Min/Max
; =============================================================================

; FMin/FMax are idempotent
(rewrite (FMin x x) x)
(rewrite (FMax x x) x)

; FMin/FMax associativity
(rewrite (FMin (FMin a b) c) (FMin a (FMin b c)))
(rewrite (FMax (FMax a b) c) (FMax a (FMax b c)))

; FMin/FMax commutativity
(rewrite (FMin a b) (FMin b a))
(rewrite (FMax a b) (FMax b a))

; FMin/FMax with negation
(rewrite (FMin (FNeg a) (FNeg b)) (FNeg (FMax a b)))
(rewrite (FMax (FNeg a) (FNeg b)) (FNeg (FMin a b)))

; =============================================================================
; Floor/Ceil/Trunc/Round Relationships
; =============================================================================

; Floor of negation
(rewrite (FFloor (FNeg x)) (FNeg (FCeil x)))
(rewrite (FCeil (FNeg x)) (FNeg (FFloor x)))

; Trunc of negation (same sign behavior)
(rewrite (FTrunc (FNeg x)) (FNeg (FTrunc x)))

; Round of negation
(rewrite (FRound (FNeg x)) (FNeg (FRound x)))

; =============================================================================
; Additional Floating-Point Algebraic Identities
; =============================================================================

; FAdd commutativity
(rewrite (FAdd a b) (FAdd b a))

; FMul commutativity
(rewrite (FMul a b) (FMul b a))

; FAdd associativity
(rewrite (FAdd (FAdd a b) c) (FAdd a (FAdd b c)))

; FMul associativity
(rewrite (FMul (FMul a b) c) (FMul a (FMul b c)))

; Distributive: a * (b + c) = a*b + a*c (useful for factoring)
; Note: May affect precision, but common optimization
(rewrite (FMul a (FAdd b c)) (FAdd (FMul a b) (FMul a c)))
(rewrite (FMul (FAdd a b) c) (FAdd (FMul a c) (FMul b c)))

; Factoring: a*c + b*c = (a+b)*c
(rewrite (FAdd (FMul a c) (FMul b c)) (FMul (FAdd a b) c))

; x + x = 2*x
(rewrite (FAdd x x) (FMul x (Const 2)))

; =============================================================================
; FP Division Optimization
; =============================================================================

; a / b / c = a / (b * c)
(rewrite (FDiv (FDiv a b) c) (FDiv a (FMul b c)))

; a / (b / c) = (a * c) / b
(rewrite (FDiv a (FDiv b c)) (FDiv (FMul a c) b))

; (a * b) / b = a (assuming no NaN/Inf issues)
(rewrite (FDiv (FMul a b) b) a)
(rewrite (FDiv (FMul b a) b) a)

; =============================================================================
; FP Min/Max Additional Rules
; =============================================================================

; Note: FMin/FMax negation rules are in the section above

; FMin/FMax absorption
(rewrite (FMin a (FMax a b)) a)
(rewrite (FMin (FMax a b) a) a)
(rewrite (FMax a (FMin a b)) a)
(rewrite (FMax (FMin a b) a) a)

; FMin/FMax idempotent within nesting
(rewrite (FMin (FMin a b) b) (FMin a b))
(rewrite (FMin a (FMin a b)) (FMin a b))
(rewrite (FMax (FMax a b) b) (FMax a b))
(rewrite (FMax a (FMax a b)) (FMax a b))

; =============================================================================
; Floating-Point Arithmetic Chain Merging (C++ MergeMulMul, etc.)
; =============================================================================

; (x * a) * b = x * (a * b) for float constants
; Note: These rules assume fast-math style optimization (may affect precision)
(rule ((= e (FMul (FMul x (Const a)) (Const b))))
      ((union e (FMul x (Const (* a b))))))
(rule ((= e (FMul (Const b) (FMul x (Const a)))))
      ((union e (FMul x (Const (* a b))))))

; (x / a) / b = x / (a * b)
(rule ((= e (FDiv (FDiv x (Const a)) (Const b))) (!= a 0) (!= b 0))
      ((union e (FDiv x (Const (* a b))))))

; (x * a) / b = x * (a / b)
(rule ((= e (FDiv (FMul x (Const a)) (Const b))) (!= b 0))
      ((union e (FMul x (Const (/ a b))))))

; (x / a) * b = x * (b / a)
(rule ((= e (FMul (FDiv x (Const a)) (Const b))) (!= a 0))
      ((union e (FMul x (Const (/ b a))))))

; (x + a) + b = x + (a + b)
(rule ((= e (FAdd (FAdd x (Const a)) (Const b))))
      ((union e (FAdd x (Const (+ a b))))))
(rule ((= e (FAdd (Const b) (FAdd x (Const a)))))
      ((union e (FAdd x (Const (+ a b))))))

; (x - a) - b = x - (a + b)
(rule ((= e (FSub (FSub x (Const a)) (Const b))))
      ((union e (FSub x (Const (+ a b))))))

; (x + a) - b = x + (a - b)
(rule ((= e (FSub (FAdd x (Const a)) (Const b))))
      ((union e (FAdd x (Const (- a b))))))

; (x - a) + b = x + (b - a)
(rule ((= e (FAdd (FSub x (Const a)) (Const b))))
      ((union e (FAdd x (Const (- b a))))))

; =============================================================================
; Negate Chain Merging (C++ MergeNegateArithmetic)
; =============================================================================

; -(-x * y) = x * y (handled above)
; -(x * -y) = x * y (handled above)
; -(-x + y) = x - y via (FNeg (FAdd (FNeg a) b)) = FSub a b - but needs care
; Simplified: -(a + b) = -a - b (already have FNeg->FSub conversion)

; -(a - b) = b - a (already covered)

; =============================================================================
; Reciprocal Optimization
; =============================================================================

; 1 / (1 / x) = x
(rewrite (FDiv (Const 1) (FDiv (Const 1) x)) x)

; a / (b / c) = (a * c) / b - already covered above

; (a / b) / c = a / (b * c) - already covered above
