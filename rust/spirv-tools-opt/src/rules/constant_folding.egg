; =============================================================================
; Constant Folding Rules
; =============================================================================

(rule ((= e (Add (Const a) (Const b))))
      ((union e (Const (+ a b)))))
(rule ((= e (Sub (Const a) (Const b))))
      ((union e (Const (- a b)))))
; Multiplication constant folding - use mul-safe guard to avoid panic on overflow
(rule ((= e (Mul (Const a) (Const b))) (mul-safe a b))
      ((union e (Const (* a b)))))
(rule ((= e (Neg (Const a))))
      ((union e (Const (- 0 a)))))
(rule ((= e (BitAnd (Const a) (Const b))))
      ((union e (Const (& a b)))))
(rule ((= e (BitOr (Const a) (Const b))))
      ((union e (Const (| a b)))))
(rule ((= e (BitXor (Const a) (Const b))))
      ((union e (Const (^ a b)))))
(rule ((= e (BitNot (Const a))))
      ((union e (Const (not-i64 a)))))
(rule ((= e (Shl (Const a) (Const b))))
      ((union e (Const (<< a b)))))
(rule ((= e (ShrU (Const a) (Const b))))
      ((union e (Const (>> a b)))))

; Signed right shift of constants
; Note: egglog's >> is arithmetic shift for i64
(rule ((= e (ShrS (Const a) (Const b))))
      ((union e (Const (>> a b)))))

; =============================================================================
; Comparison Constant Folding
; =============================================================================

; Equality comparisons - produce BoolConst since comparisons return boolean
(rule ((= e (Eq (Const a) (Const b))) (= a b))
      ((union e (BoolConst 1))))
(rule ((= e (Eq (Const a) (Const b))) (!= a b))
      ((union e (BoolConst 0))))
(rule ((= e (Ne (Const a) (Const b))) (!= a b))
      ((union e (BoolConst 1))))
(rule ((= e (Ne (Const a) (Const b))) (= a b))
      ((union e (BoolConst 0))))

; Signed comparisons (using signed i64 semantics)
(rule ((= e (SLt (Const a) (Const b))) (< a b))
      ((union e (BoolConst 1))))
(rule ((= e (SLt (Const a) (Const b))) (>= a b))
      ((union e (BoolConst 0))))
(rule ((= e (SLe (Const a) (Const b))) (<= a b))
      ((union e (BoolConst 1))))
(rule ((= e (SLe (Const a) (Const b))) (> a b))
      ((union e (BoolConst 0))))
(rule ((= e (SGt (Const a) (Const b))) (> a b))
      ((union e (BoolConst 1))))
(rule ((= e (SGt (Const a) (Const b))) (<= a b))
      ((union e (BoolConst 0))))
(rule ((= e (SGe (Const a) (Const b))) (>= a b))
      ((union e (BoolConst 1))))
(rule ((= e (SGe (Const a) (Const b))) (< a b))
      ((union e (BoolConst 0))))

; Unsigned comparisons (treat as unsigned - need primitives for proper handling)
; For now, use signed comparisons (works for positive values)
(rule ((= e (ULt (Const a) (Const b))) (< a b))
      ((union e (BoolConst 1))))
(rule ((= e (ULt (Const a) (Const b))) (>= a b))
      ((union e (BoolConst 0))))
(rule ((= e (ULe (Const a) (Const b))) (<= a b))
      ((union e (BoolConst 1))))
(rule ((= e (ULe (Const a) (Const b))) (> a b))
      ((union e (BoolConst 0))))
(rule ((= e (UGt (Const a) (Const b))) (> a b))
      ((union e (BoolConst 1))))
(rule ((= e (UGt (Const a) (Const b))) (<= a b))
      ((union e (BoolConst 0))))
(rule ((= e (UGe (Const a) (Const b))) (>= a b))
      ((union e (BoolConst 1))))
(rule ((= e (UGe (Const a) (Const b))) (< a b))
      ((union e (BoolConst 0))))

; =============================================================================
; Rotation Constant Folding
; =============================================================================

; BitReverse constant folding is handled via Rust primitives

; Rotate left/right with constants
; Note: These require proper bit-width handling, so they're typically
; handled via Rust primitives for full correctness

; =============================================================================
; Min/Max Constant Folding
; =============================================================================

; Signed min/max
(rule ((= e (SMin (Const a) (Const b))) (<= a b))
      ((union e (Const a))))
(rule ((= e (SMin (Const a) (Const b))) (> a b))
      ((union e (Const b))))
(rule ((= e (SMax (Const a) (Const b))) (>= a b))
      ((union e (Const a))))
(rule ((= e (SMax (Const a) (Const b))) (< a b))
      ((union e (Const b))))

; Unsigned min/max (using signed for positive values)
(rule ((= e (UMin (Const a) (Const b))) (<= a b))
      ((union e (Const a))))
(rule ((= e (UMin (Const a) (Const b))) (> a b))
      ((union e (Const b))))
(rule ((= e (UMax (Const a) (Const b))) (>= a b))
      ((union e (Const a))))
(rule ((= e (UMax (Const a) (Const b))) (< a b))
      ((union e (Const b))))

; =============================================================================
; Logical Operation Constant Folding
; =============================================================================

; Logical NOT of constant (0 -> 1, non-zero -> 0) - uses BoolConst
(rule ((= e (LogNot (BoolConst 0))))
      ((union e (BoolConst 1))))
(rule ((= e (LogNot (BoolConst a))) (!= a 0))
      ((union e (BoolConst 0))))
; Also match Const for when conditions come from integer constant folding chains
(rule ((= e (LogNot (Const 0))))
      ((union e (BoolConst 1))))
(rule ((= e (LogNot (Const a))) (!= a 0))
      ((union e (BoolConst 0))))

; Logical AND of boolean constants
(rule ((= e (LogAnd (BoolConst 0) x)))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd x (BoolConst 0))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (BoolConst a) (BoolConst b))) (!= a 0) (!= b 0))
      ((union e (BoolConst 1))))
; Also match Const for interop
(rule ((= e (LogAnd (Const 0) x)))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd x (Const 0))))
      ((union e (BoolConst 0))))

; Logical OR of boolean constants
(rule ((= e (LogOr (BoolConst a) x)) (!= a 0))
      ((union e (BoolConst 1))))
(rule ((= e (LogOr x (BoolConst a))) (!= a 0))
      ((union e (BoolConst 1))))
(rule ((= e (LogOr (BoolConst 0) (BoolConst 0))))
      ((union e (BoolConst 0))))
; Also match Const for interop
(rule ((= e (LogOr (Const a) x)) (!= a 0))
      ((union e (BoolConst 1))))
(rule ((= e (LogOr x (Const a))) (!= a 0))
      ((union e (BoolConst 1))))

; Logical equality of boolean constants
(rule ((= e (LogEq (BoolConst a) (BoolConst b))) (= a b))
      ((union e (BoolConst 1))))
(rule ((= e (LogEq (BoolConst a) (BoolConst b))) (!= a b))
      ((union e (BoolConst 0))))
(rule ((= e (LogNe (BoolConst a) (BoolConst b))) (!= a b))
      ((union e (BoolConst 1))))
(rule ((= e (LogNe (BoolConst a) (BoolConst b))) (= a b))
      ((union e (BoolConst 0))))

; =============================================================================
; Division and Modulo Constant Folding
; =============================================================================

; Signed division of constants (avoiding division by zero)
(rule ((= e (SDiv (Const a) (Const b))) (!= b 0))
      ((union e (Const (/ a b)))))

; Unsigned division - use signed division since egglog uses i64
; This works correctly for values that fit in the positive range
(rule ((= e (UDiv (Const a) (Const b))) (!= b 0) (>= a 0) (>= b 0))
      ((union e (Const (/ a b)))))

; Signed remainder of constants
(rule ((= e (SRem (Const a) (Const b))) (!= b 0))
      ((union e (Const (% a b)))))

; Unsigned modulo (for positive values)
(rule ((= e (UMod (Const a) (Const b))) (!= b 0) (>= a 0) (>= b 0))
      ((union e (Const (% a b)))))

; Signed modulo
(rule ((= e (SMod (Const a) (Const b))) (!= b 0))
      ((union e (Const (% a b)))))

; =============================================================================
; SAbs (Signed Absolute Value) Constant Folding
; =============================================================================

(rule ((= e (SAbs (Const a))) (>= a 0))
      ((union e (Const a))))
(rule ((= e (SAbs (Const a))) (< a 0))
      ((union e (Const (- 0 a)))))

; =============================================================================
; Sign and Clamp Constant Folding
; =============================================================================

; Sign of positive constant
(rule ((= e (Sign (Const a))) (> a 0))
      ((union e (Const 1))))

; Sign of negative constant
(rule ((= e (Sign (Const a))) (< a 0))
      ((union e (Const -1))))

; Sign of zero
(rule ((= e (Sign (Const 0))))
      ((union e (Const 0))))

; =============================================================================
; Clamp Constant Folding
; =============================================================================

; SClamp(x, lo, hi) when x <= lo
(rule ((= e (SClamp (Const x) (Const lo) (Const hi))) (<= x lo))
      ((union e (Const lo))))

; SClamp(x, lo, hi) when x >= hi
(rule ((= e (SClamp (Const x) (Const lo) (Const hi))) (>= x hi))
      ((union e (Const hi))))

; SClamp(x, lo, hi) when lo <= x <= hi
(rule ((= e (SClamp (Const x) (Const lo) (Const hi))) (>= x lo) (<= x hi))
      ((union e (Const x))))

; UClamp follows same pattern for unsigned (positive values)
(rule ((= e (UClamp (Const x) (Const lo) (Const hi))) (<= x lo) (>= lo 0) (>= x 0))
      ((union e (Const lo))))

(rule ((= e (UClamp (Const x) (Const lo) (Const hi))) (>= x hi) (>= hi 0))
      ((union e (Const hi))))

(rule ((= e (UClamp (Const x) (Const lo) (Const hi))) (>= x lo) (<= x hi) (>= x 0))
      ((union e (Const x))))

; =============================================================================
; Rotation Constant Folding (requires primitives)
; =============================================================================

; RotL and RotR of 0
(rule ((= e (RotL (Const 0) (Const a))))
      ((union e (Const 0))))
(rule ((= e (RotR (Const 0) (Const a))))
      ((union e (Const 0))))

; RotL and RotR by 0 (identity)
(rule ((= e (RotL (Const a) (Const 0))))
      ((union e (Const a))))
(rule ((= e (RotR (Const a) (Const 0))))
      ((union e (Const a))))
