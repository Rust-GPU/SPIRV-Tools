; =============================================================================
; Constant Folding Rules
; =============================================================================

(rule ((= e (Add (Const a) (Const b))))
      ((union e (Const (+ a b)))))
(rule ((= e (Sub (Const a) (Const b))))
      ((union e (Const (- a b)))))
; Multiplication constant folding - use mul-safe guard to avoid panic on overflow
(rule ((= e (Mul (Const a) (Const b))) (mul-safe a b))
      ((union e (Const (* a b)))))
(rule ((= e (Neg (Const a))))
      ((union e (Const (- 0 a)))))
(rule ((= e (BitAnd (Const a) (Const b))))
      ((union e (Const (& a b)))))
(rule ((= e (BitOr (Const a) (Const b))))
      ((union e (Const (| a b)))))
(rule ((= e (BitXor (Const a) (Const b))))
      ((union e (Const (^ a b)))))
(rule ((= e (BitNot (Const a))))
      ((union e (Const (not-i64 a)))))
(rule ((= e (Shl (Const a) (Const b))))
      ((union e (Const (<< a b)))))
(rule ((= e (ShrU (Const a) (Const b))))
      ((union e (Const (>> a b)))))

; Signed right shift of constants
; Note: egglog's >> is arithmetic shift for i64
(rule ((= e (ShrS (Const a) (Const b))))
      ((union e (Const (>> a b)))))

; =============================================================================
; Float Arithmetic Constant Folding (C++ const_folding_rules.cpp parity)
; =============================================================================
; FConst uses egglog's native f64 sort, so we can use native f64 arithmetic.

(rule ((= e (FAdd (FConst a) (FConst b))))
      ((union e (FConst (+ a b)))))
(rule ((= e (FSub (FConst a) (FConst b))))
      ((union e (FConst (- a b)))))
(rule ((= e (FMul (FConst a) (FConst b))))
      ((union e (FConst (* a b)))))
; Divide-by-zero produces IEEE 754 results: 0/0→NaN, x/0→±Inf
(rule ((= e (FDiv (FConst a) (FConst b))))
      ((union e (FConst (/ a b)))))
; Use float-neg primitive (sign bit flip) instead of 0.0 - a,
; because IEEE 754: 0.0 - 0.0 = +0.0, but FNeg(+0.0) must be -0.0.
(rule ((= e (FNeg (FConst a))))
      ((union e (FConst (float-neg a)))))

; =============================================================================
; Comparison Constant Folding
; =============================================================================

; Equality comparisons - produce BoolConst since comparisons return boolean
(rule ((= e (Eq (Const a) (Const b))) (= a b))
      ((union e (BoolConst 1))))
(rule ((= e (Eq (Const a) (Const b))) (!= a b))
      ((union e (BoolConst 0))))
(rule ((= e (Ne (Const a) (Const b))) (!= a b))
      ((union e (BoolConst 1))))
(rule ((= e (Ne (Const a) (Const b))) (= a b))
      ((union e (BoolConst 0))))

; Signed comparisons (using signed i64 semantics)
(rule ((= e (SLt (Const a) (Const b))) (< a b))
      ((union e (BoolConst 1))))
(rule ((= e (SLt (Const a) (Const b))) (>= a b))
      ((union e (BoolConst 0))))
(rule ((= e (SLe (Const a) (Const b))) (<= a b))
      ((union e (BoolConst 1))))
(rule ((= e (SLe (Const a) (Const b))) (> a b))
      ((union e (BoolConst 0))))
(rule ((= e (SGt (Const a) (Const b))) (> a b))
      ((union e (BoolConst 1))))
(rule ((= e (SGt (Const a) (Const b))) (<= a b))
      ((union e (BoolConst 0))))
(rule ((= e (SGe (Const a) (Const b))) (>= a b))
      ((union e (BoolConst 1))))
(rule ((= e (SGe (Const a) (Const b))) (< a b))
      ((union e (BoolConst 0))))

; Unsigned comparisons (using u32 primitives for correct unsigned semantics)
; Constants are sign-extended i64, so 0xFFFFFFFF is stored as -1.
; These primitives cast to u32 before comparing.
(rule ((= e (ULt (Const a) (Const b))) (u32-lt a b))
      ((union e (BoolConst 1))))
(rule ((= e (ULt (Const a) (Const b))) (u32-ge a b))
      ((union e (BoolConst 0))))
(rule ((= e (ULe (Const a) (Const b))) (u32-le a b))
      ((union e (BoolConst 1))))
(rule ((= e (ULe (Const a) (Const b))) (u32-gt a b))
      ((union e (BoolConst 0))))
(rule ((= e (UGt (Const a) (Const b))) (u32-gt a b))
      ((union e (BoolConst 1))))
(rule ((= e (UGt (Const a) (Const b))) (u32-le a b))
      ((union e (BoolConst 0))))
(rule ((= e (UGe (Const a) (Const b))) (u32-ge a b))
      ((union e (BoolConst 1))))
(rule ((= e (UGe (Const a) (Const b))) (u32-lt a b))
      ((union e (BoolConst 0))))

; =============================================================================
; Float Ordered Comparison Constant Folding (C++ const_folding_rules.cpp parity)
; =============================================================================
; IEEE 754: ordered comparisons return false if either operand is NaN.
; Uses custom primitives because egglog's OrderedFloat treats NaN==NaN as true.

(rule ((= e (FOrdEq (FConst a) (FConst b))))
      ((union e (BoolConst (ford-eq a b)))))
(rule ((= e (FOrdNe (FConst a) (FConst b))))
      ((union e (BoolConst (ford-ne a b)))))
(rule ((= e (FOrdLt (FConst a) (FConst b))))
      ((union e (BoolConst (ford-lt a b)))))
(rule ((= e (FOrdLe (FConst a) (FConst b))))
      ((union e (BoolConst (ford-le a b)))))
(rule ((= e (FOrdGt (FConst a) (FConst b))))
      ((union e (BoolConst (ford-gt a b)))))
(rule ((= e (FOrdGe (FConst a) (FConst b))))
      ((union e (BoolConst (ford-ge a b)))))

; =============================================================================
; Float Unordered Comparison Constant Folding
; =============================================================================
; Unordered comparisons return true if either operand is NaN.

(rule ((= e (FUnordEq (FConst a) (FConst b))))
      ((union e (BoolConst (funord-eq a b)))))
(rule ((= e (FUnordNe (FConst a) (FConst b))))
      ((union e (BoolConst (funord-ne a b)))))
(rule ((= e (FUnordLt (FConst a) (FConst b))))
      ((union e (BoolConst (funord-lt a b)))))
(rule ((= e (FUnordLe (FConst a) (FConst b))))
      ((union e (BoolConst (funord-le a b)))))
(rule ((= e (FUnordGt (FConst a) (FConst b))))
      ((union e (BoolConst (funord-gt a b)))))
(rule ((= e (FUnordGe (FConst a) (FConst b))))
      ((union e (BoolConst (funord-ge a b)))))

; =============================================================================
; Rotation Constant Folding
; =============================================================================

; BitReverse constant folding is handled via Rust primitives

; Rotate left/right with constants
; Note: These require proper bit-width handling, so they're typically
; handled via Rust primitives for full correctness

; =============================================================================
; Min/Max Constant Folding
; =============================================================================

; Signed min/max
(rule ((= e (SMin (Const a) (Const b))) (<= a b))
      ((union e (Const a))))
(rule ((= e (SMin (Const a) (Const b))) (> a b))
      ((union e (Const b))))
(rule ((= e (SMax (Const a) (Const b))) (>= a b))
      ((union e (Const a))))
(rule ((= e (SMax (Const a) (Const b))) (< a b))
      ((union e (Const b))))

; Unsigned min/max (using u32 primitives for correct unsigned semantics)
(rule ((= e (UMin (Const a) (Const b))))
      ((union e (Const (u32-min a b)))))
(rule ((= e (UMax (Const a) (Const b))))
      ((union e (Const (u32-max a b)))))

; =============================================================================
; Logical Operation Constant Folding
; =============================================================================

; Logical NOT of constant (0 -> 1, non-zero -> 0) - uses BoolConst
(rule ((= e (LogNot (BoolConst 0))))
      ((union e (BoolConst 1))))
(rule ((= e (LogNot (BoolConst a))) (!= a 0))
      ((union e (BoolConst 0))))

; Logical AND of boolean constants
(rule ((= e (LogAnd (BoolConst 0) x)))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd x (BoolConst 0))))
      ((union e (BoolConst 0))))
(rule ((= e (LogAnd (BoolConst a) (BoolConst b))) (!= a 0) (!= b 0))
      ((union e (BoolConst 1))))

; Logical OR of boolean constants
(rule ((= e (LogOr (BoolConst a) x)) (!= a 0))
      ((union e (BoolConst 1))))
(rule ((= e (LogOr x (BoolConst a))) (!= a 0))
      ((union e (BoolConst 1))))
(rule ((= e (LogOr (BoolConst 0) (BoolConst 0))))
      ((union e (BoolConst 0))))

; Logical equality of boolean constants
(rule ((= e (LogEq (BoolConst a) (BoolConst b))) (= a b))
      ((union e (BoolConst 1))))
(rule ((= e (LogEq (BoolConst a) (BoolConst b))) (!= a b))
      ((union e (BoolConst 0))))
(rule ((= e (LogNe (BoolConst a) (BoolConst b))) (!= a b))
      ((union e (BoolConst 1))))
(rule ((= e (LogNe (BoolConst a) (BoolConst b))) (= a b))
      ((union e (BoolConst 0))))

; =============================================================================
; Division and Modulo Constant Folding
; =============================================================================

; Signed division of constants (using sdiv32 for correct 32-bit semantics)
; sdiv32 returns None for: division by zero, i32::MIN / -1 (overflow UB)
(rule ((= e (SDiv (Const a) (Const b))))
      ((union e (Const (sdiv32 a b)))))

; Unsigned division (using u32 primitive for correct unsigned semantics)
; u32-div returns None on zero divisor, so add explicit zero rule
(rule ((= e (UDiv (Const a) (Const b))))
      ((union e (Const (u32-div a b)))))
(rule ((= e (UDiv (Const a) (Const 0))))
      ((union e (Const 0))))

; Signed remainder of constants (using srem32 for correct 32-bit semantics)
; srem32 returns None for: division by zero, i32::MIN % -1 (overflow UB)
(rule ((= e (SRem (Const a) (Const b))))
      ((union e (Const (srem32 a b)))))

; Unsigned modulo (using u32 primitive for correct unsigned semantics)
; u32-mod returns None on zero divisor, so add explicit zero rule
(rule ((= e (UMod (Const a) (Const b))))
      ((union e (Const (u32-mod a b)))))
(rule ((= e (UMod (Const a) (Const 0))))
      ((union e (Const 0))))

; Signed modulo (SPIR-V SMod: result sign matches divisor)
(rule ((= e (SMod (Const a) (Const b))))
      ((union e (Const (smod a b)))))

; =============================================================================
; SAbs (Signed Absolute Value) Constant Folding
; =============================================================================

(rule ((= e (SAbs (Const a))) (>= a 0))
      ((union e (Const a))))
(rule ((= e (SAbs (Const a))) (< a 0))
      ((union e (Const (- 0 a)))))

; =============================================================================
; Sign and Clamp Constant Folding
; =============================================================================

; Sign of positive constant
(rule ((= e (Sign (Const a))) (> a 0))
      ((union e (Const 1))))

; Sign of negative constant
(rule ((= e (Sign (Const a))) (< a 0))
      ((union e (Const -1))))

; Sign of zero
(rule ((= e (Sign (Const 0))))
      ((union e (Const 0))))

; =============================================================================
; Clamp Constant Folding
; =============================================================================

; SClamp(x, lo, hi) when x <= lo
(rule ((= e (SClamp (Const x) (Const lo) (Const hi))) (<= x lo))
      ((union e (Const lo))))

; SClamp(x, lo, hi) when x >= hi
(rule ((= e (SClamp (Const x) (Const lo) (Const hi))) (>= x hi))
      ((union e (Const hi))))

; SClamp(x, lo, hi) when lo <= x <= hi
(rule ((= e (SClamp (Const x) (Const lo) (Const hi))) (>= x lo) (<= x hi))
      ((union e (Const x))))

; UClamp follows same pattern for unsigned (using u32 primitives)
(rule ((= e (UClamp (Const x) (Const lo) (Const hi))) (u32-le x lo))
      ((union e (Const lo))))

(rule ((= e (UClamp (Const x) (Const lo) (Const hi))) (u32-ge x hi))
      ((union e (Const hi))))

(rule ((= e (UClamp (Const x) (Const lo) (Const hi))) (u32-ge x lo) (u32-le x hi))
      ((union e (Const x))))

; =============================================================================
; Rotation Constant Folding (requires primitives)
; =============================================================================

; RotL and RotR of 0
(rule ((= e (RotL (Const 0) (Const a))))
      ((union e (Const 0))))
(rule ((= e (RotR (Const 0) (Const a))))
      ((union e (Const 0))))

; RotL and RotR by 0 (identity)
(rule ((= e (RotL (Const a) (Const 0))))
      ((union e (Const a))))
(rule ((= e (RotR (Const a) (Const 0))))
      ((union e (Const a))))
