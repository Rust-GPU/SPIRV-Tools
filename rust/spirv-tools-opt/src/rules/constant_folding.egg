; =============================================================================
; Constant Folding Rules
; =============================================================================

(rule ((= e (Add (Const a) (Const b))))
      ((union e (Const (+ a b)))))
(rule ((= e (Sub (Const a) (Const b))))
      ((union e (Const (- a b)))))
(rule ((= e (Mul (Const a) (Const b))))
      ((union e (Const (* a b)))))
(rule ((= e (Neg (Const a))))
      ((union e (Const (- 0 a)))))
(rule ((= e (BitAnd (Const a) (Const b))))
      ((union e (Const (& a b)))))
(rule ((= e (BitOr (Const a) (Const b))))
      ((union e (Const (| a b)))))
(rule ((= e (BitXor (Const a) (Const b))))
      ((union e (Const (^ a b)))))
(rule ((= e (BitNot (Const a))))
      ((union e (Const (not-i64 a)))))
(rule ((= e (Shl (Const a) (Const b))))
      ((union e (Const (<< a b)))))
(rule ((= e (ShrU (Const a) (Const b))))
      ((union e (Const (>> a b)))))

; Signed right shift of constants
; Note: egglog's >> is arithmetic shift for i64
(rule ((= e (ShrS (Const a) (Const b))))
      ((union e (Const (>> a b)))))

; =============================================================================
; Comparison Constant Folding
; =============================================================================

; Equality comparisons
(rule ((= e (Eq (Const a) (Const b))) (= a b))
      ((union e (Const 1))))
(rule ((= e (Eq (Const a) (Const b))) (!= a b))
      ((union e (Const 0))))
(rule ((= e (Ne (Const a) (Const b))) (!= a b))
      ((union e (Const 1))))
(rule ((= e (Ne (Const a) (Const b))) (= a b))
      ((union e (Const 0))))

; Signed comparisons (using signed i64 semantics)
(rule ((= e (SLt (Const a) (Const b))) (< a b))
      ((union e (Const 1))))
(rule ((= e (SLt (Const a) (Const b))) (>= a b))
      ((union e (Const 0))))
(rule ((= e (SLe (Const a) (Const b))) (<= a b))
      ((union e (Const 1))))
(rule ((= e (SLe (Const a) (Const b))) (> a b))
      ((union e (Const 0))))
(rule ((= e (SGt (Const a) (Const b))) (> a b))
      ((union e (Const 1))))
(rule ((= e (SGt (Const a) (Const b))) (<= a b))
      ((union e (Const 0))))
(rule ((= e (SGe (Const a) (Const b))) (>= a b))
      ((union e (Const 1))))
(rule ((= e (SGe (Const a) (Const b))) (< a b))
      ((union e (Const 0))))

; Unsigned comparisons (treat as unsigned - need primitives for proper handling)
; For now, use signed comparisons (works for positive values)
(rule ((= e (ULt (Const a) (Const b))) (< a b))
      ((union e (Const 1))))
(rule ((= e (ULt (Const a) (Const b))) (>= a b))
      ((union e (Const 0))))
(rule ((= e (ULe (Const a) (Const b))) (<= a b))
      ((union e (Const 1))))
(rule ((= e (ULe (Const a) (Const b))) (> a b))
      ((union e (Const 0))))
(rule ((= e (UGt (Const a) (Const b))) (> a b))
      ((union e (Const 1))))
(rule ((= e (UGt (Const a) (Const b))) (<= a b))
      ((union e (Const 0))))
(rule ((= e (UGe (Const a) (Const b))) (>= a b))
      ((union e (Const 1))))
(rule ((= e (UGe (Const a) (Const b))) (< a b))
      ((union e (Const 0))))

; =============================================================================
; Rotation Constant Folding
; =============================================================================

; BitReverse constant folding is handled via Rust primitives

; Rotate left/right with constants
; Note: These require proper bit-width handling, so they're typically
; handled via Rust primitives for full correctness

; =============================================================================
; Min/Max Constant Folding
; =============================================================================

; Signed min/max
(rule ((= e (SMin (Const a) (Const b))) (<= a b))
      ((union e (Const a))))
(rule ((= e (SMin (Const a) (Const b))) (> a b))
      ((union e (Const b))))
(rule ((= e (SMax (Const a) (Const b))) (>= a b))
      ((union e (Const a))))
(rule ((= e (SMax (Const a) (Const b))) (< a b))
      ((union e (Const b))))

; Unsigned min/max (using signed for positive values)
(rule ((= e (UMin (Const a) (Const b))) (<= a b))
      ((union e (Const a))))
(rule ((= e (UMin (Const a) (Const b))) (> a b))
      ((union e (Const b))))
(rule ((= e (UMax (Const a) (Const b))) (>= a b))
      ((union e (Const a))))
(rule ((= e (UMax (Const a) (Const b))) (< a b))
      ((union e (Const b))))

; =============================================================================
; Logical Operation Constant Folding
; =============================================================================

; Logical NOT of constant (0 -> 1, non-zero -> 0)
(rule ((= e (LogNot (Const 0))))
      ((union e (Const 1))))
(rule ((= e (LogNot (Const a))) (!= a 0))
      ((union e (Const 0))))

; Logical AND of constants
(rule ((= e (LogAnd (Const 0) (Const b))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (Const a) (Const 0))))
      ((union e (Const 0))))
(rule ((= e (LogAnd (Const a) (Const b))) (!= a 0) (!= b 0))
      ((union e (Const 1))))

; Logical OR of constants
(rule ((= e (LogOr (Const a) (Const b))) (!= a 0))
      ((union e (Const 1))))
(rule ((= e (LogOr (Const a) (Const b))) (!= b 0))
      ((union e (Const 1))))
(rule ((= e (LogOr (Const 0) (Const 0))))
      ((union e (Const 0))))

; Logical equality of constants
(rule ((= e (LogEq (Const a) (Const b))) (= a b))
      ((union e (Const 1))))
(rule ((= e (LogEq (Const a) (Const b))) (!= a b))
      ((union e (Const 0))))
(rule ((= e (LogNe (Const a) (Const b))) (!= a b))
      ((union e (Const 1))))
(rule ((= e (LogNe (Const a) (Const b))) (= a b))
      ((union e (Const 0))))
