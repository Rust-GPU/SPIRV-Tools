; =============================================================================
; Type Conversion Rules
; =============================================================================
;
; Optimizations for SPIR-V type conversion operations (OpConvert*, OpBitcast)
; and GLSL pack/unpack operations.
;
; These operations are all part of the global e-graph and participate in
; whole-program optimization via RVSDG.

; =============================================================================
; Round-Trip Elimination
; =============================================================================

; Float <-> Integer round-trips
; Converting int->float->int or float->int->float often loses precision,
; but in some cases (small integers, exact representations) it's identity.
; These rewrites are conservative - they apply only when the operations cancel.

; Double conversion cancellation (same direction) - ONE-DIRECTIONAL
(rule ((= e (ConvertFToS (ConvertFToS x))))
      ((union e (ConvertFToS x))))
(rule ((= e (ConvertFToU (ConvertFToU x))))
      ((union e (ConvertFToU x))))
(rule ((= e (ConvertSToF (ConvertSToF x))))
      ((union e (ConvertSToF x))))
(rule ((= e (ConvertUToF (ConvertUToF x))))
      ((union e (ConvertUToF x))))

; Integer width change cancellation (if same signedness) - ONE-DIRECTIONAL
(rule ((= e (SConvert (SConvert x))))
      ((union e (SConvert x))))
(rule ((= e (UConvert (UConvert x))))
      ((union e (UConvert x))))

; Float precision change cancellation - ONE-DIRECTIONAL
(rule ((= e (FConvert (FConvert x))))
      ((union e (FConvert x))))

; =============================================================================
; Bitcast Rules
; =============================================================================

; Bitcast of bitcast is bitcast (two reinterpretations)
; Note: In general bitcast(bitcast(x)) may equal x if types align, but
; without type info we can only say it's still a bitcast - ONE-DIRECTIONAL
(rule ((= e (Bitcast (Bitcast x))))
      ((union e (Bitcast x))))

; =============================================================================
; Quantization Rules
; =============================================================================

; Quantize is idempotent - quantizing twice is same as once - ONE-DIRECTIONAL
(rule ((= e (QuantizeToF16 (QuantizeToF16 x))))
      ((union e (QuantizeToF16 x))))

; =============================================================================
; Pack/Unpack Round-Trip Rules
; =============================================================================

; Unpack of pack is identity (for matching types) - ONE-DIRECTIONAL
(rule ((= e (UnpackHalf2x16 (PackHalf2x16 x))))
      ((union e x)))
(rule ((= e (UnpackSnorm4x8 (PackSnorm4x8 x))))
      ((union e x)))
(rule ((= e (UnpackSnorm2x16 (PackSnorm2x16 x))))
      ((union e x)))
(rule ((= e (UnpackUnorm4x8 (PackUnorm4x8 x))))
      ((union e x)))
(rule ((= e (UnpackUnorm2x16 (PackUnorm2x16 x))))
      ((union e x)))
(rule ((= e (UnpackDouble2x32 (PackDouble2x32 x))))
      ((union e x)))

; Pack of unpack is identity (for matching types) - ONE-DIRECTIONAL
(rule ((= e (PackHalf2x16 (UnpackHalf2x16 x))))
      ((union e x)))
(rule ((= e (PackSnorm4x8 (UnpackSnorm4x8 x))))
      ((union e x)))
(rule ((= e (PackSnorm2x16 (UnpackSnorm2x16 x))))
      ((union e x)))
(rule ((= e (PackUnorm4x8 (UnpackUnorm4x8 x))))
      ((union e x)))
(rule ((= e (PackUnorm2x16 (UnpackUnorm2x16 x))))
      ((union e x)))
(rule ((= e (PackDouble2x32 (UnpackDouble2x32 x))))
      ((union e x)))

; =============================================================================
; Radians/Degrees Round-Trip
; =============================================================================

; Converting radians->degrees->radians or degrees->radians->degrees is identity - ONE-DIRECTIONAL
(rule ((= e (Radians (Degrees x))))
      ((union e x)))
(rule ((= e (Degrees (Radians x))))
      ((union e x)))

; =============================================================================
; NaN-Ignoring Min/Max Simplifications
; =============================================================================

; NMin/NMax are the same as FMin/FMax for non-NaN values
; For NaN inputs, NMin/NMax return the non-NaN value

; Self is identity (ignoring NaN) - ONE-DIRECTIONAL
(rule ((= e (NMin x x)))
      ((union e x)))
(rule ((= e (NMax x x)))
      ((union e x)))

; NClamp with equal bounds - ONE-DIRECTIONAL
(rule ((= e (NClamp x a a)))
      ((union e a)))

; Commutativity - REMOVED to prevent e-graph explosion
; NMin(a, b) ↔ NMin(b, a) creates immediate cycles
; The e-graph handles commutativity implicitly when both forms are present

; Idempotent - ONE-DIRECTIONAL
(rule ((= e (NMin (NMin x y) y)))
      ((union e (NMin x y))))
(rule ((= e (NMax (NMax x y) y)))
      ((union e (NMax x y))))
(rule ((= e (NMin x (NMin x y))))
      ((union e (NMin x y))))
(rule ((= e (NMax x (NMax x y))))
      ((union e (NMax x y))))

; Absorption: nmin(x, nmax(x, y)) = x - ONE-DIRECTIONAL to prevent explosion
(rule ((= e (NMin x (NMax x y))))
      ((union e x)))
(rule ((= e (NMin (NMax x y) x)))
      ((union e x)))
(rule ((= e (NMax x (NMin x y))))
      ((union e x)))
(rule ((= e (NMax (NMin x y) x)))
      ((union e x)))

; NClamp expressed as nested NMin/NMax - ONE-DIRECTIONAL (simplify TO clamp)
(rule ((= e (NMax lo (NMin x hi))))
      ((union e (NClamp x lo hi))))

; =============================================================================
; Additional Type Conversion Optimizations
; =============================================================================

; Convert then operation vs operation then convert
; These can sometimes be simplified when the operation is simpler in one type

; Sign extension followed by zero extension patterns
; These are complex and depend on bit widths

; Truncation followed by extension
; Trunc(Ext(x)) might equal x if bit widths match

; =============================================================================
; Loop Invariant Type Conversion
; =============================================================================

; Loop invariant rules - ONE-DIRECTIONAL
(rule ((= e (ConvertFToS (LoopInvariant x))))
      ((union e (LoopInvariant (ConvertFToS x)))))
(rule ((= e (ConvertFToU (LoopInvariant x))))
      ((union e (LoopInvariant (ConvertFToU x)))))
(rule ((= e (ConvertSToF (LoopInvariant x))))
      ((union e (LoopInvariant (ConvertSToF x)))))
(rule ((= e (ConvertUToF (LoopInvariant x))))
      ((union e (LoopInvariant (ConvertUToF x)))))
(rule ((= e (SConvert (LoopInvariant x))))
      ((union e (LoopInvariant (SConvert x)))))
(rule ((= e (UConvert (LoopInvariant x))))
      ((union e (LoopInvariant (UConvert x)))))
(rule ((= e (FConvert (LoopInvariant x))))
      ((union e (LoopInvariant (FConvert x)))))
(rule ((= e (Bitcast (LoopInvariant x))))
      ((union e (LoopInvariant (Bitcast x)))))
(rule ((= e (QuantizeToF16 (LoopInvariant x))))
      ((union e (LoopInvariant (QuantizeToF16 x)))))

; Pack/Unpack loop invariant - ONE-DIRECTIONAL
(rule ((= e (PackHalf2x16 (LoopInvariant x))))
      ((union e (LoopInvariant (PackHalf2x16 x)))))
(rule ((= e (UnpackHalf2x16 (LoopInvariant x))))
      ((union e (LoopInvariant (UnpackHalf2x16 x)))))
(rule ((= e (PackSnorm4x8 (LoopInvariant x))))
      ((union e (LoopInvariant (PackSnorm4x8 x)))))
(rule ((= e (UnpackSnorm4x8 (LoopInvariant x))))
      ((union e (LoopInvariant (UnpackSnorm4x8 x)))))
(rule ((= e (PackUnorm4x8 (LoopInvariant x))))
      ((union e (LoopInvariant (PackUnorm4x8 x)))))
(rule ((= e (UnpackUnorm4x8 (LoopInvariant x))))
      ((union e (LoopInvariant (UnpackUnorm4x8 x)))))

; Radians/Degrees loop invariant - ONE-DIRECTIONAL
(rule ((= e (Radians (LoopInvariant x))))
      ((union e (LoopInvariant (Radians x)))))
(rule ((= e (Degrees (LoopInvariant x))))
      ((union e (LoopInvariant (Degrees x)))))

; NMin/NMax/NClamp loop invariant - ONE-DIRECTIONAL
(rule ((= e (NMin (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (NMin a b)))))
(rule ((= e (NMax (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (NMax a b)))))
(rule ((= e (NClamp (LoopInvariant x) (LoopInvariant lo) (LoopInvariant hi))))
      ((union e (LoopInvariant (NClamp x lo hi)))))

; =============================================================================
; Gamma Distribution for Type Conversions
; =============================================================================

; select(c, convert(x), convert(y)) = convert(select(c, x, y)) - ONE-DIRECTIONAL
(rule ((= e (Gamma c (ConvertFToS x) (ConvertFToS y))))
      ((union e (ConvertFToS (Gamma c x y)))))
(rule ((= e (Gamma c (ConvertFToU x) (ConvertFToU y))))
      ((union e (ConvertFToU (Gamma c x y)))))
(rule ((= e (Gamma c (ConvertSToF x) (ConvertSToF y))))
      ((union e (ConvertSToF (Gamma c x y)))))
(rule ((= e (Gamma c (ConvertUToF x) (ConvertUToF y))))
      ((union e (ConvertUToF (Gamma c x y)))))
(rule ((= e (Gamma c (FConvert x) (FConvert y))))
      ((union e (FConvert (Gamma c x y)))))
(rule ((= e (Gamma c (SConvert x) (SConvert y))))
      ((union e (SConvert (Gamma c x y)))))
(rule ((= e (Gamma c (UConvert x) (UConvert y))))
      ((union e (UConvert (Gamma c x y)))))
(rule ((= e (Gamma c (Bitcast x) (Bitcast y))))
      ((union e (Bitcast (Gamma c x y)))))
