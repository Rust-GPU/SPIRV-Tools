; =============================================================================
; RVSDG (Regionalized Value State Dependence Graph) Rewrite Rules
; =============================================================================
;
; RVSDG represents control flow in a structured, functional way:
; - Gamma nodes: Conditional selection (replaces if-then-else + phi)
; - Theta nodes: Tail-controlled loops (replaces while loops + phi)
; - Effects: Side effects and control flow
;
; Uses typed sorts: Gamma/GammaI/GammaF/GammaB, Select/SelectI/SelectF/SelectB,
; If/IfI/IfF/IfB, Theta/ThetaI/ThetaF/ThetaB, LoopInvariant/LoopInvariantI/
; LoopInvariantF/LoopInvariantB, LoopVar/LoopVarI/LoopVarF/LoopVarB.

; =============================================================================
; Gamma/Select Equivalence
; =============================================================================

; Gamma and Select are equivalent - unify them
; ONE-DIRECTIONAL: Convert Select/If to Gamma (canonical form), never the reverse
(rule ((= e (Select c t f)))
      ((union e (Gamma c t f))))
(rule ((= e (SelectI c t f)))
      ((union e (GammaI c t f))))
(rule ((= e (SelectF c t f)))
      ((union e (GammaF c t f))))
(rule ((= e (SelectB c t f)))
      ((union e (GammaB c t f))))
(rule ((= e (If c t f)))
      ((union e (Gamma c t f))))
(rule ((= e (IfI c t f)))
      ((union e (GammaI c t f))))
(rule ((= e (IfF c t f)))
      ((union e (GammaF c t f))))
(rule ((= e (IfB c t f)))
      ((union e (GammaB c t f))))

; =============================================================================
; RVSDG Gamma (Conditional) Rewrite Rules
; =============================================================================

; Gamma with constant condition - ONE-DIRECTIONAL
; BoolConst is the only valid constant for BoolExpr conditions
(rule ((= e (Gamma (BoolConst 0) t f)))
      ((union e f)))
(rule ((= e (Gamma (BoolConst 1) t f)))
      ((union e t)))
(rule ((= e (GammaI (BoolConst 0) t f)))
      ((union e f)))
(rule ((= e (GammaI (BoolConst 1) t f)))
      ((union e t)))
(rule ((= e (GammaF (BoolConst 0) t f)))
      ((union e f)))
(rule ((= e (GammaF (BoolConst 1) t f)))
      ((union e t)))
(rule ((= e (GammaB (BoolConst 0) t f)))
      ((union e f)))
(rule ((= e (GammaB (BoolConst 1) t f)))
      ((union e t)))

; Push Gamma through bridge constructors into typed Gamma variants.
; When both arms have the same bridge type, convert to the typed Gamma.
; This enables typed Gamma rules (GammaB/GammaI/GammaF) to fire.
(rule ((= e (Gamma c (IntToExpr t) (IntToExpr f))))
      ((union e (IntToExpr (GammaI c t f)))))
(rule ((= e (Gamma c (FloatToExpr t) (FloatToExpr f))))
      ((union e (FloatToExpr (GammaF c t f)))))
(rule ((= e (Gamma c (BoolToExpr t) (BoolToExpr f))))
      ((union e (BoolToExpr (GammaB c t f)))))

; When one arm is BoolToExpr, the result must be boolean - convert other arm too
(rule ((= e (Gamma c x (BoolToExpr f))))
      ((union e (BoolToExpr (GammaB c (ExprToBool x) f)))))
(rule ((= e (Gamma c (BoolToExpr t) x)))
      ((union e (BoolToExpr (GammaB c t (ExprToBool x))))))

; Gamma with same true/false values - ONE-DIRECTIONAL
(rule ((= e (Gamma c x x)))
      ((union e x)))
(rule ((= e (GammaI c x x)))
      ((union e x)))
(rule ((= e (GammaF c x x)))
      ((union e x)))
(rule ((= e (GammaB c x x)))
      ((union e x)))

; Gamma with negated condition - ONE-DIRECTIONAL
; Only simplify LogNot out of condition, never put it back
(rule ((= e (Gamma (LogNot c) t f)))
      ((union e (Gamma c f t))))
(rule ((= e (GammaI (LogNot c) t f)))
      ((union e (GammaI c f t))))
(rule ((= e (GammaF (LogNot c) t f)))
      ((union e (GammaF c f t))))
(rule ((= e (GammaB (LogNot c) t f)))
      ((union e (GammaB c f t))))

; Nested Gamma simplification (same condition) - ONE-DIRECTIONAL
(rule ((= e (Gamma c (Gamma c a b) d)))
      ((union e (Gamma c a d))))
(rule ((= e (Gamma c d (Gamma c a b))))
      ((union e (Gamma c d b))))
(rule ((= e (GammaI c (GammaI c a b) d)))
      ((union e (GammaI c a d))))
(rule ((= e (GammaI c d (GammaI c a b))))
      ((union e (GammaI c d b))))
(rule ((= e (GammaF c (GammaF c a b) d)))
      ((union e (GammaF c a d))))
(rule ((= e (GammaF c d (GammaF c a b))))
      ((union e (GammaF c d b))))
(rule ((= e (GammaB c (GammaB c a b) d)))
      ((union e (GammaB c a d))))
(rule ((= e (GammaB c d (GammaB c a b))))
      ((union e (GammaB c d b))))

; Gamma with BoolConst condition and negated condition
(rule ((= e (Gamma (LogNot (BoolConst 0)) t f)))
      ((union e t)))
(rule ((= e (Gamma (LogNot (BoolConst 1)) t f)))
      ((union e f)))
(rule ((= e (GammaI (LogNot (BoolConst 0)) t f)))
      ((union e t)))
(rule ((= e (GammaI (LogNot (BoolConst 1)) t f)))
      ((union e f)))
(rule ((= e (GammaF (LogNot (BoolConst 0)) t f)))
      ((union e t)))
(rule ((= e (GammaF (LogNot (BoolConst 1)) t f)))
      ((union e f)))
(rule ((= e (GammaB (LogNot (BoolConst 0)) t f)))
      ((union e t)))
(rule ((= e (GammaB (LogNot (BoolConst 1)) t f)))
      ((union e f)))

; =============================================================================
; Additional Phi/Gamma Redundancy Patterns (C++ RedundantPhi)
; =============================================================================

; Gamma where condition appears as one branch (boolean patterns)
; select(c, c, false) = c (identity for boolean c)
; c is BoolExpr, branches are BoolExpr, so this is GammaB
(rule ((= e (GammaB c c (BoolConst 0))))
      ((union e c)))
; select(c, true, c) = c | true = true when c is boolean
; But this is the same as select(c, 1, c) = c ? 1 : c which is just 1 when c is true, c when false

; DISABLED: Gamma distribution INTO — creates new Op nodes inside both arms,
; forming cycles with the hoisting rules below (which pull common factors OUT).
; The hoisting rules (lines 166+) are the simplifying direction and are kept.
; (rule ((= e (Add (GammaI c a b) (GammaI c x y))))
;       ((union e (GammaI c (Add a x) (Add b y)))))
; (rule ((= e (Sub (GammaI c a b) (GammaI c x y))))
;       ((union e (GammaI c (Sub a x) (Sub b y)))))
; (rule ((= e (Mul (GammaI c a b) (GammaI c x y))))
;       ((union e (GammaI c (Mul a x) (Mul b y)))))
; (rule ((= e (BitAnd (GammaI c a b) (GammaI c x y))))
;       ((union e (GammaI c (BitAnd a x) (BitAnd b y)))))
; (rule ((= e (BitOr (GammaI c a b) (GammaI c x y))))
;       ((union e (GammaI c (BitOr a x) (BitOr b y)))))
; (rule ((= e (BitXor (GammaI c a b) (GammaI c x y))))
;       ((union e (GammaI c (BitXor a x) (BitXor b y)))))

; Hoist common operations out of Gamma - ONE-DIRECTIONAL
; (c ? (x + a) : (x + b)) => x + (c ? a : b)
; Hoist the common factor OUT (simplifies branching)
; Integer operations use GammaI
(rule ((= e (GammaI c (Add x a) (Add x b))))
      ((union e (Add x (GammaI c a b)))))
(rule ((= e (GammaI c (Add a x) (Add b x))))
      ((union e (Add (GammaI c a b) x))))
(rule ((= e (GammaI c (Sub x a) (Sub x b))))
      ((union e (Sub x (GammaI c a b)))))
(rule ((= e (GammaI c (Mul x a) (Mul x b))))
      ((union e (Mul x (GammaI c a b)))))
(rule ((= e (GammaI c (Mul a x) (Mul b x))))
      ((union e (Mul (GammaI c a b) x))))
(rule ((= e (GammaI c (BitAnd x a) (BitAnd x b))))
      ((union e (BitAnd x (GammaI c a b)))))
(rule ((= e (GammaI c (BitOr x a) (BitOr x b))))
      ((union e (BitOr x (GammaI c a b)))))
(rule ((= e (GammaI c (BitXor x a) (BitXor x b))))
      ((union e (BitXor x (GammaI c a b)))))

; =============================================================================
; RVSDG Theta (Loop) Rewrite Rules - Loop Invariant Code Motion
; =============================================================================

; LoopInvariant is idempotent - ONE-DIRECTIONAL
(rule ((= e (LoopInvariant (LoopInvariant x))))
      ((union e (LoopInvariant x))))
(rule ((= e (LoopInvariantI (LoopInvariantI x))))
      ((union e (LoopInvariantI x))))
(rule ((= e (LoopInvariantF (LoopInvariantF x))))
      ((union e (LoopInvariantF x))))
(rule ((= e (LoopInvariantB (LoopInvariantB x))))
      ((union e (LoopInvariantB x))))

; Constants and symbols are inherently loop-invariant (they don't depend on LoopVar)
; NOTE: These rules are DISABLED because combined with the LoopInvariant stripping rule
; they create cycles: Const(5) <-> LoopInvariant(Const(5))
; The stripping rule (LoopInvariant x) -> x is bidirectional, so it also adds
; LoopInvariant to everything, creating x <-> LoopInvariant(x) for ALL nodes.
; (rewrite (Const n) (LoopInvariantI (Const n)))
; (rewrite (Const64 n) (LoopInvariantI (Const64 n)))
; (rewrite (Sym s) (LoopInvariant (Sym s)))

; LoopVar is NOT loop-invariant (it changes each iteration)
; No rule to mark LoopVar as LoopInvariant

; Operations on loop invariants produce loop invariants - ONE-DIRECTIONAL
; Integer operations use LoopInvariantI
; Using rule/union to prevent LoopInvariantI(Add a b) -> Add(LI a, LI b) cycles
(rule ((= e (Add (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantI (Add a b)))))
(rule ((= e (Sub (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantI (Sub a b)))))
(rule ((= e (Mul (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantI (Mul a b)))))
(rule ((= e (SDiv (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantI (SDiv a b)))))
(rule ((= e (UDiv (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantI (UDiv a b)))))
(rule ((= e (BitAnd (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantI (BitAnd a b)))))
(rule ((= e (BitOr (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantI (BitOr a b)))))
(rule ((= e (BitXor (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantI (BitXor a b)))))
(rule ((= e (Shl (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantI (Shl a b)))))
(rule ((= e (ShrS (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantI (ShrS a b)))))
(rule ((= e (ShrU (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantI (ShrU a b)))))

; Unary operations on loop invariants - ONE-DIRECTIONAL
; Integer unary ops use LoopInvariantI
(rule ((= e (Neg (LoopInvariantI a))))
      ((union e (LoopInvariantI (Neg a)))))
(rule ((= e (BitNot (LoopInvariantI a))))
      ((union e (LoopInvariantI (BitNot a)))))
; Boolean unary op uses LoopInvariantB
(rule ((= e (LogNot (LoopInvariantB a))))
      ((union e (LoopInvariantB (LogNot a)))))

; Comparisons on loop invariants produce loop-invariant booleans - ONE-DIRECTIONAL
; Integer comparisons: LoopInvariantI inputs, LoopInvariantB output
(rule ((= e (Eq (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantB (Eq a b)))))
(rule ((= e (Ne (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantB (Ne a b)))))
(rule ((= e (SLt (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantB (SLt a b)))))
(rule ((= e (SLe (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantB (SLe a b)))))
(rule ((= e (SGt (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantB (SGt a b)))))
(rule ((= e (SGe (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantB (SGe a b)))))
(rule ((= e (ULt (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantB (ULt a b)))))
(rule ((= e (ULe (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantB (ULe a b)))))
(rule ((= e (UGt (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantB (UGt a b)))))
(rule ((= e (UGe (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantB (UGe a b)))))

; =============================================================================
; Theta LICM: Hoist loop-invariant expressions out of Theta
; =============================================================================

; Core LICM rule: If the body of a Theta computes a LoopInvariant value,
; that value can be computed before the loop.
; (Theta cond (LoopInvariant x) init) - the invariant x doesn't need to be in the loop
; This rule doesn't directly eliminate the Theta, but marks what can be hoisted.

; Strip LoopInvariant wrapper (it's just an annotation for optimization)
; After optimization, we extract the inner value
; ONE-DIRECTIONAL: Using (rule ... union) to prevent x -> LoopInvariant(x) for every x
(rule ((= e (LoopInvariant x)))
      ((union e x)))
(rule ((= e (LoopInvariantI x)))
      ((union e x)))
(rule ((= e (LoopInvariantF x)))
      ((union e x)))
(rule ((= e (LoopInvariantB x)))
      ((union e x)))

; =============================================================================
; RVSDG Effect Rewrite Rules
; =============================================================================

; Sequence identity - ONE-DIRECTIONAL to prevent explosion
(rule ((= e (Seq (Pure) x)))
      ((union e x)))
(rule ((= e (Seq x (Pure))))
      ((union e x)))

; Unreachable absorbs everything after it - ONE-DIRECTIONAL
(rule ((= result (Seq (Unreachable) e)))
      ((union result (Unreachable))))

; Effect Gamma with constant condition - ONE-DIRECTIONAL to prevent explosion
; BoolConst is the only valid constant for BoolExpr conditions
(rule ((= e (EffGamma (BoolConst 0) t f)))
      ((union e f)))
(rule ((= e (EffGamma (BoolConst 1) t f)))
      ((union e t)))

; Effect Gamma with same branches - ONE-DIRECTIONAL to prevent explosion
(rule ((= result (EffGamma c x x)))
      ((union result x)))

; Effect Gamma with negated condition - ONE-DIRECTIONAL
(rule ((= e (EffGamma (LogNot c) t f)))
      ((union e (EffGamma c f t))))

; Both branches return same value -> just return that value - ONE-DIRECTIONAL
(rule ((= e (EffGamma c (ReturnValue x) (ReturnValue x))))
      ((union e (ReturnValue x))))

; Both branches unreachable -> unreachable - ONE-DIRECTIONAL
(rule ((= e (EffGamma c (Unreachable) (Unreachable))))
      ((union e (Unreachable))))

; One branch unreachable with return in other -> simplify - ONE-DIRECTIONAL
; (If cond then return x else unreachable) -> return x when cond is true
(rule ((= e (EffGamma c (ReturnValue x) (Unreachable))))
      ((union e (ReturnValue x))))
(rule ((= e (EffGamma c (Unreachable) (ReturnValue x))))
      ((union e (ReturnValue x))))

; Merge return transformation (the key RVSDG optimization!) - ONE-DIRECTIONAL
; If both branches return different values, create a Gamma to select the result
; (EffGamma c (ReturnValue x) (ReturnValue y)) -> (ReturnValue (Gamma c x y))
(rule ((= e (EffGamma c (ReturnValue x) (ReturnValue y))))
      ((union e (ReturnValue (Gamma c x y)))))

; =============================================================================
; Additional Gamma Simplifications (C++ Parity)
; =============================================================================

; NOTE: The rule (Gamma c c x) -> c was REMOVED because it assumes boolean
; context. In integer context, select(c, c, x) where c is 0/1 would give wrong
; results if c is not boolean. The BoolConst rules above handle the boolean case.
; select(c, x, false) = LogAnd(c, x) - ONLY for boolean contexts
; With typed sorts, GammaB guarantees boolean context for branches
; ONE-DIRECTIONAL: Convert GammaB to LogAnd/LogOr, never reverse (prevents explosion)
(rule ((= e (GammaB c x (BoolConst 0))))
      ((union e (LogAnd c x))))
(rule ((= e (GammaB c (BoolConst 1) x)))
      ((union e (LogOr c x))))
(rule ((= e (GammaB c (BoolConst 0) x)))
      ((union e (LogAnd (LogNot c) x))))
(rule ((= e (GammaB c x (BoolConst 1))))
      ((union e (LogOr (LogNot c) x))))

; Gamma with boolean constants 0/1 and variable
; select(c, false, true) = !c
; select(c, true, false) = c - ONE-DIRECTIONAL to prevent explosion
; GammaB since both branches are BoolExpr constants
(rule ((= e (GammaB c (BoolConst 0) (BoolConst 1))))
      ((union e (LogNot c))))
(rule ((= e (GammaB c (BoolConst 1) (BoolConst 0))))
      ((union e c)))

; Chained Gamma with opposite conditions - ONE-DIRECTIONAL
; select(c, select(!c, a, b), x) simplifies
(rule ((= e (Gamma c (Gamma (LogNot c) a b) x)))
      ((union e (Gamma c b x))))
(rule ((= e (Gamma c x (Gamma (LogNot c) a b))))
      ((union e (Gamma c x a))))
(rule ((= e (GammaI c (GammaI (LogNot c) a b) x)))
      ((union e (GammaI c b x))))
(rule ((= e (GammaI c x (GammaI (LogNot c) a b))))
      ((union e (GammaI c x a))))
(rule ((= e (GammaF c (GammaF (LogNot c) a b) x)))
      ((union e (GammaF c b x))))
(rule ((= e (GammaF c x (GammaF (LogNot c) a b))))
      ((union e (GammaF c x a))))
(rule ((= e (GammaB c (GammaB (LogNot c) a b) x)))
      ((union e (GammaB c b x))))
(rule ((= e (GammaB c x (GammaB (LogNot c) a b))))
      ((union e (GammaB c x a))))

; Gamma selecting between x and operation on x
; select(c, x, x + 1) can't be simplified generally, but
; select(c, x, 0) when c means x!=0 can help

; =============================================================================
; Floating-Point Loop Invariant Rules - ONE-DIRECTIONAL
; =============================================================================

(rule ((= e (FAdd (LoopInvariantF a) (LoopInvariantF b))))
      ((union e (LoopInvariantF (FAdd a b)))))
(rule ((= e (FSub (LoopInvariantF a) (LoopInvariantF b))))
      ((union e (LoopInvariantF (FSub a b)))))
(rule ((= e (FMul (LoopInvariantF a) (LoopInvariantF b))))
      ((union e (LoopInvariantF (FMul a b)))))
(rule ((= e (FDiv (LoopInvariantF a) (LoopInvariantF b))))
      ((union e (LoopInvariantF (FDiv a b)))))
(rule ((= e (FNeg (LoopInvariantF a))))
      ((union e (LoopInvariantF (FNeg a)))))
(rule ((= e (FAbs (LoopInvariantF a))))
      ((union e (LoopInvariantF (FAbs a)))))
(rule ((= e (Sqrt (LoopInvariantF a))))
      ((union e (LoopInvariantF (Sqrt a)))))

; =============================================================================
; Floating-Point Gamma Distribution - ONE-DIRECTIONAL
; =============================================================================
; DISABLED: Distribution INTO GammaF — creates new FOp nodes inside both arms,
; forming cycles with the hoisting rules below.
; (rule ((= e (FAdd (GammaF c a b) (GammaF c x y))))
;       ((union e (GammaF c (FAdd a x) (FAdd b y)))))
; (rule ((= e (FSub (GammaF c a b) (GammaF c x y))))
;       ((union e (GammaF c (FSub a x) (FSub b y)))))
; (rule ((= e (FMul (GammaF c a b) (GammaF c x y))))
;       ((union e (GammaF c (FMul a x) (FMul b y)))))

; Hoisting common factors OUT of GammaF - ONE-DIRECTIONAL
; DISABLED: GammaF hoisting for FAdd/FMul/FDiv causes egraph explosion on mouse-shader.
; New FMul/FDiv/GammaF nodes feed back into floating-point rules (reciprocals, negation
; distribution, select absorption) and other GammaF distribution rules, creating a
; multi-way amplification loop. FMul: 73K matches, FDiv: 1.37M matches at iter 6.
; FAdd not flagged yet but has identical feedback structure via FAdd associativity.
; (rule ((= e (GammaF c (FAdd x a) (FAdd x b))))
;       ((union e (FAdd x (GammaF c a b)))))
; (rule ((= e (GammaF c (FMul x a) (FMul x b))))
;       ((union e (FMul x (GammaF c a b)))))

; =============================================================================
; Theta (Loop) Optimization Rules - ONE-DIRECTIONAL
; =============================================================================

; Theta with false condition never executes - return initial value
; BoolConst is the only valid constant for BoolExpr conditions
(rule ((= e (Theta (BoolConst 0) body init)))
      ((union e init)))
(rule ((= e (ThetaI (BoolConst 0) body init)))
      ((union e init)))
(rule ((= e (ThetaF (BoolConst 0) body init)))
      ((union e init)))
(rule ((= e (ThetaB (BoolConst 0) body init)))
      ((union e init)))

; Theta with constant true condition would loop forever
; We don't simplify this as it's an infinite loop

; Theta where body equals LoopVar - loop does nothing, return init
; (Theta cond (LoopVar) init) = init when loop doesn't modify state
(rule ((= e (Theta cond (LoopVar) init)))
      ((union e init)))
(rule ((= e (ThetaI cond (LoopVarI) init)))
      ((union e init)))
(rule ((= e (ThetaF cond (LoopVarF) init)))
      ((union e init)))
(rule ((= e (ThetaB cond (LoopVarB) init)))
      ((union e init)))

; =============================================================================
; More Loop Invariant Propagation - ONE-DIRECTIONAL
; =============================================================================

; Float comparison of loop invariants produces loop-invariant booleans
(rule ((= e (FOrdEq (LoopInvariantF a) (LoopInvariantF b))))
      ((union e (LoopInvariantB (FOrdEq a b)))))
(rule ((= e (FOrdNe (LoopInvariantF a) (LoopInvariantF b))))
      ((union e (LoopInvariantB (FOrdNe a b)))))
(rule ((= e (FOrdLt (LoopInvariantF a) (LoopInvariantF b))))
      ((union e (LoopInvariantB (FOrdLt a b)))))
(rule ((= e (FOrdLe (LoopInvariantF a) (LoopInvariantF b))))
      ((union e (LoopInvariantB (FOrdLe a b)))))
(rule ((= e (FOrdGt (LoopInvariantF a) (LoopInvariantF b))))
      ((union e (LoopInvariantB (FOrdGt a b)))))
(rule ((= e (FOrdGe (LoopInvariantF a) (LoopInvariantF b))))
      ((union e (LoopInvariantB (FOrdGe a b)))))

; GLSL extended instructions on loop invariants (float)
(rule ((= e (FMin (LoopInvariantF a) (LoopInvariantF b))))
      ((union e (LoopInvariantF (FMin a b)))))
(rule ((= e (FMax (LoopInvariantF a) (LoopInvariantF b))))
      ((union e (LoopInvariantF (FMax a b)))))
(rule ((= e (FFloor (LoopInvariantF a))))
      ((union e (LoopInvariantF (FFloor a)))))
(rule ((= e (FCeil (LoopInvariantF a))))
      ((union e (LoopInvariantF (FCeil a)))))
(rule ((= e (FRound (LoopInvariantF a))))
      ((union e (LoopInvariantF (FRound a)))))
(rule ((= e (FTrunc (LoopInvariantF a))))
      ((union e (LoopInvariantF (FTrunc a)))))

; Exp/Log on loop invariants (float)
(rule ((= e (Exp (LoopInvariantF a))))
      ((union e (LoopInvariantF (Exp a)))))
(rule ((= e (Log (LoopInvariantF a))))
      ((union e (LoopInvariantF (Log a)))))
(rule ((= e (Exp2 (LoopInvariantF a))))
      ((union e (LoopInvariantF (Exp2 a)))))
(rule ((= e (Log2 (LoopInvariantF a))))
      ((union e (LoopInvariantF (Log2 a)))))
(rule ((= e (Pow (LoopInvariantF a) (LoopInvariantF b))))
      ((union e (LoopInvariantF (Pow a b)))))

; Trig functions on loop invariants (float)
(rule ((= e (Sin (LoopInvariantF a))))
      ((union e (LoopInvariantF (Sin a)))))
(rule ((= e (Cos (LoopInvariantF a))))
      ((union e (LoopInvariantF (Cos a)))))
(rule ((= e (Tan (LoopInvariantF a))))
      ((union e (LoopInvariantF (Tan a)))))

; InverseSqrt on loop invariant - ONE-DIRECTIONAL
(rule ((= e (InverseSqrt (LoopInvariantF a))))
      ((union e (LoopInvariantF (InverseSqrt a)))))

; =============================================================================
; Gamma Inside Theta (Loop-conditional code motion)
; =============================================================================

; If condition is loop-invariant, hoist the Gamma out of the loop body
; Theta(cond, Gamma(LoopInvariant(c), a, b), init)
; can become Gamma(c, Theta(cond, a, init), Theta(cond, b, init))
; This is complex and may not always be beneficial, so we skip it

; =============================================================================
; Min/Max Loop Invariant Rules
; =============================================================================

; Min/Max loop invariant rules - ONE-DIRECTIONAL
; Integer min/max use LoopInvariantI
(rule ((= e (SMin (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantI (SMin a b)))))
(rule ((= e (SMax (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantI (SMax a b)))))
(rule ((= e (UMin (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantI (UMin a b)))))
(rule ((= e (UMax (LoopInvariantI a) (LoopInvariantI b))))
      ((union e (LoopInvariantI (UMax a b)))))

; =============================================================================
; Additional Gamma with Min/Max
; =============================================================================

; select(c, min(a, b), min(a, d)) = min(a, select(c, b, d)) - ONE-DIRECTIONAL
; Integer min/max use GammaI
(rule ((= e (GammaI c (SMin a b) (SMin a d))))
      ((union e (SMin a (GammaI c b d)))))
(rule ((= e (GammaI c (SMax a b) (SMax a d))))
      ((union e (SMax a (GammaI c b d)))))
(rule ((= e (GammaI c (UMin a b) (UMin a d))))
      ((union e (UMin a (GammaI c b d)))))
(rule ((= e (GammaI c (UMax a b) (UMax a d))))
      ((union e (UMax a (GammaI c b d)))))
; Float min/max use GammaF
(rule ((= e (GammaF c (FMin a b) (FMin a d))))
      ((union e (FMin a (GammaF c b d)))))
(rule ((= e (GammaF c (FMax a b) (FMax a d))))
      ((union e (FMax a (GammaF c b d)))))

; =============================================================================
; Gamma with Comparisons (comparison absorption)
; =============================================================================

; select(a < b, a, b) = min(a, b) - ONE-DIRECTIONAL
; select(a < b, b, a) = max(a, b)
; Integer comparisons select IntExpr values -> GammaI
(rule ((= e (GammaI (SLt a b) a b)))
      ((union e (SMin a b))))
(rule ((= e (GammaI (SLt a b) b a)))
      ((union e (SMax a b))))
(rule ((= e (GammaI (ULt a b) a b)))
      ((union e (UMin a b))))
(rule ((= e (GammaI (ULt a b) b a)))
      ((union e (UMax a b))))
; Float comparisons select FloatExpr values -> GammaF
(rule ((= e (GammaF (FOrdLt a b) a b)))
      ((union e (FMin a b))))
(rule ((= e (GammaF (FOrdLt a b) b a)))
      ((union e (FMax a b))))

; select(a > b, a, b) = max(a, b) - ONE-DIRECTIONAL
; select(a > b, b, a) = min(a, b)
(rule ((= e (GammaI (SGt a b) a b)))
      ((union e (SMax a b))))
(rule ((= e (GammaI (SGt a b) b a)))
      ((union e (SMin a b))))
(rule ((= e (GammaI (UGt a b) a b)))
      ((union e (UMax a b))))
(rule ((= e (GammaI (UGt a b) b a)))
      ((union e (UMin a b))))
(rule ((= e (GammaF (FOrdGt a b) a b)))
      ((union e (FMax a b))))
(rule ((= e (GammaF (FOrdGt a b) b a)))
      ((union e (FMin a b))))

; select(a <= b, a, b) = min(a, b) - ONE-DIRECTIONAL
(rule ((= e (GammaI (SLe a b) a b)))
      ((union e (SMin a b))))
(rule ((= e (GammaI (SLe a b) b a)))
      ((union e (SMax a b))))
(rule ((= e (GammaI (ULe a b) a b)))
      ((union e (UMin a b))))
(rule ((= e (GammaI (ULe a b) b a)))
      ((union e (UMax a b))))
(rule ((= e (GammaF (FOrdLe a b) a b)))
      ((union e (FMin a b))))
(rule ((= e (GammaF (FOrdLe a b) b a)))
      ((union e (FMax a b))))

; =============================================================================
; Additional Gamma Optimizations (C++ Parity)
; =============================================================================

; select(a >= b, a, b) = max(a, b) - ONE-DIRECTIONAL
(rule ((= e (GammaI (SGe a b) a b)))
      ((union e (SMax a b))))
(rule ((= e (GammaI (SGe a b) b a)))
      ((union e (SMin a b))))
(rule ((= e (GammaI (UGe a b) a b)))
      ((union e (UMax a b))))
(rule ((= e (GammaI (UGe a b) b a)))
      ((union e (UMin a b))))
(rule ((= e (GammaF (FOrdGe a b) a b)))
      ((union e (FMax a b))))
(rule ((= e (GammaF (FOrdGe a b) b a)))
      ((union e (FMin a b))))

; Gamma with equality: select(a == b, x, x) already handled
; select(a == b, a, b) = b (if a==b then a else b, which is just b semantically)
; Actually this is just identity - if equal pick a (which equals b), else pick b

; Gamma with negated comparison already handled via LogNot rule

; =============================================================================
; Clamp Pattern Recognition
; =============================================================================

; max(min(x, hi), lo) = clamp(x, lo, hi) when lo <= hi - ONE-DIRECTIONAL
(rule ((= e (SMax (SMin x hi) lo)))
      ((union e (SClamp x lo hi))))
(rule ((= e (UMax (UMin x hi) lo)))
      ((union e (UClamp x lo hi))))
(rule ((= e (FMax (FMin x hi) lo)))
      ((union e (FClamp x lo hi))))

; min(max(x, lo), hi) = clamp(x, lo, hi) when lo <= hi - ONE-DIRECTIONAL
(rule ((= e (SMin (SMax x lo) hi)))
      ((union e (SClamp x lo hi))))
(rule ((= e (UMin (UMax x lo) hi)))
      ((union e (UClamp x lo hi))))
(rule ((= e (FMin (FMax x lo) hi)))
      ((union e (FClamp x lo hi))))

; =============================================================================
; Dead Branch Elimination for EffGamma
; =============================================================================

; If the condition is a comparison that's always true/false based on analysis,
; the branch can be eliminated. This is complex without value analysis.
; The constant condition rules (EffGamma (BoolConst 0) t f) = f etc. are already covered.

; =============================================================================
; Theta Loop Unrolling Patterns
; =============================================================================

; Theta with loop body that doesn't use LoopVar effectively
; (Theta cond (SomeOp (LoopInvariant x)) init) patterns are already handled
; via the LoopInvariant wrapper rules

; =============================================================================
; Advanced Egraph-Only Optimizations (Beyond C++ Parity)
; =============================================================================
; These rules exploit the global nature of egraph optimization to find
; simplifications that multi-pass C++ optimizers cannot easily discover.

; Cross-branch common subexpression: if both branches compute the same thing
; differently, the egraph will unify them automatically. We add rules for
; specific patterns that help guide this:

; select(c, f(x), f(y)) where f is expensive can become f(select(c, x, y))
; when f is a pure function. This is already covered by Gamma distribution.

; Select absorption with arithmetic: - ONE-DIRECTIONAL
; select(c, x + y, x) = x + select(c, y, 0) - hoist common term OUT
; Integer ops use GammaI and Const
(rule ((= e (GammaI c (Add x y) x)))
      ((union e (Add x (GammaI c y (Const 0))))))
(rule ((= e (GammaI c x (Add x y))))
      ((union e (Add x (GammaI c (Const 0) y)))))
; Float ops use GammaF and FConst
(rule ((= e (GammaF c (FAdd x y) x)))
      ((union e (FAdd x (GammaF c y (FConst 0.0))))))
(rule ((= e (GammaF c x (FAdd x y))))
      ((union e (FAdd x (GammaF c (FConst 0.0) y)))))

; select(c, x * y, x) = x * select(c, y, 1) (when y could be 1) - ONE-DIRECTIONAL
; Integer ops use GammaI and Const
(rule ((= e (GammaI c (Mul x y) x)))
      ((union e (Mul x (GammaI c y (Const 1))))))
(rule ((= e (GammaI c x (Mul x y))))
      ((union e (Mul x (GammaI c (Const 1) y)))))
; Float ops use GammaF and FConst
; DISABLED: Creates 599 new FMul nodes that feed into FMul constant chain merging,
; amplifying the exponential growth. This is a special case of the GammaF FMul
; hoisting that was already disabled above (lines 428-429).
; (rule ((= e (GammaF c (FMul x y) x)))
;       ((union e (FMul x (GammaF c y (FConst 1.0))))))
; (rule ((= e (GammaF c x (FMul x y))))
;       ((union e (FMul x (GammaF c (FConst 1.0) y)))))

; Nested Gamma flattening (when inner condition relates to outer)
; select(c, select(c, a, b), d) = select(c, a, d) - already have
; select(c, d, select(c, a, b)) = select(c, d, b) - already have

; Double-condition elimination:
; select(c, select(d, a, b), select(d, c_val, e)) patterns

; =============================================================================
; Algebraic Simplification through Gamma
; =============================================================================

; NOTE: The inverse rules for "x op select(c, y, 0) -> select(c, x op y, x)" are REMOVED
; because they form a cycle with the select absorption rules above.
; The select absorption rules are the canonical simplifying direction.

; =============================================================================
; Min/Max with Select Patterns
; =============================================================================

; min(select(c, a, b), x) where we know relationship
; These help when one branch is constrained

; max(x, 0) when x is known non-negative = x
; This requires value analysis we don't have, but the pattern is:
; select(x >= 0, x, -x) = abs(x) - ONE-DIRECTIONAL
; Integer abs: condition compares IntExpr, selects IntExpr -> GammaI
(rule ((= e (GammaI (SGe x (Const 0)) x (Neg x))))
      ((union e (SAbs x))))
(rule ((= e (GammaI (SLt x (Const 0)) (Neg x) x)))
      ((union e (SAbs x))))
; Float abs: condition compares FloatExpr, selects FloatExpr -> GammaF
(rule ((= e (GammaF (FOrdGe x (FConst 0.0)) x (FNeg x))))
      ((union e (FAbs x))))
(rule ((= e (GammaF (FOrdLt x (FConst 0.0)) (FNeg x) x)))
      ((union e (FAbs x))))

; =============================================================================
; Conditional Evaluation Short-Circuiting - ONE-DIRECTIONAL
; =============================================================================

; select(c, c && x, false) = c && x (boolean contexts)
; All boolean: GammaB with BoolConst
(rule ((= e (GammaB c (LogAnd c x) (BoolConst 0))))
      ((union e (LogAnd c x))))

; select(c, c || x, true) = true (when c is true, c||x is true; when false, true)
; Actually: select(c, c || x, y) - if c then (true || x)=true, else y
; c is BoolExpr, LogOr returns BoolExpr, y is BoolExpr -> GammaB
(rule ((= e (GammaB c (LogOr c x) y)))
      ((union e (LogOr c y))))

; select(c, true, c || x) = c || x
; NOTE: This rule was REMOVED because it creates new Gamma nodes that cause cycles

; =============================================================================
; Gamma Distribution over Division Operations (C++ Parity)
; =============================================================================
; These rules hoist common operands out of conditional branches
; Note: Shift Gamma distribution rules are in bitwise.egg

; Division operations: select(c, a / x, b / x) = select(c, a, b) / x - ONE-DIRECTIONAL
; Integer division uses GammaI
; NOTE: Integer GammaI hoisting rules are kept because integer arithmetic lacks the
; associativity and reciprocal rules that amplify the float explosion. Monitor if
; integer-heavy shaders cause similar issues (see floating_point.egg factoring notes).
(rule ((= e (GammaI c (SDiv a x) (SDiv b x))))
      ((union e (SDiv (GammaI c a b) x))))
(rule ((= e (GammaI c (UDiv a x) (UDiv b x))))
      ((union e (UDiv (GammaI c a b) x))))
; Float division uses GammaF
; DISABLED: See FMul/FAdd hoisting comment above. 1,167 matches at iter 6 on mouse-shader.
; (rule ((= e (GammaF c (FDiv a x) (FDiv b x))))
;       ((union e (FDiv (GammaF c a b) x))))

; Division with common dividend: select(c, x / a, x / b) = x / select(c, a, b) - ONE-DIRECTIONAL
(rule ((= e (GammaI c (SDiv x a) (SDiv x b))))
      ((union e (SDiv x (GammaI c a b)))))
(rule ((= e (GammaI c (UDiv x a) (UDiv x b))))
      ((union e (UDiv x (GammaI c a b)))))
; DISABLED: See FMul/FAdd hoisting comment above. 1,370,111 matches at iter 6 on mouse-shader.
; (rule ((= e (GammaF c (FDiv x a) (FDiv x b))))
;       ((union e (FDiv x (GammaF c a b)))))

; Remainder/modulo operations - ONE-DIRECTIONAL
; Integer remainder/modulo uses GammaI
(rule ((= e (GammaI c (SRem a x) (SRem b x))))
      ((union e (SRem (GammaI c a b) x))))
(rule ((= e (GammaI c (SMod a x) (SMod b x))))
      ((union e (SMod (GammaI c a b) x))))
(rule ((= e (GammaI c (UMod a x) (UMod b x))))
      ((union e (UMod (GammaI c a b) x))))
; Float remainder uses GammaF
(rule ((= e (GammaF c (FRem a x) (FRem b x))))
      ((union e (FRem (GammaF c a b) x))))

; Negation: select(c, -a, -b) = -(select(c, a, b)) - ONE-DIRECTIONAL
; Integer negation uses GammaI
(rule ((= e (GammaI c (Neg a) (Neg b))))
      ((union e (Neg (GammaI c a b)))))
; Float negation uses GammaF
(rule ((= e (GammaF c (FNeg a) (FNeg b))))
      ((union e (FNeg (GammaF c a b)))))

; Note: BitNot Gamma distribution is in bitwise.egg

; =============================================================================
; Gamma Distribution over Comparison Operations
; =============================================================================
; select(c, a < x, b < x) = select(c, a, b) < x - ONE-DIRECTIONAL
; Comparisons take IntExpr operands and return BoolExpr
; The outer Gamma selects BoolExpr (comparison results) -> GammaB
; The inner Gamma selects IntExpr (comparison operands) -> GammaI
(rule ((= e (GammaB c (SLt a x) (SLt b x))))
      ((union e (SLt (GammaI c a b) x))))
(rule ((= e (GammaB c (SLe a x) (SLe b x))))
      ((union e (SLe (GammaI c a b) x))))
(rule ((= e (GammaB c (SGt a x) (SGt b x))))
      ((union e (SGt (GammaI c a b) x))))
(rule ((= e (GammaB c (SGe a x) (SGe b x))))
      ((union e (SGe (GammaI c a b) x))))
(rule ((= e (GammaB c (ULt a x) (ULt b x))))
      ((union e (ULt (GammaI c a b) x))))
(rule ((= e (GammaB c (ULe a x) (ULe b x))))
      ((union e (ULe (GammaI c a b) x))))
(rule ((= e (GammaB c (UGt a x) (UGt b x))))
      ((union e (UGt (GammaI c a b) x))))
(rule ((= e (GammaB c (UGe a x) (UGe b x))))
      ((union e (UGe (GammaI c a b) x))))
(rule ((= e (GammaB c (Eq a x) (Eq b x))))
      ((union e (Eq (GammaI c a b) x))))
(rule ((= e (GammaB c (Ne a x) (Ne b x))))
      ((union e (Ne (GammaI c a b) x))))

; Floating-point comparisons - ONE-DIRECTIONAL
; Float comparisons take FloatExpr operands -> inner Gamma is GammaF
; Results are BoolExpr -> outer Gamma is GammaB
(rule ((= e (GammaB c (FOrdLt a x) (FOrdLt b x))))
      ((union e (FOrdLt (GammaF c a b) x))))
(rule ((= e (GammaB c (FOrdLe a x) (FOrdLe b x))))
      ((union e (FOrdLe (GammaF c a b) x))))
(rule ((= e (GammaB c (FOrdGt a x) (FOrdGt b x))))
      ((union e (FOrdGt (GammaF c a b) x))))
(rule ((= e (GammaB c (FOrdGe a x) (FOrdGe b x))))
      ((union e (FOrdGe (GammaF c a b) x))))
(rule ((= e (GammaB c (FOrdEq a x) (FOrdEq b x))))
      ((union e (FOrdEq (GammaF c a b) x))))
(rule ((= e (GammaB c (FOrdNe a x) (FOrdNe b x))))
      ((union e (FOrdNe (GammaF c a b) x))))

; =============================================================================
; Gamma Distribution over GLSL Functions
; =============================================================================

; select(c, sqrt(a), sqrt(b)) = sqrt(select(c, a, b)) - ONE-DIRECTIONAL
; Float functions use GammaF
(rule ((= e (GammaF c (Sqrt a) (Sqrt b))))
      ((union e (Sqrt (GammaF c a b)))))
(rule ((= e (GammaF c (InverseSqrt a) (InverseSqrt b))))
      ((union e (InverseSqrt (GammaF c a b)))))

; Exponential functions - ONE-DIRECTIONAL
(rule ((= e (GammaF c (Exp a) (Exp b))))
      ((union e (Exp (GammaF c a b)))))
(rule ((= e (GammaF c (Exp2 a) (Exp2 b))))
      ((union e (Exp2 (GammaF c a b)))))
(rule ((= e (GammaF c (Log a) (Log b))))
      ((union e (Log (GammaF c a b)))))
(rule ((= e (GammaF c (Log2 a) (Log2 b))))
      ((union e (Log2 (GammaF c a b)))))

; Trigonometric functions - ONE-DIRECTIONAL
(rule ((= e (GammaF c (Sin a) (Sin b))))
      ((union e (Sin (GammaF c a b)))))
(rule ((= e (GammaF c (Cos a) (Cos b))))
      ((union e (Cos (GammaF c a b)))))
(rule ((= e (GammaF c (Tan a) (Tan b))))
      ((union e (Tan (GammaF c a b)))))

; Rounding functions - ONE-DIRECTIONAL
(rule ((= e (GammaF c (FFloor a) (FFloor b))))
      ((union e (FFloor (GammaF c a b)))))
(rule ((= e (GammaF c (FCeil a) (FCeil b))))
      ((union e (FCeil (GammaF c a b)))))
(rule ((= e (GammaF c (FRound a) (FRound b))))
      ((union e (FRound (GammaF c a b)))))
(rule ((= e (GammaF c (FTrunc a) (FTrunc b))))
      ((union e (FTrunc (GammaF c a b)))))

; Absolute value - ONE-DIRECTIONAL
; Float abs uses GammaF
(rule ((= e (GammaF c (FAbs a) (FAbs b))))
      ((union e (FAbs (GammaF c a b)))))
; Integer abs uses GammaI
(rule ((= e (GammaI c (SAbs a) (SAbs b))))
      ((union e (SAbs (GammaI c a b)))))

; Normalize and Length - ONE-DIRECTIONAL
; Normalize takes/returns Expr, so uses Gamma
(rule ((= e (Gamma c (Normalize a) (Normalize b))))
      ((union e (Normalize (Gamma c a b)))))
; Length takes Expr, returns FloatExpr -> outer GammaF, inner Gamma
(rule ((= e (GammaF c (Length a) (Length b))))
      ((union e (Length (Gamma c a b)))))

; =============================================================================
; Gamma with Common GLSL Binary Operations
; =============================================================================

; select(c, pow(a, x), pow(b, x)) = pow(select(c, a, b), x) - ONE-DIRECTIONAL
; Pow takes FloatExpr, returns FloatExpr -> GammaF
(rule ((= e (GammaF c (Pow a x) (Pow b x))))
      ((union e (Pow (GammaF c a b) x))))
(rule ((= e (GammaF c (Pow x a) (Pow x b))))
      ((union e (Pow x (GammaF c a b)))))

; Distance with common point - ONE-DIRECTIONAL
; Distance takes Expr, returns FloatExpr -> outer GammaF, inner Gamma
(rule ((= e (GammaF c (Distance a x) (Distance b x))))
      ((union e (Distance (Gamma c a b) x))))
(rule ((= e (GammaF c (Distance x a) (Distance x b))))
      ((union e (Distance x (Gamma c a b)))))

; Dot product with common vector - ONE-DIRECTIONAL
; Dot takes Expr, returns FloatExpr -> outer GammaF, inner Gamma
(rule ((= e (GammaF c (Dot a x) (Dot b x))))
      ((union e (Dot (Gamma c a b) x))))
(rule ((= e (GammaF c (Dot x a) (Dot x b))))
      ((union e (Dot x (Gamma c a b)))))

; Cross product with common vector - ONE-DIRECTIONAL
; Cross takes/returns Expr -> Gamma
(rule ((= e (Gamma c (Cross a x) (Cross b x))))
      ((union e (Cross (Gamma c a b) x))))
(rule ((= e (Gamma c (Cross x a) (Cross x b))))
      ((union e (Cross x (Gamma c a b)))))

; Reflect with common normal - ONE-DIRECTIONAL
; Reflect takes/returns Expr -> Gamma
(rule ((= e (Gamma c (Reflect a x) (Reflect b x))))
      ((union e (Reflect (Gamma c a b) x))))
(rule ((= e (Gamma c (Reflect x a) (Reflect x b))))
      ((union e (Reflect x (Gamma c a b)))))
