; =============================================================================
; RVSDG (Regionalized Value State Dependence Graph) Rewrite Rules
; =============================================================================
;
; RVSDG represents control flow in a structured, functional way:
; - Gamma nodes: Conditional selection (replaces if-then-else + phi)
; - Theta nodes: Tail-controlled loops (replaces while loops + phi)
; - Effects: Side effects and control flow

; =============================================================================
; Gamma/Select Equivalence
; =============================================================================

; Gamma and Select are equivalent - unify them
; ONE-DIRECTIONAL: Convert Select/If to Gamma (canonical form), never the reverse
(rule ((= e (Select c t f)))
      ((union e (Gamma c t f))))
(rule ((= e (If c t f)))
      ((union e (Gamma c t f))))

; =============================================================================
; RVSDG Gamma (Conditional) Rewrite Rules
; =============================================================================

; Gamma with constant condition - ONE-DIRECTIONAL
(rule ((= e (Gamma (Const 0) t f)))
      ((union e f)))
(rule ((= e (Gamma (Const 1) t f)))
      ((union e t)))

; Gamma with same true/false values - ONE-DIRECTIONAL
(rule ((= e (Gamma c x x)))
      ((union e x)))

; Gamma with negated condition - ONE-DIRECTIONAL
; Only simplify LogNot out of condition, never put it back
(rule ((= e (Gamma (LogNot c) t f)))
      ((union e (Gamma c f t))))

; Nested Gamma simplification (same condition)
(rewrite (Gamma c (Gamma c a b) d) (Gamma c a d))
(rewrite (Gamma c d (Gamma c a b)) (Gamma c d b))

; =============================================================================
; Additional Phi/Gamma Redundancy Patterns (C++ RedundantPhi)
; =============================================================================
; Note: Most Gamma constant patterns are defined later in this file (around line 215)

; Gamma where condition appears as one branch (boolean patterns)
; select(c, c, false) = c (identity for boolean c)
(rule ((= e (Gamma c c (Const 0))))
      ((union e c)))
; select(c, true, c) = c | true = true when c is boolean
; But this is the same as select(c, 1, c) = c ? 1 : c which is just 1 when c is true, c when false

; Gamma distributes over operations (hoisting) - ONE-DIRECTIONAL
; Push operations INTO Gamma, not out (pulling out creates Op(Gamma, Gamma) which explodes)
; These rules combine two Gammas with same condition into a single Gamma
(rule ((= e (Add (Gamma c a b) (Gamma c x y))))
      ((union e (Gamma c (Add a x) (Add b y)))))
(rule ((= e (Sub (Gamma c a b) (Gamma c x y))))
      ((union e (Gamma c (Sub a x) (Sub b y)))))
(rule ((= e (Mul (Gamma c a b) (Gamma c x y))))
      ((union e (Gamma c (Mul a x) (Mul b y)))))
(rule ((= e (BitAnd (Gamma c a b) (Gamma c x y))))
      ((union e (Gamma c (BitAnd a x) (BitAnd b y)))))
(rule ((= e (BitOr (Gamma c a b) (Gamma c x y))))
      ((union e (Gamma c (BitOr a x) (BitOr b y)))))
(rule ((= e (BitXor (Gamma c a b) (Gamma c x y))))
      ((union e (Gamma c (BitXor a x) (BitXor b y)))))

; Hoist common operations out of Gamma - ONE-DIRECTIONAL
; (c ? (x + a) : (x + b)) => x + (c ? a : b)
; Hoist the common factor OUT (simplifies branching)
(rule ((= e (Gamma c (Add x a) (Add x b))))
      ((union e (Add x (Gamma c a b)))))
(rule ((= e (Gamma c (Add a x) (Add b x))))
      ((union e (Add (Gamma c a b) x))))
(rule ((= e (Gamma c (Sub x a) (Sub x b))))
      ((union e (Sub x (Gamma c a b)))))
(rule ((= e (Gamma c (Mul x a) (Mul x b))))
      ((union e (Mul x (Gamma c a b)))))
(rule ((= e (Gamma c (Mul a x) (Mul b x))))
      ((union e (Mul (Gamma c a b) x))))
(rule ((= e (Gamma c (BitAnd x a) (BitAnd x b))))
      ((union e (BitAnd x (Gamma c a b)))))
(rule ((= e (Gamma c (BitOr x a) (BitOr x b))))
      ((union e (BitOr x (Gamma c a b)))))
(rule ((= e (Gamma c (BitXor x a) (BitXor x b))))
      ((union e (BitXor x (Gamma c a b)))))

; =============================================================================
; RVSDG Theta (Loop) Rewrite Rules - Loop Invariant Code Motion
; =============================================================================

; LoopInvariant is idempotent
(rewrite (LoopInvariant (LoopInvariant x)) (LoopInvariant x))

; Constants and symbols are inherently loop-invariant (they don't depend on LoopVar)
; NOTE: These rules are DISABLED because combined with the LoopInvariant stripping rule
; at line ~113, they create cycles: Const(5) ↔ LoopInvariant(Const(5))
; The stripping rule (LoopInvariant x) → x is bidirectional, so it also adds
; LoopInvariant to everything, creating x ↔ LoopInvariant(x) for ALL nodes.
; (rewrite (Const n) (LoopInvariant (Const n)))
; (rewrite (Const64 n) (LoopInvariant (Const64 n)))
; (rewrite (Sym s) (LoopInvariant (Sym s)))

; LoopVar is NOT loop-invariant (it changes each iteration)
; No rule to mark LoopVar as LoopInvariant

; Operations on loop invariants produce loop invariants - ONE-DIRECTIONAL
; Using rule/union to prevent LoopInvariant(Add a b) → Add(LI a, LI b) cycles
(rule ((= e (Add (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (Add a b)))))
(rule ((= e (Sub (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (Sub a b)))))
(rule ((= e (Mul (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (Mul a b)))))
(rule ((= e (SDiv (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (SDiv a b)))))
(rule ((= e (UDiv (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (UDiv a b)))))
(rule ((= e (BitAnd (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (BitAnd a b)))))
(rule ((= e (BitOr (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (BitOr a b)))))
(rule ((= e (BitXor (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (BitXor a b)))))
(rule ((= e (Shl (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (Shl a b)))))
(rule ((= e (ShrS (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (ShrS a b)))))
(rule ((= e (ShrU (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (ShrU a b)))))

; Unary operations on loop invariants - ONE-DIRECTIONAL
(rule ((= e (Neg (LoopInvariant a))))
      ((union e (LoopInvariant (Neg a)))))
(rule ((= e (BitNot (LoopInvariant a))))
      ((union e (LoopInvariant (BitNot a)))))
(rule ((= e (LogNot (LoopInvariant a))))
      ((union e (LoopInvariant (LogNot a)))))

; Comparisons on loop invariants - ONE-DIRECTIONAL
(rule ((= e (Eq (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (Eq a b)))))
(rule ((= e (Ne (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (Ne a b)))))
(rule ((= e (SLt (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (SLt a b)))))
(rule ((= e (SLe (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (SLe a b)))))
(rule ((= e (SGt (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (SGt a b)))))
(rule ((= e (SGe (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (SGe a b)))))
(rule ((= e (ULt (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (ULt a b)))))
(rule ((= e (ULe (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (ULe a b)))))
(rule ((= e (UGt (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (UGt a b)))))
(rule ((= e (UGe (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (UGe a b)))))

; =============================================================================
; Theta LICM: Hoist loop-invariant expressions out of Theta
; =============================================================================

; Core LICM rule: If the body of a Theta computes a LoopInvariant value,
; that value can be computed before the loop.
; (Theta cond (LoopInvariant x) init) - the invariant x doesn't need to be in the loop
; This rule doesn't directly eliminate the Theta, but marks what can be hoisted.

; Strip LoopInvariant wrapper (it's just an annotation for optimization)
; After optimization, we extract the inner value
; ONE-DIRECTIONAL: Using (rule ... union) to prevent x → LoopInvariant(x) for every x
(rule ((= e (LoopInvariant x)))
      ((union e x)))

; =============================================================================
; RVSDG Effect Rewrite Rules
; =============================================================================

; Sequence identity - ONE-DIRECTIONAL to prevent explosion
(rule ((= e (Seq (Pure) x)))
      ((union e x)))
(rule ((= e (Seq x (Pure))))
      ((union e x)))

; Unreachable absorbs everything after it
(rewrite (Seq (Unreachable) e) (Unreachable))

; Effect Gamma with constant condition - ONE-DIRECTIONAL to prevent explosion
(rule ((= e (EffGamma (Const 0) t f)))
      ((union e f)))
(rule ((= e (EffGamma (Const 1) t f)))
      ((union e t)))

; Effect Gamma with same branches - ONE-DIRECTIONAL to prevent explosion
(rule ((= result (EffGamma c x x)))
      ((union result x)))

; Effect Gamma with negated condition - ONE-DIRECTIONAL
(rule ((= e (EffGamma (LogNot c) t f)))
      ((union e (EffGamma c f t))))

; Both branches return same value -> just return that value
(rewrite (EffGamma c (ReturnValue x) (ReturnValue x)) (ReturnValue x))

; Both branches unreachable -> unreachable
(rewrite (EffGamma c (Unreachable) (Unreachable)) (Unreachable))

; One branch unreachable with return in other -> simplify
; (If cond then return x else unreachable) -> return x when cond is true
(rewrite (EffGamma c (ReturnValue x) (Unreachable)) (ReturnValue x))
(rewrite (EffGamma c (Unreachable) (ReturnValue x)) (ReturnValue x))

; Merge return transformation (the key RVSDG optimization!)
; If both branches return different values, create a Gamma to select the result
; (EffGamma c (ReturnValue x) (ReturnValue y)) -> (ReturnValue (Gamma c x y))
(rewrite (EffGamma c (ReturnValue x) (ReturnValue y)) (ReturnValue (Gamma c x y)))

; =============================================================================
; Additional Gamma Simplifications (C++ Parity)
; =============================================================================

; Gamma with one branch being the condition itself
; select(c, c, x) = c (when c is boolean, selecting true gives c=true)
; ONE-DIRECTIONAL to prevent explosion
(rule ((= e (Gamma c c x)))
      ((union e c)))
; select(c, x, c) where c is false gives false
; More precisely: select(c, x, 0) when result is 0/1
; ONE-DIRECTIONAL: Convert Gamma to LogAnd/LogOr, never reverse (prevents explosion)
(rule ((= e (Gamma c x (Const 0))))
      ((union e (LogAnd c x))))
(rule ((= e (Gamma c (Const 1) x)))
      ((union e (LogOr c x))))
(rule ((= e (Gamma c (Const 0) x)))
      ((union e (LogAnd (LogNot c) x))))
(rule ((= e (Gamma c x (Const 1))))
      ((union e (LogOr (LogNot c) x))))

; Gamma with constants 0/1 and variable
; select(c, 0, 1) = !c
; select(c, 1, 0) = c - ONE-DIRECTIONAL to prevent explosion
(rule ((= e (Gamma c (Const 0) (Const 1))))
      ((union e (LogNot c))))
(rule ((= e (Gamma c (Const 1) (Const 0))))
      ((union e c)))

; Chained Gamma with opposite conditions
; select(c, select(!c, a, b), x) simplifies
(rewrite (Gamma c (Gamma (LogNot c) a b) x) (Gamma c b x))
(rewrite (Gamma c x (Gamma (LogNot c) a b)) (Gamma c x a))

; Gamma selecting between x and operation on x
; select(c, x, x + 1) can't be simplified generally, but
; select(c, x, 0) when c means x!=0 can help

; =============================================================================
; Floating-Point Loop Invariant Rules - ONE-DIRECTIONAL
; =============================================================================

(rule ((= e (FAdd (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (FAdd a b)))))
(rule ((= e (FSub (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (FSub a b)))))
(rule ((= e (FMul (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (FMul a b)))))
(rule ((= e (FDiv (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (FDiv a b)))))
(rule ((= e (FNeg (LoopInvariant a))))
      ((union e (LoopInvariant (FNeg a)))))
(rule ((= e (FAbs (LoopInvariant a))))
      ((union e (LoopInvariant (FAbs a)))))
(rule ((= e (Sqrt (LoopInvariant a))))
      ((union e (LoopInvariant (Sqrt a)))))

; =============================================================================
; Floating-Point Gamma Distribution - ONE-DIRECTIONAL
; =============================================================================
; Distribution INTO Gamma (combining two conditional values)
(rule ((= e (FAdd (Gamma c a b) (Gamma c x y))))
      ((union e (Gamma c (FAdd a x) (FAdd b y)))))
(rule ((= e (FSub (Gamma c a b) (Gamma c x y))))
      ((union e (Gamma c (FSub a x) (FSub b y)))))
(rule ((= e (FMul (Gamma c a b) (Gamma c x y))))
      ((union e (Gamma c (FMul a x) (FMul b y)))))

; Hoisting common factors OUT of Gamma - ONE-DIRECTIONAL
(rule ((= e (Gamma c (FAdd x a) (FAdd x b))))
      ((union e (FAdd x (Gamma c a b)))))
(rule ((= e (Gamma c (FMul x a) (FMul x b))))
      ((union e (FMul x (Gamma c a b)))))

; =============================================================================
; Theta (Loop) Optimization Rules - ONE-DIRECTIONAL
; =============================================================================

; Theta with false condition never executes - return initial value
(rule ((= e (Theta (Const 0) body init)))
      ((union e init)))

; Theta with constant true condition would loop forever
; We don't simplify this as it's an infinite loop

; Theta where body equals LoopVar - loop does nothing, return init
; (Theta cond (LoopVar) init) = init when loop doesn't modify state
(rule ((= e (Theta cond (LoopVar) init)))
      ((union e init)))

; =============================================================================
; More Loop Invariant Propagation - ONE-DIRECTIONAL
; =============================================================================

; Comparison of loop invariants
(rule ((= e (FOrdEq (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (FOrdEq a b)))))
(rule ((= e (FOrdNe (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (FOrdNe a b)))))
(rule ((= e (FOrdLt (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (FOrdLt a b)))))
(rule ((= e (FOrdLe (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (FOrdLe a b)))))
(rule ((= e (FOrdGt (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (FOrdGt a b)))))
(rule ((= e (FOrdGe (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (FOrdGe a b)))))

; GLSL extended instructions on loop invariants
(rule ((= e (FMin (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (FMin a b)))))
(rule ((= e (FMax (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (FMax a b)))))
(rule ((= e (FFloor (LoopInvariant a))))
      ((union e (LoopInvariant (FFloor a)))))
(rule ((= e (FCeil (LoopInvariant a))))
      ((union e (LoopInvariant (FCeil a)))))
(rule ((= e (FRound (LoopInvariant a))))
      ((union e (LoopInvariant (FRound a)))))
(rule ((= e (FTrunc (LoopInvariant a))))
      ((union e (LoopInvariant (FTrunc a)))))

; Exp/Log on loop invariants
(rule ((= e (Exp (LoopInvariant a))))
      ((union e (LoopInvariant (Exp a)))))
(rule ((= e (Log (LoopInvariant a))))
      ((union e (LoopInvariant (Log a)))))
(rule ((= e (Exp2 (LoopInvariant a))))
      ((union e (LoopInvariant (Exp2 a)))))
(rule ((= e (Log2 (LoopInvariant a))))
      ((union e (LoopInvariant (Log2 a)))))
(rule ((= e (Pow (LoopInvariant a) (LoopInvariant b))))
      ((union e (LoopInvariant (Pow a b)))))

; Trig functions on loop invariants
(rule ((= e (Sin (LoopInvariant a))))
      ((union e (LoopInvariant (Sin a)))))
(rule ((= e (Cos (LoopInvariant a))))
      ((union e (LoopInvariant (Cos a)))))
(rule ((= e (Tan (LoopInvariant a))))
      ((union e (LoopInvariant (Tan a)))))

; InverseSqrt on loop invariant
(rewrite (InverseSqrt (LoopInvariant a)) (LoopInvariant (InverseSqrt a)))

; =============================================================================
; Gamma Inside Theta (Loop-conditional code motion)
; =============================================================================

; If condition is loop-invariant, hoist the Gamma out of the loop body
; Theta(cond, Gamma(LoopInvariant(c), a, b), init)
; can become Gamma(c, Theta(cond, a, init), Theta(cond, b, init))
; This is complex and may not always be beneficial, so we skip it

; =============================================================================
; Min/Max Loop Invariant Rules
; =============================================================================

(rewrite (SMin (LoopInvariant a) (LoopInvariant b)) (LoopInvariant (SMin a b)))
(rewrite (SMax (LoopInvariant a) (LoopInvariant b)) (LoopInvariant (SMax a b)))
(rewrite (UMin (LoopInvariant a) (LoopInvariant b)) (LoopInvariant (UMin a b)))
(rewrite (UMax (LoopInvariant a) (LoopInvariant b)) (LoopInvariant (UMax a b)))

; =============================================================================
; Additional Gamma with Min/Max
; =============================================================================

; select(c, min(a, b), min(a, d)) = min(a, select(c, b, d))
(rewrite (Gamma c (SMin a b) (SMin a d)) (SMin a (Gamma c b d)))
(rewrite (Gamma c (SMax a b) (SMax a d)) (SMax a (Gamma c b d)))
(rewrite (Gamma c (UMin a b) (UMin a d)) (UMin a (Gamma c b d)))
(rewrite (Gamma c (UMax a b) (UMax a d)) (UMax a (Gamma c b d)))
(rewrite (Gamma c (FMin a b) (FMin a d)) (FMin a (Gamma c b d)))
(rewrite (Gamma c (FMax a b) (FMax a d)) (FMax a (Gamma c b d)))

; =============================================================================
; Gamma with Comparisons (comparison absorption)
; =============================================================================

; select(a < b, a, b) = min(a, b)
; select(a < b, b, a) = max(a, b)
(rewrite (Gamma (SLt a b) a b) (SMin a b))
(rewrite (Gamma (SLt a b) b a) (SMax a b))
(rewrite (Gamma (ULt a b) a b) (UMin a b))
(rewrite (Gamma (ULt a b) b a) (UMax a b))
(rewrite (Gamma (FOrdLt a b) a b) (FMin a b))
(rewrite (Gamma (FOrdLt a b) b a) (FMax a b))

; select(a > b, a, b) = max(a, b)
; select(a > b, b, a) = min(a, b)
(rewrite (Gamma (SGt a b) a b) (SMax a b))
(rewrite (Gamma (SGt a b) b a) (SMin a b))
(rewrite (Gamma (UGt a b) a b) (UMax a b))
(rewrite (Gamma (UGt a b) b a) (UMin a b))
(rewrite (Gamma (FOrdGt a b) a b) (FMax a b))
(rewrite (Gamma (FOrdGt a b) b a) (FMin a b))

; select(a <= b, a, b) = min(a, b)
(rewrite (Gamma (SLe a b) a b) (SMin a b))
(rewrite (Gamma (SLe a b) b a) (SMax a b))
(rewrite (Gamma (ULe a b) a b) (UMin a b))
(rewrite (Gamma (ULe a b) b a) (UMax a b))
(rewrite (Gamma (FOrdLe a b) a b) (FMin a b))
(rewrite (Gamma (FOrdLe a b) b a) (FMax a b))

; =============================================================================
; Additional Gamma Optimizations (C++ Parity)
; =============================================================================

; select(a >= b, a, b) = max(a, b)
(rewrite (Gamma (SGe a b) a b) (SMax a b))
(rewrite (Gamma (SGe a b) b a) (SMin a b))
(rewrite (Gamma (UGe a b) a b) (UMax a b))
(rewrite (Gamma (UGe a b) b a) (UMin a b))
(rewrite (Gamma (FOrdGe a b) a b) (FMax a b))
(rewrite (Gamma (FOrdGe a b) b a) (FMin a b))

; Gamma with equality: select(a == b, x, x) already handled
; select(a == b, a, b) = b (if a==b then a else b, which is just b semantically)
; Actually this is just identity - if equal pick a (which equals b), else pick b

; Gamma with negated comparison already handled via LogNot rule

; =============================================================================
; Clamp Pattern Recognition
; =============================================================================

; max(min(x, hi), lo) = clamp(x, lo, hi) when lo <= hi
(rewrite (SMax (SMin x hi) lo) (SClamp x lo hi))
(rewrite (UMax (UMin x hi) lo) (UClamp x lo hi))
(rewrite (FMax (FMin x hi) lo) (FClamp x lo hi))

; min(max(x, lo), hi) = clamp(x, lo, hi) when lo <= hi
(rewrite (SMin (SMax x lo) hi) (SClamp x lo hi))
(rewrite (UMin (UMax x lo) hi) (UClamp x lo hi))
(rewrite (FMin (FMax x lo) hi) (FClamp x lo hi))

; =============================================================================
; Dead Branch Elimination for EffGamma
; =============================================================================

; If the condition is a comparison that's always true/false based on analysis,
; the branch can be eliminated. This is complex without value analysis.
; The constant condition rules (EffGamma (Const 0) t f) = f etc. are already covered.

; =============================================================================
; Theta Loop Unrolling Patterns
; =============================================================================

; Theta with loop body that doesn't use LoopVar effectively
; (Theta cond (SomeOp (LoopInvariant x)) init) patterns are already handled
; via the LoopInvariant wrapper rules

; =============================================================================
; Advanced Egraph-Only Optimizations (Beyond C++ Parity)
; =============================================================================
; These rules exploit the global nature of egraph optimization to find
; simplifications that multi-pass C++ optimizers cannot easily discover.

; Cross-branch common subexpression: if both branches compute the same thing
; differently, the egraph will unify them automatically. We add rules for
; specific patterns that help guide this:

; select(c, f(x), f(y)) where f is expensive can become f(select(c, x, y))
; when f is a pure function. This is already covered by Gamma distribution.

; Select absorption with arithmetic: - ONE-DIRECTIONAL
; select(c, x + y, x) = x + select(c, y, 0) - hoist common term OUT
(rule ((= e (Gamma c (Add x y) x)))
      ((union e (Add x (Gamma c y (Const 0))))))
(rule ((= e (Gamma c x (Add x y))))
      ((union e (Add x (Gamma c (Const 0) y)))))
(rule ((= e (Gamma c (FAdd x y) x)))
      ((union e (FAdd x (Gamma c y (Const 0))))))
(rule ((= e (Gamma c x (FAdd x y))))
      ((union e (FAdd x (Gamma c (Const 0) y)))))

; select(c, x * y, x) = x * select(c, y, 1) (when y could be 1) - ONE-DIRECTIONAL
(rule ((= e (Gamma c (Mul x y) x)))
      ((union e (Mul x (Gamma c y (Const 1))))))
(rule ((= e (Gamma c x (Mul x y))))
      ((union e (Mul x (Gamma c (Const 1) y)))))
(rule ((= e (Gamma c (FMul x y) x)))
      ((union e (FMul x (Gamma c y (Const 1))))))
(rule ((= e (Gamma c x (FMul x y))))
      ((union e (FMul x (Gamma c (Const 1) y)))))

; Nested Gamma flattening (when inner condition relates to outer)
; select(c, select(c, a, b), d) = select(c, a, d) - already have
; select(c, d, select(c, a, b)) = select(c, d, b) - already have

; Double-condition elimination:
; select(c, select(d, a, b), select(d, c_val, e)) patterns

; =============================================================================
; Algebraic Simplification through Gamma
; =============================================================================

; NOTE: The inverse rules for "x op select(c, y, 0) -> select(c, x op y, x)" are REMOVED
; because they form a cycle with the rules at lines 422-439.
; The select absorption rules above (420-439) are the canonical simplifying direction.

; =============================================================================
; Min/Max with Select Patterns
; =============================================================================

; min(select(c, a, b), x) where we know relationship
; These help when one branch is constrained

; max(x, 0) when x is known non-negative = x
; This requires value analysis we don't have, but the pattern is:
; select(x >= 0, x, -x) = abs(x)
(rewrite (Gamma (SGe x (Const 0)) x (Neg x)) (SAbs x))
(rewrite (Gamma (SLt x (Const 0)) (Neg x) x) (SAbs x))
(rewrite (Gamma (FOrdGe x (Const 0)) x (FNeg x)) (FAbs x))
(rewrite (Gamma (FOrdLt x (Const 0)) (FNeg x) x) (FAbs x))

; =============================================================================
; Conditional Evaluation Short-Circuiting - ONE-DIRECTIONAL
; =============================================================================

; select(c, c && x, false) = c && x (boolean contexts)
(rule ((= e (Gamma c (LogAnd c x) (Const 0))))
      ((union e (LogAnd c x))))

; select(c, c || x, true) = true (when c is true, c||x is true; when false, true)
; Actually: select(c, c || x, y) - if c then (true || x)=true, else y
(rule ((= e (Gamma c (LogOr c x) y)))
      ((union e (LogOr c y))))

; select(c, true, c || x) = c || x
; NOTE: This rule was REMOVED because it creates new Gamma nodes that cause cycles
; (rewrite (Gamma c (Const 1) (LogOr c x)) (LogOr c (Gamma c (Const 1) x)))

; =============================================================================
; Gamma Distribution over Division Operations (C++ Parity)
; =============================================================================
; These rules hoist common operands out of conditional branches
; Note: Shift Gamma distribution rules are in bitwise.egg

; Division operations: select(c, a / x, b / x) = select(c, a, b) / x
(rewrite (Gamma c (SDiv a x) (SDiv b x)) (SDiv (Gamma c a b) x))
(rewrite (Gamma c (UDiv a x) (UDiv b x)) (UDiv (Gamma c a b) x))
(rewrite (Gamma c (FDiv a x) (FDiv b x)) (FDiv (Gamma c a b) x))

; Division with common dividend: select(c, x / a, x / b) = x / select(c, a, b)
(rewrite (Gamma c (SDiv x a) (SDiv x b)) (SDiv x (Gamma c a b)))
(rewrite (Gamma c (UDiv x a) (UDiv x b)) (UDiv x (Gamma c a b)))
(rewrite (Gamma c (FDiv x a) (FDiv x b)) (FDiv x (Gamma c a b)))

; Remainder/modulo operations
(rewrite (Gamma c (SRem a x) (SRem b x)) (SRem (Gamma c a b) x))
(rewrite (Gamma c (SMod a x) (SMod b x)) (SMod (Gamma c a b) x))
(rewrite (Gamma c (UMod a x) (UMod b x)) (UMod (Gamma c a b) x))
(rewrite (Gamma c (FRem a x) (FRem b x)) (FRem (Gamma c a b) x))

; Negation: select(c, -a, -b) = -(select(c, a, b))
(rewrite (Gamma c (Neg a) (Neg b)) (Neg (Gamma c a b)))
(rewrite (Gamma c (FNeg a) (FNeg b)) (FNeg (Gamma c a b)))

; Note: BitNot Gamma distribution is in bitwise.egg

; =============================================================================
; Gamma Distribution over Comparison Operations
; =============================================================================
; select(c, a < x, b < x) = select(c, a, b) < x
(rewrite (Gamma c (SLt a x) (SLt b x)) (SLt (Gamma c a b) x))
(rewrite (Gamma c (SLe a x) (SLe b x)) (SLe (Gamma c a b) x))
(rewrite (Gamma c (SGt a x) (SGt b x)) (SGt (Gamma c a b) x))
(rewrite (Gamma c (SGe a x) (SGe b x)) (SGe (Gamma c a b) x))
(rewrite (Gamma c (ULt a x) (ULt b x)) (ULt (Gamma c a b) x))
(rewrite (Gamma c (ULe a x) (ULe b x)) (ULe (Gamma c a b) x))
(rewrite (Gamma c (UGt a x) (UGt b x)) (UGt (Gamma c a b) x))
(rewrite (Gamma c (UGe a x) (UGe b x)) (UGe (Gamma c a b) x))
(rewrite (Gamma c (Eq a x) (Eq b x)) (Eq (Gamma c a b) x))
(rewrite (Gamma c (Ne a x) (Ne b x)) (Ne (Gamma c a b) x))

; Floating-point comparisons
(rewrite (Gamma c (FOrdLt a x) (FOrdLt b x)) (FOrdLt (Gamma c a b) x))
(rewrite (Gamma c (FOrdLe a x) (FOrdLe b x)) (FOrdLe (Gamma c a b) x))
(rewrite (Gamma c (FOrdGt a x) (FOrdGt b x)) (FOrdGt (Gamma c a b) x))
(rewrite (Gamma c (FOrdGe a x) (FOrdGe b x)) (FOrdGe (Gamma c a b) x))
(rewrite (Gamma c (FOrdEq a x) (FOrdEq b x)) (FOrdEq (Gamma c a b) x))
(rewrite (Gamma c (FOrdNe a x) (FOrdNe b x)) (FOrdNe (Gamma c a b) x))

; =============================================================================
; Gamma Distribution over GLSL Functions
; =============================================================================

; select(c, sqrt(a), sqrt(b)) = sqrt(select(c, a, b))
(rewrite (Gamma c (Sqrt a) (Sqrt b)) (Sqrt (Gamma c a b)))
(rewrite (Gamma c (InverseSqrt a) (InverseSqrt b)) (InverseSqrt (Gamma c a b)))

; Exponential functions
(rewrite (Gamma c (Exp a) (Exp b)) (Exp (Gamma c a b)))
(rewrite (Gamma c (Exp2 a) (Exp2 b)) (Exp2 (Gamma c a b)))
(rewrite (Gamma c (Log a) (Log b)) (Log (Gamma c a b)))
(rewrite (Gamma c (Log2 a) (Log2 b)) (Log2 (Gamma c a b)))

; Trigonometric functions
(rewrite (Gamma c (Sin a) (Sin b)) (Sin (Gamma c a b)))
(rewrite (Gamma c (Cos a) (Cos b)) (Cos (Gamma c a b)))
(rewrite (Gamma c (Tan a) (Tan b)) (Tan (Gamma c a b)))

; Rounding functions
(rewrite (Gamma c (FFloor a) (FFloor b)) (FFloor (Gamma c a b)))
(rewrite (Gamma c (FCeil a) (FCeil b)) (FCeil (Gamma c a b)))
(rewrite (Gamma c (FRound a) (FRound b)) (FRound (Gamma c a b)))
(rewrite (Gamma c (FTrunc a) (FTrunc b)) (FTrunc (Gamma c a b)))

; Absolute value
(rewrite (Gamma c (FAbs a) (FAbs b)) (FAbs (Gamma c a b)))
(rewrite (Gamma c (SAbs a) (SAbs b)) (SAbs (Gamma c a b)))

; Normalize and Length
(rewrite (Gamma c (Normalize a) (Normalize b)) (Normalize (Gamma c a b)))
(rewrite (Gamma c (Length a) (Length b)) (Length (Gamma c a b)))

; =============================================================================
; Gamma with Common GLSL Binary Operations
; =============================================================================

; select(c, pow(a, x), pow(b, x)) = pow(select(c, a, b), x)
(rewrite (Gamma c (Pow a x) (Pow b x)) (Pow (Gamma c a b) x))
(rewrite (Gamma c (Pow x a) (Pow x b)) (Pow x (Gamma c a b)))

; Distance with common point
(rewrite (Gamma c (Distance a x) (Distance b x)) (Distance (Gamma c a b) x))
(rewrite (Gamma c (Distance x a) (Distance x b)) (Distance x (Gamma c a b)))

; Dot product with common vector
(rewrite (Gamma c (Dot a x) (Dot b x)) (Dot (Gamma c a b) x))
(rewrite (Gamma c (Dot x a) (Dot x b)) (Dot x (Gamma c a b)))

; Cross product with common vector
(rewrite (Gamma c (Cross a x) (Cross b x)) (Cross (Gamma c a b) x))
(rewrite (Gamma c (Cross x a) (Cross x b)) (Cross x (Gamma c a b)))

; Reflect with common normal
(rewrite (Gamma c (Reflect a x) (Reflect b x)) (Reflect (Gamma c a b) x))
(rewrite (Gamma c (Reflect x a) (Reflect x b)) (Reflect x (Gamma c a b)))
