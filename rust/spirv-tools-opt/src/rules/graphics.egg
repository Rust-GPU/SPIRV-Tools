; =============================================================================
; Graphics-Specific Optimizations for E-Graph
; =============================================================================
;
; This module provides optimizations specific to graphics shaders:
; - Interpolation optimization
; - Texture sampling optimization
; - Fragment shader optimizations
; - Robustness transformations
; - Descriptor access optimization
;
; =============================================================================
; Interpolation Optimization
; =============================================================================
; Interpolated values in fragment shaders have special properties.

; Multiple uses of same interpolated value are automatically CSE'd by e-graph

; Interpolation of constant = constant
; (Interpolating a constant across a triangle gives the same constant)

; =============================================================================
; Texture Sampling Optimization
; =============================================================================

; Same texture sampled at same coordinate = same result
; (Automatic in e-graph - same ImageSample expression)

; ImageSample with constant coordinate can be hoisted
(rule ((= e (ImageSample img (LoopInvariant coord))))
      ((union e (LoopInvariant (ImageSample img coord)))))

(rule ((= e (ImageFetch img (LoopInvariant coord))))
      ((union e (LoopInvariant (ImageFetch img coord)))))

; =============================================================================
; Image Operand Optimization (UpdateImageOperands)
; =============================================================================
; Promotes variable Offset to ConstOffset when the offset is constant,
; and eliminates zero offsets entirely.

; Zero offset elimination — Vec2 of zeros
(rule ((= e (ImageSampleOffset img coord (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e (ImageSample img coord))))
(rule ((= e (ImageFetchOffset img coord (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e (ImageFetch img coord))))

; Zero offset elimination — Vec3 of zeros
(rule ((= e (ImageSampleOffset img coord (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e (ImageSample img coord))))
(rule ((= e (ImageFetchOffset img coord (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e (ImageFetch img coord))))

; Zero offset elimination — Vec4 of zeros
(rule ((= e (ImageSampleOffset img coord (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e (ImageSample img coord))))
(rule ((= e (ImageFetchOffset img coord (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e (ImageFetch img coord))))

; Zero ConstOffset elimination — same rules for ConstOffset
(rule ((= e (ImageSampleConstOffset img coord (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e (ImageSample img coord))))
(rule ((= e (ImageFetchConstOffset img coord (Vec2 (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e (ImageFetch img coord))))
(rule ((= e (ImageSampleConstOffset img coord (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e (ImageSample img coord))))
(rule ((= e (ImageFetchConstOffset img coord (Vec3 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e (ImageFetch img coord))))
(rule ((= e (ImageSampleConstOffset img coord (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e (ImageSample img coord))))
(rule ((= e (ImageFetchConstOffset img coord (Vec4 (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0)) (IntToExpr (Const 0))))))
      ((union e (ImageFetch img coord))))

; Offset → ConstOffset promotion when offset is a constant vector
; Vec2 with all constant components
(rule ((= e (ImageSampleOffset img coord off))
       (= off (Vec2 (IntToExpr (Const a)) (IntToExpr (Const b)))))
      ((union e (ImageSampleConstOffset img coord off))))
(rule ((= e (ImageFetchOffset img coord off))
       (= off (Vec2 (IntToExpr (Const a)) (IntToExpr (Const b)))))
      ((union e (ImageFetchConstOffset img coord off))))
; Vec3 with all constant components
(rule ((= e (ImageSampleOffset img coord off))
       (= off (Vec3 (IntToExpr (Const a)) (IntToExpr (Const b)) (IntToExpr (Const c)))))
      ((union e (ImageSampleConstOffset img coord off))))
(rule ((= e (ImageFetchOffset img coord off))
       (= off (Vec3 (IntToExpr (Const a)) (IntToExpr (Const b)) (IntToExpr (Const c)))))
      ((union e (ImageFetchConstOffset img coord off))))
; Vec4 with all constant components
(rule ((= e (ImageSampleOffset img coord off))
       (= off (Vec4 (IntToExpr (Const a)) (IntToExpr (Const b)) (IntToExpr (Const c)) (IntToExpr (Const d)))))
      ((union e (ImageSampleConstOffset img coord off))))
(rule ((= e (ImageFetchOffset img coord off))
       (= off (Vec4 (IntToExpr (Const a)) (IntToExpr (Const b)) (IntToExpr (Const c)) (IntToExpr (Const d)))))
      ((union e (ImageFetchConstOffset img coord off))))

; =============================================================================
; Fragment Derivative Optimization
; =============================================================================
; Derivatives have special properties.
; Note: DPdx/DPdy/Fwidth take FloatExpr and return FloatExpr.
; FAdd/FSub/FMul/FDiv/FNeg are FloatExpr operations.

; Already in memory.egg:
; - DPdx/DPdy of constant = 0
; - Fwidth of constant = 0

; Derivative of sum = sum of derivatives
; Note: Add is IntExpr, DPdx takes FloatExpr. Only FAdd variant is valid.
(rule ((= e (DPdx (FAdd a b))))
      ((union e (FAdd (DPdx a) (DPdx b)))))
(rule ((= e (DPdy (FAdd a b))))
      ((union e (FAdd (DPdy a) (DPdy b)))))

; Derivative of product (product rule)
; d/dx(a*b) = a*d/dx(b) + b*d/dx(a)
(rule ((= e (DPdx (FMul a b))))
      ((union e (FAdd (FMul a (DPdx b)) (FMul b (DPdx a))))))
(rule ((= e (DPdy (FMul a b))))
      ((union e (FAdd (FMul a (DPdy b)) (FMul b (DPdy a))))))

; Derivative of scaled value
; d/dx(c * x) where c is constant = c * d/dx(x)
; Note: FConst for float constants in FMul context (FMul takes FloatExpr)
(rule ((= e (DPdx (FMul (FConst c) x))))
      ((union e (FMul (FConst c) (DPdx x)))))
(rule ((= e (DPdy (FMul (FConst c) x))))
      ((union e (FMul (FConst c) (DPdy x)))))

; Derivative of negation
; d/dx(-x) = -d/dx(x)
(rule ((= e (DPdx (FNeg x))))
      ((union e (FNeg (DPdx x)))))
(rule ((= e (DPdy (FNeg x))))
      ((union e (FNeg (DPdy x)))))

; Derivative of subtraction
; d/dx(a - b) = d/dx(a) - d/dx(b)
(rule ((= e (DPdx (FSub a b))))
      ((union e (FSub (DPdx a) (DPdx b)))))
(rule ((= e (DPdy (FSub a b))))
      ((union e (FSub (DPdy a) (DPdy b)))))

; Derivative of division (quotient rule) when divisor is constant
; d/dx(x / c) = d/dx(x) / c
; Note: FConst for float constants in FDiv context (FDiv takes FloatExpr)
(rule ((= e (DPdx (FDiv x (FConst c)))))
      ((union e (FDiv (DPdx x) (FConst c)))))
(rule ((= e (DPdy (FDiv x (FConst c)))))
      ((union e (FDiv (DPdy x) (FConst c)))))

; Fwidth distribution over addition
; fwidth(a + b) can be approximated as fwidth(a) + fwidth(b)
; Note: This is an approximation - fwidth = abs(dFdx) + abs(dFdy)
(rule ((= e (Fwidth (FAdd a b))))
      ((union e (FAdd (Fwidth a) (Fwidth b)))))

; Fwidth of scaled value
; Note: FConst for float constants, FAbs(FloatExpr) -> FloatExpr
(rule ((= e (Fwidth (FMul (FConst c) x))))
      ((union e (FMul (FAbs (FConst c)) (Fwidth x)))))

; Fwidth of negation is same as fwidth of original
; fwidth(-x) = fwidth(x) since fwidth uses absolute values
(rule ((= e (Fwidth (FNeg x))))
      ((union e (Fwidth x))))

; =============================================================================
; SampledImage Optimization
; =============================================================================
; Combining and extracting image/sampler pairs.

; Extracting image from combined and immediately recombining = original
(rule ((= e (SampledImage (Image combined) sampler))
       (= combined (SampledImage img sampler)))
      ((union e combined)))

; CSE: Same image + same sampler = same combined result
; (Automatic in e-graph through structural equality)

; =============================================================================
; Robustness Transformations
; =============================================================================
; Ensure robust access to buffers and images.

; Clamp array index to valid range
; For robustness, index should be: clamp(idx, 0, array_size - 1)
; This transformation is typically done by the driver/runtime,
; but we can represent clamped access in the e-graph.

; Robust buffer access pattern:
; Load(AccessChain(buf, idx), mem) where idx might be out of bounds
; Could become: Load(AccessChain(buf, Clamp(idx, 0, size-1)), mem)

; =============================================================================
; Descriptor Optimization
; =============================================================================
; Optimize access to descriptor sets.

; Multiple loads from same descriptor = same value (for uniform/readonly)
; (Automatic in e-graph)

; Descriptor accessed in uniform control flow is uniform
; (Handled by loop invariant rules)

; =============================================================================
; Workgroup/Shared Memory Optimization
; =============================================================================
; Optimize access to workgroup shared memory.

; Shared memory is indexed by local invocation ID patterns
; Barrier synchronization affects memory state

; Barrier splits memory state (no forwarding across barrier)
; For now, treat barriers as opaque memory operations

; =============================================================================
; Subgroup Operations
; =============================================================================
; Subgroup operations have special semantics.

; SubgroupBroadcast of uniform value = that value
; SubgroupShuffle with constant lane = extract from known position

; =============================================================================
; Kill/Terminate Optimization
; =============================================================================
; OpKill/OpTerminateInvocation handling.

; Code after kill is dead
; (Handled by control flow analysis)

; Conditional kill can sometimes be converted to conditional output
; (Complex - depends on shader requirements)

; =============================================================================
; Output Optimization
; =============================================================================
; Optimize writes to output variables.

; Multiple writes to same output = last write wins (like dead store)
; (Handled by StoreMem rules)

; Conditional output can use select
; if (cond) { output = a; } else { output = b; }
; becomes: output = select(cond, a, b)
; (Handled by Gamma rules)
